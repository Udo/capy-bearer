diff --git a/src/capy/stdlib.capy b/src/capy/stdlib.capy
index 0bc0c21..0df779a 100644
--- a/src/capy/stdlib.capy
+++ b/src/capy/stdlib.capy
@@ -275,6 +275,17 @@ function substr(value : string, start : s64) string { -> __bearer_string_substr(
 function substr(value : string, start : s32, length : s32) string { -> __bearer_string_substr(value, s64(start), s64(length)) }
 function substr(value : string, start : s64, length : s64) string { -> __bearer_string_substr(value, start, length) }
 function strpos(haystack : string, needle : string, offset : s64 = 0) s64 { -> __bearer_string_strpos(haystack, needle, offset) }
+function nibble(haystack : string, delim : string) string {
+    var idx := strpos(haystack, delim)
+    if idx < 0 {
+        var result := haystack
+        haystack = ""
+        return result
+    }
+    var result := substr(haystack, 0, idx)
+    haystack = substr(haystack, idx + s64(length(delim)))
+    return result
+}
 function dval_set(value : dval, source : as dval) dval { -> __bearer_dval_replace(value, __bearer_dv_apply_brrb(__bearer_dval_dval_set(), value, "", source)) }

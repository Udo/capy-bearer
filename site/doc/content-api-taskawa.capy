#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "task-await" {
        var page := dval({source_page: ""})
        page["source_page"] = "task_await"
        page["kind"] = "api"
        page["slug"] = "task-await"
        page["route"] = "/doc/api/task-await/"
        page["title"] = "task_await"
        page["content"] = "## sig\n\nfunction task_await(id : string, timeout_ms : u64) dval\n\nUse `task_await` to wait for a task status. It returns when the task ends or the timeout expires.\n"
        page["returns"] = "Task status map."
        page["label"] = "task_await"
        page["capy_sig_lines"] = dval(["function task_await(id : string, timeout_ms : u64) dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var status := task_await(\"\", u64(0))\nprint(string(status[\"state\"]), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

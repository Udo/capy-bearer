#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "regex-split" {
        var page := dval({source_page: ""})
        page["source_page"] = "regex_split"
        page["kind"] = "api"
        page["slug"] = "regex-split"
        page["route"] = "/doc/api/regex-split/"
        page["title"] = "regex_split"
        page["content"] = "`regex_split()` removes separators and keeps empty parts.\n"
        page["returns"] = "A list of text parts."
        page["label"] = "regex_split"
        page["capy_sig_lines"] = dval(["function regex_split(pattern : string, subject : string, flags : string = \"\") dval"])
        page["param_lines"] = dval(["pattern : regular expression separator", "subject : text to split", "flags : regular expression flags", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var parts := regex_split(\",\", \"a,,b\")\nprint(parts[1], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

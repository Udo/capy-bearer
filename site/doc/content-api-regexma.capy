#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "regex-match" {
        var page := dval({source_page: ""})
        page["source_page"] = "regex_match"
        page["kind"] = "api"
        page["slug"] = "regex-match"
        page["route"] = "/doc/api/regex-match/"
        page["title"] = "regex_match"
        page["content"] = "Use `regex_match()` to test a complete string. Use `regex_search()` to find text within a string.\n"
        page["returns"] = "`true` if the complete subject matches the pattern."
        page["label"] = "regex_match"
        page["capy_sig_lines"] = dval(["function regex_match(pattern : string, subject : string, flags : string = \"\") bool"])
        page["param_lines"] = dval(["pattern : regular expression", "subject : text to test", "flags : regular expression flags", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(regex_match(\"[a-z]+\", \"Capy\", \"i\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

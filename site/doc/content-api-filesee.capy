#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-seek" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_seek"
        page["kind"] = "api"
        page["slug"] = "file-seek"
        page["route"] = "/doc/api/file-seek/"
        page["title"] = "file_seek"
        page["content"] = "## sig\n\nfunction file_seek(handle : u64, offset : s64, whence : s64) s64\n\n`file_seek` sets the position for file reads and writes.\n"
        page["returns"] = "The new byte offset. Returns `-1` on error."
        page["label"] = "file_seek"
        page["capy_sig_lines"] = dval(["function file_seek(handle : u64, offset : s64, whence : s64) s64"])
        page["param_lines"] = dval(["handle : handle from `file_open`", "offset : byte offset", "whence : `0` for the start, `1` for the current position, or `2` for the end", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var handle := file_open(\"/tmp/doc-seek.txt\", \"w\")\nfile_write(handle, \"hello world\")\nfile_close(handle)\nhandle = file_open(\"/tmp/doc-seek.txt\", \"r\")\nfile_seek(handle, s64(6), s64(0))\nprint(file_read(handle, u64(5)), \"\\n\")\nfile_close(handle)\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

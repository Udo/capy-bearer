#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-pop" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_pop"
        page["kind"] = "api"
        page["slug"] = "dvalue-pop"
        page["route"] = "/doc/api/dvalue-pop/"
        page["title"] = "Remove the final child"
        page["content"] = "`dval_pop` removes the final child and returns `value`. It does not return the removed child.\n"
        page["returns"] = "The changed target value."
        page["label"] = "dval_pop"
        page["capy_sig_lines"] = dval(["function dval_pop(value : dval) dval"])
        page["param_lines"] = dval(["value : target value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var list := dval([\"first\", \"last\"])\nlist = dval_pop(list)\nprint(list[0], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-push" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_push"
        page["kind"] = "api"
        page["slug"] = "dvalue-push"
        page["route"] = "/doc/api/dvalue-push/"
        page["title"] = "Append a child"
        page["content"] = "`dval_push` appends `child` with the next numeric key. It changes and returns `value`.\n"
        page["returns"] = "The changed target value."
        page["label"] = "dval_push"
        page["capy_sig_lines"] = dval(["function dval_push(value : dval, child : as dval) dval"])
        page["param_lines"] = dval(["value : target value", "child : value to append", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var list := dval([])\nlist = dval_push(list, \"Ada\")\nprint(list[0], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

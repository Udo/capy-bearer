#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "parse-uri" {
        var page := dval({source_page: ""})
        page["source_page"] = "parse_uri"
        page["kind"] = "api"
        page["slug"] = "parse-uri"
        page["route"] = "/doc/api/parse-uri/"
        page["title"] = "parse_uri"
        page["content"] = "## sig\n\nfunction parse_uri(uri : string) dval\n\n`parse_uri()` returns URI parts as a `dval`.\n\nRead the `parts` and `query` maps from the result. Use `parse_query()` when you only have query text.\n"
        page["returns"] = "the URI data"
        page["label"] = "parse_uri"
        page["capy_sig_lines"] = dval(["function parse_uri(uri : string) dval"])
        page["param_lines"] = dval(["uri : the URI or URL text", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">uri", "parse_query"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var parsed := parse_uri(\"https://example.test/docs?name=Ada\")\nprint(parsed[\"parts\"][\"path\"], \" \", parsed[\"query\"][\"name\"], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

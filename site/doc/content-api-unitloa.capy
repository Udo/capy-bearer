#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "unit-load" {
        var page := dval({source_page: ""})
        page["source_page"] = "unit_load"
        page["kind"] = "api"
        page["slug"] = "unit-load"
        page["route"] = "/doc/api/unit-load/"
        page["title"] = "unit_load"
        page["content"] = "## sig\n\nfunction unit_load(path : string) module\n\n`unit_load` returns a `module` value for a unit.\n"
        page["returns"] = "a `module` value"
        page["label"] = "unit_load"
        page["capy_sig_lines"] = dval(["function unit_load(path : string) module"])
        page["param_lines"] = dval(["path : unit path", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">ob", ">unit_compile", ">unit_info", ">unit_call", "component_capture", "unit_render", "component_render", "call", "print", "response_status"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var target := unit_load(\"/tests/capy-module-target.capy\")\nprint(target.default_input(), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

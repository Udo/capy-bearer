#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "unit-load" {
        var page := dval({source_page: ""})
        page["source_page"] = "unit_load"
        page["kind"] = "api"
        page["slug"] = "unit-load"
        page["route"] = "/doc/api/unit-load/"
        page["title"] = "unit_load"
        page["content"] = "`unit_load()` loads a unit and returns a handle you can call exported functions on. It is the way one unit calls another unit's code, as opposed to `component()`, which renders another unit's *output*.\n\nThe target unit must publish the names it offers with `#exports`. Anything not exported is invisible to callers.\n\n## Calling through the handle\n\nTwo spellings do the same thing. Member syntax is the readable one:\n\n    var target := unit_load(\"/tests/capy-module-target.capy\")\n    var result := target.echo({name: \"Ada\"})\n\n`call()` is the explicit form, and the one to use when the function name is itself a value:\n\n    var result := call(target, \"echo\", {name: \"Ada\"})\n\nEvery exported function takes at most one `dval` input and returns a `dval`. Calling with no argument passes an empty `dval`.\n\n## When to load a handle, and when not to\n\nLoad a handle once and reuse it when several calls hit the same unit — the handle carries the resolved, compiled unit, so repeat calls skip the lookup.\n\nFor a single call, `unit_call(path, name, input)` does the same work in one step without a handle. Prefer it for one-offs.\n\n## What a handle is\n\nA `module` value is opaque: there is nothing inside it to read, print, or compare. It is request-local — a handle is valid for the request that created it and cannot be stored and reused later. It copies across `dval` boundaries, so passing one around within a request is safe.\n\nValues crossing a call are copied, not shared. Mutating the `dval` you passed in does not affect what the callee saw, and mutating the result does not reach back into the callee.\n\n## Related entry points\n\n`unit_render()` runs a unit's `RENDER` handler and writes its output to the response. `unit_info()` reports a unit's exports and compile state; `unit_compile()` compiles a uni"
        page["content"] = string(page["content"], "") + "t without calling it.\n"
        page["returns"] = "A `module` handle for the unit."
        page["errors"] = "A path that does not resolve, a unit that fails to compile, or a name the target does not export raises a runtime error that aborts the request. Use `unit_info()` first when a unit's availability is genuinely optional."
        page["label"] = "unit_load"
        page["capy_sig_lines"] = dval(["function unit_load(path : string) module"])
        page["param_lines"] = dval(["path : the unit path to load", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["call", "unit_call", "unit_info", "unit_compile", "unit_render", "component", "1_COMPONENT"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var target := unit_load(\"/tests/capy-module-target.capy\")\nprint(target.default_input(), \"\\n\")\n"}, {entry: "render", caption: "reuse one handle for several calls", body: "var target := unit_load(\"/tests/capy-module-target.capy\")\nprint(string(target.echo({name: \"Ada\"}).name, \"\"), \"\\n\")\nprint(string(target.echo({name: \"Grace\"}).name, \"\"), \"\\n\")\n"}, {entry: "render", caption: "call by a name held in a value", body: "var target := unit_load(\"/tests/capy-module-target.capy\")\nvar wanted := \"echo\"\nprint(string(call(target, wanted, {name: \"Katherine\"}).name, \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

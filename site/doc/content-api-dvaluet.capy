#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-to-bool" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_to_bool"
        page["kind"] = "api"
        page["slug"] = "dvalue-to-bool"
        page["route"] = "/doc/api/dvalue-to-bool/"
        page["title"] = "Convert to Boolean"
        page["content"] = "## sig\n\nfunction bool(value : dval, fallback : bool = false) bool\nfunction bool(value : string, fallback : bool = false) bool\n\n`bool(value)` converts a dynamic value to `bool`. Use `bool(value, fallback)` when conversion can fail.\n"
        page["returns"] = "The Boolean value or `fallback`."
        page["label"] = "dval_to_bool"
        page["capy_sig_lines"] = dval(["function bool(value : dval, fallback : bool = false) bool", "function bool(value : string, fallback : bool = false) bool"])
        page["param_lines"] = dval(["value : value to convert", "fallback : value to return when conversion fails", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(bool(dval(\"true\")), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-to-f64" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_to_f64"
        page["kind"] = "api"
        page["slug"] = "dvalue-to-f64"
        page["route"] = "/doc/api/dvalue-to-f64/"

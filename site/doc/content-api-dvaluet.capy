        page["content"] = "## sig\n\nfunction f64(value : dval, fallback : f64 = 0.0) f64\nfunction f64(value : string, fallback : f64 = 0.0) f64\n\n`f64(value)` converts a dynamic value to `f64`. Use the optional fallback for invalid input.\n"
        page["returns"] = "The `f64` value or `fallback`."
        page["label"] = "dval_to_f64"
        page["capy_sig_lines"] = dval(["function f64(value : dval, fallback : f64 = 0.0) f64", "function f64(value : string, fallback : f64 = 0.0) f64"])
        page["param_lines"] = dval(["value : value to convert", "fallback : value to return when conversion fails", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(f64(dval(\"12.5\")), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-to-json" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_to_json"
        page["kind"] = "api"
        page["slug"] = "dvalue-to-json"

        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-to-u64" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_to_u64"
        page["kind"] = "api"
        page["slug"] = "dvalue-to-u64"
        page["route"] = "/doc/api/dvalue-to-u64/"
        page["title"] = "Convert to an unsigned integer"
        page["content"] = "## sig\n\nfunction u64(value : dval, fallback : u64 = 0) u64\nfunction u64(value : string, fallback : u64 = 0) u64\n\n`u64(value)` converts a dynamic value to `u64`. Use the optional fallback for invalid input.\n"
        page["returns"] = "The `u64` value or `fallback`."
        page["label"] = "dval_to_u64"
        page["capy_sig_lines"] = dval(["function u64(value : dval, fallback : u64 = 0) u64", "function u64(value : string, fallback : u64 = 0) u64"])
        page["param_lines"] = dval(["value : value to convert", "fallback : value to return when conversion fails", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(u64(dval(\"42\")), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

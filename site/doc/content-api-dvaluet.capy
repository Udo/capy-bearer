        page["slug"] = "dvalue-to-bool"
        page["route"] = "/doc/api/dvalue-to-bool/"
        page["title"] = "DValue::to_bool"
        page["content"] = "`bool(value)` is Capy's boolean constructor for a `dval`. `bool(value, fallback)` returns the fallback for `none` or a failed conversion.\n\nIt recognizes the string values `true`, `yes`, `on`, `1`, `false`, `no`, `off`, and `0`. It also converts booleans and finite f64 values. An empty or unrecognized string, a non-finite number, a map, and a list return the fallback.\n\nCapy boolean text is `true` or `false`. Use `bool(value)` for a typed boolean. Do not use boolean text as a data test.\n\n## C++ API\n\n`DValue::to_bool()` also converts C++ pointers, references, maps, lists, and other nonempty strings. These C++ rules do not change the Capy constructor rules.\n"
        page["returns"] = "converted value or the fallback"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "DValue::to_bool"
        page["sig_lines"] = dval(["bool DValue::to_bool(bool default_value = false) const", ""])
        page["capy_sig_lines"] = dval(["function bool(value : dval, fallback : bool = false) bool", "function bool(value : string, fallback : bool = false) bool"])
        page["param_lines"] = dval(["bool : fallback returned when conversion is not possible", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">types", "0_DValue", "2_DValue_to_string", "2_DValue_require"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }

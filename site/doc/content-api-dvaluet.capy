        page["content"] = "## sig\n\nfunction string(value : dval, fallback : string = \"\") string\n\n`string(value)` converts a dynamic value to `string`. Use the optional fallback for values that cannot convert.\n"
        page["returns"] = "The string value or `fallback`."
        page["label"] = "dval_to_string"
        page["capy_sig_lines"] = dval(["function string(value : dval, fallback : string = \"\") string"])
        page["param_lines"] = dval(["value : value to convert", "fallback : value to return when conversion fails", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(string(dval(\"Ada\")), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-to-stringmap" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_to_stringmap"
        page["kind"] = "api"
        page["slug"] = "dvalue-to-stringmap"

    }
    if slug == "dvalue-to-s64" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_to_s64"
        page["kind"] = "api"
        page["slug"] = "dvalue-to-s64"
        page["route"] = "/doc/api/dvalue-to-s64/"
        page["title"] = "Convert to a signed integer"
        page["content"] = "## sig\n\nfunction s32(value : dval, fallback : s32 = 0) s32\nfunction s32(value : string, fallback : s32 = 0) s32\nfunction s64(value : dval, fallback : s64 = 0) s64\nfunction s64(value : string, fallback : s64 = 0) s64\n\n`s32(value)` and `s64(value)` convert a dynamic value to a signed integer. Use the optional fallback for invalid input.\n"
        page["returns"] = "The integer value or `fallback`."
        page["label"] = "dval_to_s64"
        page["capy_sig_lines"] = dval(["function s32(value : dval, fallback : s32 = 0) s32", "function s32(value : string, fallback : s32 = 0) s32", "function s64(value : dval, fallback : s64 = 0) s64", "function s64(value : string, fallback : s64 = 0) s64"])
        page["param_lines"] = dval(["value : value to convert", "fallback : value to return when conversion fails", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(s64(dval(\"-42\")), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-to-string" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_to_string"
        page["kind"] = "api"
        page["slug"] = "dvalue-to-string"
        page["route"] = "/doc/api/dvalue-to-string/"

        page["content"] = "## sig\n\nNo Capy declaration.\n\nCapy does not provide `dval_to_json`.\n\nUse `json_encode(value)` to encode a dynamic value as JSON text.\n"
        page["label"] = "dval_to_json"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_DValue", "json_encode"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])

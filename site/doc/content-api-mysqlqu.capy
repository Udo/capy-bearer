#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "mysql-query" {
        var page := dval({source_page: ""})
        page["source_page"] = "mysql_query"
        page["kind"] = "api"
        page["slug"] = "mysql-query"
        page["route"] = "/doc/api/mysql-query/"
        page["title"] = "mysql_query"
        page["content"] = "`mysql_query()` runs a MySQL query and returns its rows as a `dval`.\n\nPass parameter values as a `dval` map. Use named `:name` placeholders. The API rejects positional `?` placeholders.\n\nOrdinary placeholders become quoted SQL strings. For an unquoted non-negative integer, such as `LIMIT` or `OFFSET`, add `!` to the placeholder: `:limit!`. Its value must contain one or more decimal digits. It cannot contain signs, whitespace, expressions, identifiers, or SQL fragments.\n\nAfter an insert, update, or delete, call `mysql_affected_rows()`.\n"
        page["returns"] = "the query result rows"
        page["example_error"] = "expected contiguous :example cpp cli"
        page["label"] = "mysql_query"
        page["sig_lines"] = dval(["DValue mysql_query(MySQL* m, String q, StringMap params)", ""])
        page["capy_sig_lines"] = dval(["function mysql_query(handle : u64, query : string) dval", "function mysql_query(handle : u64, query : string, params : dval) dval"])
        page["param_lines"] = dval(["m : an active MySQL connection. Capy uses a `u64` handle. C++ uses a pointer.", "q : the MySQL query text", "params : optional named parameter values", ""])
        page["notes"] = dval(["The examples are compile-only because they need a reachable MySQL server. They print a fallback when no server is available."])
        page["warnings"] = dval([])
        page["see"] = dval([">mysql", "mysql_affected_rows", "mysql_insert_id", "mysql_escape", "mysql_error", "mysql_disconnect", "mysql_connected"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

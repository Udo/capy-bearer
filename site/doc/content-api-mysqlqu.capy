#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "mysql-query" {
        var page := dval({source_page: ""})
        page["source_page"] = "mysql_query"
        page["kind"] = "api"
        page["slug"] = "mysql-query"
        page["route"] = "/doc/api/mysql-query/"
        page["title"] = "mysql_query"
        page["content"] = "`mysql_query()` runs a query and returns its rows as a `dval`.\n\nUse named `:name` placeholders with a `dval` map. The API rejects positional `?` placeholders. Add `!` to a placeholder only for an unquoted non-negative integer.\n"
        page["returns"] = "the query result rows"
        page["label"] = "mysql_query"
        page["capy_sig_lines"] = dval(["function mysql_query(handle : u64, query : string) dval", "function mysql_query(handle : u64, query : string, params : dval) dval"])
        page["param_lines"] = dval(["handle : the MySQL connection handle", "query : the SQL query text", "params : the named parameter values", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">mysql", "mysql_connect", "mysql_error", "mysql_affected_rows"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var database := mysql_connect(\"localhost\", \"root\", \"\", \"\")\nif mysql_connected(database) { var rows := mysql_query(database, \"select :name as name\", dval({\"name\": \"Ada\"})); print(rows[0][\"name\"], \"\\n\") }\nif database != u64(0) { mysql_disconnect(database) }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-fsync" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_fsync"
        page["kind"] = "api"
        page["slug"] = "file-fsync"
        page["route"] = "/doc/api/file-fsync/"
        page["title"] = "file_fsync"
        page["content"] = "`file_fsync` flushes writes for a handle. Use it before `file_close()` when durable storage matters. It returns false when the flush fails. Capy uses the same handle and Boolean result.\n"
        page["returns"] = "true when Capy flushes the handle, otherwise false"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "file_fsync"
        page["sig_lines"] = dval(["bool file_fsync(u64 h)", ""])
        page["capy_sig_lines"] = dval(["function file_fsync(handle : u64) bool"])
        page["param_lines"] = dval(["h : writable handle from `file_open()`", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "file_write", "file_close", "file_symlink", "path_is_within", "file_chmod", "path_real"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-fsync" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_fsync"
        page["kind"] = "api"
        page["slug"] = "file-fsync"
        page["route"] = "/doc/api/file-fsync/"
        page["title"] = "file_fsync"
        page["content"] = "`file_fsync` flushes pending writes for a handle. Call it before `file_close` when the file system must receive the writes first.\n"
        page["returns"] = "`true` when Capy flushes the handle. Otherwise, it returns `false`."
        page["label"] = "file_fsync"
        page["capy_sig_lines"] = dval(["function file_fsync(handle : u64) bool"])
        page["param_lines"] = dval(["handle : writable handle returned by `file_open`", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "file_write", "file_close", "file_open"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var handle := file_open(\"/tmp/doc-fsync.txt\", \"w\")\nfile_write(handle, \"durable\")\nprint(file_fsync(handle), \"\\n\")\nfile_close(handle)\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

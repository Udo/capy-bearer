#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "get" {
        var page := dval({source_page: ""})
        page["source_page"] = "get"
        page["kind"] = "api"
        page["slug"] = "get"
        page["route"] = "/doc/api/get/"
        page["title"] = "Get a named child"
        page["content"] = "`get(value, key)` reads a named child without creating it. It returns `none` for a missing key or a scalar.\n"
        page["returns"] = "The copied child, or `none`."
        page["label"] = "get"
        page["capy_sig_lines"] = dval(["function get(value : dval, key : string) dval"])
        page["param_lines"] = dval(["value : source value", "key : child key", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_DValue", "has"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var user := dval({\"email\": \"ada@example.test\"})\nprint(get(user, \"email\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

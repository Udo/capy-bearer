#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "every" {
        var page := dval({source_page: ""})
        page["source_page"] = "every"
        page["kind"] = "api"
        page["slug"] = "every"
        page["route"] = "/doc/api/every/"
        page["title"] = "Test every string"
        page["content"] = "`every` tests each string in a list-shaped `dval` with `predicate`.\n\nThis function does not change `items`.\n"
        page["returns"] = "This function returns `true` when every item matches. It returns `true` for an empty list."
        page["label"] = "every"
        page["capy_sig_lines"] = dval(["function every(items : dval, predicate : function(value : string) bool) bool"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var items := split(\"one,two\", \",\")\nprint(every(items, function(value : string) bool { return value != \"\" }), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

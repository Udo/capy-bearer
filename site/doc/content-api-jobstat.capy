#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "job-status" {
        var page := dval({source_page: ""})
        page["source_page"] = "job_status"
        page["kind"] = "api"
        page["slug"] = "job-status"
        page["route"] = "/doc/api/job-status/"
        page["title"] = "job_status"
        page["content"] = "`job_status()` checks a job without waiting. The status map can include `state`, `done`, `kind`, `pid`, and `job_id`.\n\n`state` can be `pending`, `running`, `done`, `failed`, `cancelled`, or `missing`. Use it to poll without waiting for a result.\n\nIn Capy, pass the job ID as `dval`. In Capy, pass the `u64` job ID shown above.\n"
        page["returns"] = "a `dval` status map"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "job_status"
        page["sig_lines"] = dval(["DValue job_status(u64 job_id)", ""])
        page["capy_sig_lines"] = dval(["function job_status(job : dval) dval"])
        page["param_lines"] = dval(["job : the Capy `dval` job ID. Capy uses a `u64` ID.", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "shell_spawn", "job_result", "shell_exec", "job_await", "shell_escape", "job_cancel"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

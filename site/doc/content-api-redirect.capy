#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "redirect" {
        var page := dval({source_page: ""})
        page["source_page"] = "redirect"
        page["kind"] = "api"
        page["slug"] = "redirect"
        page["route"] = "/doc/api/redirect/"
        page["title"] = "redirect"
        page["content"] = "## sig\n\nfunction redirect(url : string, code : s32 = 302)\n\n`redirect()` sets the response location and status. The default status is `302`.\n"
        page["label"] = "redirect"
        page["capy_sig_lines"] = dval(["function redirect(url : string, code : s32 = 302)"])
        page["param_lines"] = dval(["url : redirect target URL", "code : HTTP status code", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "redirect(\"/next\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#include "lib/capy_signatures.generated.h"
#include "lib/doc_page.h"

// Render generated signatures and inline guide examples in one document.
StringMap* already_shown_items;

void render_doc_params(DValue param_lines)
{
	if(param_lines.size() == 0)
		return;

	<><div class="params"><h3>Parameters</h3></>
	for(auto line : param_lines)
	{
		if(trim(line) == "")
			continue;
		String name = trim(nibble(line, ":"));
		String value = trim(line);
		<><div><b><?= name ?></b><?
		if(value != "")
		{
			?> : <?: doc_markdown_inline(value) ?><?
		}
		?></div></>
	}
	<></div></>
}

void render_doc_text_section(String class_name, String title, String content)
{
	if(trim(content) == "")
		return;
	?><div class="<?= class_name ?>"><h3><?= title ?></h3><?: markdown_to_html(content) ?></div><?
}

void render_doc_example_sources(DocPage doc_page)
{
	if(doc_page.example_parse_error != "")
	{
		?><div class="example error"><h3>Example format error</h3><pre><?= doc_page.example_parse_error ?></pre></div><?
		return;
	}
	for(u64 idx = 0; idx < doc_page.example_pairs.size(); idx++)
	{
		DValue pair = doc_page.example_pairs[idx];
		String entry = pair["entry"].to_string();
		?><div class="example paired-example"><h3>Example: <?= doc_example_handler_name(entry) ?></h3>
		<div class="example-language capy"><h4><?= doc_example_language_label("capy") ?></h4><pre class="example-source"><?= pair["capy_body"].to_string() ?></pre></div>
		<div class="example-language cpp"><h4><?= doc_example_language_label("cpp") ?></h4><pre class="example-source"><?= pair["cpp_body"].to_string() ?></pre></div>
		</div><?
	}
	for(u64 idx = 0; idx < doc_page.cpp_only_examples.size(); idx++)
	{
		DValue example = doc_page.cpp_only_examples[idx];
		?><div class="example cpp-only-example"><h3>C++ example: <?= doc_example_handler_name(example["entry"].to_string()) ?></h3><pre class="example-source"><?= example["body"].to_string() ?></pre></div><?
	}
	for(String body : doc_page.example_blocks)
	{
		?><div class="example legacy-example"><h3>Legacy C++ example</h3><pre class="example-source"><?= body ?></pre></div><?
	}
}

void render_doc_page(String page)
{
	page = doc_canonical_page(page);
	(*already_shown_items)[page] = "Y";
	DocPage doc_page = load_doc_page(page);
	String title = doc_default_title(page);
	if(doc_page.title != "")
		title = doc_page.title;

	<><section class="doc-page"><div class="sig"><h2><?= title ?></h2></>
	if(doc_page.capy_sig_lines.size() > 0 || doc_page.sig_lines.size() > 0 || doc_page.capy_status != "")
	{
		?><h3>Capy</h3><?
		if(doc_page.capy_sig_lines.size() > 0)
		{
			?><pre><? print(join(doc_page.capy_sig_lines, "\n")); ?></pre><?
		}
		else
		{
			?><p class="signature-status"><?= doc_page.capy_status == "unsupported" ? "Unsupported by design for Capy." : doc_page.capy_status == "cpp-specific" ? "This page applies only to C++ (.uce)." : "No callable Capy declaration applies to this page." ?></p><?
		}
		?><h3>C++ (.uce)</h3><?
		if(doc_page.sig_lines.size() > 0)
		{
			?><pre><? print(join(doc_page.sig_lines, "\n")); ?></pre><?
		}
		else
		{
			?><p class="signature-status">No callable C++ declaration applies to this page.</p><?
		}
	}
	<></div></>

	if(trim(doc_page.content) != "")
	{
		<><div class="content"><?
		if(page.rfind("capy-", 0) != 0) { ?><h3>Description</h3><? }
		?><?: markdown_to_html(doc_page.content) ?></div></>
	}

	render_doc_params(doc_page.param_lines);
	render_doc_text_section("returns", "Return Values", doc_page.returns);
	render_doc_text_section("errors", "Errors", doc_page.errors);
	render_doc_example_sources(doc_page);
	<></section></>
}

void render_see_section(String name)
{
	DValue lines = split(file_get_contents("areas/" + name + ".txt"), "\n");
	s32 idx = 0;
	for(auto line : lines)
	{
		if(idx == 0)
		{
			<><h1><?= line ?></h1></>
		}
		else if(line != "")
		{
			render_doc_page(line);
		}
		idx += 1;
	}
}


RENDER(Request& context)
{
	StringMap shown_items;
	already_shown_items = &shown_items;

	<><html>
	<head>
		<meta name="viewport" content="width=device-width, initial-scale=1"></meta>
		<title>Bearer Documentation</title>
		<link rel="stylesheet" href='style.css?v=<?= time() ?>'></link>
	</head>
	<body>
		<h1>BEARER Documentation</h1>
		<h1>Capy Language Guide</h1>
		<?
		for(String ft : doc_page_names())
			if(ft.rfind("capy-", 0) == 0)
				render_doc_page(ft);
		?><h1>API Reference</h1><?

		for(auto file_name : ls("areas/"))
		{
			String ft = nibble(file_name, ".");
			render_see_section(ft);
		}

		?><h1>Other Functions and Data Structures</h1><?
		for(auto file_name : ls("pages/"))
		{
			String ft = nibble(file_name, ".");
			if((*already_shown_items)[ft] == "")
				render_doc_page(ft);
		}

		?>
	</body>
	</html></>
}

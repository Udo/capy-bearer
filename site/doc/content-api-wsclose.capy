#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "ws-close" {
        var page := dval({source_page: ""})
        page["source_page"] = "ws_close"
        page["kind"] = "api"
        page["slug"] = "ws-close"
        page["route"] = "/doc/api/ws-close/"
        page["title"] = "ws_close"
        page["content"] = "`ws_close()` closes the current WebSocket client. Pass a client ID to close that client.\n"
        page["returns"] = "`true` when the server queues the close."
        page["label"] = "ws_close"
        page["capy_sig_lines"] = dval(["function ws_close(connection_id : string = \"\") bool"])
        page["param_lines"] = dval(["connection_id : client ID. The default is the current client.", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "ws", caption: "", body: "ws_close()\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-tell" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_tell"
        page["kind"] = "api"
        page["slug"] = "file-tell"
        page["route"] = "/doc/api/file-tell/"
        page["title"] = "file_tell"
        page["content"] = "## sig\n\nfunction file_tell(handle : u64) s64\n\n`file_tell` returns the current position for a file handle.\n"
        page["returns"] = "The current byte offset."
        page["label"] = "file_tell"
        page["capy_sig_lines"] = dval(["function file_tell(handle : u64) s64"])
        page["param_lines"] = dval(["handle : handle from `file_open`", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var handle := file_open(\"/tmp/doc-tell.txt\", \"w\")\nfile_write(handle, \"hello\")\nprint(file_tell(handle), \"\\n\")\nfile_close(handle)\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

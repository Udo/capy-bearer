#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "usleep" {
        var page := dval({source_page: ""})
        page["source_page"] = "usleep"
        page["kind"] = "api"
        page["slug"] = "usleep"
        page["route"] = "/doc/api/usleep/"
        page["title"] = "usleep"
        page["content"] = "## sig\n\nfunction usleep(usec : s32) s32\n\n`usleep` pauses the current handler for `usec` microseconds.\n"
        page["returns"] = "`0` after the sleep"
        page["label"] = "usleep"
        page["capy_sig_lines"] = dval(["function usleep(usec : s32) s32"])
        page["param_lines"] = dval(["usec : microseconds to sleep", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">time", "time_precise", "time", "time_format_local", "time_format_relative", "time_format_utc", "time_parse"])
        page["examples"] = dval([{entry: "render", caption: "", body: "usleep(1000)\nprint(\"slept\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

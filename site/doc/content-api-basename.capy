#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "basename" {
        var page := dval({source_page: ""})
        page["source_page"] = "basename"
        page["kind"] = "api"
        page["slug"] = "basename"
        page["route"] = "/doc/api/basename/"
        page["title"] = "basename"
        page["content"] = "## sig\n\nfunction basename(path : string) string\n\n`basename` returns the final component of a path.\n\nIt does not access the file system.\n"
        page["returns"] = "the final path component"
        page["label"] = "basename"
        page["capy_sig_lines"] = dval(["function basename(path : string) string"])
        page["param_lines"] = dval(["path : a path string", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["dirname", "path_join"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(basename(\"/var/www/site/index.capy\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

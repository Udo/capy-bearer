#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "parse-query" {
        var page := dval({source_page: ""})
        page["source_page"] = "parse_query"
        page["kind"] = "api"
        page["slug"] = "parse-query"
        page["route"] = "/doc/api/parse-query/"
        page["title"] = "parse_query"
        page["content"] = "## sig\n\nfunction parse_query(query : string) dval\n\n`parse_query()` decodes URL query text into a map-shaped `dval`.\n\nAn ampersand separates pairs. The first equals sign separates a key and value. A key without an equals sign has an empty value. The last repeated key wins.\n"
        page["returns"] = "the decoded parameters"
        page["label"] = "parse_query"
        page["capy_sig_lines"] = dval(["function parse_query(query : string) dval"])
        page["param_lines"] = dval(["query : the URL query text", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">uri", "parse_uri"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var values := parse_query(\"name=Ada&role=admin\")\nprint(values[\"name\"], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "values" {
        var page := dval({source_page: ""})
        page["source_page"] = "values"
        page["kind"] = "api"
        page["slug"] = "values"
        page["route"] = "/doc/api/values/"
        page["title"] = "Get child values"
        page["content"] = "`values(value)` returns a new list of child values. A scalar returns a one-item list.\n"
        page["returns"] = "A list of copied child values."
        page["label"] = "values"
        page["capy_sig_lines"] = dval(["function values(value : dval) dval"])
        page["param_lines"] = dval(["value : source value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "dvalue", href: "/doc/type/dvalue/"}, {label: "keys", href: "/doc/api/keys/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "var user := dval({\"name\": \"Ada\", \"role\": \"admin\"})\nvar result := values(user)\nprint(is_list(result), \" \", length(result), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "gz-compress" {
        var page := dval({source_page: ""})
        page["source_page"] = "gz_compress"
        page["kind"] = "api"
        page["slug"] = "gz-compress"
        page["route"] = "/doc/api/gz-compress/"
        page["title"] = "gz_compress"
        page["content"] = "`gz_compress()` compresses a string with gzip.\n\nThe result contains binary data. Pass it to `gz_uncompress()` to restore the source.\n"
        page["returns"] = "Gzip-compressed bytes as a string."
        page["label"] = "gz_compress"
        page["capy_sig_lines"] = dval(["function gz_compress(source : string) string"])
        page["param_lines"] = dval(["source : uncompressed bytes", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["gz_uncompress", "zip_create", "zip_read"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var source := \"archive data\"\nvar packed := gz_compress(source)\nprint(gz_uncompress(packed), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

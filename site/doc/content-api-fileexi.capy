#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-exists" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_exists"
        page["kind"] = "api"
        page["slug"] = "file-exists"
        page["route"] = "/doc/api/file-exists/"
        page["title"] = "file_exists"
        page["content"] = "## sig\n\nfunction file_exists(path : string) bool\n\n`file_exists` tests for a regular file. It returns `false` for a directory. Use `file_stat` to inspect another path type.\n"
        page["returns"] = "`true` when a regular file exists. Otherwise, it returns `false`."
        page["label"] = "file_exists"
        page["capy_sig_lines"] = dval(["function file_exists(path : string) bool"])
        page["param_lines"] = dval(["path : path to test", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "file_stat", "file_unlink", "file_get_contents"])
        page["examples"] = dval([{entry: "render", caption: "", body: "file_put_contents(\"/tmp/doc-exists.txt\", \"x\")\nprint(file_exists(\"/tmp/doc-exists.txt\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "gen-int" {
        var page := dval({source_page: ""})
        page["source_page"] = "gen_int"
        page["kind"] = "api"
        page["slug"] = "gen-int"
        page["route"] = "/doc/api/gen-int/"
        page["title"] = "gen_int"
        page["content"] = "`gen_int()` returns a deterministic `u64` noise value for `index` and `seed`. `from` and `to` set the output range.\n\nUse the same inputs to reproduce procedural integer values. The Capy call uses the declaration above.\n\n"
        page["returns"] = "deterministic `u64` noise value"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "gen_int"
        page["sig_lines"] = dval(["u64 gen_int(u64 from, u64 to, u64 index, u64 seed = 0)", ""])
        page["capy_sig_lines"] = dval(["function gen_int(from : u64, to : u64, index : u64, seed : u64 = 0) u64"])
        page["param_lines"] = dval(["from : first range endpoint", "to : second range endpoint", "index : deterministic input position", "seed : deterministic input seed, default `0`", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">noise", "gen_float", "gen_sha1", "gen_noise64", "sha256", "gen_noise32", "sha256_hex"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

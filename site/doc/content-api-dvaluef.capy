#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-filter" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_filter"
        page["kind"] = "api"
        page["slug"] = "dvalue-filter"
        page["route"] = "/doc/api/dvalue-filter/"
        page["title"] = "Filter a dynamic value"
        page["content"] = "## sig\n\nfunction dval_filter(value : dval, predicate : function(value : dval, key : string) bool) dval\n\n`dval_filter` returns children for which `predicate` returns `true`. It keeps map keys and keeps list shape.\n"
        page["returns"] = "A new filtered value."
        page["label"] = "dval_filter"
        page["capy_sig_lines"] = dval(["function dval_filter(value : dval, predicate : function(value : dval, key : string) bool) dval"])
        page["param_lines"] = dval(["value : source value", "predicate : function that selects children", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var value := dval({\"name\": \"Ada\", \"role\": \"admin\"})\nvar result := dval_filter(value, function(item : dval, key : string) bool { return key == \"name\" })\nprint(result.name, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

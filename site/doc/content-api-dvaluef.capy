#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-filter" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_filter"
        page["kind"] = "api"
        page["slug"] = "dvalue-filter"
        page["route"] = "/doc/api/dvalue-filter/"
        page["title"] = "DValue::filter"
        page["content"] = "Use `dval_filter(value, predicate)` in Capy to make a copied `dval` that contains matching values. The predicate receives an item and key. The function returns a new value. A list result keeps list shape and reindexes kept items. A map result keeps its keys. A scalar result is a one-item list when the predicate accepts it.\n\nC++ also provides `filter(keys)`, which copies named children into a map. Its callback overload follows the same list, map, and scalar rules.\n"
        page["returns"] = "filtered copy"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "DValue::filter"
        page["sig_lines"] = dval(["DValue DValue::filter(DValue keys) const", "DValue DValue::filter(std::function<bool (const DValue& item, String key)> f) const", ""])
        page["capy_sig_lines"] = dval(["function dval_filter(value : dval, predicate : function(value : dval, key : string) bool) dval"])
        page["param_lines"] = dval(["keys : child keys to copy when using the key-list overload", "f : predicate returning true for children to keep", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">types", "0_DValue", "2_DValue_map", "2_DValue_keys"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

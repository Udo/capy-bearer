#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "mysql-disconnect" {
        var page := dval({source_page: ""})
        page["source_page"] = "mysql_disconnect"
        page["kind"] = "api"
        page["slug"] = "mysql-disconnect"
        page["route"] = "/doc/api/mysql-disconnect/"
        page["title"] = "mysql_disconnect"
        page["content"] = "## sig\n\nfunction mysql_disconnect(handle : u64)\n\n`mysql_disconnect()` releases the MySQL connection lease.\n\nDo not use the handle after this call.\n"
        page["label"] = "mysql_disconnect"
        page["capy_sig_lines"] = dval(["function mysql_disconnect(handle : u64)"])
        page["param_lines"] = dval(["handle : the MySQL connection handle", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">mysql", "mysql_connect", "mysql_connected"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var database := mysql_connect(\"localhost\", \"root\", \"\", \"\")\nif database != u64(0) { mysql_disconnect(database) }\nprint(\"connection released\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

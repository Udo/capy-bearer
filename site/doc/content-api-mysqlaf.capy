#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "mysql-affected-rows" {
        var page := dval({source_page: ""})
        page["source_page"] = "mysql_affected_rows"
        page["kind"] = "api"
        page["slug"] = "mysql-affected-rows"
        page["route"] = "/doc/api/mysql-affected-rows/"
        page["title"] = "mysql_affected_rows"
        page["content"] = "## sig\n\nfunction mysql_affected_rows(handle : u64) u64\n\n`mysql_affected_rows()` returns the changed-row count for the latest applicable successful statement.\n\nIt returns zero when no applicable statement has run or a query fails.\n"
        page["returns"] = "the number of changed rows"
        page["label"] = "mysql_affected_rows"
        page["capy_sig_lines"] = dval(["function mysql_affected_rows(handle : u64) u64"])
        page["param_lines"] = dval(["handle : the MySQL connection handle", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">mysql", "mysql_query", "mysql_connect"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var database := mysql_connect(\"localhost\", \"root\", \"\", \"\")\nif mysql_connected(database) { print(mysql_affected_rows(database), \"\\n\") }\nif database != u64(0) { mysql_disconnect(database) }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

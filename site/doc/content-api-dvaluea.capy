#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-assign" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_assign"
        page["kind"] = "api"
        page["slug"] = "dvalue-assign"
        page["route"] = "/doc/api/dvalue-assign/"
        page["title"] = "Assign a dynamic value"
        page["content"] = "## sig\n\nfunction dval_assign(value : dval, source : as dval) dval\n\n`dval_assign(value, source)` replaces the content of `value`. It changes `value` and returns the same value.\n"
        page["returns"] = "The target value."
        page["label"] = "dval_assign"
        page["capy_sig_lines"] = dval(["function dval_assign(value : dval, source : as dval) dval"])
        page["param_lines"] = dval(["value : target value", "source : replacement value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var value := dval(\"old\")\nvalue = dval_assign(value, \"new\")\nprint(value, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "to-f64" {
        var page := dval({source_page: ""})
        page["source_page"] = "to_f64"
        page["kind"] = "api"
        page["slug"] = "to-f64"
        page["route"] = "/doc/api/to-f64/"
        page["title"] = "to_f64"
        page["content"] = "Capy has no native `to_f64` signature. Use `f64(value, fallback)`.\n"
        page["label"] = "to_f64"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">types", "2_DValue_to_f64", "to_bool", "to_s64", "2_DValue_to_u64", "to_u64", "2_DValue_to_stringmap"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "task-status" {
        var page := dval({source_page: ""})
        page["source_page"] = "task_status"
        page["kind"] = "api"
        page["slug"] = "task-status"
        page["route"] = "/doc/api/task-status/"
        page["title"] = "task_status"
        page["content"] = "## sig\n\nfunction task_status(id : string) dval\n\nUse `task_status` to read a task status.\n"
        page["returns"] = "Task status map."
        page["label"] = "task_status"
        page["capy_sig_lines"] = dval(["function task_status(id : string) dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var status := task_status(\"\")\nprint(string(status[\"state\"]), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

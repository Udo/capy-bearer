#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "mysql-connect" {
        var page := dval({source_page: ""})
        page["source_page"] = "mysql_connect"
        page["kind"] = "api"
        page["slug"] = "mysql-connect"
        page["route"] = "/doc/api/mysql-connect/"
        page["title"] = "mysql_connect"
        page["content"] = "## sig\n\nfunction mysql_connect(host : string, username : string, password : string, database : string) u64\n\n`mysql_connect()` creates a MySQL connection lease and returns its handle.\n\nCall `mysql_connected()` before database work. Call `mysql_disconnect()` after use. A failed connection can return a nonzero handle.\n"
        page["returns"] = "a request-local MySQL connection handle"
        page["label"] = "mysql_connect"
        page["capy_sig_lines"] = dval(["function mysql_connect(host : string, username : string, password : string, database : string) u64"])
        page["param_lines"] = dval(["host : the MySQL server host", "username : the MySQL user name", "password : the MySQL password", "database : the initial database name", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">mysql", "mysql_connected", "mysql_disconnect", "mysql_error"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var database := mysql_connect(\"localhost\", \"root\", \"\", \"\")\nif mysql_connected(database) { print(\"connected\\n\") } else { print(mysql_error(database), \"\\n\") }\nif database != u64(0) { mysql_disconnect(database) }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "mysql-connected" {
        var page := dval({source_page: ""})
        page["source_page"] = "mysql_connected"
        page["kind"] = "api"
        page["slug"] = "mysql-connected"
        page["route"] = "/doc/api/mysql-connected/"
        page["title"] = "mysql_connected"
        page["content"] = "## sig\n\nfunction mysql_connected(handle : u64) bool\n\n`mysql_connected()` tests whether a MySQL handle has a live server connection.\n\nUse `mysql_error()` to get the diagnostic when it returns `false`.\n"
        page["returns"] = "`true` when the handle has a live server connection"
        page["label"] = "mysql_connected"
        page["capy_sig_lines"] = dval(["function mysql_connected(handle : u64) bool"])
        page["param_lines"] = dval(["handle : the MySQL connection handle", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">mysql", "mysql_connect", "mysql_error"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var database := mysql_connect(\"localhost\", \"root\", \"\", \"\")\nprint(mysql_connected(database), \"\\n\")\nif database != u64(0) { mysql_disconnect(database) }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

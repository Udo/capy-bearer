#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "mysql-connect" {
        var page := dval({source_page: ""})
        page["source_page"] = "mysql_connect"
        page["kind"] = "api"
        page["slug"] = "mysql-connect"
        page["route"] = "/doc/api/mysql-connect/"
        page["title"] = "mysql_connect"
        page["content"] = "This function returns an opaque request-local `u64` handle. Pass all four arguments.\n\nUse `mysql_connected()` before work that needs a live server connection.\n\nEach call creates a lease. `mysql_disconnect()` releases that lease. Bearer can retain the server connection in its worker pool instead of closing it immediately.\n\nThe C++ API returns `MySQL*` instead.\n"
        page["returns"] = "an opaque request-local MySQL handle. A failed connection can still return a nonzero handle."
        page["errors"] = "A connection failure does not necessarily return zero. Use `mysql_connected()` to test the handle. Use `mysql_error()` to read its diagnostic."
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "mysql_connect"
        page["sig_lines"] = dval(["MySQL* mysql_connect(String host = \"localhost\", String username = \"root\", String password = \"\", String database = \"\")", ""])
        page["capy_sig_lines"] = dval(["function mysql_connect(host : string, username : string, password : string, database : string) u64"])
        page["param_lines"] = dval(["host : MySQL server host", "username : MySQL user name", "password : MySQL password", "database : initial database name", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">mysql", "mysql_connected", "mysql_disconnect", "mysql_error", "mysql_escape", "mysql_insert_id", "mysql_affected_rows"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "mysql-connected" {
        var page := dval({source_page: ""})
        page["source_page"] = "mysql_connected"
        page["kind"] = "api"
        page["slug"] = "mysql-connected"
        page["route"] = "/doc/api/mysql-connected/"
        page["title"] = "mysql_connected"
        page["content"] = "Pass the opaque `u64` handle from `mysql_connect()`.\n\nThis function distinguishes a failed connection wrapper from a live server connection. It returns `false` for a failed wrapper in both Capy and C++.\n"
        page["returns"] = "`true` when the handle has a live server connection"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "mysql_connected"
        page["sig_lines"] = dval(["bool mysql_connected(MySQL* m)", ""])
        page["capy_sig_lines"] = dval(["function mysql_connected(handle : u64) bool"])
        page["param_lines"] = dval(["m : Capy MySQL handle", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">mysql", "mysql_connect", "mysql_disconnect", "mysql_error", "mysql_escape", "mysql_insert_id", "mysql_affected_rows"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

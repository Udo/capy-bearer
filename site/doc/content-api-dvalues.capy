#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-set-array" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_set_array"
        page["kind"] = "api"
        page["slug"] = "dvalue-set-array"
        page["route"] = "/doc/api/dvalue-set-array/"
        page["title"] = "Make an empty list"
        page["content"] = "## sig\n\nfunction dval_set_array(value : dval) dval\n\n`dval_set_array` makes `value` an empty list. Later `dval_push` calls start at index `0`.\n"
        page["returns"] = "The changed target value."
        page["label"] = "dval_set_array"
        page["capy_sig_lines"] = dval(["function dval_set_array(value : dval) dval"])
        page["param_lines"] = dval(["value : target value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var list := dval_set_array(dval(\"\"))\nlist = dval_push(list, \"first\")\nprint(dval_is_list(list), \" \", list[0], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-set-bool" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_set_bool"
        page["kind"] = "api"
        page["slug"] = "dvalue-set-bool"
        page["route"] = "/doc/api/dvalue-set-bool/"
        page["title"] = "Store a Boolean value"
        page["content"] = "## sig\n\nfunction dval_set_bool(value : dval, flag : bool) dval\n\n`dval_set_bool` stores `flag` in `value`. It changes and returns the target value.\n"
        page["returns"] = "The changed target value."
        page["label"] = "dval_set_bool"
        page["capy_sig_lines"] = dval(["function dval_set_bool(value : dval, flag : bool) dval"])
        page["param_lines"] = dval(["value : target value", "flag : Boolean value to store", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var flag := dval_set_bool(dval(\"\"), true)\nprint(bool(flag), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-set-reference" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_set_reference"
        page["kind"] = "api"
        page["slug"] = "dvalue-set-reference"
        page["route"] = "/doc/api/dvalue-set-reference/"
        page["title"] = "Set a reference"
        page["content"] = "## sig\n\nNo Capy declaration.\n\nCapy cannot create host reference nodes in a dynamic value.\n\nNo Capy alternative exists.\n"
        page["capy_status"] = "unsupported"
        page["label"] = "dval_set_reference"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_DValue"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-set-type" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_set_type"
        page["kind"] = "api"
        page["slug"] = "dvalue-set-type"
        page["route"] = "/doc/api/dvalue-set-type/"
        page["title"] = "Set a dynamic value type"
        page["content"] = "## sig\n\nfunction dval_set_type(value : dval, type : string) dval\n\n`dval_set_type` changes the internal type of `value`. Use `dval_set`, `dval_set_bool`, or `dval_set_array` for normal code.\n"
        page["returns"] = "The changed target value."
        page["label"] = "dval_set_type"
        page["capy_sig_lines"] = dval(["function dval_set_type(value : dval, type : string) dval"])
        page["param_lines"] = dval(["value : target value", "type : type code", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var value := dval_set_type(dval(\"\"), \"M\")\nprint(dval_get_type_name(value), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-set" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_set"
        page["kind"] = "api"
        page["slug"] = "dvalue-set"
        page["route"] = "/doc/api/dvalue-set/"
        page["title"] = "Replace a dynamic value"
        page["content"] = "## sig\n\nfunction dval_set(value : dval, source : as dval) dval\n\n`dval_set` replaces the content of `value`. It changes and returns the target value.\n"
        page["returns"] = "The changed target value."
        page["label"] = "dval_set"
        page["capy_sig_lines"] = dval(["function dval_set(value : dval, source : as dval) dval"])
        page["param_lines"] = dval(["value : target value", "source : replacement value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var value := dval(\"\")\nvalue = dval_set(value, \"hello\")\nprint(value, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

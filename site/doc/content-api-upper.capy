#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "upper" {
        var page := dval({source_page: ""})
        page["source_page"] = "upper"
        page["kind"] = "api"
        page["slug"] = "upper"
        page["route"] = "/doc/api/upper/"
        page["title"] = "upper"
        page["content"] = "`upper` changes lowercase ASCII characters to uppercase.\n"
        page["returns"] = "string with lowercase ASCII characters changed to uppercase"
        page["label"] = "upper"
        page["capy_sig_lines"] = dval(["function upper(value : string) string"])
        page["param_lines"] = dval(["value : string to convert", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">string", "string", "length", "clone", "ascii_safe_name", "base64_decode"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(upper(\"bearer\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "upper" {
        var page := dval({source_page: ""})
        page["source_page"] = "upper"
        page["kind"] = "api"
        page["slug"] = "upper"
        page["route"] = "/doc/api/upper/"
        page["title"] = "upper"
        page["content"] = "`upper(value)` converts lowercase ASCII characters to uppercase. It does not convert Unicode case.\n\nC++ uses `to_upper()` with the signature above.\n"
        page["returns"] = "string with lowercase ASCII characters changed to uppercase"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "upper"
        page["sig_lines"] = dval(["String to_upper(String s)", ""])
        page["capy_sig_lines"] = dval(["function upper(value : string) string"])
        page["param_lines"] = dval(["value : Capy string to convert", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">string", "to_upper", "string", "length", "clone", "ascii_safe_name", "base64_decode"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

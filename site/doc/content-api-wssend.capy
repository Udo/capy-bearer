#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "ws-send-to" {
        var page := dval({source_page: ""})
        page["source_page"] = "ws_send_to"
        page["kind"] = "api"
        page["slug"] = "ws-send-to"
        page["route"] = "/doc/api/ws-send-to/"
        page["title"] = "ws_send_to"
        page["content"] = "## sig\n\nfunction ws_send_to(connection_id : string, message : string, binary : bool) bool\n\n`ws_send_to()` sends a message to one client.\n"
        page["returns"] = "`true` when the server queues the message."
        page["label"] = "ws_send_to"
        page["capy_sig_lines"] = dval(["function ws_send_to(connection_id : string, message : string, binary : bool) bool"])
        page["param_lines"] = dval(["connection_id : client ID", "message : message bytes to send", "binary : `true` for a binary frame", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">websocket", "ws_send", "ws_scope", "ws_opcode", "ws_message", "ws_is_binary", "ws_connections"])
        page["examples"] = dval([{entry: "ws", caption: "", body: "ws_send_to(string(request.websocket.connection_id, \"\"), \"hello\", false)\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "ws-send" {
        var page := dval({source_page: ""})
        page["source_page"] = "ws_send"
        page["kind"] = "api"
        page["slug"] = "ws-send"
        page["route"] = "/doc/api/ws-send/"
        page["title"] = "ws_send"
        page["content"] = "## sig\n\nfunction ws_send(message : string, binary : bool) bool\nfunction ws_send(message : string, binary : bool, scope : string) bool\n\n`ws_send()` sends a message to every client in the current scope. Pass `scope` to select a scope.\n"
        page["returns"] = "`true` when the server queues the message for a client."
        page["label"] = "ws_send"
        page["capy_sig_lines"] = dval(["function ws_send(message : string, binary : bool) bool", "function ws_send(message : string, binary : bool, scope : string) bool"])
        page["param_lines"] = dval(["message : message bytes to send", "binary : `true` for a binary frame", "scope : scope identifier", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">websocket", "ws_scope", "ws_send_to", "ws_opcode", "ws_message", "ws_is_binary", "ws_connections"])
        page["examples"] = dval([{entry: "ws", caption: "", body: "ws_send(\"hello\", false)\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

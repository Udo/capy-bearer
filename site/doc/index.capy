function render_shell(title : string, component_path : string) void {
    print("<html><head><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"></meta><title>", html_escape(title), "</title><link rel=\"stylesheet\" href=\"/doc/style.css\"></link></head><body><h1><a href=\"/doc/\">Capy-Bearer Documentation</a></h1>")
    component_render(component_path)
    print("</body></html>")
}

function render_page_shell(kind : string, slug : string) void {
    print("<html><head><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"></meta><title>Capy-Bearer Documentation</title><link rel=\"stylesheet\" href=\"/doc/style.css\"></link></head><body><h1><a href=\"/doc/\">Capy-Bearer Documentation</a></h1>")
    component_render("/doc/components/page.capy", {kind: kind, slug: slug})
    print("</body></html>")
}


function RENDER(request : dval) {
    var pretty := string(request.query.pretty, "")
    if pretty != "" {
        var slash := strpos(pretty, "/")
        var kind := ""
        var slug := ""
        if slash >= 0 {
            kind = substr(pretty, 0, slash)
            slug = substr(pretty, slash + 1)
        }
        if (kind == "api" || kind == "type" || kind == "handler" || kind == "guide") && slug != "" {
            render_page_shell(kind, slug)
            return
        }
        request.out.status = 404
        print("<html><body><h1>Page not found</h1></body></html>")
        return
    }
    if string(request.query.p, "") != "" {
        request.out.status = 404
        print("<html><body><h1>Page not found</h1></body></html>")
        return
    }
    render_shell("Capy-Bearer Documentation", "/doc/components/index.capy")
}

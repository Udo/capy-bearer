#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "render" {
        var page := dval({source_page: ""})
        page["source_page"] = "1_RENDER"
        page["kind"] = "api"
        page["slug"] = "render"
        page["route"] = "/doc/api/render/"
        page["title"] = "RENDER"
        page["content"] = "## sig\n\nfunction RENDER(request : dval)\nfunction RENDER:NAME(request : dval)\n\n`RENDER` defines the HTTP page entrypoint.\n\nThe handler has one parameter named `request` with type `dval`. Read request data from the snapshot. Use `print` to write the response.\n"
        page["label"] = "RENDER"
        page["capy_sig_lines"] = dval(["function RENDER(request : dval)", "function RENDER:NAME(request : dval)"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_Request", "1_COMPONENT"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(string(request.method, \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

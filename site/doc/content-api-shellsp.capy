#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "shell-spawn" {
        var page := dval({source_page: ""})
        page["source_page"] = "shell_spawn"
        page["kind"] = "api"
        page["slug"] = "shell-spawn"
        page["route"] = "/doc/api/shell-spawn/"
        page["title"] = "shell_spawn"
        page["content"] = "## sig\n\nfunction shell_spawn(spec : dval) dval\n\nUse `shell_spawn` to start a background shell job. The `cmd` value is a shell command.\n"
        page["returns"] = "Job identifier value."
        page["label"] = "shell_spawn"
        page["capy_sig_lines"] = dval(["function shell_spawn(spec : dval) dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var job := shell_spawn(dval({\"cmd\": \"printf hello\"}))\nprint(string(job), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

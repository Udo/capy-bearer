#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "units-list" {
        var page := dval({source_page: ""})
        page["source_page"] = "units_list"
        page["kind"] = "api"
        page["slug"] = "units-list"
        page["route"] = "/doc/api/units-list/"
        page["title"] = "units_list"
        page["content"] = "## sig\n\nfunction units_list() dval\n\n`units_list` returns known unit paths.\n"
        page["returns"] = "a `dval` list of unit paths"
        page["label"] = "units_list"
        page["capy_sig_lines"] = dval(["function units_list() dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">runtime", "unit_info", "unit_compile", "unit_load"])
        page["examples"] = dval([{entry: "render", caption: "", body: "for path := units_list() {\n    print(path, \"\\n\")\n}\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "ws-opcode" {
        var page := dval({source_page: ""})
        page["source_page"] = "ws_opcode"
        page["kind"] = "api"
        page["slug"] = "ws-opcode"
        page["route"] = "/doc/api/ws-opcode/"
        page["title"] = "ws_opcode"
        page["content"] = "## sig\n\nNo Capy signature.\n\nCapy has no native `ws_opcode` signature. In a `WS` handler, use `request.websocket.opcode`.\n"
        page["label"] = "ws_opcode"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">websocket", ">0_Request", "ws_message", "ws_scope", "ws_is_binary", "ws_send", "ws_connections", "ws_send_to"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

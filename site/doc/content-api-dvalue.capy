#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue" {
        var page := dval({source_page: ""})
        page["source_page"] = "0_DValue"
        page["kind"] = "api"
        page["slug"] = "dvalue"
        page["route"] = "/doc/api/dvalue/"
        page["title"] = "DValue"
        page["content"] = "`dval` is Capy's structured value type. It stores scalars, maps, lists, and `none`.\n\nA `dval` is a mutable reference value inside one workspace. Assignment, parameters, returns, and captures share its identity. Bearer, module, component, task, custom export, codec, request, and serialization boundaries copy BRRB. Identity never crosses a boundary.\n\n## Normal Use\n\nUse a map-shaped `dval` for named fields. Use a list-shaped `dval` for ordered values.\n\n- `{\"name\": \"Ada\"}` creates named fields.\n- `dval([\"Ada\", \"Lin\"])` creates an ordered list.\n- `value[\"name\"]` and `value.name` read a named child.\n- `value[0]` reads a list child.\n- `string`, `bool`, `s32`, `s64`, `u64`, and `f64` are scalar constructors.\n- `dval_has(value, key)` tests whether a key exists.\n- `dval_key(value, key)` reads one named child.\n- `dval_get_by_path(value, \"a/b/c\")` reads a nested child.\n- `dval_require(value, key)` makes a strict read.\n\nUse `T(value)` to convert a `dval`. Use `T(value, fallback)` when `none` or a failed conversion needs a fallback.\n\n`none` is not an empty string. A child can exist and contain `none`. `dval_has` returns true for that child.\n\nMember and index reads are safe. A missing child, unusable intermediate value, negative list index, or out-of-range list index returns `none`. These reads do not change the value.\n\n`dval_key` returns `none` for a missing key or a scalar value. `dval_get_by_path` returns an empty string value when traversal fails. It does not return `none` for that case.\n\nUse `dval_require` when a missing value is an error. It traps for a missing or unusable key or index.\n\n## Updates\n\nCapy update functions mutate their target and return that same identity. Assigning the result back remains valid.\n\n- `dval_put(value, key, child)` sets a named child.\n- `dval_push(va"
        page["content"] = string(page["content"], "") + "lue, child)` adds a list child.\n- `dval_pop(value)` removes the final list child.\n- `dval_remove(value, key)` removes a named child.\n- `dval_clear(value)` removes all children.\n- `dval_get_or_create(value, key)` creates a missing child.\n- `dval_set_array(value)` makes a list-shaped value.\n- `dval_set_bool(value, flag)` stores a Boolean.\n- `dval_set_type(value, type)` changes the internal type.\n- `dval_set(value, source)` and `dval_assign(value, source)` replace the content.\n\nNested assignment mutates the target. Its root must be a named local, parameter, or captured DValue binding. Temporary, call, member, array-item, and loop-item roots are invalid. It creates missing, `none`, and scalar intermediate maps. Content mutation through a parameter affects the caller. Parameter binding reassignment remains invalid.\n\nMember reads, index reads, and loop items return copied DValues. Pure operations such as `dval_map`, `dval_filter`, `dval_keys`, and `dval_values` return new values.\n\n## C++ API\n\nC++ uses the `DValue` class. It supports calls such as `set`, `push`, `get_by_path`, and `to_string`.\n\nC++ `operator[]` can create a missing child. Use `has`, `key`, or `get_by_path` when you must not create a child.\n\nC++ `key` returns a pointer or `0`. C++ `get_by_path` returns an empty string value when traversal fails.\n"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "DValue"
        page["sig_lines"] = dval(["DValue", ""])
        page["capy_sig_lines"] = dval(["type dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">types", "2_DValue_to_string", "2_DValue_require", "2_DValue_get_by_path", "json_decode"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

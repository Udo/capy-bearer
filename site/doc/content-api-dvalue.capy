#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue" {
        var page := dval({source_page: ""})
        page["source_page"] = "0_DValue"
        page["kind"] = "api"
        page["slug"] = "dvalue"
        page["route"] = "/doc/api/dvalue/"
        page["title"] = "Dynamic values"
        page["content"] = "## sig\n\ntype dval\n\nA `dval` stores scalar values, maps, lists, and `none`.\n\nUse maps for named fields and lists for ordered values. Read children with `value.name`, `value[\"name\"]`, or `value[0]`. A missing read returns `none` and does not change the value.\n\nUse `dval_has` to test a key. Use `dval_require` when a missing child is an error. Use `string`, `bool`, `s32`, `s64`, `u64`, or `f64` to convert a value.\n\nUpdate functions such as `dval_put`, `dval_push`, and `dval_set` change their target and return it. Pure functions such as `dval_map`, `dval_filter`, `dval_keys`, and `dval_values` return new values.\n"
        page["label"] = "DValue"
        page["capy_sig_lines"] = dval(["type dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">types", "2_DValue_to_string", "2_DValue_require", "2_DValue_get_by_path", "json_decode"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var user := dval({\"name\": \"Ada\", \"tags\": [\"math\"]})\nprint(user.name, \" \", user.tags[0], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "regex-search-all" {
        var page := dval({source_page: ""})
        page["source_page"] = "regex_search_all"
        page["kind"] = "api"
        page["slug"] = "regex-search-all"
        page["route"] = "/doc/api/regex-search-all/"
        page["title"] = "regex_search_all"
        page["content"] = "## sig\n\nfunction regex_search_all(pattern : string, subject : string, flags : string = \"\") dval\n\nThe result contains `matched`, `count`, and `matches`.\n"
        page["returns"] = "Data for all non-overlapping matches."
        page["label"] = "regex_search_all"
        page["capy_sig_lines"] = dval(["function regex_search_all(pattern : string, subject : string, flags : string = \"\") dval"])
        page["param_lines"] = dval(["pattern : regular expression", "subject : text to search", "flags : regular expression flags", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var matches := regex_search_all(\"[a-z]+\", \"capy docs\")\nprint(s32(matches.count), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "regex-search" {
        var page := dval({source_page: ""})
        page["source_page"] = "regex_search"
        page["kind"] = "api"
        page["slug"] = "regex-search"
        page["route"] = "/doc/api/regex-search/"
        page["title"] = "regex_search"
        page["content"] = "## sig\n\nfunction regex_search(pattern : string, subject : string, flags : string = \"\") dval\n\nThe result contains `matched`. A matching result also contains `match`, `start`, `end`, `captures`, and `named`.\n"
        page["returns"] = "Data for the first match."
        page["label"] = "regex_search"
        page["capy_sig_lines"] = dval(["function regex_search(pattern : string, subject : string, flags : string = \"\") dval"])
        page["param_lines"] = dval(["pattern : regular expression", "subject : text to search", "flags : regular expression flags", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var match := regex_search(\"[a-z]+\", \"123 capy\")\nprint(string(match.match, \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

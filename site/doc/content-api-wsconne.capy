#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "ws-connection-count" {
        var page := dval({source_page: ""})
        page["source_page"] = "ws_connection_count"
        page["kind"] = "api"
        page["slug"] = "ws-connection-count"
        page["route"] = "/doc/api/ws-connection-count/"
        page["title"] = "ws_connection_count"
        page["content"] = "Capy has no native `ws_connection_count` signature. In a `WS` handler, use `length(request.websocket.connections)`.\n"
        page["label"] = "ws_connection_count"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">websocket", ">0_Request", "ws_close", "ws_connection_id", "ws_connections", "ws_is_binary", "ws_message", "ws_opcode"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "ws-connection-id" {
        var page := dval({source_page: ""})
        page["source_page"] = "ws_connection_id"
        page["kind"] = "api"
        page["slug"] = "ws-connection-id"
        page["route"] = "/doc/api/ws-connection-id/"
        page["title"] = "ws_connection_id"
        page["content"] = "Capy has no native `ws_connection_id` signature. In a `WS` handler, use `request.websocket.connection_id`.\n"
        page["label"] = "ws_connection_id"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">websocket", ">0_Request", "ws_connection_count", "ws_connections", "ws_close", "ws_is_binary", "ws_message", "ws_opcode"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "ws-connections" {
        var page := dval({source_page: ""})
        page["source_page"] = "ws_connections"
        page["kind"] = "api"
        page["slug"] = "ws-connections"
        page["route"] = "/doc/api/ws-connections/"
        page["title"] = "ws_connections"
        page["content"] = "Capy has no native `ws_connections` signature. In a `WS` handler, use `request.websocket.connections`.\n"
        page["label"] = "ws_connections"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">websocket", ">0_Request", "ws_connection_id", "ws_is_binary", "ws_connection_count", "ws_message", "ws_close", "ws_opcode"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

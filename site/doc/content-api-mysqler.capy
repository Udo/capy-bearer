#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "mysql-error" {
        var page := dval({source_page: ""})
        page["source_page"] = "mysql_error"
        page["kind"] = "api"
        page["slug"] = "mysql-error"
        page["route"] = "/doc/api/mysql-error/"
        page["title"] = "mysql_error"
        page["content"] = "Pass the opaque `u64` handle from `mysql_connect()`.\n\nThis function returns diagnostic text for a failed connection or the latest MySQL operation. Use it after `mysql_connected()` returns `false` or an operation fails.\n\nThe C++ API accepts `MySQL*` instead.\n"
        page["returns"] = "diagnostic text for the connection attempt or latest operation"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "mysql_error"
        page["sig_lines"] = dval(["String mysql_error(MySQL* m)", ""])
        page["capy_sig_lines"] = dval(["function mysql_error(handle : u64) string"])
        page["param_lines"] = dval(["m : Capy MySQL handle", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">mysql", "mysql_disconnect", "mysql_escape", "mysql_connected", "mysql_insert_id", "mysql_connect", "mysql_affected_rows"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

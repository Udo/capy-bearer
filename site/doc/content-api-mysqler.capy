#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "mysql-error" {
        var page := dval({source_page: ""})
        page["source_page"] = "mysql_error"
        page["kind"] = "api"
        page["slug"] = "mysql-error"
        page["route"] = "/doc/api/mysql-error/"
        page["title"] = "mysql_error"
        page["content"] = "## sig\n\nfunction mysql_error(handle : u64) string\n\n`mysql_error()` returns diagnostic text for a failed connection or the latest database operation.\n\nRead it after `mysql_connected()` returns `false` or a query fails.\n"
        page["returns"] = "the latest diagnostic text"
        page["label"] = "mysql_error"
        page["capy_sig_lines"] = dval(["function mysql_error(handle : u64) string"])
        page["param_lines"] = dval(["handle : the MySQL connection handle", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">mysql", "mysql_connect", "mysql_connected"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var database := mysql_connect(\"localhost\", \"root\", \"\", \"\")\nif !mysql_connected(database) { print(mysql_error(database), \"\\n\") }\nif database != u64(0) { mysql_disconnect(database) }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "length" {
        var page := dval({source_page: ""})
        page["source_page"] = "length"
        page["kind"] = "api"
        page["slug"] = "length"
        page["route"] = "/doc/api/length/"
        page["title"] = "length"
        page["content"] = "`length()` counts bytes in strings and markup. It counts entries in `dval` maps and lists, and elements in arrays.\n"
        page["returns"] = "A byte count for text and markup, or an entry count for maps, lists, and arrays."
        page["errors"] = "`length()` traps when a scalar `dval` reaches it."
        page["label"] = "length"
        page["capy_sig_lines"] = dval(["function length(value : string) s32", "function length(value : markup) s32", "function length(value : dval) s32", "function length(value : [T]) s32"])
        page["param_lines"] = dval(["value : text, markup, a `dval` map or list, or an array", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["split", "join"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(length(\"capy docs\"), \" / \", length(dval([\"a\", \"b\"])), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

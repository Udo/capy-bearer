#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "safe-name" {
        var page := dval({source_page: ""})
        page["source_page"] = "safe_name"
        page["kind"] = "api"
        page["slug"] = "safe-name"
        page["route"] = "/doc/api/safe-name/"
        page["title"] = "safe_name"
        page["content"] = "## sig\n\nfunction safe_name(raw : string) string\n\n`safe_name()` removes all other characters. The result can be empty.\n"
        page["returns"] = "Text that contains only letters, digits, and `_`."
        page["label"] = "safe_name"
        page["capy_sig_lines"] = dval(["function safe_name(raw : string) string"])
        page["param_lines"] = dval(["raw : source text", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(safe_name(\"Capy docs-2024\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "string-map" {
        var page := dval({source_page: ""})
        page["source_page"] = "0_StringMap"
        page["kind"] = "api"
        page["slug"] = "string-map"
        page["route"] = "/doc/api/string-map/"
        page["title"] = "StringMap"
        page["content"] = "Use a map-shaped `dval` for string-keyed values in Capy. Create one with `dval({\"key\": \"value\"})`.\n\nUse `value[\"key\"]` to read a copied child. Use `dval_has(value, \"key\")` to test for a child. `dval_put(value, \"key\", \"value\")` mutates the map and returns that same identity.\n\n`parse_query(query)` returns a map-shaped `dval`. `encode_query(map)` returns a query string. `array_merge(left, right)` returns a merged `dval`.\n\n## Capy Limit\n\nCapy has no `StringMap` type. A Capy map holds DValue children and shares identity inside one workspace. It does not expose C++ map references or mutation through `operator[]`. A C++ boundary copies BRRB.\n\n## C++ API\n\nC++ `StringMap` is `std::map<String, String>`. C++ `map[\"key\"]` creates an empty entry when the key is missing.\n"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "StringMap"
        page["sig_lines"] = dval(["0_StringMap", ""])
        page["capy_sig_lines"] = dval(["type dval (map of strings)"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">types", "0_Request", "parse_query", "encode_query", "array_merge"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

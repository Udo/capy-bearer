#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "string-map" {
        var page := dval({source_page: ""})
        page["source_page"] = "0_StringMap"
        page["kind"] = "api"
        page["slug"] = "string-map"
        page["route"] = "/doc/api/string-map/"
        page["title"] = "String map"
        page["content"] = "Use a map-shaped `dval` for string-keyed values. Create one with `dval({\"key\": \"value\"})`.\n\nUse `value[\"key\"]` to read a child. Use `has` to test for a key. Use `set` to change a map.\n\n`parse_query` returns a map-shaped `dval`. `encode_query` creates a query string from a map.\n\nCapy has no separate `StringMap` type. Use a map-shaped `dval` instead.\n"
        page["label"] = "StringMap"
        page["capy_sig_lines"] = dval(["type dval (map of strings)"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_Request", "parse_query", "encode_query", "array_merge"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var params := dval({\"page\": \"docs\"})\nprint(params[\"page\"], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

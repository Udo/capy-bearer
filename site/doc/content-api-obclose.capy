#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "ob-close" {
        var page := dval({source_page: ""})
        page["source_page"] = "ob_close"
        page["kind"] = "api"
        page["slug"] = "ob-close"
        page["route"] = "/doc/api/ob-close/"
        page["title"] = "ob_close"
        page["content"] = "## sig\n\nfunction ob_close()\n\n`ob_close()` discards the current output buffer and returns to the previous buffer.\n\nUse it when you do not need the buffered output.\n"
        page["label"] = "ob_close"
        page["capy_sig_lines"] = dval(["function ob_close()"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">ob", "ob_start", "ob_get_close"])
        page["examples"] = dval([{entry: "render", caption: "", body: "ob_start()\nprint(\"discarded\")\nob_close()\nprint(\"kept\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "ob-close" {
        var page := dval({source_page: ""})
        page["source_page"] = "ob_close"
        page["kind"] = "api"
        page["slug"] = "ob-close"
        page["route"] = "/doc/api/ob-close/"
        page["title"] = "ob_close"
        page["content"] = "`ob_close()` discards the current output buffer and returns to the previous buffer.\n\nUse this when you do not need captured output.\n"
        page["returns"] = "no value"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "ob_close"
        page["sig_lines"] = dval(["void ob_close()", ""])
        page["capy_sig_lines"] = dval(["function ob_close()"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">ob", "ob_get_close", "ob_start", "load", "ob_get", "component_resolve", "component_exists"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

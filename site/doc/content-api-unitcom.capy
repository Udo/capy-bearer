#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "unit-compile" {
        var page := dval({source_page: ""})
        page["source_page"] = "unit_compile"
        page["kind"] = "api"
        page["slug"] = "unit-compile"
        page["route"] = "/doc/api/unit-compile/"
        page["title"] = "unit_compile"
        page["content"] = "## sig\n\nfunction unit_compile(path : string = \"\") bool\n\n`unit_compile` compiles a unit.\n"
        page["returns"] = "`true` if the compiler compiles the unit"
        page["label"] = "unit_compile"
        page["capy_sig_lines"] = dval(["function unit_compile(path : string = \"\") bool"])
        page["param_lines"] = dval(["path : unit path. An empty path selects the current unit", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">runtime", "unit_info", "units_list", "unit_call"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(unit_compile(\"capy-files.capy\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

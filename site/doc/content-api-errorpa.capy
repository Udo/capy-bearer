#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "error-pages" {
        var page := dval({source_page: ""})
        page["source_page"] = "error_pages"
        page["kind"] = "api"
        page["slug"] = "error-pages"
        page["route"] = "/doc/api/error-pages/"
        page["title"] = "Configurable Error Pages"
        page["content"] = "Capy does not provide error page configuration.\n\nNo Capy alternative is available.\n"
        page["label"] = "error_pages"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

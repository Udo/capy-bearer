#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "mysql-escape" {
        var page := dval({source_page: ""})
        page["source_page"] = "mysql_escape"
        page["kind"] = "api"
        page["slug"] = "mysql-escape"
        page["route"] = "/doc/api/mysql-escape/"
        page["title"] = "mysql_escape"
        page["content"] = "## sig\n\nfunction mysql_escape(raw : string) string\nfunction mysql_escape(raw : string, quote : string) string\n\n`mysql_escape(raw)` escapes `raw` and wraps it in single quotes.\n\nUse the second form to set the wrapper. Pass an empty string when no wrapper is needed. Prefer named parameters with `mysql_query()`.\n"
        page["returns"] = "the escaped string"
        page["label"] = "mysql_escape"
        page["capy_sig_lines"] = dval(["function mysql_escape(raw : string) string", "function mysql_escape(raw : string, quote : string) string"])
        page["param_lines"] = dval(["raw : the string to escape", "quote : the string that wraps the result", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">mysql", "mysql_query"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(mysql_escape(\"O'Brien\", \"'\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

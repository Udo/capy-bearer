#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "float-val" {
        var page := dval({source_page: ""})
        page["source_page"] = "float_val"
        page["kind"] = "api"
        page["slug"] = "float-val"
        page["route"] = "/doc/api/float-val/"
        page["title"] = "float_val"
        page["content"] = "## sig\n\nfunction float_val(raw : string) f64\n\n`float_val` reads a floating-point value from text.\n"
        page["returns"] = "The parsed floating-point value. Returns `0` if no usable number exists."
        page["label"] = "float_val"
        page["capy_sig_lines"] = dval(["function float_val(raw : string) f64"])
        page["param_lines"] = dval(["raw : text that contains a number", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(float_val(\"3.14\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

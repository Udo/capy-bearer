#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-key" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_key"
        page["kind"] = "api"
        page["slug"] = "dvalue-key"
        page["route"] = "/doc/api/dvalue-key/"
        page["title"] = "Get a named child"
        page["content"] = "## sig\n\nfunction dval_key(value : dval, key : string) dval\n\n`dval_key` reads a named child without creating it. It returns `none` for a missing key or a scalar.\n"
        page["returns"] = "The copied child, or `none`."
        page["label"] = "dval_key"
        page["capy_sig_lines"] = dval(["function dval_key(value : dval, key : string) dval"])
        page["param_lines"] = dval(["value : source value", "key : child key", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var user := dval({\"email\": \"ada@example.test\"})\nprint(dval_key(user, \"email\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-keys" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_keys"
        page["kind"] = "api"
        page["slug"] = "dvalue-keys"
        page["route"] = "/doc/api/dvalue-keys/"
        page["title"] = "Get child keys"
        page["content"] = "## sig\n\nfunction dval_keys(value : dval) dval\n\n`dval_keys` returns a new list of child keys. A scalar returns an empty list.\n"
        page["returns"] = "A list of child keys."
        page["label"] = "dval_keys"
        page["capy_sig_lines"] = dval(["function dval_keys(value : dval) dval"])
        page["param_lines"] = dval(["value : source value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var user := dval({\"name\": \"Ada\", \"role\": \"admin\"})\nprint(join(sort(dval_keys(user)), \",\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

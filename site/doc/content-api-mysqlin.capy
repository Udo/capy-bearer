#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "mysql-insert-id" {
        var page := dval({source_page: ""})
        page["source_page"] = "mysql_insert_id"
        page["kind"] = "api"
        page["slug"] = "mysql-insert-id"
        page["route"] = "/doc/api/mysql-insert-id/"
        page["title"] = "mysql_insert_id"
        page["content"] = "## sig\n\nfunction mysql_insert_id(handle : u64) u64\n\n`mysql_insert_id()` returns the last automatic row ID for a connection.\n\nCall it after an insert into a table with an automatic ID column.\n"
        page["returns"] = "the last automatic row ID for this connection"
        page["label"] = "mysql_insert_id"
        page["capy_sig_lines"] = dval(["function mysql_insert_id(handle : u64) u64"])
        page["param_lines"] = dval(["handle : the MySQL connection handle", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">mysql", "mysql_query", "mysql_connect"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var database := mysql_connect(\"localhost\", \"root\", \"\", \"\")\nif mysql_connected(database) { print(mysql_insert_id(database), \"\\n\") }\nif database != u64(0) { mysql_disconnect(database) }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

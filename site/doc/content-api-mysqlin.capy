#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "mysql-info" {
        var page := dval({source_page: ""})
        page["source_page"] = "mysql_info"
        page["kind"] = "api"
        page["slug"] = "mysql-info"
        page["route"] = "/doc/api/mysql-info/"
        page["title"] = "mysql_info"
        page["content"] = "`mysql_info()` reads connection state, the latest error text, the last automatic row ID, or the changed-row count.\n\nUse a converter with a fallback because the values have different types.\n"
        page["returns"] = "The value for `key`."
        page["errors"] = "The function stops with an error for an unknown key. The error lists the valid keys."
        page["label"] = "mysql_info"
        page["capy_sig_lines"] = dval(["function mysql_info(handle : u64, key : string) dval"])
        page["param_lines"] = dval(["handle : the MySQL connection handle", "key : `connection`, `error`, `insert_id`, or `affected_rows`", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "mysql_connect", href: "/doc/api/mysql-connect/"}, {label: "mysql_disconnect", href: "/doc/api/mysql-disconnect/"}, {label: "mysql_query", href: "/doc/api/mysql-query/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "var database := mysql_connect(\"localhost\", \"root\", \"\", \"\")\nvar live := bool(mysql_info(database, \"connection\"), false)\nvar message := string(mysql_info(database, \"error\"), \"\")\nvar id := u64(mysql_info(database, \"insert_id\"), 0)\nvar rows := u64(mysql_info(database, \"affected_rows\"), 0)\nprint(live, \" \", message, \" \", id, \" \", rows, \"\\n\")\nif database != u64(0) { mysql_disconnect(database) }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

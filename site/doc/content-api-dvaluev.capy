#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-values" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_values"
        page["kind"] = "api"
        page["slug"] = "dvalue-values"
        page["route"] = "/doc/api/dvalue-values/"
        page["title"] = "Get child values"
        page["content"] = "## sig\n\nfunction dval_values(value : dval) dval\n\n`dval_values` returns a new list of child values. A scalar returns a one-item list.\n"
        page["returns"] = "A list of copied child values."
        page["label"] = "dval_values"
        page["capy_sig_lines"] = dval(["function dval_values(value : dval) dval"])
        page["param_lines"] = dval(["value : source value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var user := dval({\"name\": \"Ada\", \"role\": \"admin\"})\nvar values := dval_values(user)\nprint(dval_is_list(values), \" \", length(values), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

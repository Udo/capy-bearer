#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "s32" {
        var page := dval({source_page: ""})
        page["source_page"] = "s32"
        page["kind"] = "api"
        page["slug"] = "s32"
        page["route"] = "/doc/api/s32/"
        page["title"] = "s32"
        page["content"] = "Use `s32` to convert input to a 32-bit signed integer.\n\n`s32(dval, fallback)` accepts scalar `bool`, finite `f64`, and exact decimal text. `true` maps to `1`, and `false` maps to `0`.\n\n`s32(string, fallback)` trims spaces and then applies the same rules. Out-of-range values return `fallback`. A float input truncates toward zero.\n"
        page["returns"] = "converted `s32`, or `fallback`"
        page["errors"] = "`s32` does not throw. It returns `fallback` for invalid text, `none`, maps, lists, or out-of-range values."
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "s32"
        page["sig_lines"] = dval(["s32(value : dval, fallback : s32 = 0) s32", "s32(value : string, fallback : s32 = 0) s32", ""])
        page["capy_sig_lines"] = dval(["function s32(value : dval, fallback : s32 = 0) s32", "function s32(value : string, fallback : s32 = 0) s32"])
        page["param_lines"] = dval(["value : source value to convert", "fallback : value returned when conversion fails", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">types", "2_DValue_to_s64", "2_DValue_to_u64", "2_DValue_to_f64", "2_DValue_to_bool", "s64"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

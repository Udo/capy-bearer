#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "response-cookie" {
        var page := dval({source_page: ""})
        page["source_page"] = "response_cookie"
        page["kind"] = "api"
        page["slug"] = "response-cookie"
        page["route"] = "/doc/api/response-cookie/"
        page["title"] = "response_cookie"
        page["content"] = "## sig\n\nfunction response_cookie(name : string, value : string)\n\n`response_cookie()` queues a response cookie.\n"
        page["label"] = "response_cookie"
        page["capy_sig_lines"] = dval(["function response_cookie(name : string, value : string)"])
        page["param_lines"] = dval(["name : cookie name", "value : cookie value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "response_cookie(\"theme\", \"dark\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "response-header" {
        var page := dval({source_page: ""})
        page["source_page"] = "response_header"
        page["kind"] = "api"
        page["slug"] = "response-header"
        page["route"] = "/doc/api/response-header/"
        page["title"] = "response_header"
        page["content"] = "## sig\n\nfunction response_header(name : string, value : string)\n\n`response_header()` sets a response header.\n"
        page["label"] = "response_header"
        page["capy_sig_lines"] = dval(["function response_header(name : string, value : string)"])
        page["param_lines"] = dval(["name : header name", "value : header value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "response_header(\"X-Mode\", \"docs\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "response-status" {
        var page := dval({source_page: ""})
        page["source_page"] = "response_status"
        page["kind"] = "api"
        page["slug"] = "response-status"
        page["route"] = "/doc/api/response-status/"
        page["title"] = "response_status"
        page["content"] = "## sig\n\nfunction response_status(code : s32, reason : string = \"\")\n\n`response_status()` sets the response status.\n"
        page["label"] = "response_status"
        page["capy_sig_lines"] = dval(["function response_status(code : s32, reason : string = \"\")"])
        page["param_lines"] = dval(["code : HTTP status code", "reason : optional reason phrase", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "response_status(202, \"Accepted\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "response-cookie" {
        var page := dval({source_page: ""})
        page["source_page"] = "response_cookie"
        page["kind"] = "api"
        page["slug"] = "response-cookie"
        page["route"] = "/doc/api/response-cookie/"
        page["title"] = "response_cookie"
        page["content"] = "`response_cookie()` queues a response cookie.\n"
        page["label"] = "response_cookie"
        page["capy_sig_lines"] = dval(["function response_cookie(name : string, value : string)"])
        page["param_lines"] = dval(["name : cookie name", "value : cookie value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "response_cookie(\"theme\", \"dark\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "response-header" {
        var page := dval({source_page: ""})
        page["source_page"] = "response_header"
        page["kind"] = "api"
        page["slug"] = "response-header"
        page["route"] = "/doc/api/response-header/"
        page["title"] = "response_header"
        page["content"] = "`response_header()` sets a response header.\n"
        page["label"] = "response_header"
        page["capy_sig_lines"] = dval(["function response_header(name : string, value : string)"])
        page["param_lines"] = dval(["name : header name", "value : header value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "response_header(\"X-Mode\", \"docs\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "response-status" {
        var page := dval({source_page: ""})
        page["source_page"] = "response_status"
        page["kind"] = "api"
        page["slug"] = "response-status"
        page["route"] = "/doc/api/response-status/"
        page["title"] = "Set the response status"
        page["content"] = "`response_status` sets the status for the active response.\n\nIf `reason` is empty, Bearer uses the standard phrase for common HTTP status codes. Set the status before you write response output.\n"
        page["returns"] = "This function returns no value."
        page["label"] = "response_status"
        page["capy_sig_lines"] = dval(["function response_status(code : s32, reason : string = \"\")"])
        page["param_lines"] = dval(["code : The HTTP status code.", "reason : An optional reason phrase.", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "request", href: "/doc/type/request/"}, {label: "redirect", href: "/doc/api/redirect/"}, {label: "response_cookie", href: "/doc/api/response-cookie/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "response_status(200, \"OK\")\nprint(\"200\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "json-consume-space" {
        var page := dval({source_page: ""})
        page["source_page"] = "json_consume_space"
        page["kind"] = "api"
        page["slug"] = "json-consume-space"
        page["route"] = "/doc/api/json-consume-space/"
        page["title"] = "json_consume_space"
        page["content"] = "## sig\n\nfunction json_consume_space(source : string, index : s32) s32\n\n`json_consume_space()` skips JSON whitespace from `index`. Use `json_decode()` for normal JSON parsing.\n"
        page["returns"] = "The byte offset after JSON whitespace."
        page["label"] = "json_consume_space"
        page["capy_sig_lines"] = dval(["function json_consume_space(source : string, index : s32) s32"])
        page["param_lines"] = dval(["source : JSON source text", "index : byte offset where the scan starts", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["json_decode", "json_encode"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(json_consume_space(\" \\t\\nvalue\", 0), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "cli-arg" {
        var page := dval({source_page: ""})
        page["source_page"] = "cli_arg"
        page["kind"] = "api"
        page["slug"] = "cli-arg"
        page["route"] = "/doc/api/cli-arg/"
        page["title"] = "cli_arg"
        page["content"] = "Capy does not provide the retired CLI argument reader.\n\nIn a `CLI` handler, read the required value from `request.query`, `request.form`, or `request.body`. Select the field that matches the input source.\n"
        page["label"] = "cli_arg"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">1_CLI", ">0_Request", "cli_input"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "xml-decode" {
        var page := dval({source_page: ""})
        page["source_page"] = "xml_decode"
        page["kind"] = "api"
        page["slug"] = "xml-decode"
        page["route"] = "/doc/api/xml-decode/"
        page["title"] = "xml_decode"
        page["content"] = "## sig\n\nfunction xml_decode(source : string) dval\n\n`xml_decode()` decodes XML source into a `dval`.\n"
        page["returns"] = "A `dval` that contains the decoded XML."
        page["label"] = "xml_decode"
        page["capy_sig_lines"] = dval(["function xml_decode(source : string) dval"])
        page["param_lines"] = dval(["source : XML source", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">markup", "xml_encode", "json_decode", "0_DValue", "0_String"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var value := xml_decode(\"<root><name>Ada</name></root>\")\nprint(value[\"children\"][0][\"text\"], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

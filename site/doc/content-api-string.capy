#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "string" {
        var page := dval({source_page: ""})
        page["source_page"] = "0_String"
        page["kind"] = "api"
        page["slug"] = "string"
        page["route"] = "/doc/api/string/"
        page["title"] = "String"
        page["content"] = "`string` is Capy's text and byte value type. Use string literals, variables, parameters, and return values directly.\n\nString functions take `string` inputs and return `string`, numeric, or boolean values. Common functions include `length`, `find`, `contains`, `replace`, `lower`, `upper`, `substr`, `split`, and `split_utf8`.\n\nCapy passes strings by value. A function call does not expose a mutable C++ string reference.\n\nA `string` can contain raw bytes. Use `split_utf8()` when you must split UTF-8 text by characters. Do not treat each byte as one character.\n\n## C++ API\n\nC++ uses `String`, an alias for `std::string`. The same value can hold text or raw bytes.\n"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "String"
        page["sig_lines"] = dval(["0_String", ""])
        page["capy_sig_lines"] = dval(["type string"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">types", ">string", "split_utf8", "substr", "html_escape"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-mtime" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_mtime"
        page["kind"] = "api"
        page["slug"] = "file-mtime"
        page["route"] = "/doc/api/file-mtime/"
        page["title"] = "file_mtime"
        page["content"] = "## sig\n\nfunction file_mtime(path : string) u64\n\n`file_mtime` returns the modification time of a file.\n"
        page["returns"] = "The modification time as a Unix timestamp, or `0` when it is unavailable."
        page["label"] = "file_mtime"
        page["capy_sig_lines"] = dval(["function file_mtime(path : string) u64"])
        page["param_lines"] = dval(["path : path of the file to inspect", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "file_stat", "file_get_contents", "file_exists"])
        page["examples"] = dval([{entry: "render", caption: "", body: "file_put_contents(\"/tmp/doc-mtime.txt\", \"x\")\nprint(file_mtime(\"/tmp/doc-mtime.txt\") > u64(0), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

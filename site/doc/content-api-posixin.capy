#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "posix-info" {
        var page := dval({source_page: ""})
        page["source_page"] = "posix_info"
        page["kind"] = "api"
        page["slug"] = "posix-info"
        page["route"] = "/doc/api/posix-info/"
        page["title"] = "posix_info"
        page["content"] = "`posix_info(\"signal_name\", value)` returns the POSIX signal name for a signal number.\n"
        page["returns"] = "The value for `key`."
        page["errors"] = "The function stops with an error for an unknown key. The error lists the valid keys."
        page["label"] = "posix_info"
        page["capy_sig_lines"] = dval(["function posix_info(key : string, value : dval) dval"])
        page["param_lines"] = dval(["key : `signal_name`", "value : the value for `key`", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">runtime"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(string(posix_info(\"signal_name\", 11), \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

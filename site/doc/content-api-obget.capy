#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "ob-get" {
        var page := dval({source_page: ""})
        page["source_page"] = "ob_get"
        page["kind"] = "api"
        page["slug"] = "ob-get"
        page["route"] = "/doc/api/ob-get/"
        page["title"] = "ob_get"
        page["content"] = "`ob_get()` returns the current output buffer contents.\n\nThe buffer stays active after this call.\n"
        page["returns"] = "the current output buffer contents"
        page["label"] = "ob_get"
        page["capy_sig_lines"] = dval(["function ob_get() string"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "ob_start", href: "/doc/api/ob-start/"}, {label: "ob_get_close", href: "/doc/api/ob-get-close/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "ob_start()\nprint(\"partial\")\nvar output := ob_get()\nob_close()\nprint(output, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

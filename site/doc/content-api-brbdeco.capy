#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "brb-decode" {
        var page := dval({source_page: ""})
        page["source_page"] = "brb_decode"
        page["kind"] = "api"
        page["slug"] = "brb-decode"
        page["route"] = "/doc/api/brb-decode/"
        page["title"] = "brb_decode"
        page["content"] = "## sig\n\nfunction brb_decode(encoded : string) dval\n\n`brb_decode` decodes BRRB data into a `dval` value.\n\nUse it to read data from `brb_encode`.\n"
        page["returns"] = "a decoded `dval` value"
        page["label"] = "brb_decode"
        page["capy_sig_lines"] = dval(["function brb_decode(encoded : string) dval"])
        page["param_lines"] = dval(["encoded : BRRB data", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["brb_encode", "json_decode"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var value := brb_decode(brb_encode(dval({\"name\": \"Ada\"})))\nprint(value[\"name\"], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

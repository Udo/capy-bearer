#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "shell-escape" {
        var page := dval({source_page: ""})
        page["source_page"] = "shell_escape"
        page["kind"] = "api"
        page["slug"] = "shell-escape"
        page["route"] = "/doc/api/shell-escape/"
        page["title"] = "shell_escape"
        page["content"] = "Capy `shell_escape(raw)` returns `raw` as one shell word. Give it one value that will become an argument in a command string.\n\nUse it before `shell_exec()` when a command contains input from outside the program. It does not make a complete command safe. Do not use it for shell syntax.\n"
        page["returns"] = "a single-quoted shell word that represents `raw`"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "shell_escape"
        page["sig_lines"] = dval(["String shell_escape(String raw)", ""])
        page["capy_sig_lines"] = dval(["function shell_escape(raw : string) string"])
        page["param_lines"] = dval(["raw : string value to use as one shell word", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "cwd_set", "shell_exec", "path_join", "shell_spawn", "mkdir", "job_status"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

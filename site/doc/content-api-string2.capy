#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "string-2" {
        var page := dval({source_page: ""})
        page["source_page"] = "string"
        page["kind"] = "api"
        page["slug"] = "string-2"
        page["route"] = "/doc/api/string-2/"
        page["title"] = "string"
        page["content"] = "## sig\n\nfunction string(value : dval, fallback : string = \"\") string\n\nUse `string` to convert a `dval` value to text. It returns `fallback` when conversion fails.\n"
        page["returns"] = "Converted text, or `fallback`."
        page["label"] = "string"
        page["capy_sig_lines"] = dval(["function string(value : dval, fallback : string = \"\") string"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(string(dval(42)), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

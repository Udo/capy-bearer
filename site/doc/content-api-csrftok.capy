#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "csrf-token" {
        var page := dval({source_page: ""})
        page["source_page"] = "csrf_token"
        page["kind"] = "api"
        page["slug"] = "csrf-token"
        page["route"] = "/doc/api/csrf-token/"
        page["title"] = "csrf_token"
        page["content"] = "`csrf_token()` returns a stable token for one session and token namespace.\n\nUse the result in a hidden form field. Call `csrf_valid()` before you apply a browser-submitted change.\n"
        page["returns"] = "The active CSRF token."
        page["label"] = "csrf_token"
        page["capy_sig_lines"] = dval(["function csrf_token(session_name : string = \"bearer-session\", token_name : string = \"csrf_token\") string"])
        page["param_lines"] = dval(["session_name : the session and cookie name", "token_name : the token namespace in the session", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "csrf_field", href: "/doc/api/csrf-field/"}, {label: "csrf_valid", href: "/doc/api/csrf-valid/"}, {label: "csrf_rotate", href: "/doc/api/csrf-rotate/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "var token := csrf_token(\"capy-doc-session\")\nprint(length(token) > 0, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

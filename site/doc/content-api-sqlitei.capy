#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "sqlite-insert-id" {
        var page := dval({source_page: ""})
        page["source_page"] = "sqlite_insert_id"
        page["kind"] = "api"
        page["slug"] = "sqlite-insert-id"
        page["route"] = "/doc/api/sqlite-insert-id/"
        page["title"] = "sqlite_insert_id"
        page["content"] = "## sig\n\nfunction sqlite_insert_id(handle : u64) u64\n\nUse `sqlite_insert_id` after an insert that creates a row ID.\n"
        page["returns"] = "Last inserted row ID."
        page["label"] = "sqlite_insert_id"
        page["capy_sig_lines"] = dval(["function sqlite_insert_id(handle : u64) u64"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var db := sqlite_connect(\":memory:\")\nsqlite_query(db, \"create table t(id integer primary key)\")\nsqlite_query(db, \"insert into t values(1)\")\nprint(sqlite_insert_id(db), \"\\n\")\nsqlite_disconnect(db)\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

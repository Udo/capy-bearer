#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "sqlite-info" {
        var page := dval({source_page: ""})
        page["source_page"] = "sqlite_info"
        page["kind"] = "api"
        page["slug"] = "sqlite-info"
        page["route"] = "/doc/api/sqlite-info/"
        page["title"] = "sqlite_info"
        page["content"] = "`sqlite_info()` reads the latest error text, the last inserted row ID, or the changed-row count.\n\nUse a converter with a fallback because the values have different types.\n"
        page["returns"] = "The value for `key`."
        page["errors"] = "The function stops with an error for an unknown key. The error lists the valid keys."
        page["label"] = "sqlite_info"
        page["capy_sig_lines"] = dval(["function sqlite_info(handle : u64, key : string) dval"])
        page["param_lines"] = dval(["handle : the SQLite connection handle", "key : `error`, `insert_id`, or `affected_rows`", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sqlite", "sqlite_connect", "sqlite_disconnect", "sqlite_query"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var db := sqlite_connect(\":memory:\")\nsqlite_query(db, \"create table t(id integer primary key)\")\nsqlite_query(db, \"insert into t values(1)\")\nvar message := string(sqlite_info(db, \"error\"), \"\")\nvar id := u64(sqlite_info(db, \"insert_id\"), 0)\nvar rows := u64(sqlite_info(db, \"affected_rows\"), 0)\nprint(message, \" \", id, \" \", rows, \"\\n\")\nsqlite_disconnect(db)\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

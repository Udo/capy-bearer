#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-get-contents" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_get_contents"
        page["kind"] = "api"
        page["slug"] = "file-get-contents"
        page["route"] = "/doc/api/file-get-contents/"
        page["title"] = "file_get_contents"
        page["content"] = "`file_get_contents()` reads a complete file into a `string`. Use it for a small file that you need as one value. An unreadable file returns `\"\"`.\n\nUse `file_open()` and `file_read()` for streamed reads. Capy returns the same data as `String`.\n"
        page["returns"] = "file content as a Capy `string`, or `\"\"` when Capy cannot read it"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "file_get_contents"
        page["sig_lines"] = dval(["String file_get_contents(String file_name)", ""])
        page["capy_sig_lines"] = dval(["function file_get_contents(path : string) string"])
        page["param_lines"] = dval(["file_name : path of the file to read", ""])
        page["notes"] = dval(["`file_get_contents()` returns an empty string for an empty file and for an unreadable file. Use `file_exists()` first when you must tell these cases apart."])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "file_put_contents", "file_append", "file_open"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-get-contents" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_get_contents"
        page["kind"] = "api"
        page["slug"] = "file-get-contents"
        page["route"] = "/doc/api/file-get-contents/"
        page["title"] = "file_get_contents"
        page["content"] = "`file_get_contents` reads a complete file into a string. Use it for a small file that fits in one value. Use `file_open` and `file_read` for incremental reads.\n"
        page["returns"] = "The file content, or `\"\"` when Capy cannot read the file."
        page["label"] = "file_get_contents"
        page["capy_sig_lines"] = dval(["function file_get_contents(path : string) string"])
        page["param_lines"] = dval(["path : path of the file to read", ""])
        page["notes"] = dval(["An empty file and an unreadable file both return `\"\"`. Use `file_exists` when you must distinguish them."])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "file_put_contents", "file_append", "file_open"])
        page["examples"] = dval([{entry: "render", caption: "", body: "file_put_contents(\"/tmp/doc-get.txt\", \"hello\")\nprint(file_get_contents(\"/tmp/doc-get.txt\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "array-merge" {
        var page := dval({source_page: ""})
        page["source_page"] = "array_merge"
        page["kind"] = "api"
        page["slug"] = "array-merge"
        page["route"] = "/doc/api/array-merge/"
        page["title"] = "array_merge"
        page["content"] = "## sig\n\nfunction array_merge(left : dval, right : dval) dval\n\n`array_merge` combines two `dval` values. It returns a new value.\n\nFor maps, values from `right` replace matching values from `left`. The function also merges lists.\n"
        page["returns"] = "a merged `dval` value"
        page["label"] = "array_merge"
        page["capy_sig_lines"] = dval(["function array_merge(left : dval, right : dval) dval"])
        page["param_lines"] = dval(["left : first value", "right : second value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["json_decode"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var merged := array_merge(dval({\"name\": \"Ada\"}), dval({\"role\": \"admin\"}))\nprint(merged[\"name\"], \" \", merged[\"role\"], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

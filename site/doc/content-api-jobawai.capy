#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "job-await" {
        var page := dval({source_page: ""})
        page["source_page"] = "job_await"
        page["kind"] = "api"
        page["slug"] = "job-await"
        page["route"] = "/doc/api/job-await/"
        page["title"] = "job_await"
        page["content"] = "`job_await()` waits for a job until the timeout expires. It returns the current status when the timeout expires.\n"
        page["returns"] = "A job status map. A completed job includes `result`."
        page["label"] = "job_await"
        page["capy_sig_lines"] = dval(["function job_await(job : dval, timeout_ms : s32) dval"])
        page["param_lines"] = dval(["job : a job ID as `dval`", "timeout_ms : maximum wait time in milliseconds", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["job_result", "job_status", "job_cancel"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var job := shell_spawn(dval({\"cmd\": \"printf hello\", \"timeout_ms\": 1000}))\nvar result := job_await(job, 3000)\nprint(dval_get_by_path(result, \"result/stdout\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

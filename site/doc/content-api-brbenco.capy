#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "brb-encode" {
        var page := dval({source_page: ""})
        page["source_page"] = "brb_encode"
        page["kind"] = "api"
        page["slug"] = "brb-encode"
        page["route"] = "/doc/api/brb-encode/"
        page["title"] = "brb_encode"
        page["content"] = "`brb_encode` encodes a `dval` value as BRRB data.\n\nUse `brb_decode` to restore the value.\n"
        page["returns"] = "BRRB data as a string"
        page["label"] = "brb_encode"
        page["capy_sig_lines"] = dval(["function brb_encode(value : dval) string"])
        page["param_lines"] = dval(["value : value to encode", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "brb_decode", href: "/doc/api/brb-decode/"}, {label: "json_encode", href: "/doc/api/json-encode/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "var packed := brb_encode(dval({\"name\": \"Ada\"}))\nprint(brb_decode(packed)[\"name\"], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

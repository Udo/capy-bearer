#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-pwrite" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_pwrite"
        page["kind"] = "api"
        page["slug"] = "file-pwrite"
        page["route"] = "/doc/api/file-pwrite/"
        page["title"] = "file_pwrite"
        page["content"] = "`file_pwrite` writes text at an absolute byte offset. It does not change the handle position.\n"
        page["returns"] = "The number of bytes written."
        page["label"] = "file_pwrite"
        page["capy_sig_lines"] = dval(["function file_pwrite(handle : u64, offset : u64, data : string) u64"])
        page["param_lines"] = dval(["handle : writable handle returned by `file_open`", "offset : absolute byte offset", "data : text to write", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "file_write", "file_pread", "file_open"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var handle := file_open(\"/tmp/doc-pwrite.txt\", \"w\")\nfile_write(handle, \"hello world\")\nfile_close(handle)\nvar editor := file_open(\"/tmp/doc-pwrite.txt\", \"r+\")\nfile_pwrite(editor, u64(6), \"earth\")\nfile_close(editor)\nprint(file_get_contents(\"/tmp/doc-pwrite.txt\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

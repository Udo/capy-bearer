#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "init" {
        var page := dval({source_page: ""})
        page["source_page"] = "1_INIT"
        page["kind"] = "api"
        page["slug"] = "init"
        page["route"] = "/doc/api/init/"
        page["title"] = "INIT"
        page["content"] = "`INIT` defines the unit materialization hook.\n\nBearer runs this hook before dispatch in a request workspace. The handler has one parameter named `request` with type `dval`.\n"
        page["label"] = "INIT"
        page["capy_sig_lines"] = dval(["function INIT(request : dval)"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_Request", "1_ONCE"])
        page["examples"] = dval([{entry: "init", caption: "", body: "print(string(request.method, \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "uri-encode" {
        var page := dval({source_page: ""})
        page["source_page"] = "uri_encode"
        page["kind"] = "api"
        page["slug"] = "uri-encode"
        page["route"] = "/doc/api/uri-encode/"
        page["title"] = "uri_encode"
        page["content"] = "`uri_encode` encodes a string for a URI component.\n"
        page["returns"] = "URI-encoded string"
        page["label"] = "uri_encode"
        page["capy_sig_lines"] = dval(["function uri_encode(value : string) string"])
        page["param_lines"] = dval(["value : string to encode", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">uri", "uri_decode", "parse_uri", "parse_query", "session_id_create", "route_path_sanitize"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(uri_encode(\"Ada Lovelace\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

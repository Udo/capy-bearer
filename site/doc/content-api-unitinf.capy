#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "unit-info" {
        var page := dval({source_page: ""})
        page["source_page"] = "unit_info"
        page["kind"] = "api"
        page["slug"] = "unit-info"
        page["route"] = "/doc/api/unit-info/"
        page["title"] = "unit_info"
        page["content"] = "Call `unit_info()` for the current unit. Call `unit_info(path)` for another unit.\n\nThe function returns a `dval` value with available unit metadata. Fields can include paths, status, times, and exported APIs. Check that a field exists before you use it. An empty result means Capy cannot resolve the unit.\n\nUse this function to inspect a unit before an optional call. Relative paths use the same unit path rules as unit calls. Counters describe the current runtime process.\n\nC++ returns a `DValue` through the signature above. Use the same path and result checks.\n"
        page["returns"] = "unit metadata as a `dval`, or an empty value if Capy cannot resolve the unit"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "unit_info"
        page["sig_lines"] = dval(["DValue unit_info(String path = \"\")", ""])
        page["capy_sig_lines"] = dval(["function unit_info(path : string = \"\") dval"])
        page["param_lines"] = dval(["path : optional unit path. If empty, uses the current unit", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">runtime", "units_list", "unit_compile", "0_Request"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

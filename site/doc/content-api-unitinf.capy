#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "unit-info" {
        var page := dval({source_page: ""})
        page["source_page"] = "unit_info"
        page["kind"] = "api"
        page["slug"] = "unit-info"
        page["route"] = "/doc/api/unit-info/"
        page["title"] = "unit_info"
        page["content"] = "## sig\n\nfunction unit_info(path : string = \"\") dval\n\n`unit_info` returns metadata for a unit.\n"
        page["returns"] = "unit metadata"
        page["label"] = "unit_info"
        page["capy_sig_lines"] = dval(["function unit_info(path : string = \"\") dval"])
        page["param_lines"] = dval(["path : unit path. An empty path selects the current unit", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">runtime", "units_list", "unit_compile", "0_Request"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var info := unit_info(\"capy-files.capy\")\nprint(bool(info[\"source_exists\"]), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

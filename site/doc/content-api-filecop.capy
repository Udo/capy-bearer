#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-copy" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_copy"
        page["kind"] = "api"
        page["slug"] = "file-copy"
        page["route"] = "/doc/api/file-copy/"
        page["title"] = "file_copy"
        page["content"] = "## sig\n\nfunction file_copy(from : string, to : string) bool\n\n`file_copy` copies a file to another path. The source path remains available after a successful copy.\n"
        page["returns"] = "`true` when Capy copies the file. Otherwise, it returns `false`."
        page["label"] = "file_copy"
        page["capy_sig_lines"] = dval(["function file_copy(from : string, to : string) bool"])
        page["param_lines"] = dval(["from : source path", "to : destination path", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "file_rename", "file_put_contents", "file_stat"])
        page["examples"] = dval([{entry: "render", caption: "", body: "file_put_contents(\"/tmp/doc-copy-src.txt\", \"payload\")\nfile_copy(\"/tmp/doc-copy-src.txt\", \"/tmp/doc-copy-dst.txt\")\nprint(file_get_contents(\"/tmp/doc-copy-dst.txt\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

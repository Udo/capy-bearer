#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "request-context-params" {
        var page := dval({source_page: ""})
        page["source_page"] = "request_context_params"
        page["kind"] = "api"
        page["slug"] = "request-context-params"
        page["route"] = "/doc/api/request-context-params/"
        page["title"] = "request_context_params"
        page["content"] = "Handlers receive request data in `request`.\n\nUse `request.url.script` for the script URL. Use `request.url.base` for the base URL. Use `request.route.path`, `request.route.page`, `request.route.raw_path`, and `request.route.valid` for route data.\n"
        page["label"] = "request_context_params"
        page["capy_sig_lines"] = dval(["handler request : dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(string(request.route.path, \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

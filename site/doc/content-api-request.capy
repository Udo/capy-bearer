        page["slug"] = "request-query-route"
        page["route"] = "/doc/api/request-query-route/"
        page["title"] = "request_query_route"
        page["content"] = "## sig\n\nNot available in Capy.\n\nUse `request.route` in a handler to read route data. Its fields include `path`, `page`, `raw_path`, and `valid`.\n"
        page["label"] = "request_query_route"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(string(request.route.page, \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])

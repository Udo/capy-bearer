#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "request-base-url" {
        var page := dval({source_page: ""})
        page["source_page"] = "request_base_url"
        page["kind"] = "api"
        page["slug"] = "request-base-url"
        page["route"] = "/doc/api/request-base-url/"
        page["title"] = "request_base_url"
        page["content"] = "## sig\n\nNot available in Capy.\n\nUse `request.url.base` in a handler to read the base URL.\n"
        page["label"] = "request_base_url"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(string(request.url.base, \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "request-context-params" {
        var page := dval({source_page: ""})
        page["source_page"] = "request_context_params"
        page["kind"] = "api"
        page["slug"] = "request-context-params"
        page["route"] = "/doc/api/request-context-params/"
        page["title"] = "request_context_params"
        page["content"] = "## sig\n\nhandler request : dval\n\nHandlers receive request data in `request`.\n\nUse `request.url.script` for the script URL. Use `request.url.base` for the base URL. Use `request.route.path`, `request.route.page`, `request.route.raw_path`, and `request.route.valid` for route data.\n"
        page["label"] = "request_context_params"
        page["capy_sig_lines"] = dval(["handler request : dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(string(request.route.path, \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "request-ob-start" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_Request_ob_start"
        page["kind"] = "api"
        page["slug"] = "request-ob-start"
        page["route"] = "/doc/api/request-ob-start/"
        page["title"] = "Start an output buffer"
        page["content"] = "## sig\n\nfunction ob_start()\n\n`ob_start()` starts an output buffer for the active request.\n\nOutput after this call goes to the buffer. Use `ob_get`, `ob_get_close`, or `ob_close` to read or close it.\n"
        page["returns"] = "This function returns no value."
        page["label"] = "ob_start"
        page["capy_sig_lines"] = dval(["function ob_start()"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_Request", "ob_get_close"])
        page["examples"] = dval([{entry: "render", caption: "", body: "ob_start()\nprint(\"fragment\")\nvar captured := ob_get_close()\nprint(\"captured: \", captured, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "request-perf" {
        var page := dval({source_page: ""})
        page["source_page"] = "request_perf"
        page["kind"] = "api"
        page["slug"] = "request-perf"
        page["route"] = "/doc/api/request-perf/"
        page["title"] = "request_perf"
        page["content"] = "## sig\n\nNot available in Capy.\n\nUse `runtime_perf()` in a handler to read runtime performance data.\n"
        page["label"] = "request_perf"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var perf := runtime_perf()\nprint(dval_get_type_name(perf), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "request-query-path" {
        var page := dval({source_page: ""})
        page["source_page"] = "request_query_path"
        page["kind"] = "api"
        page["slug"] = "request-query-path"
        page["route"] = "/doc/api/request-query-path/"
        page["title"] = "request_query_path"
        page["content"] = "## sig\n\nNot available in Capy.\n\nUse `request.route.path` in a handler to read the safe query route.\n"
        page["label"] = "request_query_path"
        page["capy_sig_lines"] = dval([])

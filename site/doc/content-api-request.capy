        page["kind"] = "api"
        page["slug"] = "request-route-from-raw-path"
        page["route"] = "/doc/api/request-route-from-raw-path/"
        page["title"] = "request_route_from_raw_path"
        page["content"] = "## sig\n\nNot available in Capy.\n\nUse `route_from_raw_path()` to validate route text without reading the request.\n"
        page["label"] = "request_route_from_raw_path"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var route := route_from_raw_path(\"docs/api\")\nprint(string(route.path, \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "request-script-url" {
        var page := dval({source_page: ""})

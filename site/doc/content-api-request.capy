        page["guide_examples"] = dval([])
        return page
    }
    if slug == "request-set-status" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_Request_set_status"
        page["kind"] = "api"
        page["slug"] = "request-set-status"
        page["route"] = "/doc/api/request-set-status/"
        page["title"] = "Set the response status"
        page["content"] = "## sig\n\nfunction response_status(code : s32, reason : string = \"\")\n\n`response_status` sets the status for the active response.\n\nIf `reason` is empty, Bearer uses the standard phrase for common HTTP status codes. Set the status before you write response output.\n"
        page["returns"] = "This function returns no value."
        page["label"] = "response_status"
        page["capy_sig_lines"] = dval(["function response_status(code : s32, reason : string = \"\")"])
        page["param_lines"] = dval(["code : The HTTP status code.", "reason : An optional reason phrase.", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_Request", "redirect", "response_cookie"])
        page["examples"] = dval([{entry: "render", caption: "", body: "response_status(200, \"OK\")\nprint(\"200\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "request" {
        var page := dval({source_page: ""})
        page["source_page"] = "0_Request"
        page["kind"] = "api"
        page["slug"] = "request"
        page["route"] = "/doc/api/request/"
        page["title"] = "Request snapshot"
        page["content"] = "## sig\n\nhandler request : dval\n\nEach Capy handler receives `request : dval`. This value is a request snapshot.\n\nThe snapshot can contain `method`, `query`, `form`, `headers`, `cookies`, `body`, `files`, `route`, `url`, `server`, `session`, `props`, `config`, `call`, `connection`, `unit`, and `websocket`.\n\nUse `string`, `s32`, or `bool` with a fallback to read scalar values. Use response, session, output, and WebSocket functions to change the active request.\n"
        page["label"] = "Request"
        page["capy_sig_lines"] = dval(["handler request : dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">1_RENDER", ">1_COMPONENT", ">1_CLI", ">1_WS"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(string(request.query.name, \"guest\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})

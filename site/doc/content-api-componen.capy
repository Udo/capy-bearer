#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "component-2" {
        var page := dval({source_page: ""})
        page["source_page"] = "component"
        page["kind"] = "api"
        page["slug"] = "component-2"
        page["route"] = "/doc/api/component-2/"
        page["title"] = "component"
        page["content"] = "## sig\n\nfunction component(name : string) string\nfunction component(name : string, props : as dval) string\n\n`component()` renders a component and returns its output as a string.\n\nUse it when a larger result needs a component fragment. `component_render()` writes output directly.\n\nBearer accepts a component path with or without the `.capy` suffix. A colon selects a named handler. A leading colon selects a handler in the current file.\n\nUse `component_exists()` before an optional component.\n"
        page["returns"] = "The component output."
        page["label"] = "component"
        page["capy_sig_lines"] = dval(["function component(name : string) string", "function component(name : string, props : as dval) string"])
        page["param_lines"] = dval(["name : a component name or named handler", "props : optional input for `request.props`", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["component_capture", "component_exists", "component_render", "component_resolve"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var props := {name: \"Capy\"}\nprint(component(\"/tests/capy-request-context.capy\", props), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "component-capture" {
        var page := dval({source_page: ""})
        page["source_page"] = "component_capture"
        page["kind"] = "api"
        page["slug"] = "component-capture"
        page["route"] = "/doc/api/component-capture/"
        page["title"] = "component_capture"
        page["content"] = "## sig\n\nfunction component_capture(name : string) string\nfunction component_capture(name : string, props : as dval) string\n\n`component_capture()` renders a component and returns its output as a string.\n\nUse it when a larger result needs a component fragment. The function uses normal component resolution rules.\n"
        page["returns"] = "The captured component output."
        page["label"] = "component_capture"
        page["capy_sig_lines"] = dval(["function component_capture(name : string) string", "function component_capture(name : string, props : as dval) string"])
        page["param_lines"] = dval(["name : a component name or named handler", "props : optional input for `request.props`", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["component", "component_render", "component_resolve"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var output := component_capture(\"/tests/capy-request-context.capy\", {name: \"Capy\"})\nprint(output, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "component-exists" {
        var page := dval({source_page: ""})
        page["source_page"] = "component_exists"
        page["kind"] = "api"
        page["slug"] = "component-exists"
        page["route"] = "/doc/api/component-exists/"
        page["title"] = "component_exists"
        page["content"] = "## sig\n\nfunction component_exists(name : string) bool\n\n`component_exists()` checks whether Bearer can resolve a component file.\n\nA named handler does not affect this check. Use this function before you render an optional component.\n"
        page["returns"] = "`true` if Bearer resolves the component file. Otherwise, `false`."
        page["label"] = "component_exists"
        page["capy_sig_lines"] = dval(["function component_exists(name : string) bool"])
        page["param_lines"] = dval(["name : a component path with an optional named handler", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["component", "component_render", "component_resolve"])
        page["examples"] = dval([{entry: "render", caption: "", body: "if component_exists(\"/tests/capy-request-context.capy\") { print(\"exists\\n\") } else { print(\"missing\\n\") }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "component-render" {
        var page := dval({source_page: ""})
        page["source_page"] = "component_render"
        page["kind"] = "api"
        page["slug"] = "component-render"
        page["route"] = "/doc/api/component-render/"
        page["title"] = "component_render"
        page["content"] = "## sig\n\nfunction component_render(name : string)\nfunction component_render(name : string, props : as dval)\n\n`component_render()` writes component output to the current response.\n\nUse `component()` or `component_capture()` when you need the output as a string. Bearer accepts a component path with or without `.capy`.\n\nA colon selects a named handler. A leading colon selects a handler in the current file. Use `component_exists()` before an optional component.\n"
        page["label"] = "component_render"
        page["capy_sig_lines"] = dval(["function component_render(name : string)", "function component_render(name : string, props : as dval)"])
        page["param_lines"] = dval(["name : a component name or named handler", "props : optional input for `request.props`", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["component", "component_capture", "component_exists", "component_resolve"])
        page["examples"] = dval([{entry: "render", caption: "", body: "component_render(\"/tests/capy-request-context.capy\", {name: \"Capy\"})\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "component-resolve" {
        var page := dval({source_page: ""})
        page["source_page"] = "component_resolve"
        page["kind"] = "api"
        page["slug"] = "component-resolve"
        page["route"] = "/doc/api/component-resolve/"
        page["title"] = "component_resolve"
        page["content"] = "## sig\n\nfunction component_resolve(name : string) string\n\n`component_resolve()` resolves a component name to its source path.\n\nA name without a suffix resolves to its `.capy` file. A named handler does not affect the returned path.\n"
        page["returns"] = "The resolved component source path."
        page["label"] = "component_resolve"
        page["capy_sig_lines"] = dval(["function component_resolve(name : string) string"])
        page["param_lines"] = dval(["name : a component path with an optional named handler", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["component", "component_exists", "component_render"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(component_resolve(\"/tests/capy-request-context\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "component" {
        var page := dval({source_page: ""})
        page["source_page"] = "1_COMPONENT"
        page["kind"] = "api"
        page["slug"] = "component"
        page["route"] = "/doc/api/component/"
        page["title"] = "COMPONENT"
        page["content"] = "## sig\n\nfunction COMPONENT(request : dval)\nfunction COMPONENT:NAME(request : dval)\n\n`COMPONENT` defines a component entrypoint. Use `COMPONENT:NAME` for a named component.\n\nThe handler has one parameter named `request` with type `dval`. Read component properties from `request.props`. Use `print` to write component output.\n"
        page["label"] = "COMPONENT"
        page["capy_sig_lines"] = dval(["function COMPONENT(request : dval)", "function COMPONENT:NAME(request : dval)"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_Request", "1_RENDER"])
        page["examples"] = dval([{entry: "component", caption: "", body: "print(string(request.props.name, \"guest\"))\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

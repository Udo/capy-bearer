#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "signal-name" {
        var page := dval({source_page: ""})
        page["source_page"] = "signal_name"
        page["kind"] = "api"
        page["slug"] = "signal-name"
        page["route"] = "/doc/api/signal-name/"
        page["title"] = "signal_name"
        page["content"] = "Use `signal_name` to get the POSIX name for a signal number. It returns an empty string for an unknown number.\n"
        page["returns"] = "Signal name, or an empty string."
        page["label"] = "signal_name"
        page["capy_sig_lines"] = dval(["function signal_name(signal : s32) string"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(signal_name(11), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

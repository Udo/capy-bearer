#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-pread" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_pread"
        page["kind"] = "api"
        page["slug"] = "file-pread"
        page["route"] = "/doc/api/file-pread/"
        page["title"] = "file_pread"
        page["content"] = "## sig\n\nfunction file_pread(handle : u64, offset : u64, length : u64) string\n\n`file_pread` reads at an absolute byte offset. It does not change the handle position.\n"
        page["returns"] = "A string with up to `length` bytes."
        page["label"] = "file_pread"
        page["capy_sig_lines"] = dval(["function file_pread(handle : u64, offset : u64, length : u64) string"])
        page["param_lines"] = dval(["handle : readable handle returned by `file_open`", "offset : absolute byte offset", "length : maximum number of bytes to read", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "file_read", "file_pwrite", "file_open"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var writer := file_open(\"/tmp/doc-pread.txt\", \"w\")\nfile_write(writer, \"hello world\")\nfile_close(writer)\nvar reader := file_open(\"/tmp/doc-pread.txt\", \"r\")\nprint(file_pread(reader, u64(6), u64(5)), \"\\n\")\nfile_close(reader)\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

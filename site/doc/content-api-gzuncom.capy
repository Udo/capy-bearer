#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "gz-uncompress" {
        var page := dval({source_page: ""})
        page["source_page"] = "gz_uncompress"
        page["kind"] = "api"
        page["slug"] = "gz-uncompress"
        page["route"] = "/doc/api/gz-uncompress/"
        page["title"] = "gz_uncompress"
        page["content"] = "`gz_uncompress()` uncompresses gzip data from a string.\n\nUse it with data from `gz_compress()`.\n"
        page["returns"] = "Uncompressed bytes as a string."
        page["label"] = "gz_uncompress"
        page["capy_sig_lines"] = dval(["function gz_uncompress(source : string) string"])
        page["param_lines"] = dval(["source : gzip-compressed bytes", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "gz_compress", href: "/doc/api/gz-compress/"}, {label: "zip_read", href: "/doc/api/zip-read/"}, {label: "zip_extract", href: "/doc/api/zip-extract/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "var packed := gz_compress(\"archive data\")\nvar source := gz_uncompress(packed)\nprint(source, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

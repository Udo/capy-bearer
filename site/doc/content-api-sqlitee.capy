#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "sqlite-error" {
        var page := dval({source_page: ""})
        page["source_page"] = "sqlite_error"
        page["kind"] = "api"
        page["slug"] = "sqlite-error"
        page["route"] = "/doc/api/sqlite-error/"
        page["title"] = "sqlite_error"
        page["content"] = "## sig\n\nfunction sqlite_error(handle : u64) string\n\nUse `sqlite_error` after a SQLite operation when you need its diagnostic text.\n"
        page["returns"] = "Latest SQLite error text."
        page["label"] = "sqlite_error"
        page["capy_sig_lines"] = dval(["function sqlite_error(handle : u64) string"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var db := sqlite_connect(\":memory:\")\nsqlite_query(db, \"select * from missing_table\")\nprint(sqlite_error(db), \"\\n\")\nsqlite_disconnect(db)\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

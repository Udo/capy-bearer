#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "sqlite-error" {
        var page := dval({source_page: ""})
        page["source_page"] = "sqlite_error"
        page["kind"] = "api"
        page["slug"] = "sqlite-error"
        page["route"] = "/doc/api/sqlite-error/"
        page["title"] = "sqlite_error"
        page["content"] = "Capy `sqlite_error(db)` returns the latest SQLite status or error message for a handle. Give it a handle from `sqlite_connect()`.\n\nCall it after `sqlite_connect()` or `sqlite_query()` when you need error text. A failed operation sets an error message. The C++ API uses an `SQLite*` pointer. Capy uses a `u64` handle.\n"
        page["returns"] = "latest SQLite status or error message"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "sqlite_error"
        page["sig_lines"] = dval(["String sqlite_error(SQLite* db)", ""])
        page["capy_sig_lines"] = dval(["function sqlite_error(handle : u64) string"])
        page["param_lines"] = dval(["db : SQLite handle from `sqlite_connect()`", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sqlite", "sqlite_query", "sqlite_disconnect", "sqlite_connect", "sqlite_insert_id", "sqlite_affected_rows"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

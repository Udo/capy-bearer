#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "str-starts-with" {
        var page := dval({source_page: ""})
        page["source_page"] = "str_starts_with"
        page["kind"] = "api"
        page["slug"] = "str-starts-with"
        page["route"] = "/doc/api/str-starts-with/"
        page["title"] = "str_starts_with"
        page["content"] = "Use `str_starts_with` to test a string prefix.\n"
        page["returns"] = "`true` when the text starts with the prefix."
        page["label"] = "str_starts_with"
        page["capy_sig_lines"] = dval(["function str_starts_with(haystack : string, needle : string) bool"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(str_starts_with(\"/doc\", \"/\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

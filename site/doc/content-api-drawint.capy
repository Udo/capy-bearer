#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "draw-int" {
        var page := dval({source_page: ""})
        page["source_page"] = "draw_int"
        page["kind"] = "api"
        page["slug"] = "draw-int"
        page["route"] = "/doc/api/draw-int/"
        page["title"] = "draw_int"
        page["content"] = "`draw_int()` returns the next integer value from the request random sequence.\n\nBearer uses the request random seed and advances the random index after each call.\n"
        page["returns"] = "A `u64` value between the range values."
        page["label"] = "draw_int"
        page["capy_sig_lines"] = dval(["function draw_int(from : u64, to : u64) u64"])
        page["param_lines"] = dval(["from : the first range value", "to : the second range value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "draw_float", href: "/doc/api/draw-float/"}, {label: "gen_int", href: "/doc/api/gen-int/"}, {label: "gen_noise32", href: "/doc/api/gen-noise32/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "var value := draw_int(u64(1), u64(10))\nprint(value >= u64(1), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

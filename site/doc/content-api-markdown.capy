#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "markdown-to-ast" {
        var page := dval({source_page: ""})
        page["source_page"] = "markdown_to_ast"
        page["kind"] = "api"
        page["slug"] = "markdown-to-ast"
        page["route"] = "/doc/api/markdown-to-ast/"
        page["title"] = "markdown_to_ast"
        page["content"] = "This function parses Markdown text into a `dval` document tree.\n\nThe root is a map-shaped document node. Its `children` field is a list-shaped value. The parser stores component data but does not call component hooks during parsing.\n\nBy default, the parser supports GitHub-flavored headings, paragraphs, blockquotes, lists, task items, code blocks, and tables.\n\nIt also supports rules, emphasis, links, images, autolinks, code spans, and `:::` directive blocks.\n\nEach node has a `type` field and node-specific fields. Common fields include `level`, `text`, `lang`, `href`, `src`, `name`, `argument`, `attrs`, and `children`.\n\nCommon block types are `heading`, `paragraph`, `blockquote`, `list`, `list_item`, `code_block`, `table`, `directive`, and `hr`. Common inline types are `text`, `code`, `strong`, `em`, `strike`, `link`, `image`, and `raw_html`.\n\nOptions:\n\n- `options[\"gfm\"]` enables tables, task lists, strikethrough, and bare URL autolinks. The default is `true`.\n- `options[\"allow_html\"]` captures raw HTML nodes for later output. The default is `false`.\n- `options[\"components\"]` stores hooks for `markdown_to_html()`.\n"
        page["returns"] = "`dval` document tree"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "markdown_to_ast"
        page["sig_lines"] = dval(["DValue markdown_to_ast(String src)", "DValue markdown_to_ast(String src, DValue options)", ""])
        page["capy_sig_lines"] = dval(["function markdown_to_ast(source : string) dval", "function markdown_to_ast(source : string, options : dval) dval"])
        page["param_lines"] = dval(["src : Markdown text", "options : optional `dval` options", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">markup", "markdown_to_html", "component", "component_render", "json_encode", "0_DValue"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "markdown-to-html" {
        var page := dval({source_page: ""})
        page["source_page"] = "markdown_to_html"
        page["kind"] = "api"
        page["slug"] = "markdown-to-html"
        page["route"] = "/doc/api/markdown-to-html/"
        page["title"] = "markdown_to_html"
        page["content"] = "This function renders Markdown text as HTML.\n\nUse it to render trusted Markdown in a response. When `allow_html` is true, it outputs stored raw HTML without escaping it.\n\nComponent hooks need an active request context. Without one, the function uses default HTML. Capy cannot pass a previously returned AST to this function.\n\nThe C++ API has the same source-text rendering model.\n"
        page["returns"] = "HTML text"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "markdown_to_html"
        page["sig_lines"] = dval(["String markdown_to_html(String src)", "String markdown_to_html(String src, DValue options)", ""])
        page["capy_sig_lines"] = dval(["function markdown_to_html(source : string) string", "function markdown_to_html(source : string, options : dval) string"])
        page["param_lines"] = dval(["src : Markdown text", "options : optional `dval` options", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">markup", "markdown_to_ast", "component", "component_render", "json_decode", "0_String"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

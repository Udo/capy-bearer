#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "markdown-to-ast" {
        var page := dval({source_page: ""})
        page["source_page"] = "markdown_to_ast"
        page["kind"] = "api"
        page["slug"] = "markdown-to-ast"
        page["route"] = "/doc/api/markdown-to-ast/"
        page["title"] = "markdown_to_ast"
        page["content"] = "## sig\n\nfunction markdown_to_ast(source : string) dval\nfunction markdown_to_ast(source : string, options : dval) dval\n\n`markdown_to_ast()` parses Markdown into a `dval` document tree.\n\nThe root node contains a `children` list. Nodes contain a `type` field and fields for their content. The default options support GitHub-flavored Markdown.\n\nSet `gfm` to control GitHub-flavored extensions. Set `allow_html` to retain raw HTML nodes.\n"
        page["returns"] = "the Markdown document tree"
        page["label"] = "markdown_to_ast"
        page["capy_sig_lines"] = dval(["function markdown_to_ast(source : string) dval", "function markdown_to_ast(source : string, options : dval) dval"])
        page["param_lines"] = dval(["source : the Markdown source text", "options : parser options", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">markup", "markdown_to_html", "json_encode"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var document := markdown_to_ast(\"# Title\")\nprint(document[\"type\"], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "markdown-to-html" {
        var page := dval({source_page: ""})
        page["source_page"] = "markdown_to_html"
        page["kind"] = "api"
        page["slug"] = "markdown-to-html"
        page["route"] = "/doc/api/markdown-to-html/"
        page["title"] = "markdown_to_html"
        page["content"] = "## sig\n\nfunction markdown_to_html(source : string) string\nfunction markdown_to_html(source : string, options : dval) string\n\n`markdown_to_html()` renders Markdown source as HTML.\n\nRaw HTML stays escaped unless `options[\"allow_html\"]` is true. Only enable it for trusted source.\n"
        page["returns"] = "the HTML text"
        page["label"] = "markdown_to_html"
        page["capy_sig_lines"] = dval(["function markdown_to_html(source : string) string", "function markdown_to_html(source : string, options : dval) string"])
        page["param_lines"] = dval(["source : the Markdown source text", "options : render options", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">markup", "markdown_to_ast"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(markdown_to_html(\"**bold**\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

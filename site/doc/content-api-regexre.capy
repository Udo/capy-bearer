#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "regex-replace" {
        var page := dval({source_page: ""})
        page["source_page"] = "regex_replace"
        page["kind"] = "api"
        page["slug"] = "regex-replace"
        page["route"] = "/doc/api/regex-replace/"
        page["title"] = "regex_replace"
        page["content"] = "`regex_replace()` replaces every `pattern` match in `subject` and returns a new `string`.\n\nThe replacement uses PCRE2 substitution syntax. Use `$1` for a numbered capture. Use `${name}` for a named capture.\n\nUse `replace()` for a literal search. Use `regex_replace()` when you need a pattern, capture, character class, anchor, or flag.\n"
        page["returns"] = "a new string with all matches replaced"
        page["errors"] = "Invalid patterns, flags, and replacement syntax cause a request-visible runtime error."
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "regex_replace"
        page["sig_lines"] = dval(["String regex_replace(String pattern, String replacement, String subject)", "String regex_replace(String pattern, String replacement, String subject, String flags)", ""])
        page["capy_sig_lines"] = dval(["function regex_replace(pattern : string, replacement : string, subject : string, flags : string = \"\") string"])
        page["param_lines"] = dval(["pattern : the PCRE2 regular expression", "replacement : the replacement text", "subject : the string to change", "flags : optional regular expression flags", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">string", ">regex", "regex_match", "regex_search", "regex_search_all", "regex_split", "replace"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

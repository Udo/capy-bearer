#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "yaml-encode" {
        var page := dval({source_page: ""})
        page["source_page"] = "yaml_encode"
        page["kind"] = "api"
        page["slug"] = "yaml-encode"
        page["route"] = "/doc/api/yaml-encode/"
        page["title"] = "yaml_encode"
        page["content"] = "`yaml_encode()` encodes a `dval` as YAML.\n"
        page["returns"] = "The YAML source."
        page["label"] = "yaml_encode"
        page["capy_sig_lines"] = dval(["function yaml_encode(value : dval) string"])
        page["param_lines"] = dval(["value : value to encode", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "yaml_decode", href: "/doc/api/yaml-decode/"}, {label: "json_encode", href: "/doc/api/json-encode/"}, {label: "dvalue", href: "/doc/type/dvalue/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(yaml_encode(dval({name: \"Ada\"})))\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

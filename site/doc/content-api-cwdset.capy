#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "cwd-set" {
        var page := dval({source_page: ""})
        page["source_page"] = "cwd_set"
        page["kind"] = "api"
        page["slug"] = "cwd-set"
        page["route"] = "/doc/api/cwd-set/"
        page["title"] = "cwd_set"
        page["content"] = "## sig\n\nfunction cwd_set(path : string)\n\n`cwd_set()` changes the worker process working directory.\n\nSave the current directory with `cwd_get()`. Restore it after temporary use.\n"
        page["label"] = "cwd_set"
        page["capy_sig_lines"] = dval(["function cwd_set(path : string)"])
        page["param_lines"] = dval(["path : the new working directory path", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["cwd_get"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var old_path := cwd_get()\ncwd_set(\"/tmp\")\nprint(cwd_get(), \"\\n\")\ncwd_set(old_path)\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

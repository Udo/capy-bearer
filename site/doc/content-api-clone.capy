#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "clone" {
        var page := dval({source_page: ""})
        page["source_page"] = "clone"
        page["kind"] = "api"
        page["slug"] = "clone"
        page["route"] = "/doc/api/clone/"
        page["title"] = "clone"
        page["content"] = "## sig\n\nfunction clone(value : string) string\n\n`clone()` copies a string.\n\nMost Capy code does not need an explicit copy. Use `clone()` when a fresh string value is required.\n"
        page["returns"] = "A separate string copy."
        page["label"] = "clone"
        page["capy_sig_lines"] = dval(["function clone(value : string) string"])
        page["param_lines"] = dval(["value : a source string", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">0_String", "length"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var source := \"token\"\nvar copy := clone(source)\nprint(length(source), \" \", length(copy), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "time-format-local" {
        var page := dval({source_page: ""})
        page["source_page"] = "time_format_local"
        page["kind"] = "api"
        page["slug"] = "time-format-local"
        page["route"] = "/doc/api/time-format-local/"
        page["title"] = "time_format_local"
        page["content"] = "`time_format_local` formats a Unix timestamp in the server local time zone.\n"
        page["returns"] = "formatted local time"
        page["label"] = "time_format_local"
        page["capy_sig_lines"] = dval(["function time_format_local(format : string = \"\", timestamp : u64 = 0) string"])
        page["param_lines"] = dval(["format : date format", "timestamp : Unix timestamp. Zero uses the current time", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">time", ">time_format_relative", "time", "time_format_relative", "time_precise", "time_format_utc", "usleep", "time_parse"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(time_format_local(\"%Y\", u64(5)), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "time-format-relative" {
        var page := dval({source_page: ""})
        page["source_page"] = "time_format_relative"
        page["kind"] = "api"
        page["slug"] = "time-format-relative"
        page["route"] = "/doc/api/time-format-relative/"
        page["title"] = "time_format_relative"
        page["content"] = "`time_format_relative` formats a timestamp relative to the current time.\n"
        page["returns"] = "formatted relative time"
        page["label"] = "time_format_relative"
        page["capy_sig_lines"] = dval(["function time_format_relative(timestamp : u64, very_recent : string = \"\", medium_seconds : u64 = 0, medium_recent : string = \"\", not_recent_seconds : u64 = 0, not_recent : string = \"\") string"])
        page["param_lines"] = dval(["timestamp : Unix timestamp", "very_recent : text for very recent timestamps", "medium_seconds : very recent cutoff in seconds", "medium_recent : text after the very recent cutoff", "not_recent_seconds : medium recent cutoff in seconds", "not_recent : text after the medium recent cutoff", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">time", ">time_format_local", ">time_format_utc", "time_format_local", "time_format_utc", "time", "time_parse", "time_precise", "usleep"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(time_format_relative(time()), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "time-format-utc" {
        var page := dval({source_page: ""})
        page["source_page"] = "time_format_utc"
        page["kind"] = "api"
        page["slug"] = "time-format-utc"
        page["route"] = "/doc/api/time-format-utc/"
        page["title"] = "time_format_utc"
        page["content"] = "`time_format_utc` formats a Unix timestamp in UTC.\n"
        page["returns"] = "formatted UTC time"
        page["label"] = "time_format_utc"
        page["capy_sig_lines"] = dval(["function time_format_utc(format : string = \"\", timestamp : u64 = 0) string"])
        page["param_lines"] = dval(["format : date format", "timestamp : Unix timestamp. Zero uses the current time", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">time", ">time_format_relative", "time_format_relative", "time_parse", "time_format_local", "time", "time_precise", "usleep"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(time_format_utc(\"%Y\", u64(5)), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-get-by-path" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_get_by_path"
        page["kind"] = "api"
        page["slug"] = "dvalue-get-by-path"
        page["route"] = "/doc/api/dvalue-get-by-path/"
        page["title"] = "Get a child by path"
        page["content"] = "## sig\n\nfunction dval_get_by_path(value : dval, path : string) dval\n\n`dval_get_by_path` reads a nested child without creating nodes. Use a slash between path segments.\n"
        page["returns"] = "The copied child, or an empty string value when the path fails."
        page["label"] = "dval_get_by_path"
        page["capy_sig_lines"] = dval(["function dval_get_by_path(value : dval, path : string) dval"])
        page["param_lines"] = dval(["value : source value", "path : slash-separated child path", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var config := dval({\"site\": {\"title\": \"Bearer\"}})\nprint(dval_get_by_path(config, \"site/title\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-get-or-create" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_get_or_create"
        page["kind"] = "api"
        page["slug"] = "dvalue-get-or-create"
        page["route"] = "/doc/api/dvalue-get-or-create/"
        page["title"] = "Get or create a child"
        page["content"] = "## sig\n\nfunction dval_get_or_create(value : dval, key : string) dval\n\n`dval_get_or_create` creates an empty child when `key` is missing. It changes and returns `value`.\n"
        page["returns"] = "The target value."
        page["label"] = "dval_get_or_create"
        page["capy_sig_lines"] = dval(["function dval_get_or_create(value : dval, key : string) dval"])
        page["param_lines"] = dval(["value : target value", "key : child key", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var config := dval({:})\nconfig = dval_get_or_create(config, \"host\")\nconfig = dval_put(config, \"host\", \"localhost\")\nprint(config.host, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-get-type-name" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_get_type_name"
        page["kind"] = "api"
        page["slug"] = "dvalue-get-type-name"
        page["route"] = "/doc/api/dvalue-get-type-name/"
        page["title"] = "Get a dynamic value type name"
        page["content"] = "## sig\n\nfunction dval_get_type_name(value : dval) string\n\n`dval_get_type_name` returns the runtime type name for a dynamic value.\n"
        page["returns"] = "The type name."
        page["label"] = "dval_get_type_name"
        page["capy_sig_lines"] = dval(["function dval_get_type_name(value : dval) string"])
        page["param_lines"] = dval(["value : value to inspect", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(dval_get_type_name(dval(\"text\")), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

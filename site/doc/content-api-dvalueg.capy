        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-get-type-name" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_get_type_name"
        page["kind"] = "api"
        page["slug"] = "dvalue-get-type-name"
        page["route"] = "/doc/api/dvalue-get-type-name/"
        page["title"] = "DValue::get_type_name"
        page["content"] = "Use `dval_get_type_name(value)` in Capy to get a DValue type name. It takes one value and returns a string. Normal results are `String`, `f64`, `bool`, `array`, `none`, `pointer`, `reference`, or `unknown`.\n\nC++ `get_type_name()` gets the name after it dereferences the value.\n\n"
        page["returns"] = "one of String, f64, bool, array, none, pointer, reference, or unknown"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "DValue::get_type_name"
        page["sig_lines"] = dval(["String DValue::get_type_name() const", ""])

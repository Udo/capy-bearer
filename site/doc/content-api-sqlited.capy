#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "sqlite-disconnect" {
        var page := dval({source_page: ""})
        page["source_page"] = "sqlite_disconnect"
        page["kind"] = "api"
        page["slug"] = "sqlite-disconnect"
        page["route"] = "/doc/api/sqlite-disconnect/"
        page["title"] = "sqlite_disconnect"
        page["content"] = "## sig\n\nfunction sqlite_disconnect(handle : u64)\n\nUse `sqlite_disconnect` to close an SQLite connection. Do not use the handle after this call.\n"
        page["label"] = "sqlite_disconnect"
        page["capy_sig_lines"] = dval(["function sqlite_disconnect(handle : u64)"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var db := sqlite_connect(\":memory:\")\nif db != 0 { sqlite_disconnect(db) }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

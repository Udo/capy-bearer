#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "session-destroy" {
        var page := dval({source_page: ""})
        page["source_page"] = "session_destroy"
        page["kind"] = "api"
        page["slug"] = "session-destroy"
        page["route"] = "/doc/api/session-destroy/"
        page["title"] = "session_destroy"
        page["content"] = "`session_destroy()` expires the named session cookie and removes its server-side data.\n"
        page["returns"] = "The resulting session state."
        page["label"] = "session_destroy"
        page["capy_sig_lines"] = dval(["function session_destroy(name : string = \"bearer-session\") dval"])
        page["param_lines"] = dval(["name : session cookie name", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var session := session_destroy(\"docs-session\")\nprint(string(session.id, \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "session-id-create" {
        var page := dval({source_page: ""})
        page["source_page"] = "session_id_create"
        page["kind"] = "api"
        page["slug"] = "session-id-create"
        page["route"] = "/doc/api/session-id-create/"
        page["title"] = "session_id_create"
        page["content"] = "Use `session_id_create()` when you need an ID without starting a session.\n"
        page["returns"] = "A new session ID."
        page["label"] = "session_id_create"
        page["capy_sig_lines"] = dval(["function session_id_create() string"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(length(session_id_create()), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "session-remove" {
        var page := dval({source_page: ""})
        page["source_page"] = "session_remove"
        page["kind"] = "api"
        page["slug"] = "session-remove"
        page["route"] = "/doc/api/session-remove/"
        page["title"] = "session_remove"
        page["content"] = "Call `session_start()` before you remove a session field.\n"
        page["returns"] = "The updated session state."
        page["label"] = "session_remove"
        page["capy_sig_lines"] = dval(["function session_remove(key : string) dval"])
        page["param_lines"] = dval(["key : session field name", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var session := session_start(\"docs-session\")\nsession = session_remove(\"theme\")\nprint(string(session.name, \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "session-set" {
        var page := dval({source_page: ""})
        page["source_page"] = "session_set"
        page["kind"] = "api"
        page["slug"] = "session-set"
        page["route"] = "/doc/api/session-set/"
        page["title"] = "session_set"
        page["content"] = "Call `session_start()` before you store a session field.\n"
        page["returns"] = "The updated session state."
        page["label"] = "session_set"
        page["capy_sig_lines"] = dval(["function session_set(key : string, value : string) dval"])
        page["param_lines"] = dval(["key : session field name", "value : value to store", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var session := session_start(\"docs-session\")\nsession = session_set(\"theme\", \"dark\")\nprint(string(session.values.theme, \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "session-start" {
        var page := dval({source_page: ""})
        page["source_page"] = "session_start"
        page["kind"] = "api"
        page["slug"] = "session-start"
        page["route"] = "/doc/api/session-start/"
        page["title"] = "session_start"
        page["content"] = "`session_start()` restores the named session or creates one.\n"
        page["returns"] = "The current session state."
        page["label"] = "session_start"
        page["capy_sig_lines"] = dval(["function session_start(name : string = \"bearer-session\") dval"])
        page["param_lines"] = dval(["name : session cookie name", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var session := session_start(\"docs-session\")\nprint(string(session.id, \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

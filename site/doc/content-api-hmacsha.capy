#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "hmac-sha256-hex" {
        var page := dval({source_page: ""})
        page["source_page"] = "hmac_sha256_hex"
        page["kind"] = "api"
        page["slug"] = "hmac-sha256-hex"
        page["route"] = "/doc/api/hmac-sha256-hex/"
        page["title"] = "hmac_sha256_hex"
        page["content"] = "`hmac_sha256_hex()` returns an HMAC-SHA256 value as hexadecimal text. Use `crypto_equal()` to compare received signatures.\n"
        page["returns"] = "A 64-character lowercase hexadecimal HMAC-SHA256 value."
        page["label"] = "hmac_sha256_hex"
        page["capy_sig_lines"] = dval(["function hmac_sha256_hex(key : string, value : string) string"])
        page["param_lines"] = dval(["key : secret key bytes", "value : message bytes", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["hmac_sha256", "sha256_hex", "crypto_equal"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(hmac_sha256_hex(\"key\", \"message\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "hmac-sha256" {
        var page := dval({source_page: ""})
        page["source_page"] = "hmac_sha256"
        page["kind"] = "api"
        page["slug"] = "hmac-sha256"
        page["route"] = "/doc/api/hmac-sha256/"
        page["title"] = "hmac_sha256"
        page["content"] = "`hmac_sha256()` returns a raw binary HMAC-SHA256 value. Use `hmac_sha256_hex()` when you need hexadecimal text.\n"
        page["returns"] = "A raw 32-byte HMAC-SHA256 value."
        page["label"] = "hmac_sha256"
        page["capy_sig_lines"] = dval(["function hmac_sha256(key : string, value : string) string"])
        page["param_lines"] = dval(["key : secret key bytes", "value : message bytes", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["hmac_sha256_hex", "sha256", "crypto_equal"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(length(hmac_sha256(\"key\", \"message\")), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "filter" {
        var page := dval({source_page: ""})
        page["source_page"] = "filter"
        page["kind"] = "api"
        page["slug"] = "filter"
        page["route"] = "/doc/api/filter/"
        page["title"] = "filter"
        page["content"] = "`filter` calls `predicate` for each value. It keeps values for which the predicate returns `true`.\n"
        page["returns"] = "A new list of selected values."
        page["label"] = "filter"
        page["capy_sig_lines"] = dval(["function filter(items : dval, predicate : function(value : string) bool) dval"])
        page["param_lines"] = dval(["items : list of values", "predicate : function that selects a value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var names := split(\"ada,bob,amy\", \",\")\nvar selected := filter(names, function(value : string) bool { return str_starts_with(value, \"a\") })\nprint(join(selected, \",\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

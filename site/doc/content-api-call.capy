#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "call" {
        var page := dval({source_page: ""})
        page["source_page"] = "call"
        page["kind"] = "api"
        page["slug"] = "call"
        page["route"] = "/doc/api/call/"
        page["title"] = "call"
        page["content"] = "`call()` calls an exported function in a loaded unit. It returns the result as `dval`.\n\nUse `unit_load()` once when several calls use the same unit. The two-argument form passes an empty `dval`.\n"
        page["returns"] = "The exported function result."
        page["label"] = "call"
        page["capy_sig_lines"] = dval(["function call(handle : module, name : string) dval", "function call(handle : module, name : string, input : as dval) dval"])
        page["param_lines"] = dval(["handle : a value from `unit_load()`", "name : an exported function name", "input : optional `dval` input", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["unit_load", "unit_call", "component_capture"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var handle := unit_load(\"/doc/examples/call_target.capy\")\nvar result := call(handle, \"echo\", {name: \"Ada\"})\nprint(string(result.name), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "draw-float" {
        var page := dval({source_page: ""})
        page["source_page"] = "draw_float"
        page["kind"] = "api"
        page["slug"] = "draw-float"
        page["route"] = "/doc/api/draw-float/"
        page["title"] = "draw_float"
        page["content"] = "## sig\n\nfunction draw_float(from : f64, to : f64, precision : f64 = 0.000000000001) f64\n\n`draw_float()` returns the next floating-point value from the request random sequence.\n\nBearer uses the request random seed and advances the random index after each call.\n"
        page["returns"] = "An `f64` value between the range values."
        page["label"] = "draw_float"
        page["capy_sig_lines"] = dval(["function draw_float(from : f64, to : f64, precision : f64 = 0.000000000001) f64"])
        page["param_lines"] = dval(["from : the first range value", "to : the second range value", "precision : the output precision", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["draw_int", "gen_float", "gen_noise01"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var value := draw_float(0.0, 1.0)\nprint(value >= 0.0, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "trim" {
        var page := dval({source_page: ""})
        page["source_page"] = "trim"
        page["kind"] = "api"
        page["slug"] = "trim"
        page["route"] = "/doc/api/trim/"
        page["title"] = "trim"
        page["content"] = "## sig\n\nfunction trim(raw : string) string\n\n`trim` removes leading and trailing whitespace.\n"
        page["returns"] = "text without leading or trailing whitespace"
        page["label"] = "trim"
        page["capy_sig_lines"] = dval(["function trim(raw : string) string"])
        page["param_lines"] = dval(["raw : text to trim", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">string", "to_upper", "float_val", "to_lower", "int_val", "regex_split", "html_escape"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(trim(\"  docs  \"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

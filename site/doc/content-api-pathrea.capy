#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "path-real" {
        var page := dval({source_page: ""})
        page["source_page"] = "path_real"
        page["kind"] = "api"
        page["slug"] = "path-real"
        page["route"] = "/doc/api/path-real/"
        page["title"] = "path_real"
        page["content"] = "## sig\n\nfunction path_real(path : string) string\n\n`path_real()` returns the canonical absolute path for an existing path.\n\nIt follows symbolic links and removes dot segments. It returns an empty string when it cannot resolve the path.\n"
        page["returns"] = "the canonical absolute path, or an empty string on failure"
        page["label"] = "path_real"
        page["capy_sig_lines"] = dval(["function path_real(path : string) string"])
        page["param_lines"] = dval(["path : the path to resolve", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "path_is_within", "path_join"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(path_real(\"/tmp\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "csrf-rotate" {
        var page := dval({source_page: ""})
        page["source_page"] = "csrf_rotate"
        page["kind"] = "api"
        page["slug"] = "csrf-rotate"
        page["route"] = "/doc/api/csrf-rotate/"
        page["title"] = "csrf_rotate"
        page["content"] = "`csrf_rotate()` removes the active CSRF token from a token namespace.\n\nThe next `csrf_token()` call creates a replacement token. Use it after a sensitive successful change.\n"
        page["label"] = "csrf_rotate"
        page["capy_sig_lines"] = dval(["function csrf_rotate(session_name : string = \"bearer-session\", token_name : string = \"csrf_token\")"])
        page["param_lines"] = dval(["session_name : the session and cookie name", "token_name : the token namespace to clear", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "csrf_token", href: "/doc/api/csrf-token/"}, {label: "csrf_valid", href: "/doc/api/csrf-valid/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "var old_token := csrf_token(\"capy-doc-session\")\ncsrf_rotate(\"capy-doc-session\")\nvar new_token := csrf_token(\"capy-doc-session\")\nprint(old_token != new_token, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

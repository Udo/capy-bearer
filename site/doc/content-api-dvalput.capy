#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dval-put" {
        var page := dval({source_page: ""})
        page["source_page"] = "dval_put"
        page["kind"] = "api"
        page["slug"] = "dval-put"
        page["route"] = "/doc/api/dval-put/"
        page["title"] = "dval_put"
        page["content"] = "## sig\n\nfunction dval_put(value : dval, key : string, child : as dval) dval\n\n`dval_put()` stores `child` at `value[key]` and returns `value`.\n\nIf needed, it creates a map shape before it stores the key.\n"
        page["returns"] = "The same `dval` as `value`."
        page["label"] = "dval_put"
        page["capy_sig_lines"] = dval(["function dval_put(value : dval, key : string, child : as dval) dval"])
        page["param_lines"] = dval(["value : the target `dval`", "key : the child key to set", "child : the replacement child", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">0_DValue", "dval_set", "dval_remove", "dval_get_or_create"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var user := {:}\nuser = dval_put(user, \"active\", true)\nprint(bool(user.active), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

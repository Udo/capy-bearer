#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "job-result" {
        var page := dval({source_page: ""})
        page["source_page"] = "job_result"
        page["kind"] = "api"
        page["slug"] = "job-result"
        page["route"] = "/doc/api/job-result/"
        page["title"] = "job_result"
        page["content"] = "`job_result()` checks a job with a short bounded wait. Use it to poll a job after `shell_spawn()` or `http_request_async()`.\n"
        page["returns"] = "A job status map. A completed job includes `result`."
        page["label"] = "job_result"
        page["capy_sig_lines"] = dval(["function job_result(job : dval) dval"])
        page["param_lines"] = dval(["job : a job ID as `dval`", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["job_status", "job_await", "job_cancel"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var job := shell_spawn(dval({\"cmd\": \"printf result\", \"timeout_ms\": 1000}))\njob_await(job, 3000)\nprint(dval_get_by_path(job_result(job), \"result/stdout\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

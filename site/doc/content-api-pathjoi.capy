#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "path-join" {
        var page := dval({source_page: ""})
        page["source_page"] = "path_join"
        page["kind"] = "api"
        page["slug"] = "path-join"
        page["route"] = "/doc/api/path-join/"
        page["title"] = "path_join"
        page["content"] = "`path_join()` joins `base` and `child` with one slash when needed.\n\nAn absolute `child` replaces `base`. This function does not resolve dot segments.\n"
        page["returns"] = "the joined path"
        page["label"] = "path_join"
        page["capy_sig_lines"] = dval(["function path_join(base : string, child : string) string"])
        page["param_lines"] = dval(["base : the base path", "child : the path to append", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "path_real", "path_is_within"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(path_join(\"/var/www\", \"site/index.capy\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

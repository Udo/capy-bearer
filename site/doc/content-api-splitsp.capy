#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "split-space" {
        var page := dval({source_page: ""})
        page["source_page"] = "split_space"
        page["kind"] = "api"
        page["slug"] = "split-space"
        page["route"] = "/doc/api/split-space/"
        page["title"] = "split_space"
        page["content"] = "## sig\n\nfunction split_space(value : string) dval\n\nUse `split_space` to separate text at whitespace.\n"
        page["returns"] = "List-shaped `dval`."
        page["label"] = "split_space"
        page["capy_sig_lines"] = dval(["function split_space(value : string) dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(join(split_space(\"one  two\"), \",\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

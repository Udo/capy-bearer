#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-has" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_has"
        page["kind"] = "api"
        page["slug"] = "dvalue-has"
        page["route"] = "/doc/api/dvalue-has/"
        page["title"] = "DValue::has"
        page["content"] = "Use `dval_has(value, key)` in Capy to test a DValue key. It returns `true` when the value is map-shaped and contains the key. It does not create a child. It returns `false` for scalars and missing keys.\n\nC++ `has(key)` applies the same test after it dereferences the value.\n"
        page["returns"] = "true when the dereferenced value is map-shaped and contains the key"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "DValue::has"
        page["sig_lines"] = dval(["bool DValue::has(String s) const", ""])
        page["capy_sig_lines"] = dval(["dval_has(value : dval, key : string) bool"])
        page["param_lines"] = dval(["s : child key to test", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">types", "0_DValue", "2_DValue_key", "2_DValue_get_by_path"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

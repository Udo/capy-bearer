#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-has" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_has"
        page["kind"] = "api"
        page["slug"] = "dvalue-has"
        page["route"] = "/doc/api/dvalue-has/"
        page["title"] = "Test for a child"
        page["content"] = "## sig\n\ndval_has(value : dval, key : string) bool\n\n`dval_has` tests for a child without creating it. It returns `false` for a missing key or a scalar.\n"
        page["returns"] = "`true` when the key exists."
        page["label"] = "dval_has"
        page["capy_sig_lines"] = dval(["dval_has(value : dval, key : string) bool"])
        page["param_lines"] = dval(["value : value to test", "key : child key", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var user := dval({\"name\": \"Ada\"})\nprint(dval_has(user, \"name\"), \" \", dval_has(user, \"age\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "mkdir" {
        var page := dval({source_page: ""})
        page["source_page"] = "mkdir"
        page["kind"] = "api"
        page["slug"] = "mkdir"
        page["route"] = "/doc/api/mkdir/"
        page["title"] = "mkdir"
        page["content"] = "This function creates one directory at `path`.\n\nUse it when the parent directory already exists. It does not create missing parent directories. The C++ API has the same behavior.\n"
        page["returns"] = "`true` if the API creates the directory"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "mkdir"
        page["sig_lines"] = dval(["bool mkdir(String path)", ""])
        page["capy_sig_lines"] = dval(["function mkdir(path : string) bool"])
        page["param_lines"] = dval(["path : directory path", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "dir_remove", "dir_list", "ls", "path_join", "cwd_get", "cwd_set"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

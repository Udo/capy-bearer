#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "mkdir" {
        var page := dval({source_page: ""})
        page["source_page"] = "mkdir"
        page["kind"] = "api"
        page["slug"] = "mkdir"
        page["route"] = "/doc/api/mkdir/"
        page["title"] = "mkdir"
        page["content"] = "## sig\n\nfunction mkdir(path : string) bool\n\n`mkdir()` creates one directory at `path`.\n\nThe parent directory must exist. This function does not create parent directories.\n"
        page["returns"] = "`true` when the API creates the directory"
        page["label"] = "mkdir"
        page["capy_sig_lines"] = dval(["function mkdir(path : string) bool"])
        page["param_lines"] = dval(["path : the directory path", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "dir_remove", "path_join"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var path := file_temp(\"/tmp/doc-mkdir-\")\nfile_unlink(path)\nprint(mkdir(path), \"\\n\")\ndir_remove(path, true)\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

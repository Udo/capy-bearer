#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-rename" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_rename"
        page["kind"] = "api"
        page["slug"] = "file-rename"
        page["route"] = "/doc/api/file-rename/"
        page["title"] = "file_rename"
        page["content"] = "`file_rename` moves a file from one path to another. Use it after writing a temporary file. A successful call removes the source path. It returns false when Capy cannot rename the file. Capy uses the same paths and Boolean result.\n"
        page["returns"] = "true when Capy renames the file, otherwise false"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "file_rename"
        page["sig_lines"] = dval(["bool file_rename(String from, String to)", ""])
        page["capy_sig_lines"] = dval(["function file_rename(from : string, to : string) bool"])
        page["param_lines"] = dval(["from : current path of the file", "to : new path of the file", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "file_copy", "file_temp", "dir_list", "file_stat", "file_truncate", "file_close"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

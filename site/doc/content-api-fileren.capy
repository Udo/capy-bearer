#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-rename" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_rename"
        page["kind"] = "api"
        page["slug"] = "file-rename"
        page["route"] = "/doc/api/file-rename/"
        page["title"] = "file_rename"
        page["content"] = "## sig\n\nfunction file_rename(from : string, to : string) bool\n\n`file_rename` changes a file path. The source path no longer exists after a successful call.\n"
        page["returns"] = "`true` if Capy renames the file. Otherwise, `false`."
        page["label"] = "file_rename"
        page["capy_sig_lines"] = dval(["function file_rename(from : string, to : string) bool"])
        page["param_lines"] = dval(["from : source path", "to : destination path", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "file_put_contents(\"/tmp/doc-rename-source.txt\", \"moved\")\nif file_rename(\"/tmp/doc-rename-source.txt\", \"/tmp/doc-rename-destination.txt\") {\n    print(file_get_contents(\"/tmp/doc-rename-destination.txt\"), \"\\n\")\n}\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

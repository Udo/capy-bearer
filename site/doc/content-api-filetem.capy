#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-temp" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_temp"
        page["kind"] = "api"
        page["slug"] = "file-temp"
        page["route"] = "/doc/api/file-temp/"
        page["title"] = "file_temp"
        page["content"] = "## sig\n\nfunction file_temp(prefix : string) string\n\n`file_temp` creates an empty file with a unique suffix.\n"
        page["returns"] = "The new empty file path. Returns `\"\"` on failure."
        page["label"] = "file_temp"
        page["capy_sig_lines"] = dval(["function file_temp(prefix : string) string"])
        page["param_lines"] = dval(["prefix : path prefix for the temporary file", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var path := file_temp(\"/tmp/doc-temp-\")\nif path != \"\" {\n    file_put_contents(path, \"scratch\")\n    print(file_get_contents(path), \"\\n\")\n    file_unlink(path)\n}\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

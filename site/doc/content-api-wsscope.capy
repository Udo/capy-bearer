#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "ws-scope" {
        var page := dval({source_page: ""})
        page["source_page"] = "ws_scope"
        page["kind"] = "api"
        page["slug"] = "ws-scope"
        page["route"] = "/doc/api/ws-scope/"
        page["title"] = "ws_scope"
        page["content"] = "Capy has no native `ws_scope` signature. In a `WS` handler, use `request.websocket.scope`.\n"
        page["label"] = "ws_scope"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">websocket", ">0_Request", "ws_connections", "ws_opcode", "ws_send", "ws_message", "ws_send_to", "ws_is_binary"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "base64-encode" {
        var page := dval({source_page: ""})
        page["source_page"] = "base64_encode"
        page["kind"] = "api"
        page["slug"] = "base64-encode"
        page["route"] = "/doc/api/base64-encode/"
        page["title"] = "base64_encode"
        page["content"] = "## sig\n\nfunction base64_encode(value : string) string\n\n`base64_encode` encodes a string as Base64 text.\n\nUse `base64_decode` to decode the result.\n"
        page["returns"] = "Base64 text"
        page["label"] = "base64_encode"
        page["capy_sig_lines"] = dval(["function base64_encode(value : string) string"])
        page["param_lines"] = dval(["value : source string", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["base64_decode"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(base64_encode(\"hello\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

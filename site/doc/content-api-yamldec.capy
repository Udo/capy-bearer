#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "yaml-decode" {
        var page := dval({source_page: ""})
        page["source_page"] = "yaml_decode"
        page["kind"] = "api"
        page["slug"] = "yaml-decode"
        page["route"] = "/doc/api/yaml-decode/"
        page["title"] = "yaml_decode"
        page["content"] = "`yaml_decode()` decodes YAML source into a `dval`.\n"
        page["returns"] = "A `dval` that contains the decoded YAML."
        page["label"] = "yaml_decode"
        page["capy_sig_lines"] = dval(["function yaml_decode(source : string) dval"])
        page["param_lines"] = dval(["source : YAML source", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "yaml_encode", href: "/doc/api/yaml-encode/"}, {label: "json_decode", href: "/doc/api/json-decode/"}, {label: "dvalue", href: "/doc/type/dvalue/"}, {label: "string", href: "/doc/api/string/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "var value := yaml_decode(\"name: Ada\\n\")\nprint(value[\"name\"], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

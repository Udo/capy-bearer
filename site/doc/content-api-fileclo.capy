#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-close" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_close"
        page["kind"] = "api"
        page["slug"] = "file-close"
        page["route"] = "/doc/api/file-close/"
        page["title"] = "file_close"
        page["content"] = "`file_close` closes a handle from `file_open()`. Use it after the final read or write. The Capy API does not return an error value. Capy uses the same handle value and call.\n"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "file_close"
        page["sig_lines"] = dval(["void file_close(u64 h)", ""])
        page["capy_sig_lines"] = dval(["function file_close(handle : u64)"])
        page["param_lines"] = dval(["h : handle returned by `file_open()`", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "file_open", "file_write", "file_read"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "first" {
        var page := dval({source_page: ""})
        page["source_page"] = "first"
        page["kind"] = "api"
        page["slug"] = "first"
        page["route"] = "/doc/api/first/"
        page["title"] = "first"
        page["content"] = "## sig\n\nfunction first() string\nfunction first(one : string) string\nfunction first(one : string, two : string) string\nfunction first(one : string, two : string, three : string) string\nfunction first(one : string, two : string, three : string, four : string) string\n\n`first` checks values in order. It ignores values that contain only whitespace.\n"
        page["returns"] = "The first nonblank value. Returns `\"\"` if no value is nonblank."
        page["label"] = "first"
        page["capy_sig_lines"] = dval(["function first() string", "function first(one : string) string", "function first(one : string, two : string) string", "function first(one : string, two : string, three : string) string", "function first(one : string, two : string, three : string, four : string) string"])
        page["param_lines"] = dval(["one : first value", "two : second value", "three : third value", "four : fourth value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(first(\"\", \"  \", \"fallback\", \"other\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

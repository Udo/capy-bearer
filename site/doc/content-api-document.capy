#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "documentation-format" {
        var page := dval({source_page: ""})
        page["source_page"] = "3_Documentation format"
        page["kind"] = "api"
        page["slug"] = "documentation-format"
        page["route"] = "/doc/api/documentation-format/"
        page["title"] = "Documentation format"
        page["content"] = "Each page describes one Capy API. Use `:sig` for an existing Capy signature. Use `:content` for normal use. Use `:params`, `:returns`, and `:errors` for verified behavior.\n\nUse `:example capy ENTRY` for a runnable Capy example. Put `:output` after a render example. ENTRY can be `render`, `cli`, `component`, `init`, `once`, or `ws`.\n\n`capyc` reads Capy declarations from `src/capy/stdlib.capy`. The generator validates documented signatures and examples.\n"
        page["example_error"] = "output must follow a Capy guide example"
        page["label"] = "Documentation format"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "function RENDER(request : dval) {\n    print(\"ok\")\n}\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

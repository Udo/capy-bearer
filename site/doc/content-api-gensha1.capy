#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "gen-sha1" {
        var page := dval({source_page: ""})
        page["source_page"] = "gen_sha1"
        page["kind"] = "api"
        page["slug"] = "gen-sha1"
        page["route"] = "/doc/api/gen-sha1/"
        page["title"] = "gen_sha1"
        page["content"] = "## sig\n\nfunction gen_sha1(value : string, as_binary : bool = false) string\n\n`gen_sha1()` returns the SHA-1 digest of a string.\n\nIt returns hexadecimal text by default. Set `as_binary` to `true` for raw digest bytes.\n\nUse it only for SHA-1 compatibility.\n"
        page["returns"] = "A SHA-1 digest string."
        page["label"] = "gen_sha1"
        page["capy_sig_lines"] = dval(["function gen_sha1(value : string, as_binary : bool = false) string"])
        page["param_lines"] = dval(["value : bytes to hash", "as_binary : `false` for hexadecimal text, `true` for raw digest bytes", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["sha256", "sha256_hex", "hmac_sha256"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var digest := gen_sha1(\"abc\")\nprint(digest, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "split-kv" {
        var page := dval({source_page: ""})
        page["source_page"] = "split_kv"
        page["kind"] = "api"
        page["slug"] = "split-kv"
        page["route"] = "/doc/api/split-kv/"
        page["title"] = "split_kv"
        page["content"] = "## sig\n\nfunction split_kv(value : string, separator : string = \"=\", trim_whitespace : bool = true, uppercase_keys : bool = false) dval\n\nUse `split_kv` to parse lines that contain key and value pairs.\n"
        page["returns"] = "Map-shaped `dval`."
        page["label"] = "split_kv"
        page["capy_sig_lines"] = dval(["function split_kv(value : string, separator : string = \"=\", trim_whitespace : bool = true, uppercase_keys : bool = false) dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var values := split_kv(\"name=Ada\")\nprint(values[\"name\"], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

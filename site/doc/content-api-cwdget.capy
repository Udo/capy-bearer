#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "cwd-get" {
        var page := dval({source_page: ""})
        page["source_page"] = "cwd_get"
        page["kind"] = "api"
        page["slug"] = "cwd-get"
        page["route"] = "/doc/api/cwd-get/"
        page["title"] = "cwd_get"
        page["content"] = "`cwd_get()` returns the current working directory path.\n\nSave this path before `cwd_set()` when you must restore the directory.\n"
        page["returns"] = "The current working directory path."
        page["label"] = "cwd_get"
        page["capy_sig_lines"] = dval(["function cwd_get() string"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["cwd_set", "process_start_directory"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(cwd_get() != \"\", \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "substr" {
        var page := dval({source_page: ""})
        page["source_page"] = "substr"
        page["kind"] = "api"
        page["slug"] = "substr"
        page["route"] = "/doc/api/substr/"
        page["title"] = "substr"
        page["content"] = "## sig\n\nfunction substr(value : string, start : s32) string\nfunction substr(value : string, start : s64) string\nfunction substr(value : string, start : s32, length : s32) string\nfunction substr(value : string, start : s64, length : s64) string\n\nUse `substr` to get part of a string. A negative start or length counts from the end.\n"
        page["returns"] = "Extracted text."
        page["label"] = "substr"
        page["capy_sig_lines"] = dval(["function substr(value : string, start : s32) string", "function substr(value : string, start : s64) string", "function substr(value : string, start : s32, length : s32) string", "function substr(value : string, start : s64, length : s64) string"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(substr(\"documentation\", 0, 3), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

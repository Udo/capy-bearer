#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-clear" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_clear"
        page["kind"] = "api"
        page["slug"] = "dvalue-clear"
        page["route"] = "/doc/api/dvalue-clear/"
        page["title"] = "Clear a dynamic value"
        page["content"] = "`dval_clear(value)` removes all children and makes `value` an empty map. Use `dval_set_array` for an empty list.\n"
        page["returns"] = "The cleared target value."
        page["label"] = "dval_clear"
        page["capy_sig_lines"] = dval(["function dval_clear(value : dval) dval"])
        page["param_lines"] = dval(["value : target value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var value := dval({\"name\": \"Ada\"})\nvalue = dval_clear(value)\nprint(dval_has(value, \"name\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

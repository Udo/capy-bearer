#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "ob-start" {
        var page := dval({source_page: ""})
        page["source_page"] = "ob_start"
        page["kind"] = "api"
        page["slug"] = "ob-start"
        page["route"] = "/doc/api/ob-start/"
        page["title"] = "ob_start"
        page["content"] = "## sig\n\nfunction ob_start()\n\n`ob_start()` starts a new output buffer.\n\nLater `print()` calls write to this buffer. Use `ob_get_close()` to get its text, or `ob_close()` to discard it.\n"
        page["label"] = "ob_start"
        page["capy_sig_lines"] = dval(["function ob_start()"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">ob", "ob_get_close", "ob_close"])
        page["examples"] = dval([{entry: "render", caption: "", body: "ob_start()\nprint(\"buffered\")\nprint(ob_get_close(), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

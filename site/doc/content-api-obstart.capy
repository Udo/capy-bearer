#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "ob-start" {
        var page := dval({source_page: ""})
        page["source_page"] = "ob_start"
        page["kind"] = "api"
        page["slug"] = "ob-start"
        page["route"] = "/doc/api/ob-start/"
        page["title"] = "Start an output buffer"
        page["content"] = "`ob_start()` starts an output buffer for the active request.\n\nOutput after this call goes to the buffer. Use `ob_get`, `ob_get_close`, or `ob_close` to read or close it.\n"
        page["returns"] = "This function returns no value."
        page["label"] = "ob_start"
        page["capy_sig_lines"] = dval(["function ob_start()"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "request", href: "/doc/type/request/"}, {label: "ob_get_close", href: "/doc/api/ob-get-close/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "ob_start()\nprint(\"fragment\")\nvar captured := ob_get_close()\nprint(\"captured: \", captured, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

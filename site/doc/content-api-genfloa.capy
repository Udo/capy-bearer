#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "gen-float" {
        var page := dval({source_page: ""})
        page["source_page"] = "gen_float"
        page["kind"] = "api"
        page["slug"] = "gen-float"
        page["route"] = "/doc/api/gen-float/"
        page["title"] = "gen_float"
        page["content"] = "`gen_float()` returns a deterministic value for the range values, index, seed, and precision.\n\nUse the same inputs to reproduce a value.\n"
        page["returns"] = "A deterministic `f64` value."
        page["label"] = "gen_float"
        page["capy_sig_lines"] = dval(["function gen_float(from : f64, to : f64, index : u64, seed : u64 = 0, precision : f64 = 0.000000000001) f64"])
        page["param_lines"] = dval(["from : first range value", "to : second range value", "index : deterministic input position", "seed : deterministic input seed", "precision : output precision", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "gen_int", href: "/doc/api/gen-int/"}, {label: "gen_noise01", href: "/doc/api/gen-noise01/"}, {label: "draw_float", href: "/doc/api/draw-float/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "var value := gen_float(0.0, 1.0, u64(1))\nprint(value, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

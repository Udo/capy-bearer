#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "ws" {
        var page := dval({source_page: ""})
        page["source_page"] = "1_WS"
        page["kind"] = "api"
        page["slug"] = "ws"
        page["route"] = "/doc/api/ws/"
        page["title"] = "WS"
        page["content"] = "`function WS(request : dval)` defines the Capy WebSocket message handler.\n\nEvery Capy Bearer handler has exactly one parameter. The parameter name is `request`. Its type is `dval`. The value is a copied request snapshot. `request.body` contains the current message payload. `request.websocket.connections` contains current-scope connection IDs.\n\nRead input from the request fields. Use response, session, output, and WebSocket functions for effects. The compiler rejects zero parameters, other parameter types, extra parameters, return types, and handler overloads.\n\nC++ declares `WS(Request& context)`. It reads the payload from `context.in`, metadata from `context.params[\"WS_...\"]`, and persistent connection state from `context.connection`. The connection value starts empty and persists for later calls on that socket.\n"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "WS"
        page["sig_lines"] = dval(["WS(Request& context)", ""])
        page["capy_sig_lines"] = dval(["function WS(request : dval)"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">0_Request", ">1_RENDER", ">1_COMPONENT", ">1_CLI", ">1_WS"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

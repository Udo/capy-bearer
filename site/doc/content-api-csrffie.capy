#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "csrf-field" {
        var page := dval({source_page: ""})
        page["source_page"] = "csrf_field"
        page["kind"] = "api"
        page["slug"] = "csrf-field"
        page["route"] = "/doc/api/csrf-field/"
        page["title"] = "csrf_field"
        page["content"] = "`csrf_field()` returns a hidden form input with the active CSRF token.\n\nUse it in a form that changes state. Check the submitted value with `csrf_valid()` before you change state.\n"
        page["returns"] = "An HTML hidden input with the active CSRF token."
        page["label"] = "csrf_field"
        page["capy_sig_lines"] = dval(["function csrf_field(session_name : string = \"bearer-session\", token_name : string = \"csrf_token\", field_name : string = \"\") string"])
        page["param_lines"] = dval(["session_name : the session and cookie name", "token_name : the token namespace", "field_name : the form field name. The default is `token_name`.", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "csrf_token", href: "/doc/api/csrf-token/"}, {label: "csrf_valid", href: "/doc/api/csrf-valid/"}, {label: "csrf_rotate", href: "/doc/api/csrf-rotate/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "var field := csrf_field(\"capy-doc-session\", \"profile\", \"csrf_token\")\nprint(contains(field, \"type=\\\"hidden\\\"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

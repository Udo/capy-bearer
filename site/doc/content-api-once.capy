#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "once" {
        var page := dval({source_page: ""})
        page["source_page"] = "1_ONCE"
        page["kind"] = "api"
        page["slug"] = "once"
        page["route"] = "/doc/api/once/"
        page["title"] = "ONCE"
        page["content"] = "`function ONCE(request : dval)` defines the Capy request-local unit hook.\n\nEvery Capy Bearer handler has exactly one parameter. The parameter name is `request`. Its type is `dval`. The value is a copied request snapshot. Bearer runs this hook before the first unit entry or component call.\n\nRead input from the request fields. Use response, session, output, and WebSocket functions for effects. The compiler rejects zero parameters, other parameter types, extra parameters, return types, and handler overloads.\n\nC++ declares `ONCE(Request& context)`. C++ can store request-local data in the live context.\n"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "ONCE"
        page["sig_lines"] = dval(["ONCE(Request& context)", ""])
        page["capy_sig_lines"] = dval(["function ONCE(request : dval)"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">0_Request", ">1_RENDER", ">1_COMPONENT", ">1_CLI", ">1_WS"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

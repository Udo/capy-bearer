#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "once" {
        var page := dval({source_page: ""})
        page["source_page"] = "1_ONCE"
        page["kind"] = "api"
        page["slug"] = "once"
        page["route"] = "/doc/api/once/"
        page["title"] = "ONCE"
        page["content"] = "## sig\n\nfunction ONCE(request : dval)\n\n`ONCE` defines the request-local unit hook.\n\nBearer runs this hook before the first unit entry or component call. The handler has one parameter named `request` with type `dval`.\n"
        page["label"] = "ONCE"
        page["capy_sig_lines"] = dval(["function ONCE(request : dval)"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_Request", "1_INIT"])
        page["examples"] = dval([{entry: "once", caption: "", body: "print(string(request.method, \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "sha256" {
        var page := dval({source_page: ""})
        page["source_page"] = "sha256"
        page["kind"] = "api"
        page["slug"] = "sha256"
        page["route"] = "/doc/api/sha256/"
        page["title"] = "sha256"
        page["content"] = "## sig\n\nfunction sha256(value : string) string\n\nUse `sha256` to create a raw SHA-256 digest. Use `sha256_hex` when you need hexadecimal text.\n"
        page["returns"] = "Raw 32-byte SHA-256 digest."
        page["label"] = "sha256"
        page["capy_sig_lines"] = dval(["function sha256(value : string) string"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(length(sha256(\"abc\")), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

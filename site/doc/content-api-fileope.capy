#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-open" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_open"
        page["kind"] = "api"
        page["slug"] = "file-open"
        page["route"] = "/doc/api/file-open/"
        page["title"] = "file_open"
        page["content"] = "## sig\n\nfunction file_open(path : string, mode : string) u64\n\n`file_open` opens a file for incremental access. Use the handle with `file_read`, `file_write`, `file_seek`, and `file_close`.\n"
        page["returns"] = "A file handle, or `u64(0)` when Capy cannot open the file."
        page["label"] = "file_open"
        page["capy_sig_lines"] = dval(["function file_open(path : string, mode : string) u64"])
        page["param_lines"] = dval(["path : path of the file to open", "mode : access mode, such as `\"r\"`, `\"w\"`, `\"a\"`, or `\"r+\"`", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "file_read", "file_write", "file_close", "file_get_contents"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var handle := file_open(\"/tmp/doc-open.txt\", \"w\")\nfile_write(handle, \"streamed\")\nfile_close(handle)\nprint(file_get_contents(\"/tmp/doc-open.txt\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

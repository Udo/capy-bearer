#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "time" {
        var page := dval({source_page: ""})
        page["source_page"] = "time"
        page["kind"] = "api"
        page["slug"] = "time"
        page["route"] = "/doc/api/time/"
        page["title"] = "time"
        page["content"] = "## sig\n\nfunction time() u64\n\n`time` returns the current Unix timestamp with second precision.\n"
        page["returns"] = "current Unix timestamp with second precision"
        page["label"] = "time"
        page["capy_sig_lines"] = dval(["function time() u64"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">time", "time_precise", "time_format_local", "usleep", "time_format_relative", "time_format_utc", "time_parse"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(time(), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

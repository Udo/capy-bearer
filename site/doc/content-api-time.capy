#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "time" {
        var page := dval({source_page: ""})
        page["source_page"] = "time"
        page["kind"] = "api"
        page["slug"] = "time"
        page["route"] = "/doc/api/time/"
        page["title"] = "time"
        page["content"] = "`time` returns the current Unix timestamp with second precision.\n"
        page["returns"] = "current Unix timestamp with second precision"
        page["label"] = "time"
        page["capy_sig_lines"] = dval(["function time() u64"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "time", href: "/doc/api/time/"}, {label: "time_precise", href: "/doc/api/time-precise/"}, {label: "time_format_local", href: "/doc/api/time-format-local/"}, {label: "usleep", href: "/doc/api/usleep/"}, {label: "time_format_relative", href: "/doc/api/time-format-relative/"}, {label: "time_format_utc", href: "/doc/api/time-format-utc/"}, {label: "time_parse", href: "/doc/api/time-parse/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(time(), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

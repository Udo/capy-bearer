#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-unlink" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_unlink"
        page["kind"] = "api"
        page["slug"] = "file-unlink"
        page["route"] = "/doc/api/file-unlink/"
        page["title"] = "file_unlink"
        page["content"] = "`file_unlink` deletes a file at `file_name`. Use it to remove a temporary file or before you recreate a file. A missing path does not cause an error. The Capy API does not return an error value.\n"
        page["returns"] = "none"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "file_unlink"
        page["sig_lines"] = dval(["void file_unlink(String file_name)", ""])
        page["capy_sig_lines"] = dval(["function file_unlink(path : string)"])
        page["param_lines"] = dval(["file_name : path of the file to delete", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "file_exists", "dir_remove", "job_cancel", "zip_create", "job_await", "zip_list"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

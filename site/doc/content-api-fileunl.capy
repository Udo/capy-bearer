#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-unlink" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_unlink"
        page["kind"] = "api"
        page["slug"] = "file-unlink"
        page["route"] = "/doc/api/file-unlink/"
        page["title"] = "file_unlink"
        page["content"] = "`file_unlink` removes a file. A missing path does not cause an error.\n"
        page["returns"] = "No value."
        page["label"] = "file_unlink"
        page["capy_sig_lines"] = dval(["function file_unlink(path : string)"])
        page["param_lines"] = dval(["path : file path", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "file_put_contents(\"/tmp/doc-unlink.txt\", \"x\")\nfile_unlink(\"/tmp/doc-unlink.txt\")\nprint(file_exists(\"/tmp/doc-unlink.txt\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

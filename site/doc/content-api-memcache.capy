#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "memcache-command" {
        var page := dval({source_page: ""})
        page["source_page"] = "memcache_command"
        page["kind"] = "api"
        page["slug"] = "memcache-command"
        page["route"] = "/doc/api/memcache-command/"
        page["title"] = "memcache_command"
        page["content"] = "`memcache_command()` sends `command` to the server and returns one bounded response read.\n\nUse a dedicated Memcache function when one is available. This function does not guarantee a complete multi-part response.\n"
        page["returns"] = "one server response read"
        page["label"] = "memcache_command"
        page["capy_sig_lines"] = dval(["function memcache_command(connection : u64, command : string) string"])
        page["param_lines"] = dval(["connection : the connection handle", "command : the Memcache command text", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">memcache", "memcache_connect"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var connection := memcache_connect()\nif connection != u64(0) { print(memcache_command(connection, \"version\"), \"\\n\") }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "memcache-connect" {
        var page := dval({source_page: ""})
        page["source_page"] = "memcache_connect"
        page["kind"] = "api"
        page["slug"] = "memcache-connect"
        page["route"] = "/doc/api/memcache-connect/"
        page["title"] = "memcache_connect"
        page["content"] = "`memcache_connect()` opens a connection to a Memcache server.\n\nDo not pass a zero handle to another Memcache function.\n"
        page["returns"] = "a connection handle, or zero on failure"
        page["label"] = "memcache_connect"
        page["capy_sig_lines"] = dval(["function memcache_connect(host : string = \"127.0.0.1\", port : s32 = 11211) u64"])
        page["param_lines"] = dval(["host : the server host name", "port : the server port", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">memcache", "memcache_get", "memcache_set"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var connection := memcache_connect()\nif connection != u64(0) { print(\"connected\\n\") } else { print(\"not connected\\n\") }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "memcache-delete" {
        var page := dval({source_page: ""})
        page["source_page"] = "memcache_delete"
        page["kind"] = "api"
        page["slug"] = "memcache-delete"
        page["route"] = "/doc/api/memcache-delete/"
        page["title"] = "memcache_delete"
        page["content"] = "`memcache_delete()` deletes the entry for `key`.\n\nIt returns `true` only when the server returns `DELETED`.\n"
        page["returns"] = "`true` when the server deletes the entry"
        page["label"] = "memcache_delete"
        page["capy_sig_lines"] = dval(["function memcache_delete(connection : u64, key : string) bool"])
        page["param_lines"] = dval(["connection : the connection handle", "key : the entry key", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">memcache", "memcache_connect", "memcache_get"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var connection := memcache_connect()\nif connection != u64(0) { print(memcache_delete(connection, \"doc-key\"), \"\\n\") }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "memcache-escape-key" {
        var page := dval({source_page: ""})
        page["source_page"] = "memcache_escape_key"
        page["kind"] = "api"
        page["slug"] = "memcache-escape-key"
        page["route"] = "/doc/api/memcache-escape-key/"
        page["title"] = "memcache_escape_key"
        page["content"] = "`memcache_escape_key()` replaces whitespace characters in a key with underscores.\n\nIt does not validate every Memcache protocol byte.\n\nThe dedicated Memcache operations escape keys before they send requests.\n"
        page["returns"] = "the key with whitespace replaced by underscores"
        page["label"] = "memcache_escape_key"
        page["capy_sig_lines"] = dval(["function memcache_escape_key(key : string) string"])
        page["param_lines"] = dval(["key : the key text", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">memcache"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(memcache_escape_key(\"a key\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "memcache-get-multiple" {
        var page := dval({source_page: ""})
        page["source_page"] = "memcache_get_multiple"
        page["kind"] = "api"
        page["slug"] = "memcache-get-multiple"
        page["route"] = "/doc/api/memcache-get-multiple/"
        page["title"] = "memcache_get_multiple"
        page["content"] = "`memcache_get_multiple()` reads several keys through one connection.\n\nMissing keys do not occur in the returned map. It escapes each key before it sends the request.\n"
        page["returns"] = "a map of returned entries"
        page["label"] = "memcache_get_multiple"
        page["capy_sig_lines"] = dval(["function memcache_get_multiple(connection : u64, keys : dval) dval"])
        page["param_lines"] = dval(["connection : the connection handle", "keys : the entry keys", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">memcache", "memcache_get", "memcache_set"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var connection := memcache_connect()\nif connection != u64(0) { print(memcache_get_multiple(connection, dval([\"first\", \"second\"]))[\"first\"], \"\\n\") }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "memcache-get" {
        var page := dval({source_page: ""})
        page["source_page"] = "memcache_get"
        page["kind"] = "api"
        page["slug"] = "memcache-get"
        page["route"] = "/doc/api/memcache-get/"
        page["title"] = "memcache_get"
        page["content"] = "`memcache_get()` reads the value for `key`.\n\nIt returns `default_value` for a missing key or an incomplete response. It escapes the key before it sends the request.\n"
        page["returns"] = "the stored value or `default_value`"
        page["label"] = "memcache_get"
        page["capy_sig_lines"] = dval(["function memcache_get(connection : u64, key : string, default_value : string = \"\") string"])
        page["param_lines"] = dval(["connection : the connection handle", "key : the entry key", "default_value : the value for a missing or invalid response", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">memcache", "memcache_connect", "memcache_set"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var connection := memcache_connect()\nif connection != u64(0) { print(memcache_get(connection, \"doc-key\", \"missing\"), \"\\n\") }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "memcache-set" {
        var page := dval({source_page: ""})
        page["source_page"] = "memcache_set"
        page["kind"] = "api"
        page["slug"] = "memcache-set"
        page["route"] = "/doc/api/memcache-set/"
        page["title"] = "memcache_set"
        page["content"] = "`memcache_set()` stores `value` under `key`.\n\nIt returns `true` only when the server returns `STORED`. It escapes the key before it sends the request.\n"
        page["returns"] = "`true` when the server stores the entry"
        page["label"] = "memcache_set"
        page["capy_sig_lines"] = dval(["function memcache_set(connection : u64, key : string, value : string, expires_in : u64 = 3600) bool"])
        page["param_lines"] = dval(["connection : the connection handle", "key : the entry key", "value : the value text", "expires_in : the lifetime in seconds", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">memcache", "memcache_connect", "memcache_get"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var connection := memcache_connect()\nif connection != u64(0) { print(memcache_set(connection, \"doc-key\", \"value\"), \"\\n\") }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "socket-write" {
        var page := dval({source_page: ""})
        page["source_page"] = "socket_write"
        page["kind"] = "api"
        page["slug"] = "socket-write"
        page["route"] = "/doc/api/socket-write/"
        page["title"] = "socket_write"
        page["content"] = "Use `socket_write` to send data to a socket.\n"
        page["returns"] = "`true` when the write succeeds."
        page["label"] = "socket_write"
        page["capy_sig_lines"] = dval(["function socket_write(handle : u64, data : string) bool"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var handle := socket_connect(\"127.0.0.1\", 1)\nif handle != 0 { print(socket_write(handle, \"hello\"), \"\\n\"); socket_close(handle) }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

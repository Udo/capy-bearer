#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "keys" {
        var page := dval({source_page: ""})
        page["source_page"] = "keys"
        page["kind"] = "api"
        page["slug"] = "keys"
        page["route"] = "/doc/api/keys/"
        page["title"] = "Get child keys"
        page["content"] = "`keys(value)` returns a new list of child keys. A scalar returns an empty list.\n"
        page["returns"] = "A list of child keys."
        page["label"] = "keys"
        page["capy_sig_lines"] = dval(["function keys(value : dval) dval"])
        page["param_lines"] = dval(["value : source value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_DValue", "values"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var user := dval({\"name\": \"Ada\", \"role\": \"admin\"})\nprint(join(sort(keys(user)), \",\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

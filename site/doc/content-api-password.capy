#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "password-hash" {
        var page := dval({source_page: ""})
        page["source_page"] = "password_hash"
        page["kind"] = "api"
        page["slug"] = "password-hash"
        page["route"] = "/doc/api/password-hash/"
        page["title"] = "password_hash"
        page["content"] = "`password_hash()` creates a password encoding with a random salt and current scrypt parameters.\n\nStore the returned value exactly. Do not store an empty result.\n"
        page["returns"] = "a self-contained password encoding, or an empty string on failure"
        page["label"] = "password_hash"
        page["capy_sig_lines"] = dval(["function password_hash(password : string) string"])
        page["param_lines"] = dval(["password : the password to hash", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "password_verify", "password_needs_rehash"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var encoded := password_hash(\"correct horse battery staple\")\nprint(encoded != \"\", \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "password-needs-rehash" {
        var page := dval({source_page: ""})
        page["source_page"] = "password_needs_rehash"
        page["kind"] = "api"
        page["slug"] = "password-needs-rehash"
        page["route"] = "/doc/api/password-needs-rehash/"
        page["title"] = "password_needs_rehash"
        page["content"] = "`password_needs_rehash()` returns `true` for malformed encodings and older Bearer password parameters.\n\nCall it after `password_verify()` succeeds. Hash the known password again and replace the stored encoding.\n"
        page["returns"] = "`true` when the encoding needs replacement"
        page["label"] = "password_needs_rehash"
        page["capy_sig_lines"] = dval(["function password_needs_rehash(encoded : string) bool"])
        page["param_lines"] = dval(["encoded : the stored password encoding", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "password_hash", "password_verify"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var encoded := password_hash(\"correct horse battery staple\")\nif password_verify(\"correct horse battery staple\", encoded) { print(password_needs_rehash(encoded), \"\\n\") }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "password-verify" {
        var page := dval({source_page: ""})
        page["source_page"] = "password_verify"
        page["kind"] = "api"
        page["slug"] = "password-verify"
        page["route"] = "/doc/api/password-verify/"
        page["title"] = "password_verify"
        page["content"] = "`password_verify()` tests a password against a stored encoding.\n\nIt rejects malformed encodings and parameters above the Bearer limits. Set password length and sign-in rate limits in public handlers.\n"
        page["returns"] = "`true` when the password matches a valid encoding"
        page["label"] = "password_verify"
        page["capy_sig_lines"] = dval(["function password_verify(password : string, encoded : string) bool"])
        page["param_lines"] = dval(["password : the candidate password", "encoded : the stored password encoding", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "password_hash", "password_needs_rehash"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var encoded := password_hash(\"correct horse battery staple\")\nprint(password_verify(\"correct horse battery staple\", encoded), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

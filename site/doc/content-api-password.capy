#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "password-hash" {
        var page := dval({source_page: ""})
        page["source_page"] = "password_hash"
        page["kind"] = "api"
        page["slug"] = "password-hash"
        page["route"] = "/doc/api/password-hash/"
        page["title"] = "password_hash"
        page["content"] = "`password_hash()` returns a password credential as a `string`. It uses a random salt and Bearer's current scrypt parameters.\n\nStore the returned encoding exactly as received. If the result is empty, do not store it. Report the failure.\n"
        page["returns"] = "a self-contained scrypt encoding, or an empty string on failure"
        page["errors"] = "Returns an empty string when the runtime cannot create the hash."
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "password_hash"
        page["sig_lines"] = dval(["String password_hash(String password)", ""])
        page["capy_sig_lines"] = dval(["function password_hash(password : string) string"])
        page["param_lines"] = dval(["password : the password bytes to hash", ""])
        page["notes"] = dval(["Use a database column that can store at least 255 characters. Use `password_needs_rehash()` when you read an old hash."])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "password_verify", "password_needs_rehash", "basename", "dirname", "expand_path", "file_append"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "password-needs-rehash" {
        var page := dval({source_page: ""})
        page["source_page"] = "password_needs_rehash"
        page["kind"] = "api"
        page["slug"] = "password-needs-rehash"
        page["route"] = "/doc/api/password-needs-rehash/"
        page["title"] = "password_needs_rehash"
        page["content"] = "`password_needs_rehash()` returns `true` when a stored Bearer password encoding needs replacement.\n\nCall this only after `password_verify()` succeeds. Hash the known password again. Then replace the stored credential as one operation.\n\nOther credential formats return `true`. Your application must verify them before it upgrades them.\n"
        page["returns"] = "`true` if the encoding is malformed or uses older Bearer parameters"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "password_needs_rehash"
        page["sig_lines"] = dval(["bool password_needs_rehash(String encoded)", ""])
        page["capy_sig_lines"] = dval(["function password_needs_rehash(encoded : string) bool"])
        page["param_lines"] = dval(["encoded : the stored password credential", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "password_hash", "password_verify", "basename", "dirname", "expand_path", "file_append"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "password-verify" {
        var page := dval({source_page: ""})
        page["source_page"] = "password_verify"
        page["kind"] = "api"
        page["slug"] = "password-verify"
        page["route"] = "/doc/api/password-verify/"
        page["title"] = "password_verify"
        page["content"] = "`password_verify()` returns `true` only when `password` matches `encoded`. It compares the derived value in constant time.\n\nThe API rejects malformed encodings. It also rejects parameters above the Bearer memory and work limits.\n\nSet password length limits and rate limits for public sign-in endpoints.\n"
        page["returns"] = "`true` only if the password matches a valid bounded encoding"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "password_verify"
        page["sig_lines"] = dval(["bool password_verify(String password, String encoded)", ""])
        page["capy_sig_lines"] = dval(["function password_verify(password : string, encoded : string) bool"])
        page["param_lines"] = dval(["password : the candidate password bytes", "encoded : a self-contained `$bearer$scrypt$...` credential", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "password_hash", "password_needs_rehash", "basename", "dirname", "expand_path", "file_append"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

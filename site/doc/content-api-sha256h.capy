#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "sha256-hex" {
        var page := dval({source_page: ""})
        page["source_page"] = "sha256_hex"
        page["kind"] = "api"
        page["slug"] = "sha256-hex"
        page["route"] = "/doc/api/sha256-hex/"
        page["title"] = "sha256_hex"
        page["content"] = "Use `sha256_hex` to create a printable SHA-256 digest.\n"
        page["returns"] = "Lowercase hexadecimal SHA-256 digest."
        page["label"] = "sha256_hex"
        page["capy_sig_lines"] = dval(["function sha256_hex(value : string) string"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(sha256_hex(\"abc\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dirname" {
        var page := dval({source_page: ""})
        page["source_page"] = "dirname"
        page["kind"] = "api"
        page["slug"] = "dirname"
        page["route"] = "/doc/api/dirname/"
        page["title"] = "dirname"
        page["content"] = "`dirname()` returns the directory part of a Capy path string.\n\nPass a path with a final component. The returned string omits that final component. Use it to get a containing directory.\n\nThe Capy call has the same arguments.\n"
        page["returns"] = "directory part of the path"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "dirname"
        page["sig_lines"] = dval(["String dirname(String fn)", ""])
        page["capy_sig_lines"] = dval(["function dirname(path : string) string"])
        page["param_lines"] = dval(["fn : path to inspect", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "basename", "path_join", "expand_path", "file_append", "file_exists", "file_get_contents"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dirname" {
        var page := dval({source_page: ""})
        page["source_page"] = "dirname"
        page["kind"] = "api"
        page["slug"] = "dirname"
        page["route"] = "/doc/api/dirname/"
        page["title"] = "dirname"
        page["content"] = "## sig\n\nfunction dirname(path : string) string\n\n`dirname()` removes the final component from a path string.\n\nThe function does not access the file system.\n"
        page["returns"] = "The directory part of the path."
        page["label"] = "dirname"
        page["capy_sig_lines"] = dval(["function dirname(path : string) string"])
        page["param_lines"] = dval(["path : the path to inspect", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["basename", "path_join"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(dirname(\"/var/www/site/index.capy\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

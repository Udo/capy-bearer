#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "base64-decode" {
        var page := dval({source_page: ""})
        page["source_page"] = "base64_decode"
        page["kind"] = "api"
        page["slug"] = "base64-decode"
        page["route"] = "/doc/api/base64-decode/"
        page["title"] = "base64_decode"
        page["content"] = "`base64_decode` decodes Base64 text into a string.\n\nInvalid Base64 text returns an empty string.\n"
        page["returns"] = "the decoded string"
        page["label"] = "base64_decode"
        page["capy_sig_lines"] = dval(["function base64_decode(value : string) string"])
        page["param_lines"] = dval(["value : Base64 text", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["base64_encode"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(base64_decode(\"aGVsbG8=\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-deref" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_deref"
        page["kind"] = "api"
        page["slug"] = "dvalue-deref"
        page["route"] = "/doc/api/dvalue-deref/"
        page["title"] = "Dereference a dynamic value"
        page["content"] = "Capy does not provide a dereference operation. Capy values do not expose host pointers or reference nodes.\n\nNo Capy alternative exists.\n"
        page["capy_status"] = "unsupported"
        page["label"] = "dval_deref"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_DValue"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

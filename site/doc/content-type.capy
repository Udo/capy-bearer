#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue" {
        var page := dval({source_page: ""})
        page["source_page"] = "type/dvalue"
        page["kind"] = "type"
        page["slug"] = "dvalue"
        page["route"] = "/doc/type/dvalue/"
        page["title"] = "Dynamic values"
        page["content"] = "A `dval` stores scalar values, maps, lists, and `none`.\n\nUse maps for named fields and lists for ordered values. Read children with `value.name`, `value[\"name\"]`, or `value[0]`. A missing read returns `none` and does not change the value.\n\nUse `has` to test a key. Use `get` when absence is valid. Use `string`, `bool`, `s32`, `s64`, `u64`, or `f64` to convert a value.\n\nUpdate functions such as `set`, `push`, and `clear` change their target and return it. `keys` and `values` return new values.\n"
        page["label"] = "dvalue"
        page["capy_sig_lines"] = dval(["type dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "string", href: "/doc/api/string/"}, {label: "get", href: "/doc/api/get/"}, {label: "get_by_path", href: "/doc/api/get-by-path/"}, {label: "json_decode", href: "/doc/api/json-decode/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "var user := dval({\"name\": \"Ada\", \"tags\": [\"math\"]})\nprint(user.name, \" \", user.tags[0], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "request" {
        var page := dval({source_page: ""})
        page["source_page"] = "type/request"
        page["kind"] = "type"
        page["slug"] = "request"
        page["route"] = "/doc/type/request/"
        page["title"] = "Request snapshot"
        page["content"] = "Every Capy handler receives one parameter, `request`, of type `dval`. It is a snapshot of the request taken when the handler is entered — reading it never touches the network, and reading the same field twice always gives the same answer.\n\nRead scalars through a converter with a fallback, so a key that is absent has a defined value rather than an error:\n\n    var name := string(request.query.name, \"guest\")\n    var page := s64(request.query.page, 1)\n    var debug := bool(request.query.debug, false)\n\nTest for presence with the `?` suffix, which is `true` when the key exists:\n\n    if request.query.token? { print(\"token supplied\\n\") }\n\n## Fields\n\n| Field | Type | Contains |\n| --- | --- | --- |\n| `method` | string | `GET`, `POST`, and so on |\n| `query` | map | parsed query-string parameters |\n| `form` | map | parsed form body parameters |\n| `body` | string | the raw request body |\n| `headers` | map | request headers, lowercased with dashes: `content-type`, `x-request-id` |\n| `cookies` | map | request cookies by name |\n| `files` | array | uploaded files, each with `name`, `size`, `temporary_path` |\n| `route` | map | `path`, `page`, `raw_path`, `valid` |\n| `url` | map | `script`, `base` |\n| `server` | map | remaining server and CGI variables, original uppercase names |\n| `session` | map | the current session snapshot |\n| `props` | map | properties passed by a component caller |\n| `config` | map | request-visible configuration |\n| `connection` | map | connection information |\n| `unit` | string | the source path of the unit currently executing |\n| `websocket` | map | `connection_id`, `scope`, `opcode`, `binary`, `connections` |\n| `call` | map | dispatch information for the current call |\n\n## Headers and server variables\n\n`headers` holds anything that arrived as an HTTP header, re"
        page["content"] = string(page["content"], "") + "named for readability: the transport's `HTTP_X_REQUEST_ID` appears as `request.headers[\"x-request-id\"]`. `content-type` and `content-length` are included even though they arrive without the `HTTP_` prefix. Use bracket syntax for these, since the names contain dashes.\n\n`server` holds everything else — `QUERY_STRING`, `REMOTE_ADDR`, `SERVER_NAME` — under the original uppercase names. `method`, `route`, and `url` are lifted out of `server` into their own fields, so look for them there rather than in `server`.\n\n## Reading and writing\n\nThe snapshot is read-only in the sense that changing it does not change the request. To affect the response, call the response functions — `response_status()`, `response_header()`, `response_cookie()`, `redirect()` — and use the session functions to change session state. `print()` writes the body.\n\n`request.props` is the one field that changes during a request: a component call swaps in the caller's props for the duration of the call and restores the previous value on return.\n"
        page["label"] = "request"
        page["capy_sig_lines"] = dval(["handler request : dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "render", href: "/doc/handler/render/"}, {label: "component", href: "/doc/handler/component/"}, {label: "cli", href: "/doc/handler/cli/"}, {label: "ws", href: "/doc/handler/ws/"}, {label: "string", href: "/doc/api/string/"}, {label: "response_status", href: "/doc/api/response-status/"}, {label: "response_header", href: "/doc/api/response-header/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(string(request.query.name, \"guest\"), \"\\n\")\n"}, {entry: "render", caption: "branch on the method and read a form field", body: "if string(request.method, \"\") == \"POST\" {\n    print(\"saved \", string(request.form.answer, \"\"), \"\\n\")\n} else {\n    print(\"<form method=\\\"post\\\"><input name=\\\"answer\\\"></form>\", \"\\n\")\n}\n"}, {entry: "render", caption: "read a header and a cookie", body: "print(string(request.headers[\"user-agent\"], \"unknown\"), \"\\n\")\nprint(string(request.cookies.session, \"none\"), \"\\n\")\n"}, {entry: "render", caption: "list uploaded files", body: "for file := request.files {\n    print(string(file.name, \"\"), \" \", u64(file.size, 0), \"\\n\")\n}\n"}, {entry: "render", caption: "check presence before use", body: "if request.query.page? {\n    print(\"page \", s64(request.query.page, 1), \"\\n\")\n} else {\n    print(\"no page requested\\n\")\n}\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "string" {
        var page := dval({source_page: ""})
        page["source_page"] = "type/string"
        page["kind"] = "type"
        page["slug"] = "string"
        page["route"] = "/doc/type/string/"
        page["title"] = "String"
        page["content"] = "`string` stores text or raw bytes in Capy.\n\nUse string literals, variables, parameters, and return values directly. Use `length`, `find`, `contains`, `replace`, `lower`, `upper`, and `substr` for common text work.\n\nUse `split_utf8` when you must split UTF-8 text by characters.\n"
        page["label"] = "string"
        page["capy_sig_lines"] = dval(["type string"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "split_utf8", href: "/doc/api/split-utf8/"}, {label: "substr", href: "/doc/api/substr/"}, {label: "html_escape", href: "/doc/api/html-escape/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "var name := \"Ada\"\nprint(upper(name), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "process-start-directory" {
        var page := dval({source_page: ""})
        page["source_page"] = "process_start_directory"
        page["kind"] = "api"
        page["slug"] = "process-start-directory"
        page["route"] = "/doc/api/process-start-directory/"
        page["title"] = "process_start_directory"
        page["content"] = "## sig\n\nfunction process_start_directory() string\n\n`process_start_directory()` returns the worker process start directory.\n\nThe value does not change when `cwd_set()` changes the current directory.\n"
        page["returns"] = "the worker process start directory"
        page["label"] = "process_start_directory"
        page["capy_sig_lines"] = dval(["function process_start_directory() string"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "cwd_get", "cwd_set"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(process_start_directory(), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

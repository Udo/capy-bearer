#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "to-s64" {
        var page := dval({source_page: ""})
        page["source_page"] = "to_s64"
        page["kind"] = "api"
        page["slug"] = "to-s64"
        page["route"] = "/doc/api/to-s64/"
        page["title"] = "to_s64"
        page["content"] = "## sig\n\nNo Capy signature.\n\nCapy has no native `to_s64` signature. Use `s64(value, fallback)`.\n"
        page["label"] = "to_s64"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">types", "2_DValue_to_s64", "to_f64", "to_u64", "to_bool", "brb_encode", "2_DValue_to_u64"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

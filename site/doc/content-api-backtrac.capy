#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "backtrace-capture" {
        var page := dval({source_page: ""})
        page["source_page"] = "backtrace_capture"
        page["kind"] = "api"
        page["slug"] = "backtrace-capture"
        page["route"] = "/doc/api/backtrace-capture/"
        page["title"] = "backtrace_capture"
        page["content"] = "`backtrace_capture` gets a backtrace for the current call stack.\n\nCall it with no arguments. You can also set the maximum frame count and skip count.\n"
        page["returns"] = "a backtrace string"
        page["label"] = "backtrace_capture"
        page["capy_sig_lines"] = dval(["function backtrace_capture() string", "function backtrace_capture(max_frames : s32, skip_frames : s32) string"])
        page["param_lines"] = dval(["max_frames : maximum number of frames", "skip_frames : number of newest frames to omit", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "backtrace_get_frames", href: "/doc/api/backtrace-get-frames/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(backtrace_capture(), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "backtrace-get-frames" {
        var page := dval({source_page: ""})
        page["source_page"] = "backtrace_get_frames"
        page["kind"] = "api"
        page["slug"] = "backtrace-get-frames"
        page["route"] = "/doc/api/backtrace-get-frames/"
        page["title"] = "backtrace_get_frames"
        page["content"] = "`backtrace_get_frames` gets source-mapped frames for the current Capy call stack.\n\nSet `max_frames` to limit the result. Set `skip_frames` to omit the newest frames.\n"
        page["returns"] = "a backtrace string"
        page["label"] = "backtrace_get_frames"
        page["capy_sig_lines"] = dval(["function backtrace_get_frames(max_frames : s32 = 32, skip_frames : s32 = 0) string"])
        page["param_lines"] = dval(["max_frames : maximum number of frames", "skip_frames : number of newest frames to omit", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "backtrace_capture", href: "/doc/api/backtrace-capture/"}])
        page["examples"] = dval([{entry: "cli", caption: "", body: "print(backtrace_get_frames(4, 0), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

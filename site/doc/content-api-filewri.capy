#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-write" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_write"
        page["kind"] = "api"
        page["slug"] = "file-write"
        page["route"] = "/doc/api/file-write/"
        page["title"] = "file_write"
        page["content"] = "`file_write` writes bytes at the current handle position. It advances the position.\n"
        page["returns"] = "The number of bytes written."
        page["label"] = "file_write"
        page["capy_sig_lines"] = dval(["function file_write(handle : u64, value : string) u64"])
        page["param_lines"] = dval(["handle : writable handle from `file_open`", "value : bytes to write", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var handle := file_open(\"/tmp/doc-write.txt\", \"w\")\nvar count := file_write(handle, \"hello\")\nfile_close(handle)\nprint(count, \" \", file_get_contents(\"/tmp/doc-write.txt\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

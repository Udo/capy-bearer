#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "push" {
        var page := dval({source_page: ""})
        page["source_page"] = "push"
        page["kind"] = "api"
        page["slug"] = "push"
        page["route"] = "/doc/api/push/"
        page["title"] = "Append a child"
        page["content"] = "`push(value, child)` appends `child` with the next numeric key. It changes and returns `value`.\n"
        page["returns"] = "The changed target value."
        page["label"] = "push"
        page["capy_sig_lines"] = dval(["function push(value : dval, child : as dval) dval"])
        page["param_lines"] = dval(["value : target value", "child : value to append", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "dvalue", href: "/doc/type/dvalue/"}, {label: "pop", href: "/doc/api/pop/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "var list := dval([])\nlist = push(list, \"Ada\")\nprint(list[0], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

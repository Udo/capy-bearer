#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "sqlite-affected-rows" {
        var page := dval({source_page: ""})
        page["source_page"] = "sqlite_affected_rows"
        page["kind"] = "api"
        page["slug"] = "sqlite-affected-rows"
        page["route"] = "/doc/api/sqlite-affected-rows/"
        page["title"] = "sqlite_affected_rows"
        page["content"] = "## sig\n\nfunction sqlite_affected_rows(handle : u64) u64\n\nUse `sqlite_affected_rows` after an insert, update, or delete.\n"
        page["returns"] = "Rows changed by the latest statement."
        page["label"] = "sqlite_affected_rows"
        page["capy_sig_lines"] = dval(["function sqlite_affected_rows(handle : u64) u64"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var db := sqlite_connect(\":memory:\")\nsqlite_query(db, \"create table t(id integer)\")\nsqlite_query(db, \"insert into t values(1)\")\nprint(sqlite_affected_rows(db), \"\\n\")\nsqlite_disconnect(db)\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

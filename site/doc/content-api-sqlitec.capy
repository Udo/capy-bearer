#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "sqlite-connect" {
        var page := dval({source_page: ""})
        page["source_page"] = "sqlite_connect"
        page["kind"] = "api"
        page["slug"] = "sqlite-connect"
        page["route"] = "/doc/api/sqlite-connect/"
        page["title"] = "sqlite_connect"
        page["content"] = "## sig\n\nfunction sqlite_connect(path : string) u64\n\nUse `sqlite_connect` to open an SQLite database. Call `sqlite_disconnect` when you finish with the handle.\n"
        page["returns"] = "SQLite handle, or zero when the connection fails."
        page["label"] = "sqlite_connect"
        page["capy_sig_lines"] = dval(["function sqlite_connect(path : string) u64"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var db := sqlite_connect(\":memory:\")\nprint(db != 0, \"\\n\")\nif db != 0 { sqlite_disconnect(db) }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "cli" {
        var page := dval({source_page: ""})
        page["source_page"] = "1_CLI"
        page["kind"] = "api"
        page["slug"] = "cli"
        page["route"] = "/doc/api/cli/"
        page["title"] = "CLI"
        page["content"] = "`function CLI(request : dval)` defines the Capy local command entrypoint.\n\nEvery Capy Bearer handler has exactly one parameter. The parameter name is `request`. Its type is `dval`. The value is a copied request snapshot. Bearer calls this handler through its local CLI socket.\n\nRead input from the request fields. Use response, session, output, and WebSocket functions for effects. The compiler rejects zero parameters, other parameter types, extra parameters, return types, and handler overloads.\n\nC++ declares `CLI(Request& context)`. Its live `context` provides query, POST, body, parameter, header, and response access. C++ can test `context.params[\"BEARER_CLI\"]` and read `context.params[\"SCRIPT_FILENAME\"]`.\n"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "CLI"
        page["sig_lines"] = dval(["CLI(Request& context)", ""])
        page["capy_sig_lines"] = dval(["function CLI(request : dval)"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">0_Request", ">1_RENDER", ">1_COMPONENT", ">1_CLI", ">1_WS"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

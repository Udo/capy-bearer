#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "cli" {
        var page := dval({source_page: ""})
        page["source_page"] = "1_CLI"
        page["kind"] = "api"
        page["slug"] = "cli"
        page["route"] = "/doc/api/cli/"
        page["title"] = "CLI"
        page["content"] = "`CLI` defines the local command entrypoint.\n\nThe handler has one parameter named `request` with type `dval`. Read command data from the request snapshot. Use `print` to write command output.\n"
        page["label"] = "CLI"
        page["capy_sig_lines"] = dval(["function CLI(request : dval)"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_Request", "1_RENDER"])
        page["examples"] = dval([{entry: "cli", caption: "", body: "print(string(request.method, \"\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

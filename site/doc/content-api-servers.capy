#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "server-start-http" {
        var page := dval({source_page: ""})
        page["source_page"] = "server_start_http"
        page["kind"] = "api"
        page["slug"] = "server-start-http"
        page["route"] = "/doc/api/server-start-http/"
        page["title"] = "server_start_http"
        page["content"] = "`server_start_http()` starts or updates a custom HTTP listener. The handler file must define `SERVE_HTTP`.\n"
        page["returns"] = "The listener process ID, or `0`."
        page["label"] = "server_start_http"
        page["capy_sig_lines"] = dval(["function server_start_http(key : string, bind : string, file : string, callback : string = \"\") s32"])
        page["param_lines"] = dval(["key : listener key", "bind : TCP port or Unix socket path", "file : handler file", "callback : optional handler name", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var pid := server_start_http(\"docs-server\", \"29994\", \"servers/http.capy\", \"named\")\nprint(pid, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "server-stop" {
        var page := dval({source_page: ""})
        page["source_page"] = "server_stop"
        page["kind"] = "api"
        page["slug"] = "server-stop"
        page["route"] = "/doc/api/server-stop/"
        page["title"] = "server_stop"
        page["content"] = "`server_stop()` removes the custom HTTP listener for `key`.\n"
        page["returns"] = "`true` if no listener remains."
        page["label"] = "server_stop"
        page["capy_sig_lines"] = dval(["function server_stop(key : string) bool"])
        page["param_lines"] = dval(["key : listener key", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(server_stop(\"docs-server\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

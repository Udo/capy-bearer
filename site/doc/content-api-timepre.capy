#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "time-precise" {
        var page := dval({source_page: ""})
        page["source_page"] = "time_precise"
        page["kind"] = "api"
        page["slug"] = "time-precise"
        page["route"] = "/doc/api/time-precise/"
        page["title"] = "time_precise"
        page["content"] = "`time_precise` returns the current Unix timestamp with fractional seconds.\n"
        page["returns"] = "current Unix timestamp with fractional seconds"
        page["label"] = "time_precise"
        page["capy_sig_lines"] = dval(["function time_precise() f64"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">time", "usleep", "time", "time_format_local", "time_format_relative", "time_format_utc", "time_parse"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(time_precise(), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

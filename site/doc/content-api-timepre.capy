#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "time-precise" {
        var page := dval({source_page: ""})
        page["source_page"] = "time_precise"
        page["kind"] = "api"
        page["slug"] = "time-precise"
        page["route"] = "/doc/api/time-precise/"
        page["title"] = "time_precise"
        page["content"] = "Call `time_precise()` to get the current Unix timestamp as an `f64`.\n\nUse this value to measure elapsed time within an operation. C++ uses the same no-input call and return value.\n\n"
        page["returns"] = "current Unix timestamp as an `f64`"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "time_precise"
        page["sig_lines"] = dval(["f64 time_precise()", ""])
        page["capy_sig_lines"] = dval(["function time_precise() f64"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">time", "usleep", "time", "time_format_local", "time_format_relative", "time_format_utc", "time_parse"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "socket-close" {
        var page := dval({source_page: ""})
        page["source_page"] = "socket_close"
        page["kind"] = "api"
        page["slug"] = "socket-close"
        page["route"] = "/doc/api/socket-close/"
        page["title"] = "socket_close"
        page["content"] = "## sig\n\nfunction socket_close(handle : u64)\n\nUse `socket_close` after socket work. Do not use the handle after this call.\n"
        page["label"] = "socket_close"
        page["capy_sig_lines"] = dval(["function socket_close(handle : u64)"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var handle := socket_connect(\"127.0.0.1\", 1)\nif handle != 0 { socket_close(handle) }\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "socket-connect" {
        var page := dval({source_page: ""})
        page["source_page"] = "socket_connect"
        page["kind"] = "api"
        page["slug"] = "socket-connect"
        page["route"] = "/doc/api/socket-connect/"
        page["title"] = "socket_connect"
        page["content"] = "## sig\n\nfunction socket_connect(host : string, port : s32) u64\n\nUse `socket_connect` to open a socket to an IPv4 address and port. Pass a nonzero handle to the socket functions.\n"
        page["returns"] = "Socket handle, or zero when the connection fails."
        page["label"] = "socket_connect"
        page["capy_sig_lines"] = dval(["function socket_connect(host : string, port : s32) u64"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var handle := socket_connect(\"127.0.0.1\", 80)\nprint(handle, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "each" {
        var page := dval({source_page: ""})
        page["source_page"] = "each"
        page["kind"] = "api"
        page["slug"] = "each"
        page["route"] = "/doc/api/each/"
        page["title"] = "Call a function for each string"
        page["content"] = "`each` calls `callback` once for each item in a list-shaped `dval`.\n\nThe callback receives a string value. `each` processes items in list order.\n"
        page["returns"] = "This function returns no value."
        page["label"] = "each"
        page["capy_sig_lines"] = dval(["function each(items : dval, callback : function(value : string) string)"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var items := split(\"one,two\", \",\")\neach(items, function(value : string) string { print(value); return \"\" })\nprint(\"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

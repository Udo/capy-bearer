#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "job-cancel" {
        var page := dval({source_page: ""})
        page["source_page"] = "job_cancel"
        page["kind"] = "api"
        page["slug"] = "job-cancel"
        page["route"] = "/doc/api/job-cancel/"
        page["title"] = "job_cancel"
        page["content"] = "`job_cancel()` requests cancellation of a job.\n\nUse it to stop a job that no longer has a useful result. Its status then reports `cancelled`.\n\nIn Capy, pass the job ID as `dval`. In Capy, pass the `u64` job ID shown above.\n"
        page["returns"] = "`true` when Bearer cancels an active job. Otherwise, `false`."
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "job_cancel"
        page["sig_lines"] = dval(["bool job_cancel(u64 job_id)", ""])
        page["capy_sig_lines"] = dval(["function job_cancel(job : dval) bool"])
        page["param_lines"] = dval(["job : the Capy `dval` job ID. Capy uses a `u64` ID.", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "job_await", "file_unlink", "job_result", "zip_create", "job_status", "zip_list"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>u8</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function u8(value : as string, opt : dval = {}) u8</pre></div><div class=\"doc-section content\"><p><code>u8()</code> parses text in the range 0 through 255. Invalid, negative, or out-of-range text returns <code>opt.fallback</code>. The default fallback is <code>0</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : scalar value or text to convert</p></div><div><p>opt : options map with <code>fallback</code> and <code>base</code></p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>An unsigned 8-bit integer, or <code>opt.fallback</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(u8(&quot;ff&quot;, {base: 16}), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/bool/\">bool</a><a class=\"related-link\" href=\"/doc/type/s8/\">s8</a><a class=\"related-link\" href=\"/doc/type/s16/\">s16</a><a class=\"related-link\" href=\"/doc/type/s32/\">s32</a><a class=\"related-link\" href=\"/doc/type/s64/\">s64</a><a class=\"related-link\" href=\"/doc/type/u16/\">u16</a><a class=\"related-link\" href=\"/doc/type/u32/\">u32</a><a class=\"related-link\" href=\"/doc/type/u64/\">u64</a><a class=\"related-link\" href=\"/doc/type/f32/\">f32</a><a class=\"related-link\" href=\"/doc/type/f64/\">f64</a><a class=\"related-link\" href=\"/doc/api/string/\">string</a><a class=\"related-link\" href=\"/doc/api/dval/\">dval</a><a class=\"related-link\" href=\"/doc/type/struct/\">struct</a><a class=\"related-")
    print("link\" href=\"/doc/type/array/\">array</a><a class=\"related-link\" href=\"/doc/type/function/\">function value</a><a class=\"related-link\" href=\"/doc/type/module/\">module</a></aside></div>")
}

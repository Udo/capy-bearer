function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>bool</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function bool(value : dval, opt : dval = {}) bool</pre></div><div class=\"doc-section content\"><p><code>bool()</code> converts a <code>dval</code> to a Boolean value. <code>opt.fallback</code> is the result when conversion fails. It defaults to <code>false</code>. An empty or missing <code>dval</code> fails conversion and uses the fallback. Use <code>value?</code> before conversion when presence matters.</p><p><code>bool()</code> deliberately keeps a <code>dval</code> first parameter. Strings cannot be conditions. A string must pass through <code>dval()</code> before conversion, so <code>if &quot;true&quot;</code> remains a compile error.</p><p>The options map accepts only <code>fallback</code>. An unknown key, including <code>base</code>, is an error.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : dynamic value to convert</p></div><div><p>opt : options map with <code>fallback</code></p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A Boolean value, or <code>opt.fallback</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(bool(dval(&quot;YES&quot;)), &quot;\\n&quot;)\nprint(bool(dval(&quot;unknown&quot;), {fallback: true}), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/s8/\">s8</a><a class=\"related-link\" href=\"/doc/type/s16/\">s16</a><a class=\"related-link\" href=\"/doc/type/s32/\">s32</a><a class=\"related-link\" href=\"/doc/typ")
    print("e/s64/\">s64</a><a class=\"related-link\" href=\"/doc/type/u8/\">u8</a><a class=\"related-link\" href=\"/doc/type/u16/\">u16</a><a class=\"related-link\" href=\"/doc/type/u32/\">u32</a><a class=\"related-link\" href=\"/doc/type/u64/\">u64</a><a class=\"related-link\" href=\"/doc/type/f32/\">f32</a><a class=\"related-link\" href=\"/doc/type/f64/\">f64</a><a class=\"related-link\" href=\"/doc/api/string/\">string</a><a class=\"related-link\" href=\"/doc/api/dval/\">dval</a><a class=\"related-link\" href=\"/doc/type/struct/\">struct</a><a class=\"related-link\" href=\"/doc/type/array/\">array</a><a class=\"related-link\" href=\"/doc/type/function/\">function value</a><a class=\"related-link\" href=\"/doc/type/module/\">module</a></aside></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>String</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>type string</pre></div><div class=\"doc-section content\"><p><code>string</code> stores text or raw bytes in Capy.</p><p>Use string literals, variables, parameters, and return values directly. Use <code>length</code>, <code>find</code>, <code>contains</code>, <code>replace</code>, <code>lower</code>, <code>upper</code>, and <code>substr</code> for common text work.</p><p>Use <code>split_utf8</code> when you must split UTF-8 text by characters.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var name := &quot;Ada&quot;\nprint(upper(name), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/split-utf8/\">split_utf8</a><a class=\"related-link\" href=\"/doc/api/substr/\">substr</a><a class=\"related-link\" href=\"/doc/api/html-escape/\">html_escape</a></aside></div>")
}

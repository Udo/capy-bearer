function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>read-request-context</h2></div><div class=\"doc-section content\"><p>Handlers receive request data in <code>request</code>.</p><p>Use <code>request.url.script</code> for the script URL. Use <code>request.url.base</code> for the base URL. Use <code>request.route.path</code>, <code>request.route.page</code>, <code>request.route.raw_path</code>, and <code>request.route.valid</code> for route data.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(string(request.route.path), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/request/\">Request</a><a class=\"related-link\" href=\"/doc/api/redirect/\">redirect</a></aside></div>")
}

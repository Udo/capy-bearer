function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>INIT</h2></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function INIT(request : dval)</pre></div><div class=\"doc-section content\"><p><code>INIT</code> defines the unit materialization hook.</p><p>Bearer runs this hook before dispatch in a request workspace. The handler has one parameter named <code>request</code> with type <code>dval</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(string(request.method), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/handler/render/\">RENDER</a><a class=\"related-link\" href=\"/doc/handler/cli/\">CLI</a><a class=\"related-link\" href=\"/doc/handler/ws/\">WS</a><a class=\"related-link\" href=\"/doc/handler/once/\">ONCE</a><a class=\"related-link\" href=\"/doc/type/request/\">Request</a></aside></div>")

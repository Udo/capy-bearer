function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>CLI</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function CLI(request : dval)</pre></div><div class=\"doc-section content\"><p><code>CLI</code> defines the local command entrypoint.</p><p>The handler has one parameter named <code>request</code> with type <code>dval</code>. Read command data from the request snapshot. Use <code>print</code> to write command output.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(string(request.method), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/request/\">request</a><a class=\"related-link\" href=\"/doc/handler/render/\">render</a></aside></div>")

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>WS</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function WS(request : dval)</pre></div><div class=\"doc-section content\"><p><code>WS</code> defines the WebSocket message handler.</p><p>The handler has one parameter named <code>request</code> with type <code>dval</code>. Read the message from <code>request.body</code>. Read connection data from <code>request.websocket</code>.</p><p>Use <code>ws_send</code>, <code>ws_send_to</code>, or <code>ws_close</code> to affect the connection.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">ws_send(&quot;echo: &quot; + string(request.body), false)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/request/\">request</a><a class=\"related-link\" href=\"/doc/handler/render/\">render</a></aside></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>sha256</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function sha256(value : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>sha256()</code> returns 32 raw SHA-256 bytes. Use <code>hex(sha256(value))</code> when you need lowercase hexadecimal text.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>Raw 32-byte SHA-256 digest.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(hex(sha256(&quot;abc&quot;)), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/hex/\">hex</a></aside></div>")
}

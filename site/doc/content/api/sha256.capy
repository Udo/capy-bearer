function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "sha256"
    page["kind"] = "api"
    page["slug"] = "sha256"
    page["route"] = "/doc/api/sha256/"
    page["title"] = "sha256"
    page["content"] = "Use `sha256` to create a raw SHA-256 digest. Use `sha256_hex` when you need hexadecimal text.\n"
    page["returns"] = "Raw 32-byte SHA-256 digest."
    page["label"] = "sha256"
    page["capy_sig_lines"] = dval(["function sha256(value : string) string"])
    page["param_lines"] = dval([])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([])
    page["examples"] = dval([{entry: "render", caption: "", body: "print(length(sha256(\"abc\")), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

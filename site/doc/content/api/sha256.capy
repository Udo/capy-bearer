function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>sha256</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function sha256(value : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>sha256</code> to create a raw SHA-256 digest. Use <code>sha256_hex</code> when you need hexadecimal text.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>Raw 32-byte SHA-256 digest.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(length(sha256(&quot;abc&quot;)), &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

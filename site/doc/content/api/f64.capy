function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>f64</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function f64(value : dval, fallback : f64 = 0.0) f64\nfunction f64(value : string, fallback : f64 = 0.0) f64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>f64</code> converts a <code>dval</code> or a string to a floating-point value. The string form removes leading and trailing spaces. The value must contain a complete decimal number.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : value to convert</p></div><div><p>fallback : value to return when conversion fails</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>An <code>f64</code> value, or <code>fallback</code>.</p></div><div class=\"doc-section\"><h3>Errors</h3><p><code>f64</code> does not trap for an invalid conversion. It returns <code>fallback</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(f64(&quot; 3.5 &quot;), &quot;\\n&quot;)\nprint(f64(&quot;not a number&quot;, 9.0), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/f64/\">f64</a><a class=\"related-link\" href=\"/doc/api/s64/\">s64</a><a class=\"related-link\" href=\"/doc/api/u64/\">u64</a></aside></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>var_dump</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function var_dump(value : dval, prefix : string = &quot;&quot;, postfix : string = &quot;&quot;) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>var_dump</code> formats a <code>dval</code> as a string.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : value to format</p></div><div><p>prefix : text before the formatted value</p></div><div><p>postfix : text after the formatted value</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>formatted string</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(var_dump(dval({&quot;name&quot;: &quot;Ada&quot;})), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/print/\">print</a><a class=\"related-link\" href=\"/doc/api/ob-start/\">ob_start</a><a class=\"related-link\" href=\"/doc/api/ob-get/\">ob_get</a><a class=\"related-link\" href=\"/doc/api/ob-get-close/\">ob_get_close</a><a class=\"related-link\" href=\"/doc/api/ob-close/\">ob_close</a><a class=\"related-link\" href=\"/doc/type/dvalue/\">Dynamic values</a><a class=\"related-link\" href=\"/doc/api/json-encode/\">json_encode</a></aside></div>")

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>socket_write</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function socket_write(handle : u64, data : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>socket_write</code> to send data to a socket.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> when the write succeeds.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var handle := socket_connect(&quot;127.0.0.1&quot;, 1)\nif handle != 0 { print(socket_write(handle, &quot;hello&quot;), &quot;\\n&quot;); socket_close(handle) }\n</pre></div></div></main></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>u64</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function u64(value : dval, fallback : u64 = 0) u64\nfunction u64(value : string, fallback : u64 = 0) u64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>u64</code> converts a <code>dval</code> or <code>string</code> to <code>u64</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : value to convert</p></div><div><p>fallback : value to return if conversion fails</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>converted <code>u64</code>, or <code>fallback</code></p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(u64(&quot;42&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/u64/\">u64</a><a class=\"related-link\" href=\"/doc/api/s64/\">s64</a><a class=\"related-link\" href=\"/doc/api/f64/\">f64</a><a class=\"related-link\" href=\"/doc/api/bool/\">bool</a><a class=\"related-link\" href=\"/doc/api/string/\">string</a></aside></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>base64_decode</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function base64_decode(value : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>base64_decode</code> decodes Base64 text into a string.</p><p>Invalid Base64 text returns an empty string.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : Base64 text</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>the decoded string</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(base64_decode(&quot;aGVsbG8=&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/base64-encode/\">base64_encode</a></aside></div>")
}

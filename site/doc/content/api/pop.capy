function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>Remove the final child</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function pop(value : dval) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>pop(value)</code> removes the final child and returns <code>value</code>. It does not return the removed child.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : target value</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>The changed target value.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var list := dval([&quot;first&quot;, &quot;last&quot;])\nlist = pop(list)\nprint(list[0], &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/dvalue/\">dvalue</a><a class=\"related-link\" href=\"/doc/api/push/\">push</a></aside></div>")
}

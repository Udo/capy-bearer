function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>lower</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function lower(value : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>lower()</code> converts uppercase ASCII characters to lowercase. It does not convert Unicode case.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : text to convert</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>Text with uppercase ASCII characters converted to lowercase.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(lower(&quot;BEARER&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/upper/\">upper</a><a class=\"related-link\" href=\"/doc/api/length/\">length</a></aside></div>")
}

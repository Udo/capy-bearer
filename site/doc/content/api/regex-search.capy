function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>regex_search</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function regex_search(pattern : string, subject : string, flags : string = &quot;&quot;) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>The result contains <code>matched</code>. A matching result also contains <code>match</code>, <code>start</code>, <code>end</code>, <code>captures</code>, and <code>named</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>pattern : regular expression</p></div><div><p>subject : text to search</p></div><div><p>flags : regular expression flags</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>Data for the first match.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var match := regex_search(&quot;[a-z]+&quot;, &quot;123 capy&quot;)\nprint(string(match.match, &quot;&quot;), &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

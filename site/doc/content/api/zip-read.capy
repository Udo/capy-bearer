function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "zip_read"
    page["kind"] = "api"
    page["slug"] = "zip-read"
    page["route"] = "/doc/api/zip-read/"
    page["title"] = "zip_read"
    page["content"] = "`zip_read()` returns one ZIP archive entry.\n"
    page["returns"] = "The uncompressed entry bytes."
    page["label"] = "zip_read"
    page["capy_sig_lines"] = dval(["function zip_read(path : string, entry : string) string"])
    page["param_lines"] = dval(["path : archive path", "entry : entry name", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "zip_create", href: "/doc/api/zip-create/"}, {label: "zip_list", href: "/doc/api/zip-list/"}, {label: "zip_extract", href: "/doc/api/zip-extract/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var archive := file_temp(\"/tmp/capy-zip-\") + \".zip\"\nzip_create(archive, dval({\"note.txt\": \"hello\"}))\nprint(zip_read(archive, \"note.txt\"), \"\\n\")\nfile_unlink(archive)\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

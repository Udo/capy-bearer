function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>unit_compile</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function unit_compile(path : string = &quot;&quot;) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>unit_compile</code> compiles a unit.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>path : unit path. An empty path selects the current unit</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> if the compiler compiles the unit</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(unit_compile(&quot;capy-files.capy&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/unit-load/\">unit_load</a><a class=\"related-link\" href=\"/doc/api/call/\">call</a><a class=\"related-link\" href=\"/doc/api/unit-call/\">unit_call</a><a class=\"related-link\" href=\"/doc/api/unit-render/\">unit_render</a><a class=\"related-link\" href=\"/doc/api/unit-info/\">unit_info</a><a class=\"related-link\" href=\"/doc/api/units-list/\">units_list</a></aside></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>ob_close</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function ob_close()</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>ob_close()</code> discards the current output buffer and returns to the previous buffer.</p><p>Use it when you do not need the buffered output.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">ob_start()\nprint(&quot;discarded&quot;)\nob_close()\nprint(&quot;kept\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/ob-start/\">ob_start</a><a class=\"related-link\" href=\"/doc/api/ob-get-close/\">ob_get_close</a></aside></div>")
}

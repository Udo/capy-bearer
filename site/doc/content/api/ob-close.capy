function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "ob_close"
    page["kind"] = "api"
    page["slug"] = "ob-close"
    page["route"] = "/doc/api/ob-close/"
    page["title"] = "ob_close"
    page["content"] = "`ob_close()` discards the current output buffer and returns to the previous buffer.\n\nUse it when you do not need the buffered output.\n"
    page["label"] = "ob_close"
    page["capy_sig_lines"] = dval(["function ob_close()"])
    page["param_lines"] = dval([])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "ob_start", href: "/doc/api/ob-start/"}, {label: "ob_get_close", href: "/doc/api/ob-get-close/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "ob_start()\nprint(\"discarded\")\nob_close()\nprint(\"kept\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

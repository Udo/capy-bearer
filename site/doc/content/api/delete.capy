function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>Delete a child</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function delete(value : dval, key : string) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>delete(value, key)</code> removes <code>key</code> from <code>value</code>. A missing key leaves the value unchanged.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : target value</p></div><div><p>key : child key</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>The changed target value.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var user := dval({&quot;name&quot;: &quot;Ada&quot;, &quot;role&quot;: &quot;admin&quot;})\nuser = delete(user, &quot;role&quot;)\nprint(has(user, &quot;role&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/dvalue/\">dvalue</a><a class=\"related-link\" href=\"/doc/api/has/\">has</a></aside></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>Test any string</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function some(items : dval, predicate : function(value : string) bool) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>some</code> tests each string in a list-shaped <code>dval</code> with <code>predicate</code>.</p><p>This function does not change <code>items</code>.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>This function returns <code>true</code> when any item matches. It returns <code>false</code> for an empty list.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var items := split(&quot;one,two&quot;, &quot;,&quot;)\nprint(some(items, function(value : string) bool { return value == &quot;two&quot; }), &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>http_request_async</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function http_request_async(request : dval) u64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>http_request_async()</code> starts an outbound request and returns its job ID. Use <code>job_await()</code> or <code>job_result()</code> to get the response map.</p><p>The request map follows the <code>http_request()</code> rules.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>request : a map that describes an outbound request</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A job ID.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var outbound := dval({&quot;method&quot;: &quot;GET&quot;, &quot;url&quot;: &quot;http://127.0.0.1/tests/capy-render.capy&quot;, &quot;headers&quot;: {&quot;Host&quot;: &quot;bearer.openfu.com&quot;}, &quot;timeout_ms&quot;: 2000})\nvar job := http_request_async(outbound)\nvar done := job_await(dval(job), 3000)\nprint(s32(get_by_path(done, &quot;result/status&quot;)), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/http-request/\">http_request</a><a class=\"related-link\" href=\"/doc/api/job-await/\">job_await</a><a class=\"related-link\" href=\"/doc/api/job-result/\">job_result</a></aside></div>")
}

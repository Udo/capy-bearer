function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "http_request_async"
    page["kind"] = "api"
    page["slug"] = "http-request-async"
    page["route"] = "/doc/api/http-request-async/"
    page["title"] = "http_request_async"
    page["content"] = "`http_request_async()` starts an outbound request and returns its job ID. Use `job_await()` or `job_result()` to get the response map.\n\nThe request map follows the `http_request()` rules.\n"
    page["returns"] = "A job ID."
    page["label"] = "http_request_async"
    page["capy_sig_lines"] = dval(["function http_request_async(request : dval) u64"])
    page["param_lines"] = dval(["request : a map that describes an outbound request", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "http_request", href: "/doc/api/http-request/"}, {label: "job_await", href: "/doc/api/job-await/"}, {label: "job_result", href: "/doc/api/job-result/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var outbound := dval({\"method\": \"GET\", \"url\": \"http://127.0.0.1/tests/capy-render.capy\", \"headers\": {\"Host\": \"bearer.openfu.com\"}, \"timeout_ms\": 2000})\nvar job := http_request_async(outbound)\nvar done := job_await(dval(job), 3000)\nprint(s32(get_by_path(done, \"result/status\")), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

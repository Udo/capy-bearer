function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>s32</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function s32(value : dval, fallback : s32 = 0) s32\nfunction s32(value : string, fallback : s32 = 0) s32</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>s32()</code> converts supported scalar values and integer text. It returns <code>fallback</code> when conversion fails.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : value to convert</p></div><div><p>fallback : value for a failed conversion</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A signed 32-bit integer, or <code>fallback</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(s32(&quot;42&quot;, -1), &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

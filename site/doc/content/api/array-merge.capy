function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>array_merge</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function array_merge(left : dval, right : dval) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>array_merge</code> combines two <code>dval</code> values. It returns a new value.</p><p>For maps, values from <code>right</code> replace matching values from <code>left</code>. The function also merges lists.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>left : first value</p></div><div><p>right : second value</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>a merged <code>dval</code> value</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var merged := array_merge(dval({&quot;name&quot;: &quot;Ada&quot;}), dval({&quot;role&quot;: &quot;admin&quot;}))\nprint(merged[&quot;name&quot;], &quot; &quot;, merged[&quot;role&quot;], &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/json-decode/\">json_decode</a></aside></div>")
}

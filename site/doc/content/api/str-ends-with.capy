function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>str_ends_with</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function str_ends_with(haystack : string, needle : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>str_ends_with</code> to test a string suffix.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> when the text ends with the suffix.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(str_ends_with(&quot;index.capy&quot;, &quot;.capy&quot;), &quot;\\n&quot;)\n</pre></div></div></main></div>")

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>cwd_get</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function cwd_get() string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>cwd_get()</code> returns the current working directory path.</p><p>Save this path before <code>cwd_set()</code> when you must restore the directory.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>The current working directory path.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(cwd_get() != &quot;&quot;, &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/basename/\">basename</a><a class=\"related-link\" href=\"/doc/api/dirname/\">dirname</a><a class=\"related-link\" href=\"/doc/api/path-join/\">path_join</a><a class=\"related-link\" href=\"/doc/api/path-normalize/\">path_normalize</a><a class=\"related-link\" href=\"/doc/api/cwd-set/\">cwd_set</a></aside></div>")

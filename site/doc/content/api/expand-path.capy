function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>expand_path</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function expand_path(path : string, relative_to_path : string = &quot;&quot;) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>expand_path()</code> returns an expanded path string.</p><p>Pass a path and an optional base directory. It resolves a relative path against the base directory.</p><p>Without a base directory, it uses the current unit directory.</p><p>Use the returned path with file APIs.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>path : path to expand</p></div><div><p>relative<em>to</em>path : base directory for a relative path</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>expanded path</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(expand_path(&quot;sub/page.capy&quot;, &quot;/var/www/site&quot;), &quot;\\n&quot;)</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/path-join/\">path_join</a><a class=\"related-link\" href=\"/doc/api/path-real/\">path_real</a><a class=\"related-link\" href=\"/doc/api/dirname/\">dirname</a><a class=\"related-link\" href=\"/doc/api/file-append/\">file_append</a><a class=\"related-link\" href=\"/doc/api/basename/\">basename</a><a class=\"related-link\" href=\"/doc/api/file-exists/\">file_exists</a></aside></div>")
}

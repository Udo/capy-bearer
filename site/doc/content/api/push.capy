function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>Append a child</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function push(value : dval, child : as dval) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>push(value, child)</code> appends <code>child</code> with the next numeric key. It changes and returns <code>value</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : target value</p></div><div><p>child : value to append</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>The changed target value.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var list := dval([])\nlist = push(list, &quot;Ada&quot;)\nprint(list[0], &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/dvalue/\">dvalue</a><a class=\"related-link\" href=\"/doc/api/pop/\">pop</a></aside></div>")
}

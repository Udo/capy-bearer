function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "redirect"
    page["kind"] = "api"
    page["slug"] = "redirect"
    page["route"] = "/doc/api/redirect/"
    page["title"] = "redirect"
    page["content"] = "`redirect()` sets the response location and status. The default status is `302`.\n"
    page["label"] = "redirect"
    page["capy_sig_lines"] = dval(["function redirect(url : string, code : s32 = 302)"])
    page["param_lines"] = dval(["url : redirect target URL", "code : HTTP status code", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([])
    page["examples"] = dval([{entry: "render", caption: "", body: "redirect(\"/next\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

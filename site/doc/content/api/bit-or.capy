function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>bit_or</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function bit_or(a : s8, b : s8) s8\nfunction bit_or(a : s16, b : s16) s16\nfunction bit_or(a : s32, b : s32) s32\nfunction bit_or(a : s64, b : s64) s64\nfunction bit_or(a : u8, b : u8) u8\nfunction bit_or(a : u16, b : u16) u16\nfunction bit_or(a : u32, b : u32) u32\nfunction bit_or(a : u64, b : u64) u64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>bit_or()</code> returns the bitwise OR of <code>a</code> and <code>b</code>.</p><p>The compiler emits a direct lib call.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>a : the first integer value</p></div><div><p>b : the second integer value</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>An integer with the same type as the inputs.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var value := bit_or(u8(12), u8(10))\nprint(value, &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/bit-and/\">bit_and</a><a class=\"related-link\" href=\"/doc/api/bit-xor/\">bit_xor</a><a class=\"related-link\" href=\"/doc/api/bit-not/\">bit_not</a><a class=\"related-link\" href=\"/doc/api/bit-shl/\">bit_shl</a><a class=\"related-link\" href=\"/doc/api/bit-shr/\">bit_shr</a><a class=\"related-link\" href=\"/doc/api/bit-rotate-left/\">bit_rotate_left</a><a class=\"related-link\" href=\"/doc/api/bit-rotate-right/\">bit_rotate_right</a><a class=\"related-link\" href=\"/doc/api/bit-count-lz/\">bit_count_lz</a><a class=\"related-lin")
    print("k\" href=\"/doc/api/bit-count-tz/\">bit_count_tz</a><a class=\"related-link\" href=\"/doc/api/bit-count-1/\">bit_count_1</a><a class=\"related-link\" href=\"/doc/api/bits-of/\">bits_of</a><a class=\"related-link\" href=\"/doc/api/f64-from-bits/\">f64_from_bits</a><a class=\"related-link\" href=\"/doc/api/f32-from-bits/\">f32_from_bits</a></aside></div>")
}

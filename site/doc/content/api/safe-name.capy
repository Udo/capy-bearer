function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "safe_name"
    page["kind"] = "api"
    page["slug"] = "safe-name"
    page["route"] = "/doc/api/safe-name/"
    page["title"] = "safe_name"
    page["content"] = "`safe_name()` removes all other characters. The result can be empty.\n"
    page["returns"] = "Text that contains only letters, digits, and `_`."
    page["label"] = "safe_name"
    page["capy_sig_lines"] = dval(["function safe_name(raw : string) string"])
    page["param_lines"] = dval(["raw : source text", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([])
    page["examples"] = dval([{entry: "render", caption: "", body: "print(safe_name(\"Capy docs-2024\"), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

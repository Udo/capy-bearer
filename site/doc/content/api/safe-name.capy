function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>safe_name</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function safe_name(raw : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>safe_name()</code> removes all other characters. The result can be empty.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>raw : source text</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>Text that contains only letters, digits, and <code>_</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(safe_name(&quot;Capy docs-2024&quot;), &quot;\\n&quot;)\n</pre></div></div></main></div>")

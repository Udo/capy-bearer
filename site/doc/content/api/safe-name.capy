    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>safe_name</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function safe_name(raw : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>safe_name()</code> removes all other characters. The result can be empty.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>raw : source text</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>Text that contains only letters, digits, and <code>_</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(safe_name(&quot;Capy docs-2024&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/string/\">String</a><a class=\"related-link\" href=\"/doc/api/string-from-bytes/\">string_from_bytes</a><a class=\"related-link\" href=\"/doc/api/bytes-of/\">bytes_of</a><a class=\"related-link\" href=\"/doc/api/substr/\">substr</a><a class=\"related-link\" href=\"/doc/api/strpos/\">strpos</a><a class=\"related-link\" href=\"/doc/api/contains/\">contains</a><a class=\"related-link\" href=\"/doc/api/replace/\">replace</a><a class=\"related-link\" href=\"/doc/api/trim/\">trim</a><a class=\"related-link\" href=\"/doc/api/join/\">join</a><a class=\"related-link\" href=\"/doc/api/first/\">first</a><a class=\"related-link\" href=\"/doc/api/nibble/\">nibble</a><a class=\"related-link\" href=\"/doc/api/clone/\">clone</a><a class=\"related-link\" href=\"/doc/api/str-starts-with/\">str_starts_with</a><a class=\"related-link\" href=\"/doc/api/str-ends-with/\">str_ends_with</a><a class=\"related-link\" hr")

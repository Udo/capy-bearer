function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "basename"
    page["kind"] = "api"
    page["slug"] = "basename"
    page["route"] = "/doc/api/basename/"
    page["title"] = "basename"
    page["content"] = "`basename` returns the final component of a path.\n\nIt does not access the file system.\n"
    page["returns"] = "the final path component"
    page["label"] = "basename"
    page["capy_sig_lines"] = dval(["function basename(path : string) string"])
    page["param_lines"] = dval(["path : a path string", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "dirname", href: "/doc/api/dirname/"}, {label: "path_join", href: "/doc/api/path-join/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "print(basename(\"/var/www/site/index.capy\"), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

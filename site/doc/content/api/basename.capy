function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>basename</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function basename(path : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>basename</code> returns the final component of a path.</p><p>It does not access the file system.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>path : a path string</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>the final path component</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(basename(&quot;/var/www/site/index.capy&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/dirname/\">dirname</a><a class=\"related-link\" href=\"/doc/api/path-join/\">path_join</a><a class=\"related-link\" href=\"/doc/api/path-normalize/\">path_normalize</a><a class=\"related-link\" href=\"/doc/api/cwd-get/\">cwd_get</a><a class=\"related-link\" href=\"/doc/api/cwd-set/\">cwd_set</a></aside></div>")
}

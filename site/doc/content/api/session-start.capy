function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>session_start</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function session_start(name : string = &quot;bearer-session&quot;) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>session_start()</code> restores the named session or creates one.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>name : session cookie name</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>The current session state.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var session := session_start(&quot;docs-session&quot;)\nprint(string(session.id, &quot;&quot;), &quot;\\n&quot;)\n</pre></div></div></main></div>")

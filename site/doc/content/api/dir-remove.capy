function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>dir_remove</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function dir_remove(path : string, recursive : bool = false) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>dir_remove()</code> removes a directory.</p><p>Without <code>recursive</code>, the directory must be empty. With <code>recursive = true</code>, it removes every contained file and directory.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>path : the directory path to remove</p></div><div><p>recursive : <code>true</code> removes the directory and its contents</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> on success.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var root := file_temp(&quot;/tmp/capy-doc-dir-remove-&quot;)\nfile_unlink(root)\nmkdir(root)\nfile_put_contents(path_join(root, &quot;child.txt&quot;), &quot;x&quot;)\nprint(dir_remove(root, true), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/ls/\">ls</a><a class=\"related-link\" href=\"/doc/api/dir-list/\">dir_list</a><a class=\"related-link\" href=\"/doc/api/mkdir/\">mkdir</a><a class=\"related-link\" href=\"/doc/api/file-unlink/\">file_unlink</a></aside></div>")
}

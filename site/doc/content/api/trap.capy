function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>trap</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function trap()</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>trap</code> stops the current handler.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>no value because execution stops</p></div><div class=\"doc-section\"><h3>Errors</h3><p><code>trap</code> always aborts execution.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">if false { trap() }\nprint(&quot;handler continues\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/backtrace-capture/\">backtrace_capture</a><a class=\"related-link\" href=\"/doc/api/backtrace-get-frames/\">backtrace_get_frames</a><a class=\"related-link\" href=\"/doc/api/posix-info/\">posix_info</a><a class=\"related-link\" href=\"/doc/api/runtime-perf/\">runtime_perf</a><a class=\"related-link\" href=\"/doc/api/unit-render/\">unit_render</a><a class=\"related-link\" href=\"/doc/api/unit-compile/\">unit_compile</a></aside></div>")
}

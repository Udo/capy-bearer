function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>print</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function print(...values : as string)</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>print()</code> converts each value to a string and writes the values in order.</p><p>It writes to the active output buffer when one exists. Otherwise, it writes to the response.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>values : the values to output</p></div><div></div></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(&quot;hello docs\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/flush-output/\">flush_output</a><a class=\"related-link\" href=\"/doc/api/ob-start/\">ob_start</a><a class=\"related-link\" href=\"/doc/api/ob-get/\">ob_get</a><a class=\"related-link\" href=\"/doc/api/ob-get-close/\">ob_get_close</a><a class=\"related-link\" href=\"/doc/api/ob-close/\">ob_close</a><a class=\"related-link\" href=\"/doc/api/var-dump/\">var_dump</a><a class=\"related-link\" href=\"/doc/api/string/\">string</a></aside></div>")
}

function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "print"
    page["kind"] = "api"
    page["slug"] = "print"
    page["route"] = "/doc/api/print/"
    page["title"] = "print"
    page["content"] = "`print()` converts each value to a string and writes the values in order.\n\nIt writes to the active output buffer when one exists. Otherwise, it writes to the response.\n"
    page["label"] = "print"
    page["capy_sig_lines"] = dval(["function print(...values : as string)"])
    page["param_lines"] = dval(["values : the values to output", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "string", href: "/doc/api/string/"}, {label: "ob_start", href: "/doc/api/ob-start/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "print(\"hello docs\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>time_precise</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function time_precise() f64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>time_precise</code> returns the current Unix timestamp with fractional seconds.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>current Unix timestamp with fractional seconds</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(time_precise(), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/time/\">time</a><a class=\"related-link\" href=\"/doc/api/time-parse/\">time_parse</a><a class=\"related-link\" href=\"/doc/api/time-format-relative/\">time_format_relative</a><a class=\"related-link\" href=\"/doc/api/time-format-local/\">time_format_local</a><a class=\"related-link\" href=\"/doc/api/time-format-utc/\">time_format_utc</a><a class=\"related-link\" href=\"/doc/api/usleep/\">usleep</a></aside></div>")

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>file_symlink</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function file_symlink(target : string, linkpath : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>file_symlink</code> creates a symbolic link at <code>linkpath</code> that points to <code>target</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>target : path for the symbolic link</p></div><div><p>linkpath : path of the new symbolic link</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> if Capy creates the link. Otherwise, <code>false</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">file_put_contents(&quot;/tmp/doc-symlink-target.txt&quot;, &quot;data&quot;)\nfile_unlink(&quot;/tmp/doc-symlink-link.txt&quot;)\nif file_symlink(&quot;/tmp/doc-symlink-target.txt&quot;, &quot;/tmp/doc-symlink-link.txt&quot;) {\n    print(file_get_contents(&quot;/tmp/doc-symlink-link.txt&quot;), &quot;\\n&quot;)\n}\n</pre></div></div></main></div>")
}

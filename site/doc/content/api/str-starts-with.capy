function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>str_starts_with</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function str_starts_with(haystack : string, needle : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>str_starts_with</code> to test a string prefix.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> when the text starts with the prefix.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(str_starts_with(&quot;/doc&quot;, &quot;/&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/string/\">String</a><a class=\"related-link\" href=\"/doc/api/string-from-bytes/\">string_from_bytes</a><a class=\"related-link\" href=\"/doc/api/bytes-of/\">bytes_of</a><a class=\"related-link\" href=\"/doc/api/substr/\">substr</a><a class=\"related-link\" href=\"/doc/api/strpos/\">strpos</a><a class=\"related-link\" href=\"/doc/api/contains/\">contains</a><a class=\"related-link\" href=\"/doc/api/replace/\">replace</a><a class=\"related-link\" href=\"/doc/api/trim/\">trim</a><a class=\"related-link\" href=\"/doc/api/join/\">join</a><a class=\"related-link\" href=\"/doc/api/first/\">first</a><a class=\"related-link\" href=\"/doc/api/nibble/\">nibble</a><a class=\"related-link\" href=\"/doc/api/clone/\">clone</a><a class=\"related-link\" href=\"/doc/api/str-ends-with/\">str_ends_with</a><a class=\"related-link\" href=\"/doc/api/lower/\">lower</a><a class=\"related-link\" href=\"/doc/api/upper/\">upper</a><a class=\"related-link\" href=\"/doc/api/safe-name/\">safe_name</a></aside></div")

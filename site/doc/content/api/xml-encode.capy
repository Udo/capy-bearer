function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "xml_encode"
    page["kind"] = "api"
    page["slug"] = "xml-encode"
    page["route"] = "/doc/api/xml-encode/"
    page["title"] = "xml_encode"
    page["content"] = "`xml_encode()` encodes a `dval` as XML. The default root name is `root`.\n"
    page["returns"] = "The XML source."
    page["label"] = "xml_encode"
    page["capy_sig_lines"] = dval(["function xml_encode(value : dval, root_name : string = \"root\") string"])
    page["param_lines"] = dval(["value : value to encode", "root_name : root element name", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "xml_decode", href: "/doc/api/xml-decode/"}, {label: "json_encode", href: "/doc/api/json-encode/"}, {label: "dvalue", href: "/doc/type/dvalue/"}, {label: "html_escape", href: "/doc/api/html-escape/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "print(xml_encode(dval({name: \"Ada\"})), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>mkdir</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function mkdir(path : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>mkdir()</code> creates one directory at <code>path</code>.</p><p>The parent directory must exist. This function does not create parent directories.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>path : the directory path</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> when the API creates the directory</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var path := file_temp(&quot;/tmp/doc-mkdir-&quot;)\nfile_unlink(path)\nprint(mkdir(path), &quot;\\n&quot;)\ndir_remove(path, true)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/ls/\">ls</a><a class=\"related-link\" href=\"/doc/api/dir-list/\">dir_list</a><a class=\"related-link\" href=\"/doc/api/dir-remove/\">dir_remove</a><a class=\"related-link\" href=\"/doc/api/path-join/\">path_join</a></aside></div>")
}

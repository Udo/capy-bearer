function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>file_temp</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function file_temp(prefix : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>file_temp</code> creates an empty file with a unique suffix.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>prefix : path prefix for the temporary file</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>The new empty file path. Returns <code>&quot;&quot;</code> on failure.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var path := file_temp(&quot;/tmp/doc-temp-&quot;)\nif path != &quot;&quot; {\n    file_put_contents(path, &quot;scratch&quot;)\n    print(file_get_contents(path), &quot;\\n&quot;)\n    file_unlink(path)\n}\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/file-get-contents/\">file_get_contents</a><a class=\"related-link\" href=\"/doc/api/file-put-contents/\">file_put_contents</a><a class=\"related-link\" href=\"/doc/api/file-append/\">file_append</a><a class=\"related-link\" href=\"/doc/api/file-exists/\">file_exists</a><a class=\"related-link\" href=\"/doc/api/file-mtime/\">file_mtime</a><a class=\"related-link\" href=\"/doc/api/file-stat/\">file_stat</a><a class=\"related-link\" href=\"/doc/api/file-unlink/\">file_unlink</a><a class=\"related-link\" href=\"/doc/api/file-rename/\">file_rename</a><a class=\"related-link\" href=\"/doc/api/file-copy/\">file_copy</a><a class=\"related-link\" href=\"/doc/api/file-truncate/\">file_truncate</a><a class=\"related-link\" hr")
    print("ef=\"/doc/api/file-chmod/\">file_chmod</a><a class=\"related-link\" href=\"/doc/api/file-symlink/\">file_symlink</a></aside></div>")
}

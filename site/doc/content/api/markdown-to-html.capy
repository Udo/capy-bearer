function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>markdown_to_html</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function markdown_to_html(source : string) string\nfunction markdown_to_html(source : string, options : dval) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>markdown_to_html()</code> renders Markdown source as HTML.</p><p>Raw HTML stays escaped unless <code>options[&quot;allow_html&quot;]</code> is true. Only enable it for trusted source.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>source : the Markdown source text</p></div><div><p>options : render options</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>the HTML text</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(markdown_to_html(&quot;**bold**&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/markdown-to-ast/\">markdown_to_ast</a></aside></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>shell_escape</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function shell_escape(raw : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>shell_escape</code> for one value in a shell command. Do not use it for shell syntax or a complete command.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>A shell-escaped word.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(shell_escape(&quot;Ada Lovelace&quot;), &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

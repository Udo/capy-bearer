function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "shell_escape"
    page["kind"] = "api"
    page["slug"] = "shell-escape"
    page["route"] = "/doc/api/shell-escape/"
    page["title"] = "shell_escape"
    page["content"] = "Use `shell_escape` for one value in a shell command. Do not use it for shell syntax or a complete command.\n"
    page["returns"] = "A shell-escaped word."
    page["label"] = "shell_escape"
    page["capy_sig_lines"] = dval(["function shell_escape(raw : string) string"])
    page["param_lines"] = dval([])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([])
    page["examples"] = dval([{entry: "render", caption: "", body: "print(shell_escape(\"Ada Lovelace\"), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

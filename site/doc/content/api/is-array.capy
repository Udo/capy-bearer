function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>Test for a container</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function is_array(value : dval) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>is_array(value)</code> returns <code>true</code> when a value has map shape. It returns <code>true</code> for both maps and lists.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : value to test</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> for a map or list.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(is_array(dval({&quot;name&quot;: &quot;Ada&quot;})), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/dvalue/\">dvalue</a><a class=\"related-link\" href=\"/doc/api/is-list/\">is_list</a></aside></div>")
}

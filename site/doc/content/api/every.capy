function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>Test every string</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function every(items : dval, predicate : function(value : string) bool) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>every</code> tests each string in a list-shaped <code>dval</code> with <code>predicate</code>.</p><p>This function does not change <code>items</code>.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>This function returns <code>true</code> when every item matches. It returns <code>true</code> for an empty list.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var items := split(&quot;one,two&quot;, &quot;,&quot;)\nprint(every(items, function(value : string) bool { return value != &quot;&quot; }), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/length/\">length</a><a class=\"related-link\" href=\"/doc/api/array-merge/\">array_merge</a><a class=\"related-link\" href=\"/doc/api/map/\">map</a><a class=\"related-link\" href=\"/doc/api/filter/\">filter</a><a class=\"related-link\" href=\"/doc/api/each/\">each</a><a class=\"related-link\" href=\"/doc/api/find/\">find</a><a class=\"related-link\" href=\"/doc/api/some/\">some</a><a class=\"related-link\" href=\"/doc/api/sort/\">sort</a><a class=\"related-link\" href=\"/doc/api/unique/\">unique</a></aside></div>")
}

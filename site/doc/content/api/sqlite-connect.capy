function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>sqlite_connect</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function sqlite_connect(path : string) u64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>sqlite_connect</code> to open an SQLite database. Call <code>sqlite_disconnect</code> when you finish with the handle.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>SQLite handle, or zero when the connection fails.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var db := sqlite_connect(&quot;:memory:&quot;)\nprint(db != 0, &quot;\\n&quot;)\nif db != 0 { sqlite_disconnect(db) }\n</pre></div></div></main></div>")
}

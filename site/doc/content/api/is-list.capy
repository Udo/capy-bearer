function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>Test for a list</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function is_list(value : dval) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>is_list(value)</code> tests whether a value is a list.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : value to test</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> for a list-shaped value.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(is_list(dval([&quot;Ada&quot;])), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/dvalue/\">dvalue</a><a class=\"related-link\" href=\"/doc/api/is-array/\">is_array</a></aside></div>")

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>draw_int</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function draw_int(from : u64, to : u64) u64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>draw_int()</code> returns the next integer value from the request random sequence.</p><p>Bearer uses the request random seed and advances the random index after each call.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>from : the first range value</p></div><div><p>to : the second range value</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A <code>u64</code> value between the range values.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var value := draw_int(u64(1), u64(10))\nprint(value &gt;= u64(1), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/draw-float/\">draw_float</a><a class=\"related-link\" href=\"/doc/api/gen-int/\">gen_int</a><a class=\"related-link\" href=\"/doc/api/gen-noise32/\">gen_noise32</a></aside></div>")
}

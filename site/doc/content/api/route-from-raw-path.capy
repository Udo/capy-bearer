function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>route_from_raw_path</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function route_from_raw_path(raw_path : string, default_path : string = &quot;index&quot;) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>path</code> only below an application-controlled route root. It is empty when the route is unsafe.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>raw_path : route text to validate</p></div><div><p>default_path : route for empty input</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>Route data with <code>path</code>, <code>page</code>, <code>raw_path</code>, and <code>valid</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var route := route_from_raw_path(&quot;docs/api&quot;)\nprint(string(route.page), &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

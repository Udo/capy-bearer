function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>Get child keys</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function keys(value : dval) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>keys(value)</code> returns a new list of child keys. A scalar returns an empty list.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : source value</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A list of child keys.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var user := dval({&quot;name&quot;: &quot;Ada&quot;, &quot;role&quot;: &quot;admin&quot;})\nprint(join(sort(keys(user)), &quot;,&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/dvalue/\">dvalue</a><a class=\"related-link\" href=\"/doc/api/values/\">values</a></aside></div>")
}

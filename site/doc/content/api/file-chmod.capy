function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>file_chmod</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function file_chmod(path : string, mode : s32) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>file_chmod</code> changes the permission bits of a path.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>path : path of the file or directory</p></div><div><p>mode : Unix permission bits as a decimal <code>s32</code></p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> when Capy changes the mode. Otherwise, it returns <code>false</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">file_put_contents(&quot;/tmp/doc-chmod.txt&quot;, &quot;secret&quot;)\nprint(file_chmod(&quot;/tmp/doc-chmod.txt&quot;, 384), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/file-get-contents/\">file_get_contents</a><a class=\"related-link\" href=\"/doc/api/file-put-contents/\">file_put_contents</a><a class=\"related-link\" href=\"/doc/api/file-append/\">file_append</a><a class=\"related-link\" href=\"/doc/api/file-exists/\">file_exists</a><a class=\"related-link\" href=\"/doc/api/file-mtime/\">file_mtime</a><a class=\"related-link\" href=\"/doc/api/file-stat/\">file_stat</a><a class=\"related-link\" href=\"/doc/api/file-unlink/\">file_unlink</a><a class=\"related-link\" href=\"/doc/api/file-rename/\">file_rename</a><a class=\"related-link\" href=\"/doc/api/file-copy/\">file_copy</a><a class=\"related-link\" href=\"/doc/api/file-truncate/\">file_trunca")
    print("te</a><a class=\"related-link\" href=\"/doc/api/file-symlink/\">file_symlink</a><a class=\"related-link\" href=\"/doc/api/file-temp/\">file_temp</a><a class=\"related-link\" href=\"/doc/api/file-fsync/\">file_fsync</a></aside></div>")
}

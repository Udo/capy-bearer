function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>job_status</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function job_status(job : dval) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>job_status()</code> checks a job without waiting. The map can include <code>state</code>, <code>done</code>, <code>kind</code>, <code>pid</code>, and <code>job_id</code>.</p><p>The <code>state</code> value can be <code>pending</code>, <code>running</code>, <code>done</code>, <code>failed</code>, <code>cancelled</code>, or <code>missing</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>job : a job ID as <code>dval</code></p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A job status map.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var job := shell_exec(&quot;printf x&quot;, {background: true, timeout_ms: 1000})\njob_await(job, 3000)\nprint(job_status(job)[&quot;state&quot;], &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/job-await/\">job_await</a><a class=\"related-link\" href=\"/doc/api/job-result/\">job_result</a><a class=\"related-link\" href=\"/doc/api/job-cancel/\">job_cancel</a></aside></div>")
}

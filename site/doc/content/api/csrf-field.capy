function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>csrf_field</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function csrf_field(session_name : string = &quot;bearer-session&quot;, token_name : string = &quot;csrf_token&quot;, field_name : string = &quot;&quot;) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>csrf_field()</code> returns a hidden form input with the active CSRF token.</p><p>Use it in a form that changes state. Check the submitted value with <code>csrf_valid()</code> before you change state.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>session_name : the session and cookie name</p></div><div><p>token_name : the token namespace</p></div><div><p>field<em>name : the form field name. The default is `token</em>name`.</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>An HTML hidden input with the active CSRF token.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var field := csrf_field(&quot;capy-doc-session&quot;, &quot;profile&quot;, &quot;csrf_token&quot;)\nprint(contains(field, &quot;type=\\&quot;hidden\\&quot;&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/csrf-token/\">csrf_token</a><a class=\"related-link\" href=\"/doc/api/csrf-valid/\">csrf_valid</a><a class=\"related-link\" href=\"/doc/api/csrf-rotate/\">csrf_rotate</a></aside></div>")
}

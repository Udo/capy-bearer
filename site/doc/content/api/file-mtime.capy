function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "file_mtime"
    page["kind"] = "api"
    page["slug"] = "file-mtime"
    page["route"] = "/doc/api/file-mtime/"
    page["title"] = "file_mtime"
    page["content"] = "`file_mtime` returns the modification time of a file.\n"
    page["returns"] = "The modification time as a Unix timestamp, or `0` when it is unavailable."
    page["label"] = "file_mtime"
    page["capy_sig_lines"] = dval(["function file_mtime(path : string) u64"])
    page["param_lines"] = dval(["path : path of the file to inspect", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "file_stat", href: "/doc/api/file-stat/"}, {label: "file_get_contents", href: "/doc/api/file-get-contents/"}, {label: "file_exists", href: "/doc/api/file-exists/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "file_put_contents(\"/tmp/doc-mtime.txt\", \"x\")\nprint(file_mtime(\"/tmp/doc-mtime.txt\") > u64(0), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

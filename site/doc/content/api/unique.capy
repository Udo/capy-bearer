function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>Get unique strings</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function unique(items : dval) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>unique</code> keeps the first copy of each string in a list-shaped <code>dval</code>.</p><p>The result keeps input order. This function does not change <code>items</code>.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>This function returns a new list-shaped <code>dval</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var items := split(&quot;one,two,one&quot;, &quot;,&quot;)\nprint(join(unique(items), &quot;,&quot;), &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

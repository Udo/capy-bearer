function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "unique"
    page["kind"] = "api"
    page["slug"] = "unique"
    page["route"] = "/doc/api/unique/"
    page["title"] = "Get unique strings"
    page["content"] = "`unique` keeps the first copy of each string in a list-shaped `dval`.\n\nThe result keeps input order. This function does not change `items`.\n"
    page["returns"] = "This function returns a new list-shaped `dval`."
    page["label"] = "unique"
    page["capy_sig_lines"] = dval(["function unique(items : dval) dval"])
    page["param_lines"] = dval([])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([])
    page["examples"] = dval([{entry: "render", caption: "", body: "var items := split(\"one,two,one\", \",\")\nprint(join(unique(items), \",\"), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>sqlite_query</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function sqlite_query(handle : u64, query : string) dval\nfunction sqlite_query(handle : u64, query : string, params : dval) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>sqlite_query</code> to run one SQL statement. Use <code>:name</code> placeholders with a parameter map.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>Query result as <code>dval</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var db := sqlite_connect(&quot;:memory:&quot;)\nvar rows := sqlite_query(db, &quot;select :name as name&quot;, dval({&quot;name&quot;: &quot;Ada&quot;}))\nprint(rows[0][&quot;name&quot;], &quot;\\n&quot;)\nsqlite_disconnect(db)\n</pre></div></div></main></div>")
}

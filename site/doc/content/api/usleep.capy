function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>usleep</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function usleep(usec : s32) s32</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>usleep</code> pauses the current handler for <code>usec</code> microseconds.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>usec : microseconds to sleep</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>0</code> after the sleep</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">usleep(1000)\nprint(&quot;slept\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/time/\">time</a><a class=\"related-link\" href=\"/doc/api/time-precise/\">time_precise</a><a class=\"related-link\" href=\"/doc/api/time/\">time</a><a class=\"related-link\" href=\"/doc/api/time-format-local/\">time_format_local</a><a class=\"related-link\" href=\"/doc/api/time-format-relative/\">time_format_relative</a><a class=\"related-link\" href=\"/doc/api/time-format-utc/\">time_format_utc</a><a class=\"related-link\" href=\"/doc/api/time-parse/\">time_parse</a></aside></div>")
}

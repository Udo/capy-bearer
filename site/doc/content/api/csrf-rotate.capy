function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>csrf_rotate</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function csrf_rotate(session_name : string = &quot;bearer-session&quot;, token_name : string = &quot;csrf_token&quot;)</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>csrf_rotate()</code> removes the active CSRF token from a token namespace.</p><p>The next <code>csrf_token()</code> call creates a replacement token. Use it after a sensitive successful change.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>session_name : the session and cookie name</p></div><div><p>token_name : the token namespace to clear</p></div><div></div></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var old_token := csrf_token(&quot;capy-doc-session&quot;)\ncsrf_rotate(&quot;capy-doc-session&quot;)\nvar new_token := csrf_token(&quot;capy-doc-session&quot;)\nprint(old_token != new_token, &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/csrf-token/\">csrf_token</a><a class=\"related-link\" href=\"/doc/api/csrf-valid/\">csrf_valid</a></aside></div>")
}

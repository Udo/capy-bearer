function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>mysql_query</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function mysql_query(handle : u64, query : string) dval\nfunction mysql_query(handle : u64, query : string, params : dval) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>mysql_query()</code> runs a query and returns its rows as a <code>dval</code>.</p><p>Use named <code>:name</code> placeholders with a <code>dval</code> map. The API rejects positional <code>?</code> placeholders. Add <code>!</code> to a placeholder only for an unquoted non-negative integer.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>handle : the MySQL connection handle</p></div><div><p>query : the SQL query text</p></div><div><p>params : the named parameter values</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>the query result rows</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var database := mysql_connect(&quot;localhost&quot;, &quot;root&quot;, &quot;&quot;, &quot;&quot;)\nif bool(mysql_info(database, &quot;connection&quot;)) { var rows := mysql_query(database, &quot;select :name as name&quot;, dval({&quot;name&quot;: &quot;Ada&quot;})); print(rows[0][&quot;name&quot;], &quot;\\n&quot;) }\nif database != u64(0) { mysql_disconnect(database) }\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/mysql-connect/\">mysql_connect</a><a class=\"related-link\" href=\"/doc/api/mysql-info/\">mysql_info</a></aside></div>")
}

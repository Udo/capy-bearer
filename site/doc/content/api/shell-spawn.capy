function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>shell_spawn</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function shell_spawn(spec : dval) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>shell_spawn</code> to start a background shell job. The <code>cmd</code> value is a shell command.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>Job identifier value.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var job := shell_spawn(dval({&quot;cmd&quot;: &quot;printf hello&quot;}))\nprint(string(job), &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

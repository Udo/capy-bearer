function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>int_val</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function int_val(raw : string) u64\nfunction int_val(raw : string, base : s32) u64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>int_val()</code> extracts an unsigned integer from text. The one-argument form uses base 10.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>raw : text that can contain an integer</p></div><div><p>base : number base</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A parsed unsigned integer, or <code>0</code> when no usable number exists.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(int_val(&quot;42&quot;), &quot; / &quot;, int_val(&quot;ff&quot;, 16), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/trim/\">trim</a></aside></div>")
}

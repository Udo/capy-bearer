function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>file_truncate</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function file_truncate(path : string, size : u64) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>file_truncate</code> sets a file length. A smaller length removes trailing bytes.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>path : file path</p></div><div><p>size : new file length in bytes</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> if Capy changes the file length. Otherwise, <code>false</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">file_put_contents(&quot;/tmp/doc-truncate.txt&quot;, &quot;hello world&quot;)\nif file_truncate(&quot;/tmp/doc-truncate.txt&quot;, u64(5)) {\n    print(file_get_contents(&quot;/tmp/doc-truncate.txt&quot;), &quot;\\n&quot;)\n}\n</pre></div></div></main></div>")
}

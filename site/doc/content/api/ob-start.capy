function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>Start an output buffer</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function ob_start()</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>ob_start()</code> starts an output buffer for the active request.</p><p>Output after this call goes to the buffer. Use <code>ob_get</code>, <code>ob_get_close</code>, or <code>ob_close</code> to read or close it.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>This function returns no value.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">ob_start()\nprint(&quot;fragment&quot;)\nvar captured := ob_get_close()\nprint(&quot;captured: &quot;, captured, &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/print/\">print</a><a class=\"related-link\" href=\"/doc/api/flush-output/\">flush_output</a><a class=\"related-link\" href=\"/doc/api/ob-get/\">ob_get</a><a class=\"related-link\" href=\"/doc/api/ob-get-close/\">ob_get_close</a><a class=\"related-link\" href=\"/doc/api/ob-close/\">ob_close</a><a class=\"related-link\" href=\"/doc/api/var-dump/\">var_dump</a><a class=\"related-link\" href=\"/doc/type/request/\">Request</a></aside></div>")
}

function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "markdown_to_ast"
    page["kind"] = "api"
    page["slug"] = "markdown-to-ast"
    page["route"] = "/doc/api/markdown-to-ast/"
    page["title"] = "markdown_to_ast"
    page["content"] = "`markdown_to_ast()` parses Markdown into a `dval` document tree.\n\nThe root node contains a `children` list. Nodes contain a `type` field and fields for their content. The default options support GitHub-flavored Markdown.\n\nSet `gfm` to control GitHub-flavored extensions. Set `allow_html` to retain raw HTML nodes.\n"
    page["returns"] = "the Markdown document tree"
    page["label"] = "markdown_to_ast"
    page["capy_sig_lines"] = dval(["function markdown_to_ast(source : string) dval", "function markdown_to_ast(source : string, options : dval) dval"])
    page["param_lines"] = dval(["source : the Markdown source text", "options : parser options", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "markdown_to_html", href: "/doc/api/markdown-to-html/"}, {label: "json_encode", href: "/doc/api/json-encode/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var document := markdown_to_ast(\"# Title\")\nprint(document[\"type\"], \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>route_path_is_safe</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function route_path_is_safe(path : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>A safe route has non-empty segments. Segments can contain ASCII letters, digits, <code>_</code>, and <code>-</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>path : route text to test</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> if the path is safe.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(route_path_is_safe(&quot;docs/api&quot;), &quot;\\n&quot;)\n</pre></div></div></main></div>")

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>zip_extract</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function zip_extract(path : string, destination : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>zip_extract()</code> extracts every entry from a ZIP archive.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>path : archive path</p></div><div><p>destination : destination directory</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> when the server extracts the archive.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var archive := file_temp(&quot;/tmp/capy-zip-&quot;) + &quot;.zip&quot;\nvar destination := archive + &quot;.out&quot;\nzip_create(archive, dval({&quot;note.txt&quot;: &quot;hello&quot;}))\nzip_extract(archive, destination)\nprint(file_get_contents(destination + &quot;/note.txt&quot;), &quot;\\n&quot;)\ndir_remove(destination, true)\nfile_unlink(archive)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/zip-create/\">zip_create</a><a class=\"related-link\" href=\"/doc/api/zip-list/\">zip_list</a><a class=\"related-link\" href=\"/doc/api/zip-read/\">zip_read</a><a class=\"related-link\" href=\"/doc/api/gz-compress/\">gz_compress</a><a class=\"related-link\" href=\"/doc/api/gz-uncompress/\">gz_uncompress</a></aside></div>")
}

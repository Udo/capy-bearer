function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "zip_extract"
    page["kind"] = "api"
    page["slug"] = "zip-extract"
    page["route"] = "/doc/api/zip-extract/"
    page["title"] = "zip_extract"
    page["content"] = "`zip_extract()` extracts every entry from a ZIP archive.\n"
    page["returns"] = "`true` when the server extracts the archive."
    page["label"] = "zip_extract"
    page["capy_sig_lines"] = dval(["function zip_extract(path : string, destination : string) bool"])
    page["param_lines"] = dval(["path : archive path", "destination : destination directory", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "zip_create", href: "/doc/api/zip-create/"}, {label: "zip_list", href: "/doc/api/zip-list/"}, {label: "zip_read", href: "/doc/api/zip-read/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var archive := file_temp(\"/tmp/capy-zip-\") + \".zip\"\nvar destination := archive + \".out\"\nzip_create(archive, dval({\"note.txt\": \"hello\"}))\nzip_extract(archive, destination)\nprint(file_get_contents(destination + \"/note.txt\"), \"\\n\")\ndir_remove(destination, true)\nfile_unlink(archive)\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

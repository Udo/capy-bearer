function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>process_start_directory</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function process_start_directory() string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>process_start_directory()</code> returns the worker process start directory.</p><p>The value does not change when <code>cwd_set()</code> changes the current directory.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>the worker process start directory</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(process_start_directory(), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/cwd-get/\">cwd_get</a><a class=\"related-link\" href=\"/doc/api/cwd-set/\">cwd_set</a></aside></div>")

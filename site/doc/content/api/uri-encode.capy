    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>uri_encode</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function uri_encode(value : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>uri_encode</code> encodes a string for a URI component.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : string to encode</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>URI-encoded string</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(uri_encode(&quot;Ada Lovelace&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/uri-decode/\">uri_decode</a><a class=\"related-link\" href=\"/doc/api/parse-uri/\">parse_uri</a><a class=\"related-link\" href=\"/doc/api/parse-query/\">parse_query</a><a class=\"related-link\" href=\"/doc/api/session-id-create/\">session_id_create</a><a class=\"related-link\" href=\"/doc/api/route-path-sanitize/\">route_path_sanitize</a></aside></div>")

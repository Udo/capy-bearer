function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>dval</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function dval(value : string) dval\nfunction dval(value : s32) dval\nfunction dval(value : s64) dval\nfunction dval(value : u64) dval\nfunction dval(value : f64) dval\nfunction dval(value : bool) dval\nfunction dval(value : dval) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>dval()</code> converts a scalar or literal structure to a dynamic value.</p><p>Use it for request payloads and nested map or list data. Existing <code>dval</code> input stays a <code>dval</code> value.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : a scalar, literal structure, or <code>dval</code></p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A <code>dval</code> value.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var profile := dval({name: &quot;Ada&quot;, scores: [1, 2, 3]})\nprint(string(profile.name), &quot; &quot;, length(profile.scores), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/bool/\">bool</a><a class=\"related-link\" href=\"/doc/type/s8/\">s8</a><a class=\"related-link\" href=\"/doc/type/s16/\">s16</a><a class=\"related-link\" href=\"/doc/type/s32/\">s32</a><a class=\"related-link\" href=\"/doc/type/s64/\">s64</a><a class=\"related-link\" href=\"/doc/type/u8/\">u8</a><a class=\"related-link\" href=\"/doc/type/u16/\">u16</a><a class=\"related-link\" href=\"/doc/type/u32/\">u32</a><a class=\"related-link\" href=\"/doc/type/u64/\">u64</a><a class=\"re")
    print("lated-link\" href=\"/doc/type/f32/\">f32</a><a class=\"related-link\" href=\"/doc/type/f64/\">f64</a><a class=\"related-link\" href=\"/doc/api/string/\">string</a><a class=\"related-link\" href=\"/doc/type/struct/\">struct</a><a class=\"related-link\" href=\"/doc/type/array/\">array</a><a class=\"related-link\" href=\"/doc/type/function/\">function value</a><a class=\"related-link\" href=\"/doc/type/module/\">module</a><a class=\"related-link\" href=\"/doc/type/dvalue/\">Dynamic values</a><a class=\"related-link\" href=\"/doc/api/set/\">set</a></aside></div>")
}

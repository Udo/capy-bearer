function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>brb_decode</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function brb_decode(encoded : string) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>brb_decode</code> decodes BRRB data into a <code>dval</code> value.</p><p>Use it to read data from <code>brb_encode</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>encoded : BRRB data</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>a decoded <code>dval</code> value</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var value := brb_decode(brb_encode(dval({&quot;name&quot;: &quot;Ada&quot;})))\nprint(value[&quot;name&quot;], &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/brb-encode/\">brb_encode</a><a class=\"related-link\" href=\"/doc/api/json-decode/\">json_decode</a></aside></div>")
}

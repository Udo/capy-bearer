function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "brb_decode"
    page["kind"] = "api"
    page["slug"] = "brb-decode"
    page["route"] = "/doc/api/brb-decode/"
    page["title"] = "brb_decode"
    page["content"] = "`brb_decode` decodes BRRB data into a `dval` value.\n\nUse it to read data from `brb_encode`.\n"
    page["returns"] = "a decoded `dval` value"
    page["label"] = "brb_decode"
    page["capy_sig_lines"] = dval(["function brb_decode(encoded : string) dval"])
    page["param_lines"] = dval(["encoded : BRRB data", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "brb_encode", href: "/doc/api/brb-encode/"}, {label: "json_decode", href: "/doc/api/json-decode/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var value := brb_decode(brb_encode(dval({\"name\": \"Ada\"})))\nprint(value[\"name\"], \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

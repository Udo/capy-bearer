function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>cos</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function cos(value : f32) f32\nfunction cos(value : f64) f64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>cos()</code> returns the host math result for <code>value</code>.</p><p>This function uses a host call.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : the input value</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>An <code>f32</code> or <code>f64</code> value.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var value := cos(2.0)\nprint(value, &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/sqrt/\">sqrt</a><a class=\"related-link\" href=\"/doc/api/abs/\">abs</a><a class=\"related-link\" href=\"/doc/api/neg/\">neg</a><a class=\"related-link\" href=\"/doc/api/floor/\">floor</a><a class=\"related-link\" href=\"/doc/api/ceil/\">ceil</a><a class=\"related-link\" href=\"/doc/api/trunc/\">trunc</a><a class=\"related-link\" href=\"/doc/api/nearest/\">nearest</a><a class=\"related-link\" href=\"/doc/api/min/\">min</a><a class=\"related-link\" href=\"/doc/api/max/\">max</a><a class=\"related-link\" href=\"/doc/api/copysign/\">copysign</a><a class=\"related-link\" href=\"/doc/api/pow/\">pow</a><a class=\"related-link\" href=\"/doc/api/log/\">log</a><a class=\"related-link\" href=\"/doc/api/exp/\">exp</a><a class=\"related-link\" href=\"/doc/api/sin/\">sin</a><a class=\"related-link\" href=\"/doc/api/atan2/\">atan2</a><a class=\"related-link\" href=\"/doc/api/is-nan/\">i")
    print("s_nan</a><a class=\"related-link\" href=\"/doc/api/is-infinite/\">is_infinite</a><a class=\"related-link\" href=\"/doc/api/is-finite/\">is_finite</a><a class=\"related-link\" href=\"/doc/api/clamp/\">clamp</a></aside></div>")
}

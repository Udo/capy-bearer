function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>regex_split</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function regex_split(pattern : string, subject : string, flags : string = &quot;&quot;) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>regex_split()</code> removes separators and keeps empty parts.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>pattern : regular expression separator</p></div><div><p>subject : text to split</p></div><div><p>flags : regular expression flags</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A list of text parts.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var parts := regex_split(&quot;,&quot;, &quot;a,,b&quot;)\nprint(parts[1], &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

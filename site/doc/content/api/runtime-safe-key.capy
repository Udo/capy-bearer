function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>runtime_safe_key</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function runtime_safe_key(key : string, label : string = &quot;runtime key&quot;) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>The function trims <code>key</code>. It reports an error for an empty key.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>key : runtime key</p></div><div><p>label : name for an empty-key error</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A stable SHA-1 key.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(runtime_safe_key(&quot;docs task&quot;), &quot;\\n&quot;)\n</pre></div></div></main></div>")

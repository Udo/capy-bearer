function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>join</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function join(items : dval, delimiter : string = &quot;\\n&quot;) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>join()</code> reads each list value as text. It uses a newline when you omit the delimiter.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>items : a <code>dval</code> list</p></div><div><p>delimiter : text between values</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>One string with the values separated by <code>delimiter</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(join(split(&quot;a,b,c&quot;, &quot;,&quot;), &quot;-&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/split/\">split</a><a class=\"related-link\" href=\"/doc/api/json-encode/\">json_encode</a><a class=\"related-link\" href=\"/doc/api/map/\">map</a></aside></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>sqlite_disconnect</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function sqlite_disconnect(handle : u64)</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>sqlite_disconnect</code> to close an SQLite connection. Do not use the handle after this call.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var db := sqlite_connect(&quot;:memory:&quot;)\nif db != 0 { sqlite_disconnect(db) }\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/sqlite-connect/\">sqlite_connect</a><a class=\"related-link\" href=\"/doc/api/sqlite-query/\">sqlite_query</a><a class=\"related-link\" href=\"/doc/api/sqlite-info/\">sqlite_info</a></aside></div>")
}

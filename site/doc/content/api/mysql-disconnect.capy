    page["slug"] = "mysql-disconnect"
    page["route"] = "/doc/api/mysql-disconnect/"
    page["title"] = "mysql_disconnect"
    page["content"] = "`mysql_disconnect()` releases the MySQL connection lease.\n\nDo not use the handle after this call.\n"
    page["label"] = "mysql_disconnect"
    page["capy_sig_lines"] = dval(["function mysql_disconnect(handle : u64)"])
    page["param_lines"] = dval(["handle : the MySQL connection handle", ""])

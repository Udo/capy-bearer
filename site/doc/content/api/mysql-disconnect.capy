function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>mysql_disconnect</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function mysql_disconnect(handle : u64)</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>mysql_disconnect()</code> releases the MySQL connection lease.</p><p>Do not use the handle after this call.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>handle : the MySQL connection handle</p></div><div></div></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var database := mysql_connect(&quot;localhost&quot;, &quot;root&quot;, &quot;&quot;, &quot;&quot;)\nif database { mysql_disconnect(database) }\nprint(&quot;connection released\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/mysql-connect/\">mysql_connect</a><a class=\"related-link\" href=\"/doc/api/mysql-query/\">mysql_query</a><a class=\"related-link\" href=\"/doc/api/mysql-escape/\">mysql_escape</a><a class=\"related-link\" href=\"/doc/api/mysql-info/\">mysql_info</a></aside></div>")
}

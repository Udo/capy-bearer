function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>ws_send_to</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function ws_send_to(connection_id : string, message : string, binary : bool) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>ws_send_to()</code> sends a message to one client.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>connection_id : client ID</p></div><div><p>message : message bytes to send</p></div><div><p>binary : <code>true</code> for a binary frame</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> when the server queues the message.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">ws_send_to(string(request.websocket.connection_id), &quot;hello&quot;, false)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/ws-send/\">ws_send</a></aside></div>")
}

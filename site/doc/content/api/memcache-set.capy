function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "memcache_set"
    page["kind"] = "api"
    page["slug"] = "memcache-set"
    page["route"] = "/doc/api/memcache-set/"
    page["title"] = "memcache_set"
    page["content"] = "`memcache_set()` stores `value` under `key`.\n\nIt returns `true` only when the server returns `STORED`. It escapes the key before it sends the request.\n"
    page["returns"] = "`true` when the server stores the entry"
    page["label"] = "memcache_set"
    page["capy_sig_lines"] = dval(["function memcache_set(connection : u64, key : string, value : string, expires_in : u64 = 3600) bool"])
    page["param_lines"] = dval(["connection : the connection handle", "key : the entry key", "value : the value text", "expires_in : the lifetime in seconds", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "memcache_connect", href: "/doc/api/memcache-connect/"}, {label: "memcache_get", href: "/doc/api/memcache-get/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var connection := memcache_connect()\nif connection != u64(0) { print(memcache_set(connection, \"doc-key\", \"value\"), \"\\n\") }\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>Test for a child</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>has(value : dval, key : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>has(value, key)</code> tests for a child without creating it. It returns <code>false</code> for a missing key or a scalar.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : value to test</p></div><div><p>key : child key</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> when the key exists.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var user := dval({&quot;name&quot;: &quot;Ada&quot;})\nprint(has(user, &quot;name&quot;), &quot; &quot;, has(user, &quot;age&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/dvalue/\">Dynamic values</a><a class=\"related-link\" href=\"/doc/api/get/\">get</a><a class=\"related-link\" href=\"/doc/api/set/\">set</a><a class=\"related-link\" href=\"/doc/api/delete/\">delete</a><a class=\"related-link\" href=\"/doc/api/clear/\">clear</a><a class=\"related-link\" href=\"/doc/api/push/\">push</a><a class=\"related-link\" href=\"/doc/api/pop/\">pop</a><a class=\"related-link\" href=\"/doc/api/keys/\">keys</a><a class=\"related-link\" href=\"/doc/api/values/\">values</a><a class=\"related-link\" href=\"/doc/api/get-by-path/\">get_by_path</a><a class=\"related-link\" href=\"/doc/api/get-or-create/\">get_or_create</a><a class=\"related-link\" href=\"/doc/api/get-type-name/\">get_type_name</a><a class=\"related-lin")
    print("k\" href=\"/doc/api/is-array/\">is_array</a><a class=\"related-link\" href=\"/doc/api/is-list/\">is_list</a></aside></div>")
}

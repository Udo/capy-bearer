function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>backtrace_capture</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function backtrace_capture() string\nfunction backtrace_capture(max_frames : s32, skip_frames : s32) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>backtrace_capture</code> gets a backtrace for the current call stack.</p><p>Call it with no arguments. You can also set the maximum frame count and skip count.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>max_frames : maximum number of frames</p></div><div><p>skip_frames : number of newest frames to omit</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>a backtrace string</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(backtrace_capture(), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/backtrace-get-frames/\">backtrace_get_frames</a></aside></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>file_unlink</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function file_unlink(path : string)</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>file_unlink</code> removes a file. A missing path does not cause an error.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>path : file path</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>No value.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">file_put_contents(&quot;/tmp/doc-unlink.txt&quot;, &quot;x&quot;)\nfile_unlink(&quot;/tmp/doc-unlink.txt&quot;)\nprint(file_exists(&quot;/tmp/doc-unlink.txt&quot;), &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

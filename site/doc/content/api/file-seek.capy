function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>file_seek</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function file_seek(handle : u64, offset : s64, whence : s64) s64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>file_seek</code> sets the position for file reads and writes.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>handle : handle from <code>file_open</code></p></div><div><p>offset : byte offset</p></div><div><p>whence : <code>0</code> for the start, <code>1</code> for the current position, or <code>2</code> for the end</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>The new byte offset. Returns <code>-1</code> on error.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var handle := file_open(&quot;/tmp/doc-seek.txt&quot;, &quot;w&quot;)\nfile_write(handle, &quot;hello world&quot;)\nfile_close(handle)\nhandle = file_open(&quot;/tmp/doc-seek.txt&quot;, &quot;r&quot;)\nfile_seek(handle, s64(6), s64(0))\nprint(file_read(handle, u64(5)), &quot;\\n&quot;)\nfile_close(handle)\n</pre></div></div></main></div>")
}

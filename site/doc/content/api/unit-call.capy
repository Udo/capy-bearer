function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>unit_call</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function unit_call(file_name : string, function_name : string) dval\nfunction unit_call(file_name : string, function_name : string, props : as dval) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>unit_call</code> calls an exported function in a unit.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>file_name : unit path</p></div><div><p>function_name : exported function name</p></div><div><p>props : function input</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>exported function result</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var result := unit_call(&quot;/tests/capy-module-target.capy&quot;, &quot;echo&quot;, &quot;hello&quot;)\nprint(result, &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/unit-load/\">unit_load</a><a class=\"related-link\" href=\"/doc/api/unit-render/\">unit_render</a><a class=\"related-link\" href=\"/doc/api/unit-info/\">unit_info</a><a class=\"related-link\" href=\"/doc/handler/render/\">render</a><a class=\"related-link\" href=\"/doc/handler/component/\">component</a></aside></div>")
}

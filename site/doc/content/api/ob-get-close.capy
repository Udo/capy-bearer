function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>ob_get_close</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function ob_get_close() string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>ob_get_close()</code> returns the current output buffer contents and closes the buffer.</p><p>Output then returns to the previous buffer.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>the current output buffer contents</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">ob_start()\nprint(&quot;captured&quot;)\nvar output := ob_get_close()\nprint(output, &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/print/\">print</a><a class=\"related-link\" href=\"/doc/api/ob-start/\">ob_start</a><a class=\"related-link\" href=\"/doc/api/ob-get/\">ob_get</a><a class=\"related-link\" href=\"/doc/api/ob-close/\">ob_close</a><a class=\"related-link\" href=\"/doc/api/var-dump/\">var_dump</a></aside></div>")
}

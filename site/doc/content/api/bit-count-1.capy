function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>bit_count_1</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function bit_count_1(value : s8) s64\nfunction bit_count_1(value : s16) s64\nfunction bit_count_1(value : s32) s64\nfunction bit_count_1(value : s64) s64\nfunction bit_count_1(value : u8) s64\nfunction bit_count_1(value : u16) s64\nfunction bit_count_1(value : u32) s64\nfunction bit_count_1(value : u64) s64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>bit_count_1()</code> counts one bits in the width of <code>value</code>. An <code>u8</code> value uses eight bits, not its container width.</p><p>The compiler emits a direct lib call.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : the integer value</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>An <code>s64</code> count.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var value := bit_count_1(u8(1))\nprint(value, &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/bit-and/\">bit_and</a><a class=\"related-link\" href=\"/doc/api/bit-or/\">bit_or</a><a class=\"related-link\" href=\"/doc/api/bit-xor/\">bit_xor</a><a class=\"related-link\" href=\"/doc/api/bit-not/\">bit_not</a><a class=\"related-link\" href=\"/doc/api/bit-shl/\">bit_shl</a><a class=\"related-link\" href=\"/doc/api/bit-shr/\">bit_shr</a><a class=\"related-link\" href=\"/doc/api/bit-rotate-left/\">bit_rotate_left</a><a class=\"related-link\" href=\"/doc/api/bit-rotate-right/\">bit_rotate_right</a><a class=\"related-link\" href=\"/")
    print("doc/api/bit-count-lz/\">bit_count_lz</a><a class=\"related-link\" href=\"/doc/api/bit-count-tz/\">bit_count_tz</a><a class=\"related-link\" href=\"/doc/api/bits-of/\">bits_of</a><a class=\"related-link\" href=\"/doc/api/f64-from-bits/\">f64_from_bits</a><a class=\"related-link\" href=\"/doc/api/f32-from-bits/\">f32_from_bits</a></aside></div>")
}

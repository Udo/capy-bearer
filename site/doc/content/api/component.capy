function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "component"
    page["kind"] = "api"
    page["slug"] = "component"
    page["route"] = "/doc/api/component/"
    page["title"] = "component"
    page["content"] = "`component()` renders a component and returns everything it printed as a string.\n\nIt collects the output into a buffer, which costs something. Reach for `component_render()` instead when you are writing the fragment straight into the current response and never look at the string — it skips the buffer entirely, so `component_render(\"card\")` does less work than `print(component(\"card\"))`.\n\nCapture the string when the string is the goal: wrapping the fragment in surrounding markup, checking whether it produced anything before emitting a container, storing it in a `dval` beside other values, or emitting the same fragment more than once from one call.\n\n## How a name resolves\n\nA name is a path with an optional `:HANDLER` suffix. Bearer appends `.capy` when the path has no suffix, so `\"card\"` and `\"card.capy\"` mean the same file.\n\nA path that starts with `/` is tried first as a real filesystem path and then as a site-root path, so `\"/tests/capy-request-context.capy\"` means that file under the site root.\n\nA relative path is tried against three directories, in order:\n\n1. the directory of the entry unit that is handling the request\n2. the directory of the unit calling `component()`, when that differs\n3. the site root\n\nThe first match wins. A resolved path that escapes the site root is rejected. Use `component_resolve()` to see which file a name reached, and `component_exists()` to test a name before rendering it.\n\n## Named handlers\n\n`\"lib/widgets.capy:CARD\"` calls the `COMPONENT:CARD` handler in that file. A name that is only `\":CARD\"` calls `COMPONENT:CARD` in the file that is currently rendering, which lets one file hold several related fragments.\n\nA file with no named handler must define a plain `COMPONENT` handler.\n\n## What the component sees\n\n`props` arrives as `request.prop"
    page["content"] = string(page["content"], "") + "s`. It is swapped in for the duration of the call and restored when the component returns, so a component cannot disturb its caller's props, and nested components each read their own.\n\nRelative paths inside the component resolve against the component's own file, not the caller's — a component in `lib/` can call `component(\"sibling\")` and reach `lib/sibling.capy`.\n\nThe target unit's `ONCE` handler runs before the component handler the first time that unit is used in the request.\n"
    page["returns"] = "The component output as a string."
    page["errors"] = "An unresolvable component does not raise an error. Bearer sets the response status to `500`, returns a banner element describing the failure in place of the component output, and continues rendering the rest of the page. Guard optional components with `component_exists()` when a missing file should not be an error."
    page["label"] = "component"
    page["capy_sig_lines"] = dval(["function component(name : string) string", "function component(name : string, props : as dval) string"])
    page["param_lines"] = dval(["name : a component path, optionally followed by `:HANDLER`", "props : optional input, readable inside the component as `request.props`", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "component_exists", href: "/doc/api/component-exists/"}, {label: "component_render", href: "/doc/api/component-render/"}, {label: "component_resolve", href: "/doc/api/component-resolve/"}, {label: "component", href: "/doc/handler/component/"}, {label: "request", href: "/doc/type/request/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "print(component(\"/doc/examples/card.capy:CARD\", {title: \"Release notes\"}), \"\\n\")\n"}, {entry: "render", caption: "wrap the captured output", body: "var body := component(\"/doc/examples/card.capy:CARD\", {title: \"Ada\"})\nprint(\"<section>\", body, \"</section>\", \"\\n\")\n"}, {entry: "render", caption: "render a list of components", body: "var titles := [\"Ada\", \"Grace\"]\nfor title := titles {\n    print(component(\"/doc/examples/card.capy:CARD\", {title: title}))\n}\nprint(\"\\n\")\n"}, {entry: "render", caption: "skip a component that may not exist", body: "if component_exists(\"/doc/examples/card.capy\") {\n    print(component(\"/doc/examples/card.capy:CARD\", {title: \"Optional\"}), \"\\n\")\n} else {\n    print(\"no card component\\n\")\n}\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

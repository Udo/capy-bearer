function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "unit_info"
    page["kind"] = "api"
    page["slug"] = "unit-info"
    page["route"] = "/doc/api/unit-info/"
    page["title"] = "unit_info"
    page["content"] = "`unit_info` returns metadata for a unit.\n"
    page["returns"] = "unit metadata"
    page["label"] = "unit_info"
    page["capy_sig_lines"] = dval(["function unit_info(path : string = \"\") dval"])
    page["param_lines"] = dval(["path : unit path. An empty path selects the current unit", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "units_list", href: "/doc/api/units-list/"}, {label: "unit_compile", href: "/doc/api/unit-compile/"}, {label: "request", href: "/doc/type/request/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var info := unit_info(\"capy-files.capy\")\nprint(bool(info[\"source_exists\"]), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>unit_info</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function unit_info(path : string = &quot;&quot;) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>unit_info</code> returns metadata for a unit.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>path : unit path. An empty path selects the current unit</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>unit metadata</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var info := unit_info(&quot;capy-files.capy&quot;)\nprint(bool(info[&quot;source_exists&quot;]), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/units-list/\">units_list</a><a class=\"related-link\" href=\"/doc/api/unit-compile/\">unit_compile</a><a class=\"related-link\" href=\"/doc/type/request/\">request</a></aside></div>")
}

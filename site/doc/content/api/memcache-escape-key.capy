    page["title"] = "memcache_escape_key"
    page["content"] = "`memcache_escape_key()` replaces whitespace characters in a key with underscores.\n\nIt does not validate every Memcache protocol byte.\n\nThe dedicated Memcache operations escape keys before they send requests.\n"
    page["returns"] = "the key with whitespace replaced by underscores"
    page["label"] = "memcache_escape_key"
    page["capy_sig_lines"] = dval(["function memcache_escape_key(key : string) string"])

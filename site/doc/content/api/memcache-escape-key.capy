function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>memcache_escape_key</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function memcache_escape_key(key : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>memcache_escape_key()</code> replaces whitespace characters in a key with underscores.</p><p>It does not validate every Memcache protocol byte.</p><p>The dedicated Memcache operations escape keys before they send requests.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>key : the key text</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>the key with whitespace replaced by underscores</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(memcache_escape_key(&quot;a key&quot;), &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

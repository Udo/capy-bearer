function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>socket_close</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function socket_close(handle : u64)</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>socket_close</code> after socket work. Do not use the handle after this call.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var handle := socket_connect(&quot;127.0.0.1&quot;, 1)\nif handle != 0 { socket_close(handle) }\n</pre></div></div></main></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>gen_noise01</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function gen_noise01(index : u64, seed : u64 = 0) f64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>gen_noise01()</code> returns normalized noise for an index and seed.</p><p>Use the same inputs to reproduce a value.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>index : deterministic input position</p></div><div><p>seed : deterministic input seed</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A deterministic <code>f64</code> value from <code>0</code> to <code>1</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var value := gen_noise01(u64(1), u64(2))\nprint(value, &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/gen-noise32/\">gen_noise32</a><a class=\"related-link\" href=\"/doc/api/gen-noise64/\">gen_noise64</a><a class=\"related-link\" href=\"/doc/api/gen-float/\">gen_float</a></aside></div>")
}

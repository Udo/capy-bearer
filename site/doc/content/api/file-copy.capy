function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>file_copy</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function file_copy(from : string, to : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>file_copy</code> copies a file to another path. The source path remains available after a successful copy.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>from : source path</p></div><div><p>to : destination path</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> when Capy copies the file. Otherwise, it returns <code>false</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">file_put_contents(&quot;/tmp/doc-copy-src.txt&quot;, &quot;payload&quot;)\nfile_copy(&quot;/tmp/doc-copy-src.txt&quot;, &quot;/tmp/doc-copy-dst.txt&quot;)\nprint(file_get_contents(&quot;/tmp/doc-copy-dst.txt&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/file-rename/\">file_rename</a><a class=\"related-link\" href=\"/doc/api/file-put-contents/\">file_put_contents</a><a class=\"related-link\" href=\"/doc/api/file-stat/\">file_stat</a></aside></div>")
}

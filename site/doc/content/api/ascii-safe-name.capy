function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>ascii_safe_name</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function ascii_safe_name(raw : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>ascii_safe_name</code> converts text to an ASCII-safe name.</p><p>Use it when a target accepts ASCII names only.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>raw : source text</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>an ASCII-safe name</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(ascii_safe_name(&quot;Café file-1&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/safe-name/\">safe_name</a></aside></div>")
}

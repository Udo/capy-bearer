function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "clone"
    page["kind"] = "api"
    page["slug"] = "clone"
    page["route"] = "/doc/api/clone/"
    page["title"] = "clone"
    page["content"] = "`clone()` copies a string.\n\nMost Capy code does not need an explicit copy. Use `clone()` when a fresh string value is required.\n"
    page["returns"] = "A separate string copy."
    page["label"] = "clone"
    page["capy_sig_lines"] = dval(["function clone(value : string) string"])
    page["param_lines"] = dval(["value : a source string", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "string", href: "/doc/type/string/"}, {label: "length", href: "/doc/api/length/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var source := \"token\"\nvar copy := clone(source)\nprint(length(source), \" \", length(copy), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>clone</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function clone(value : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>clone()</code> copies a string.</p><p>Most Capy code does not need an explicit copy. Use <code>clone()</code> when a fresh string value is required.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : a source string</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A separate string copy.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var source := &quot;token&quot;\nvar copy := clone(source)\nprint(length(source), &quot; &quot;, length(copy), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/string/\">string</a><a class=\"related-link\" href=\"/doc/api/length/\">length</a></aside></div>")
}

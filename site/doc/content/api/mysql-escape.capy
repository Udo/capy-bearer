function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>mysql_escape</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function mysql_escape(raw : string) string\nfunction mysql_escape(raw : string, quote : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>mysql_escape(raw)</code> escapes <code>raw</code> and wraps it in single quotes.</p><p>Use the second form to set the wrapper. Pass an empty string when no wrapper is needed. Prefer named parameters with <code>mysql_query()</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>raw : the string to escape</p></div><div><p>quote : the string that wraps the result</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>the escaped string</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(mysql_escape(&quot;O'Brien&quot;, &quot;'&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/mysql-query/\">mysql_query</a></aside></div>")
}

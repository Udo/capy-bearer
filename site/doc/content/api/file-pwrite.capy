function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>file_pwrite</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function file_pwrite(handle : u64, offset : u64, data : string) u64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>file_pwrite</code> writes text at an absolute byte offset. It does not change the handle position.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>handle : writable handle returned by <code>file_open</code></p></div><div><p>offset : absolute byte offset</p></div><div><p>data : text to write</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>The number of bytes written.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var handle := file_open(&quot;/tmp/doc-pwrite.txt&quot;, &quot;w&quot;)\nfile_write(handle, &quot;hello world&quot;)\nfile_close(handle)\nvar editor := file_open(&quot;/tmp/doc-pwrite.txt&quot;, &quot;r+&quot;)\nfile_pwrite(editor, u64(6), &quot;earth&quot;)\nfile_close(editor)\nprint(file_get_contents(&quot;/tmp/doc-pwrite.txt&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/file-open/\">file_open</a><a class=\"related-link\" href=\"/doc/api/file-read/\">file_read</a><a class=\"related-link\" href=\"/doc/api/file-write/\">file_write</a><a class=\"related-link\" href=\"/doc/api/file-pread/\">file_pread</a><a class=\"related-link\" href=\"/doc/api/file-seek/\">file_seek</a><a class=\"related-link\" href=\"/doc/api/file-tell/\">file_tell</a><a class=\"related-link\" href=\"/doc/api/file-close/\">file_close</")
    print("a><a class=\"related-link\" href=\"/doc/api/file-fsync/\">file_fsync</a></aside></div>")
}

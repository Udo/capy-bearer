function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "job_await"
    page["kind"] = "api"
    page["slug"] = "job-await"
    page["route"] = "/doc/api/job-await/"
    page["title"] = "job_await"
    page["content"] = "`job_await()` waits for a job until the timeout expires. It returns the current status when the timeout expires.\n"
    page["returns"] = "A job status map. A completed job includes `result`."
    page["label"] = "job_await"
    page["capy_sig_lines"] = dval(["function job_await(job : dval, timeout_ms : s32) dval"])
    page["param_lines"] = dval(["job : a job ID as `dval`", "timeout_ms : maximum wait time in milliseconds", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "job_result", href: "/doc/api/job-result/"}, {label: "job_status", href: "/doc/api/job-status/"}, {label: "job_cancel", href: "/doc/api/job-cancel/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var job := shell_spawn(dval({\"cmd\": \"printf hello\", \"timeout_ms\": 1000}))\nvar result := job_await(job, 3000)\nprint(get_by_path(result, \"result/stdout\"), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

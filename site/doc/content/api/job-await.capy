function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>job_await</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function job_await(job : dval, timeout_ms : s32) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>job_await()</code> waits for a job until the timeout expires. It returns the current status when the timeout expires.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>job : a job ID as <code>dval</code></p></div><div><p>timeout_ms : maximum wait time in milliseconds</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A job status map. A completed job includes <code>result</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var job := shell_spawn(dval({&quot;cmd&quot;: &quot;printf hello&quot;, &quot;timeout_ms&quot;: 1000}))\nvar result := job_await(job, 3000)\nprint(get_by_path(result, &quot;result/stdout&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/job-result/\">job_result</a><a class=\"related-link\" href=\"/doc/api/job-status/\">job_status</a><a class=\"related-link\" href=\"/doc/api/job-cancel/\">job_cancel</a></aside></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>password_hash</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function password_hash(password : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>password_hash()</code> creates a password encoding with a random salt and current scrypt parameters.</p><p>Store the returned value exactly. Do not store an empty result.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>password : the password to hash</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>a self-contained password encoding, or an empty string on failure</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var encoded := password_hash(&quot;correct horse battery staple&quot;)\nprint(encoded != &quot;&quot;, &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/password-verify/\">password_verify</a><a class=\"related-link\" href=\"/doc/api/password-needs-rehash/\">password_needs_rehash</a></aside></div>")
}

function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "password_hash"
    page["kind"] = "api"
    page["slug"] = "password-hash"
    page["route"] = "/doc/api/password-hash/"
    page["title"] = "password_hash"
    page["content"] = "`password_hash()` creates a password encoding with a random salt and current scrypt parameters.\n\nStore the returned value exactly. Do not store an empty result.\n"
    page["returns"] = "a self-contained password encoding, or an empty string on failure"
    page["label"] = "password_hash"
    page["capy_sig_lines"] = dval(["function password_hash(password : string) string"])
    page["param_lines"] = dval(["password : the password to hash", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "password_verify", href: "/doc/api/password-verify/"}, {label: "password_needs_rehash", href: "/doc/api/password-needs-rehash/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var encoded := password_hash(\"correct horse battery staple\")\nprint(encoded != \"\", \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

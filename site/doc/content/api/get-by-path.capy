function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>Get a child by path</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function get_by_path(value : dval, path : string) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>get_by_path(value, path)</code> reads a nested child without creating nodes. Use a slash between path segments.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : source value</p></div><div><p>path : slash-separated child path</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>The copied child, or an empty string value when the path fails.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var config := dval({&quot;site&quot;: {&quot;title&quot;: &quot;Bearer&quot;}})\nprint(get_by_path(config, &quot;site/title&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/dvalue/\">dvalue</a><a class=\"related-link\" href=\"/doc/api/get/\">get</a></aside></div>")
}

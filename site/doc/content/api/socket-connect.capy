function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>socket_connect</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function socket_connect(host : string, port : s32) u64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>socket_connect</code> to open a socket to an IPv4 address and port. Pass a nonzero handle to the socket functions.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>Socket handle, or zero when the connection fails.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var handle := socket_connect(&quot;127.0.0.1&quot;, 80)\nprint(handle, &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

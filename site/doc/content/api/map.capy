function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>map</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function map(items : dval, mapper : function(value : string) string) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>map()</code> calls <code>mapper</code> for each item in <code>items</code>.</p><p>It converts each item to a string before it calls <code>mapper</code>. The function returns a new <code>dval</code> list.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>items : the input list</p></div><div><p>mapper : the function that transforms each item</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>a new list of transformed strings</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var names := dval([&quot;ada&quot;, &quot;grace&quot;])\nvar names_upper := map(names, function(name : string) string { return upper(name) })\nprint(join(names_upper, &quot;,&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/length/\">length</a><a class=\"related-link\" href=\"/doc/api/array-merge/\">array_merge</a><a class=\"related-link\" href=\"/doc/api/filter/\">filter</a><a class=\"related-link\" href=\"/doc/api/each/\">each</a><a class=\"related-link\" href=\"/doc/api/find/\">find</a><a class=\"related-link\" href=\"/doc/api/some/\">some</a><a class=\"related-link\" href=\"/doc/api/every/\">every</a><a class=\"related-link\" href=\"/doc/api/sort/\">sort</a><a class=\"related-link\" href=\"/doc/api/unique/\">unique</a><a class=\"related-link\" href=\"/doc/api/s")
    print("tring/\">string</a><a class=\"related-link\" href=\"/doc/api/print/\">print</a></aside></div>")
}

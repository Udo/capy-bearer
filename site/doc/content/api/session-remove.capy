function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>session_remove</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function session_remove(key : string) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Call <code>session_start()</code> before you remove a session field.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>key : session field name</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>The updated session state.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var session := session_start(&quot;docs-session&quot;)\nsession = session_remove(&quot;theme&quot;)\nprint(string(session.name), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/session-start/\">session_start</a><a class=\"related-link\" href=\"/doc/api/session-set/\">session_set</a><a class=\"related-link\" href=\"/doc/api/session-destroy/\">session_destroy</a><a class=\"related-link\" href=\"/doc/api/session-id-create/\">session_id_create</a></aside></div>")

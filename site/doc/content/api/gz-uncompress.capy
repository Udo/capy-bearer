function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>gz_uncompress</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function gz_uncompress(source : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>gz_uncompress()</code> uncompresses gzip data from a string.</p><p>Use it with data from <code>gz_compress()</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>source : gzip-compressed bytes</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>Uncompressed bytes as a string.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var packed := gz_compress(&quot;archive data&quot;)\nvar source := gz_uncompress(packed)\nprint(source, &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/gz-compress/\">gz_compress</a><a class=\"related-link\" href=\"/doc/api/zip-read/\">zip_read</a><a class=\"related-link\" href=\"/doc/api/zip-extract/\">zip_extract</a></aside></div>")
}

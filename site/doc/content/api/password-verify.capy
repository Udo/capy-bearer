function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "password_verify"
    page["kind"] = "api"
    page["slug"] = "password-verify"
    page["route"] = "/doc/api/password-verify/"
    page["title"] = "password_verify"
    page["content"] = "`password_verify()` tests a password against a stored encoding.\n\nIt rejects malformed encodings and parameters above the Bearer limits. Set password length and sign-in rate limits in public handlers.\n"
    page["returns"] = "`true` when the password matches a valid encoding"
    page["label"] = "password_verify"
    page["capy_sig_lines"] = dval(["function password_verify(password : string, encoded : string) bool"])
    page["param_lines"] = dval(["password : the candidate password", "encoded : the stored password encoding", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "password_hash", href: "/doc/api/password-hash/"}, {label: "password_needs_rehash", href: "/doc/api/password-needs-rehash/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var encoded := password_hash(\"correct horse battery staple\")\nprint(password_verify(\"correct horse battery staple\", encoded), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

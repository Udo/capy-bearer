function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>contains</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function contains(haystack : string, needle : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>contains()</code> checks for a substring.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>haystack : the string to search</p></div><div><p>needle : the substring to find</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> if <code>needle</code> occurs in <code>haystack</code>. An empty <code>needle</code> matches.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">if contains(&quot;Capy docs&quot;, &quot;docs&quot;) { print(&quot;yes\\n&quot;) } else { print(&quot;no\\n&quot;) }\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/find/\">find</a><a class=\"related-link\" href=\"/doc/api/strpos/\">strpos</a></aside></div>")
}

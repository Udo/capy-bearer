function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "contains"
    page["kind"] = "api"
    page["slug"] = "contains"
    page["route"] = "/doc/api/contains/"
    page["title"] = "contains"
    page["content"] = "`contains()` checks for a substring.\n"
    page["returns"] = "`true` if `needle` occurs in `haystack`. An empty `needle` matches."
    page["label"] = "contains"
    page["capy_sig_lines"] = dval(["function contains(haystack : string, needle : string) bool"])
    page["param_lines"] = dval(["haystack : the string to search", "needle : the substring to find", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "find", href: "/doc/api/find/"}, {label: "strpos", href: "/doc/api/strpos/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "if contains(\"Capy docs\", \"docs\") { print(\"yes\\n\") } else { print(\"no\\n\") }\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

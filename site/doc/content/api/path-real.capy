function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "path_real"
    page["kind"] = "api"
    page["slug"] = "path-real"
    page["route"] = "/doc/api/path-real/"
    page["title"] = "path_real"
    page["content"] = "`path_real()` returns the canonical absolute path for an existing path.\n\nIt follows symbolic links and removes dot segments. It returns an empty string when it cannot resolve the path.\n"
    page["returns"] = "the canonical absolute path, or an empty string on failure"
    page["label"] = "path_real"
    page["capy_sig_lines"] = dval(["function path_real(path : string) string"])
    page["param_lines"] = dval(["path : the path to resolve", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "path_is_within", href: "/doc/api/path-is-within/"}, {label: "path_join", href: "/doc/api/path-join/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "print(path_real(\"/tmp\"), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

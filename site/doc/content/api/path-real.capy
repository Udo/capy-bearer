function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>path_real</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function path_real(path : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>path_real()</code> returns the canonical absolute path for an existing path.</p><p>It follows symbolic links and removes dot segments. It returns an empty string when it cannot resolve the path.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>path : the path to resolve</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>the canonical absolute path, or an empty string on failure</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(path_real(&quot;/tmp&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/path-is-within/\">path_is_within</a><a class=\"related-link\" href=\"/doc/api/path-join/\">path_join</a></aside></div>")
}

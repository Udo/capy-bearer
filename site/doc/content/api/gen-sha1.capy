function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>gen_sha1</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function gen_sha1(value : string, as_binary : bool = false) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>gen_sha1()</code> returns the SHA-1 digest of a string.</p><p>It returns hexadecimal text by default. Set <code>as_binary</code> to <code>true</code> for raw digest bytes.</p><p>Use it only for SHA-1 compatibility.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : bytes to hash</p></div><div><p>as_binary : <code>false</code> for hexadecimal text, <code>true</code> for raw digest bytes</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A SHA-1 digest string.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var digest := gen_sha1(&quot;abc&quot;)\nprint(digest, &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/sha256/\">sha256</a><a class=\"related-link\" href=\"/doc/api/sha256-hex/\">sha256_hex</a><a class=\"related-link\" href=\"/doc/api/hmac-sha256/\">hmac_sha256</a></aside></div>")
}

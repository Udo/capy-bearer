function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "ls"
    page["kind"] = "api"
    page["slug"] = "ls"
    page["route"] = "/doc/api/ls/"
    page["title"] = "ls"
    page["content"] = "`ls()` returns the names in a directory. It returns an empty list when it cannot list the directory.\n"
    page["returns"] = "A `dval` list of entry names."
    page["label"] = "ls"
    page["capy_sig_lines"] = dval(["function ls(path : string) dval"])
    page["param_lines"] = dval(["path : directory path to list", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "dir_list", href: "/doc/api/dir-list/"}, {label: "mkdir", href: "/doc/api/mkdir/"}, {label: "path_join", href: "/doc/api/path-join/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var root := file_temp(\"/tmp/capy-doc-ls-\")\nfile_unlink(root)\nmkdir(root)\nfile_put_contents(path_join(root, \"one.txt\"), \"1\")\nprint(join(sort(ls(root)), \",\"), \"\\n\")\ndir_remove(root, true)\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>gz_compress</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function gz_compress(source : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>gz_compress()</code> compresses a string with gzip.</p><p>The result contains binary data. Pass it to <code>gz_uncompress()</code> to restore the source.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>source : uncompressed bytes</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>Gzip-compressed bytes as a string.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var source := &quot;archive data&quot;\nvar packed := gz_compress(source)\nprint(gz_uncompress(packed), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/gz-uncompress/\">gz_uncompress</a><a class=\"related-link\" href=\"/doc/api/zip-create/\">zip_create</a><a class=\"related-link\" href=\"/doc/api/zip-read/\">zip_read</a></aside></div>")
}

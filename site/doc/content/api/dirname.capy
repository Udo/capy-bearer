function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "dirname"
    page["kind"] = "api"
    page["slug"] = "dirname"
    page["route"] = "/doc/api/dirname/"
    page["title"] = "dirname"
    page["content"] = "`dirname()` removes the final component from a path string.\n\nThe function does not access the file system.\n"
    page["returns"] = "The directory part of the path."
    page["label"] = "dirname"
    page["capy_sig_lines"] = dval(["function dirname(path : string) string"])
    page["param_lines"] = dval(["path : the path to inspect", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "basename", href: "/doc/api/basename/"}, {label: "path_join", href: "/doc/api/path-join/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "print(dirname(\"/var/www/site/index.capy\"), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

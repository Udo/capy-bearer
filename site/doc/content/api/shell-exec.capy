function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>shell_exec</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function shell_exec(command : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>shell_exec</code> to run a shell command and get its output. Escape external values with <code>shell_escape</code> before you add them to the command.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>Command output.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(shell_exec(&quot;printf hello&quot;), &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

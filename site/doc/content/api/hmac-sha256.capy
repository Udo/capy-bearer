function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>hmac_sha256</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function hmac_sha256(key : string, value : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>hmac_sha256()</code> returns 32 raw HMAC-SHA256 bytes. Use <code>hex(hmac_sha256(key, value))</code> when you need lowercase hexadecimal text.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>key : secret key bytes</p></div><div><p>value : message bytes</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A raw 32-byte HMAC-SHA256 value.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(length(hmac_sha256(&quot;key&quot;, &quot;message&quot;)), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/password-hash/\">password_hash</a><a class=\"related-link\" href=\"/doc/api/password-verify/\">password_verify</a><a class=\"related-link\" href=\"/doc/api/gen-sha1/\">gen_sha1</a><a class=\"related-link\" href=\"/doc/api/sha256/\">sha256</a><a class=\"related-link\" href=\"/doc/api/crypto-equal/\">crypto_equal</a><a class=\"related-link\" href=\"/doc/api/runtime-safe-key/\">runtime_safe_key</a><a class=\"related-link\" href=\"/doc/api/hex/\">hex</a></aside></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>hmac_sha256</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function hmac_sha256(key : string, value : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>hmac_sha256()</code> returns a raw binary HMAC-SHA256 value. Use <code>hmac_sha256_hex()</code> when you need hexadecimal text.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>key : secret key bytes</p></div><div><p>value : message bytes</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A raw 32-byte HMAC-SHA256 value.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(length(hmac_sha256(&quot;key&quot;, &quot;message&quot;)), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/hmac-sha256-hex/\">hmac_sha256_hex</a><a class=\"related-link\" href=\"/doc/api/sha256/\">sha256</a><a class=\"related-link\" href=\"/doc/api/crypto-equal/\">crypto_equal</a></aside></div>")
}

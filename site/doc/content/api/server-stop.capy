    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>server_stop</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function server_stop(key : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>server_stop()</code> removes the custom HTTP listener for <code>key</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>key : listener key</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> if no listener remains.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(server_stop(&quot;docs-server&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/server-start-http/\">server_start_http</a></aside></div>")

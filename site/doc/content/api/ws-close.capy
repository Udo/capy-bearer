function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>ws_close</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function ws_close(connection_id : string = &quot;&quot;) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>ws_close()</code> closes the current WebSocket client. Pass a client ID to close that client.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>connection_id : client ID. The default is the current client.</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> when the server queues the close.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">ws_close()\n</pre></div></div></main></div>")
}

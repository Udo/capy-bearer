function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>backtrace_get_frames</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function backtrace_get_frames(max_frames : s32 = 32, skip_frames : s32 = 0) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>backtrace_get_frames</code> gets source-mapped frames for the current Capy call stack.</p><p>Set <code>max_frames</code> to limit the result. Set <code>skip_frames</code> to omit the newest frames.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>max_frames : maximum number of frames</p></div><div><p>skip_frames : number of newest frames to omit</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>a backtrace string</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(backtrace_get_frames(4, 0), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/trap/\">trap</a><a class=\"related-link\" href=\"/doc/api/backtrace-capture/\">backtrace_capture</a><a class=\"related-link\" href=\"/doc/api/posix-info/\">posix_info</a><a class=\"related-link\" href=\"/doc/api/runtime-perf/\">runtime_perf</a></aside></div>")
}

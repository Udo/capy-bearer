function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>xml_decode</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function xml_decode(source : string) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>xml_decode()</code> decodes XML source into a <code>dval</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>source : XML source</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A <code>dval</code> that contains the decoded XML.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var value := xml_decode(&quot;&lt;root&gt;&lt;name&gt;Ada&lt;/name&gt;&lt;/root&gt;&quot;)\nprint(value[&quot;children&quot;][0][&quot;text&quot;], &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/xml-encode/\">xml_encode</a><a class=\"related-link\" href=\"/doc/api/json-decode/\">json_decode</a><a class=\"related-link\" href=\"/doc/type/dvalue/\">dvalue</a><a class=\"related-link\" href=\"/doc/type/string/\">string</a></aside></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>Filter strings</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function filter(items : dval, predicate : function(value : string) bool) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>filter</code> keeps the strings for which <code>predicate</code> returns <code>true</code>.</p><p>The result keeps input order. This function does not change <code>items</code>.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>This function returns a new list-shaped <code>dval</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var items := split(&quot;one,two&quot;, &quot;,&quot;)\nvar kept := filter(items, function(value : string) bool { return value == &quot;two&quot; })\nprint(join(kept, &quot;,&quot;), &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

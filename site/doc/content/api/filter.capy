function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "filter"
    page["kind"] = "api"
    page["slug"] = "filter"
    page["route"] = "/doc/api/filter/"
    page["title"] = "Filter strings"
    page["content"] = "`filter` keeps the strings for which `predicate` returns `true`.\n\nThe result keeps input order. This function does not change `items`.\n"
    page["returns"] = "This function returns a new list-shaped `dval`."
    page["label"] = "filter"
    page["capy_sig_lines"] = dval(["function filter(items : dval, predicate : function(value : string) bool) dval"])
    page["param_lines"] = dval([])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([])
    page["examples"] = dval([{entry: "render", caption: "", body: "var items := split(\"one,two\", \",\")\nvar kept := filter(items, function(value : string) bool { return value == \"two\" })\nprint(join(kept, \",\"), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

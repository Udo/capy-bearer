function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>time_format_utc</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function time_format_utc(format : string = &quot;&quot;, timestamp : u64 = 0) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>time_format_utc</code> formats a Unix timestamp in UTC.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>format : date format</p></div><div><p>timestamp : Unix timestamp. Zero uses the current time</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>formatted UTC time</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(time_format_utc(&quot;%Y&quot;, u64(5)), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/time/\">time</a><a class=\"related-link\" href=\"/doc/api/time-precise/\">time_precise</a><a class=\"related-link\" href=\"/doc/api/time-parse/\">time_parse</a><a class=\"related-link\" href=\"/doc/api/time-format-relative/\">time_format_relative</a><a class=\"related-link\" href=\"/doc/api/time-format-local/\">time_format_local</a><a class=\"related-link\" href=\"/doc/api/usleep/\">usleep</a></aside></div>")
}

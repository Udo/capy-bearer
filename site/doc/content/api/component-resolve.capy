function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "component_resolve"
    page["kind"] = "api"
    page["slug"] = "component-resolve"
    page["route"] = "/doc/api/component-resolve/"
    page["title"] = "component_resolve"
    page["content"] = "`component_resolve()` answers \"which file would `component()` actually load for this name?\". It renders nothing and runs no handler.\n\nThis is the tool for debugging resolution. Because a relative name is tried against several directories in turn, the same string can mean different files depending on which unit is calling it, and the failure that follows is usually reported against the wrong place. Printing the resolved path shows you which candidate won.\n\n## The order it searches\n\n`.capy` is appended when the name has no suffix. A `:HANDLER` suffix does not affect the returned path.\n\nA name starting with `/` is tried as a real filesystem path first, then as a path under the site root.\n\nA relative name is tried against, in order:\n\n1. the directory of the entry unit handling the request\n2. the directory of the unit calling `component_resolve()`, when that differs\n3. the site root\n\nThe first candidate that exists is returned. A candidate that resolves outside the site root is rejected, and the result is an empty string.\n\nAn empty return means the same thing as `component_exists()` returning `false` — the two functions run the same lookup and differ only in what they report.\n"
    page["returns"] = "The absolute source path the name resolves to, or an empty string when nothing matches."
    page["label"] = "component_resolve"
    page["capy_sig_lines"] = dval(["function component_resolve(name : string) string"])
    page["param_lines"] = dval(["name : a component path, optionally followed by `:HANDLER`", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "component", href: "/doc/api/component/"}, {label: "component_exists", href: "/doc/api/component-exists/"}, {label: "component_render", href: "/doc/api/component-render/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "print(component_resolve(\"/doc/examples/card\"), \"\\n\")\n"}, {entry: "render", caption: "show which directory a relative name reached", body: "var resolved := component_resolve(\"card\")\nif length(resolved) > 0 { print(resolved, \"\\n\") } else { print(\"unresolved\\n\") }\n"}, {entry: "render", caption: "the handler suffix does not change the path", body: "print(component_resolve(\"/doc/examples/card.capy:CARD\"), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>first</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function first() string\nfunction first(one : string) string\nfunction first(one : string, two : string) string\nfunction first(one : string, two : string, three : string) string\nfunction first(one : string, two : string, three : string, four : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>first</code> checks values in order. It ignores values that contain only whitespace.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>one : first value</p></div><div><p>two : second value</p></div><div><p>three : third value</p></div><div><p>four : fourth value</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>The first nonblank value. Returns <code>&quot;&quot;</code> if no value is nonblank.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(first(&quot;&quot;, &quot;  &quot;, &quot;fallback&quot;, &quot;other&quot;), &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>first</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function first() string\nfunction first(one : string) string\nfunction first(one : string, two : string) string\nfunction first(one : string, two : string, three : string) string\nfunction first(one : string, two : string, three : string, four : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>first</code> checks values in order. It ignores values that contain only whitespace.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>one : first value</p></div><div><p>two : second value</p></div><div><p>three : third value</p></div><div><p>four : fourth value</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>The first nonblank value. Returns <code>&quot;&quot;</code> if no value is nonblank.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(first(&quot;&quot;, &quot;  &quot;, &quot;fallback&quot;, &quot;other&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/string/\">String</a><a class=\"related-link\" href=\"/doc/api/substr/\">substr</a><a class=\"related-link\" href=\"/doc/api/strpos/\">strpos</a><a class=\"related-link\" href=\"/doc/api/contains/\">contains</a><a class=\"related-link\" href=\"/doc/api/replace/\">replace</a><a class=\"related-link\" href=\"/doc/api/trim/\">trim</a><a class=\"related-link\" href=\"/doc/api/join/\">join</a><a class=\"related-link\" href=\"/doc/api/nibble/\">nibble</a><a class=\"related-link\" href=\"/")
    print("doc/api/clone/\">clone</a><a class=\"related-link\" href=\"/doc/api/str-starts-with/\">str_starts_with</a><a class=\"related-link\" href=\"/doc/api/str-ends-with/\">str_ends_with</a><a class=\"related-link\" href=\"/doc/api/lower/\">lower</a><a class=\"related-link\" href=\"/doc/api/upper/\">upper</a><a class=\"related-link\" href=\"/doc/api/safe-name/\">safe_name</a></aside></div>")

function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "first"
    page["kind"] = "api"
    page["slug"] = "first"
    page["route"] = "/doc/api/first/"
    page["title"] = "first"
    page["content"] = "`first` checks values in order. It ignores values that contain only whitespace.\n"
    page["returns"] = "The first nonblank value. Returns `\"\"` if no value is nonblank."
    page["label"] = "first"
    page["capy_sig_lines"] = dval(["function first() string", "function first(one : string) string", "function first(one : string, two : string) string", "function first(one : string, two : string, three : string) string", "function first(one : string, two : string, three : string, four : string) string"])
    page["param_lines"] = dval(["one : first value", "two : second value", "three : third value", "four : fourth value", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([])
    page["examples"] = dval([{entry: "render", caption: "", body: "print(first(\"\", \"  \", \"fallback\", \"other\"), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

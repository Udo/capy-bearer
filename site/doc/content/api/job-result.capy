function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>job_result</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function job_result(job : dval) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>job_result()</code> checks a job with a short bounded wait. Use it to poll a job after <code>shell_exec(command, flags)</code> or <code>http_request_async()</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>job : a job ID as <code>dval</code></p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A job status map. A completed job includes <code>result</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var job := shell_exec(&quot;printf result&quot;, {background: true, timeout_ms: 1000})\njob_await(job, 3000)\nprint(get_by_path(job_result(job), &quot;result/stdout&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/job-status/\">job_status</a><a class=\"related-link\" href=\"/doc/api/job-await/\">job_await</a><a class=\"related-link\" href=\"/doc/api/job-cancel/\">job_cancel</a></aside></div>")
}

function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "password_needs_rehash"
    page["kind"] = "api"
    page["slug"] = "password-needs-rehash"
    page["route"] = "/doc/api/password-needs-rehash/"
    page["title"] = "password_needs_rehash"
    page["content"] = "`password_needs_rehash()` returns `true` for malformed encodings and older Bearer password parameters.\n\nCall it after `password_verify()` succeeds. Hash the known password again and replace the stored encoding.\n"
    page["returns"] = "`true` when the encoding needs replacement"
    page["label"] = "password_needs_rehash"
    page["capy_sig_lines"] = dval(["function password_needs_rehash(encoded : string) bool"])
    page["param_lines"] = dval(["encoded : the stored password encoding", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "password_hash", href: "/doc/api/password-hash/"}, {label: "password_verify", href: "/doc/api/password-verify/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var encoded := password_hash(\"correct horse battery staple\")\nif password_verify(\"correct horse battery staple\", encoded) { print(password_needs_rehash(encoded), \"\\n\") }\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>password_needs_rehash</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function password_needs_rehash(encoded : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>password_needs_rehash()</code> returns <code>true</code> for malformed encodings and older Bearer password parameters.</p><p>Call it after <code>password_verify()</code> succeeds. Hash the known password again and replace the stored encoding.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>encoded : the stored password encoding</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> when the encoding needs replacement</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var encoded := password_hash(&quot;correct horse battery staple&quot;)\nif password_verify(&quot;correct horse battery staple&quot;, encoded) { print(password_needs_rehash(encoded), &quot;\\n&quot;) }\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/password-hash/\">password_hash</a><a class=\"related-link\" href=\"/doc/api/password-verify/\">password_verify</a></aside></div>")
}

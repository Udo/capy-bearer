function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>file_put_contents</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function file_put_contents(path : string, content : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>file_put_contents</code> writes a complete string to a file. It creates or replaces a small file.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>path : path of the file to write</p></div><div><p>content : text that replaces the file content</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> when Capy writes the file. Otherwise, it returns <code>false</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">file_put_contents(&quot;/tmp/doc-put.txt&quot;, &quot;first&quot;)\nfile_put_contents(&quot;/tmp/doc-put.txt&quot;, &quot;second&quot;)\nprint(file_get_contents(&quot;/tmp/doc-put.txt&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/file-get-contents/\">file_get_contents</a><a class=\"related-link\" href=\"/doc/api/file-append/\">file_append</a><a class=\"related-link\" href=\"/doc/api/file-open/\">file_open</a></aside></div>")
}

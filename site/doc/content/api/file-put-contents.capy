function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "file_put_contents"
    page["kind"] = "api"
    page["slug"] = "file-put-contents"
    page["route"] = "/doc/api/file-put-contents/"
    page["title"] = "file_put_contents"
    page["content"] = "`file_put_contents` writes a complete string to a file. It creates or replaces a small file.\n"
    page["returns"] = "`true` when Capy writes the file. Otherwise, it returns `false`."
    page["label"] = "file_put_contents"
    page["capy_sig_lines"] = dval(["function file_put_contents(path : string, content : string) bool"])
    page["param_lines"] = dval(["path : path of the file to write", "content : text that replaces the file content", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "file_get_contents", href: "/doc/api/file-get-contents/"}, {label: "file_append", href: "/doc/api/file-append/"}, {label: "file_open", href: "/doc/api/file-open/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "file_put_contents(\"/tmp/doc-put.txt\", \"first\")\nfile_put_contents(\"/tmp/doc-put.txt\", \"second\")\nprint(file_get_contents(\"/tmp/doc-put.txt\"), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

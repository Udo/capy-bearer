function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>encode_query</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function encode_query(map : dval) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>encode_query()</code> converts a map-shaped <code>dval</code> to a URL query string.</p><p>Pass the returned string after <code>?</code> in a URL.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>map : map-shaped <code>dval</code> of URL parameters</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>URL query string</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var query := dval({&quot;name&quot;: &quot;Ada&quot;})\nprint(encode_query(query), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/parse-uri/\">parse_uri</a><a class=\"related-link\" href=\"/doc/api/parse-query/\">parse_query</a><a class=\"related-link\" href=\"/doc/api/redirect/\">redirect</a><a class=\"related-link\" href=\"/doc/how-to/read-request-context/\">read-request-context</a></aside></div>")
}

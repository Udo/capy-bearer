function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "encode_query"
    page["kind"] = "api"
    page["slug"] = "encode-query"
    page["route"] = "/doc/api/encode-query/"
    page["title"] = "encode_query"
    page["content"] = "`encode_query()` converts a map-shaped `dval` to a URL query string.\n\nPass the returned string after `?` in a URL.\n"
    page["returns"] = "URL query string"
    page["label"] = "encode_query"
    page["capy_sig_lines"] = dval(["function encode_query(map : dval) string"])
    page["param_lines"] = dval(["map : map-shaped `dval` of URL parameters", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "redirect", href: "/doc/api/redirect/"}, {label: "request_context_params", href: "/doc/api/request-context-params/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var query := dval({\"name\": \"Ada\"})\nprint(encode_query(query), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

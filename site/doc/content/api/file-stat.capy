function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "file_stat"
    page["kind"] = "api"
    page["slug"] = "file-stat"
    page["route"] = "/doc/api/file-stat/"
    page["title"] = "file_stat"
    page["content"] = "`file_stat` returns metadata for a path. The result includes `exists`, `is_file`, `is_dir`, `is_symlink`, and `size`.\n"
    page["returns"] = "A `dval` with file metadata."
    page["label"] = "file_stat"
    page["capy_sig_lines"] = dval(["function file_stat(path : string) dval"])
    page["param_lines"] = dval(["path : path to inspect", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([])
    page["examples"] = dval([{entry: "render", caption: "", body: "file_put_contents(\"/tmp/doc-stat.txt\", \"12345\")\nvar stat := file_stat(\"/tmp/doc-stat.txt\")\nprint(u64(stat[\"size\"]), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>file_stat</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function file_stat(path : string) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>file_stat</code> returns metadata for a path. The result includes <code>exists</code>, <code>is_file</code>, <code>is_dir</code>, <code>is_symlink</code>, and <code>size</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>path : path to inspect</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A <code>dval</code> with file metadata.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">file_put_contents(&quot;/tmp/doc-stat.txt&quot;, &quot;12345&quot;)\nvar stat := file_stat(&quot;/tmp/doc-stat.txt&quot;)\nprint(u64(stat[&quot;size&quot;]), &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

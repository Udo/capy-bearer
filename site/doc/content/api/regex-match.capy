function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>regex_match</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function regex_match(pattern : string, subject : string, flags : string = &quot;&quot;) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>regex_match()</code> to test a complete string. Use <code>regex_search()</code> to find text within a string.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>pattern : regular expression</p></div><div><p>subject : text to test</p></div><div><p>flags : regular expression flags</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> if the complete subject matches the pattern.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(regex_match(&quot;[a-z]+&quot;, &quot;Capy&quot;, &quot;i&quot;), &quot;\\n&quot;)\n</pre></div></div></main></div>")
}

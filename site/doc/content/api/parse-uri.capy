function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "parse_uri"
    page["kind"] = "api"
    page["slug"] = "parse-uri"
    page["route"] = "/doc/api/parse-uri/"
    page["title"] = "parse_uri"
    page["content"] = "`parse_uri()` returns URI parts as a `dval`.\n\nRead the `parts` and `query` maps from the result. Use `parse_query()` when you only have query text.\n"
    page["returns"] = "the URI data"
    page["label"] = "parse_uri"
    page["capy_sig_lines"] = dval(["function parse_uri(uri : string) dval"])
    page["param_lines"] = dval(["uri : the URI or URL text", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "parse_query", href: "/doc/api/parse-query/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var parsed := parse_uri(\"https://example.test/docs?name=Ada\")\nprint(parsed[\"parts\"][\"path\"], \" \", parsed[\"query\"][\"name\"], \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

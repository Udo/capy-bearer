function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "task"
    page["kind"] = "api"
    page["slug"] = "task"
    page["route"] = "/doc/api/task/"
    page["title"] = "task"
    page["content"] = "Use `task` to submit a task handler. Pass a unit path and a `dval` value for its input.\n"
    page["returns"] = "Task identifier."
    page["label"] = "task"
    page["capy_sig_lines"] = dval(["function task(target : string, props : as dval) string"])
    page["param_lines"] = dval([])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([])
    page["examples"] = dval([{entry: "render", caption: "", body: "var id := task(\"/tests/task-handlers.capy\", dval({\"nested\": {\"value\": \"Ada\"}}))\nprint(id, \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

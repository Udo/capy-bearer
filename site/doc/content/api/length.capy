function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>length</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function length(value : string) s64\nfunction length(value : dval) s64\nfunction length(value : [T]) s64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>length()</code> counts bytes in strings. It counts entries in <code>dval</code> maps and lists, and elements in arrays.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : text, a <code>dval</code> map or list, or an array</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A byte count for text, or an entry count for maps, lists, and arrays.</p></div><div class=\"doc-section\"><h3>Errors</h3><p><code>length()</code> traps when a scalar <code>dval</code> reaches it.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(length(&quot;capy docs&quot;), &quot; / &quot;, length(dval([&quot;a&quot;, &quot;b&quot;])), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/array-merge/\">array_merge</a><a class=\"related-link\" href=\"/doc/api/map/\">map</a><a class=\"related-link\" href=\"/doc/api/filter/\">filter</a><a class=\"related-link\" href=\"/doc/api/each/\">each</a><a class=\"related-link\" href=\"/doc/api/find/\">find</a><a class=\"related-link\" href=\"/doc/api/some/\">some</a><a class=\"related-link\" href=\"/doc/api/every/\">every</a><a class=\"related-link\" href=\"/doc/api/sort/\">sort</a><a class=\"related-link\" href=\"/doc/api/unique/\">unique</a><a class=\"related-link\" href=\"/doc/api/split/\">s")
    print("plit</a><a class=\"related-link\" href=\"/doc/api/join/\">join</a></aside></div>")
}

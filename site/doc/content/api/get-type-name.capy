function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>Get a dynamic value type name</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function get_type_name(value : dval) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>get_type_name(value)</code> returns the runtime type name for a dynamic value.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : value to inspect</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>The type name.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(get_type_name(dval(&quot;text&quot;)), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/dvalue/\">dvalue</a></aside></div>")
}

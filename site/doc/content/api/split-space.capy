    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>split_space</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function split_space(value : string) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>split_space</code> to separate text at whitespace.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>List-shaped <code>dval</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(join(split_space(&quot;one  two&quot;), &quot;,&quot;), &quot;\\n&quot;)\n</pre></div></div></main></div>")

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>bool</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function bool(value : dval, fallback : bool = false) bool\nfunction bool(value : string, fallback : bool = false) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>bool</code> converts a <code>dval</code> or string to a Boolean value.</p><p>For strings, it ignores outer whitespace and accepts case-insensitive Boolean text. It returns <code>fallback</code> when conversion fails.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : value to convert</p></div><div><p>fallback : value to return when conversion fails</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>a Boolean value</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(bool(&quot;YES&quot;), &quot;\\n&quot;)\nprint(bool(&quot;unknown&quot;, true), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/string/\">string</a></aside></div>")
}

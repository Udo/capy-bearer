function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "cwd_set"
    page["kind"] = "api"
    page["slug"] = "cwd-set"
    page["route"] = "/doc/api/cwd-set/"
    page["title"] = "cwd_set"
    page["content"] = "`cwd_set()` changes the worker process working directory.\n\nSave the current directory with `cwd_get()`. Restore it after temporary use.\n"
    page["label"] = "cwd_set"
    page["capy_sig_lines"] = dval(["function cwd_set(path : string)"])
    page["param_lines"] = dval(["path : the new working directory path", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "cwd_get", href: "/doc/api/cwd-get/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var old_path := cwd_get()\ncwd_set(\"/tmp\")\nprint(cwd_get(), \"\\n\")\ncwd_set(old_path)\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

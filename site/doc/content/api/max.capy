function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>max</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function max(a : f32, b : f32) f32\nfunction max(a : f64, b : f64) f64\nfunction max(a : s8, b : s8) s8\nfunction max(a : s16, b : s16) s16\nfunction max(a : s32, b : s32) s32\nfunction max(a : s64, b : s64) s64\nfunction max(a : u8, b : u8) u8\nfunction max(a : u16, b : u16) u16\nfunction max(a : u32, b : u32) u32\nfunction max(a : u64, b : u64) u64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>max()</code> returns the larger of <code>a</code> and <code>b</code>.</p><p>The compiler emits a direct lib call.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>a : the first value</p></div><div><p>b : the second value</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A value with the same type as the inputs</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var value := max(3.0, 2.0)\nprint(value, &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/sqrt/\">sqrt</a><a class=\"related-link\" href=\"/doc/api/abs/\">abs</a><a class=\"related-link\" href=\"/doc/api/neg/\">neg</a><a class=\"related-link\" href=\"/doc/api/floor/\">floor</a><a class=\"related-link\" href=\"/doc/api/ceil/\">ceil</a><a class=\"related-link\" href=\"/doc/api/trunc/\">trunc</a><a class=\"related-link\" href=\"/doc/api/nearest/\">nearest</a><a class=\"related-link\" href=\"/doc/api/min/\">min</a><a class=\"related-link\" href=\"/doc/api/copysign/\">copysign</a><a class=\"related-link\" href=\"/doc/api/p")
    print("ow/\">pow</a><a class=\"related-link\" href=\"/doc/api/log/\">log</a><a class=\"related-link\" href=\"/doc/api/exp/\">exp</a><a class=\"related-link\" href=\"/doc/api/sin/\">sin</a><a class=\"related-link\" href=\"/doc/api/cos/\">cos</a><a class=\"related-link\" href=\"/doc/api/atan2/\">atan2</a><a class=\"related-link\" href=\"/doc/api/is-nan/\">is_nan</a><a class=\"related-link\" href=\"/doc/api/is-infinite/\">is_infinite</a><a class=\"related-link\" href=\"/doc/api/is-finite/\">is_finite</a><a class=\"related-link\" href=\"/doc/api/clamp/\">clamp</a></aside></div>")
}

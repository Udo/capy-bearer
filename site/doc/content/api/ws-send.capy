function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>ws_send</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function ws_send(message : string, binary : bool) bool\nfunction ws_send(message : string, binary : bool, scope : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>ws_send()</code> sends a message to every client in the current scope. Pass <code>scope</code> to select a scope.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>message : message bytes to send</p></div><div><p>binary : <code>true</code> for a binary frame</p></div><div><p>scope : scope identifier</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> when the server queues the message for a client.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">ws_send(&quot;hello&quot;, false)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/ws-send-to/\">ws_send_to</a></aside></div>")
}

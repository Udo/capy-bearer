function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>copysign</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function copysign(magnitude : f32, sign : f32) f32\nfunction copysign(magnitude : f64, sign : f64) f64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>copysign()</code> copies the sign of <code>sign</code> to the magnitude of <code>magnitude</code>.</p><p>The compiler emits a direct lib call.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>magnitude : the absolute value to use</p></div><div><p>sign : the value that supplies the sign</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A value with the magnitude of <code>magnitude</code> and the sign of <code>sign</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var value := copysign(2.0, -1.0)\nprint(value, &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/sqrt/\">sqrt</a><a class=\"related-link\" href=\"/doc/api/abs/\">abs</a><a class=\"related-link\" href=\"/doc/api/neg/\">neg</a><a class=\"related-link\" href=\"/doc/api/floor/\">floor</a><a class=\"related-link\" href=\"/doc/api/ceil/\">ceil</a><a class=\"related-link\" href=\"/doc/api/trunc/\">trunc</a><a class=\"related-link\" href=\"/doc/api/nearest/\">nearest</a><a class=\"related-link\" href=\"/doc/api/min/\">min</a><a class=\"related-link\" href=\"/doc/api/max/\">max</a><a class=\"related-link\" href=\"/doc/api/pow/\">pow</a><a class=\"related-link\" href=\"/doc/api/log/\">log</a><a class=\"related-link\" href=\"/doc/api/exp/\">exp</a><a class=\"re")
    print("lated-link\" href=\"/doc/api/sin/\">sin</a><a class=\"related-link\" href=\"/doc/api/cos/\">cos</a><a class=\"related-link\" href=\"/doc/api/atan2/\">atan2</a><a class=\"related-link\" href=\"/doc/api/is-nan/\">is_nan</a><a class=\"related-link\" href=\"/doc/api/is-infinite/\">is_infinite</a><a class=\"related-link\" href=\"/doc/api/is-finite/\">is_finite</a><a class=\"related-link\" href=\"/doc/api/clamp/\">clamp</a></aside></div>")
}

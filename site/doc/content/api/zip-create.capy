function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "zip_create"
    page["kind"] = "api"
    page["slug"] = "zip-create"
    page["route"] = "/doc/api/zip-create/"
    page["title"] = "zip_create"
    page["content"] = "`zip_create()` creates a ZIP archive from a `dval` map of entry names and content.\n"
    page["returns"] = "`true` when the server creates the archive."
    page["label"] = "zip_create"
    page["capy_sig_lines"] = dval(["function zip_create(path : string, entries : dval) bool"])
    page["param_lines"] = dval(["path : archive path", "entries : archive entries", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "zip_list", href: "/doc/api/zip-list/"}, {label: "zip_read", href: "/doc/api/zip-read/"}, {label: "zip_extract", href: "/doc/api/zip-extract/"}, {label: "dvalue", href: "/doc/type/dvalue/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var archive := file_temp(\"/tmp/capy-zip-\") + \".zip\"\nzip_create(archive, dval({\"note.txt\": \"hello\"}))\nprint(zip_read(archive, \"note.txt\"), \"\\n\")\nfile_unlink(archive)\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

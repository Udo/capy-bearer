function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "random_bytes"
    page["kind"] = "api"
    page["slug"] = "random-bytes"
    page["route"] = "/doc/api/random-bytes/"
    page["title"] = "random_bytes"
    page["content"] = "`random_bytes()` returns random bytes. The result can contain binary data.\n\nUse `base64_encode()` when you need printable text.\n"
    page["returns"] = "Random bytes as a string."
    page["label"] = "random_bytes"
    page["capy_sig_lines"] = dval(["function random_bytes(count : u64) string"])
    page["param_lines"] = dval(["count : number of bytes to request", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([])
    page["examples"] = dval([{entry: "render", caption: "", body: "var token := base64_encode(random_bytes(u64(16)))\nprint(token, \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>file_rename</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function file_rename(from : string, to : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>file_rename</code> changes a file path. The source path no longer exists after a successful call.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>from : source path</p></div><div><p>to : destination path</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> if Capy renames the file. Otherwise, <code>false</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">file_put_contents(&quot;/tmp/doc-rename-source.txt&quot;, &quot;moved&quot;)\nif file_rename(&quot;/tmp/doc-rename-source.txt&quot;, &quot;/tmp/doc-rename-destination.txt&quot;) {\n    print(file_get_contents(&quot;/tmp/doc-rename-destination.txt&quot;), &quot;\\n&quot;)\n}\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/file-get-contents/\">file_get_contents</a><a class=\"related-link\" href=\"/doc/api/file-put-contents/\">file_put_contents</a><a class=\"related-link\" href=\"/doc/api/file-append/\">file_append</a><a class=\"related-link\" href=\"/doc/api/file-exists/\">file_exists</a><a class=\"related-link\" href=\"/doc/api/file-mtime/\">file_mtime</a><a class=\"related-link\" href=\"/doc/api/file-stat/\">file_stat</a><a class=\"related-link\" href=\"/doc/api/file-unlink/\">file_unlink</a><a class=\"related-link\" href=\"/doc/api/file-copy/\">file_copy</a><a class=\"related-link\" hre")
    print("f=\"/doc/api/file-truncate/\">file_truncate</a><a class=\"related-link\" href=\"/doc/api/file-chmod/\">file_chmod</a><a class=\"related-link\" href=\"/doc/api/file-symlink/\">file_symlink</a><a class=\"related-link\" href=\"/doc/api/file-temp/\">file_temp</a></aside></div>")
}

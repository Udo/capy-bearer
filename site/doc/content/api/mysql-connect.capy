function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>mysql_connect</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function mysql_connect(host : string, username : string, password : string, database : string) u64</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>mysql_connect()</code> creates a MySQL connection lease and returns its handle.</p><p>Use <code>mysql_info(database, &quot;connection&quot;)</code> before database work. Call <code>mysql_disconnect()</code> after use. A failed connection can return a nonzero handle.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>host : the MySQL server host</p></div><div><p>username : the MySQL user name</p></div><div><p>password : the MySQL password</p></div><div><p>database : the initial database name</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>a request-local MySQL connection handle</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var database := mysql_connect(&quot;localhost&quot;, &quot;root&quot;, &quot;&quot;, &quot;&quot;)\nif bool(mysql_info(database, &quot;connection&quot;)) { print(&quot;connected\\n&quot;) } else { print(string(mysql_info(database, &quot;error&quot;)), &quot;\\n&quot;) }\nif database != u64(0) { mysql_disconnect(database) }\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/mysql-info/\">mysql_info</a><a class=\"related-link\" href=\"/doc/api/mysql-disconnect/\">mysql_disconnect</a></aside></div>")
}

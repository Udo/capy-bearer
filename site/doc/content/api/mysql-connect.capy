function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "mysql_connect"
    page["kind"] = "api"
    page["slug"] = "mysql-connect"
    page["route"] = "/doc/api/mysql-connect/"
    page["title"] = "mysql_connect"
    page["content"] = "`mysql_connect()` creates a MySQL connection lease and returns its handle.\n\nUse `mysql_info(database, \"connection\")` before database work. Call `mysql_disconnect()` after use. A failed connection can return a nonzero handle.\n"
    page["returns"] = "a request-local MySQL connection handle"
    page["label"] = "mysql_connect"
    page["capy_sig_lines"] = dval(["function mysql_connect(host : string, username : string, password : string, database : string) u64"])
    page["param_lines"] = dval(["host : the MySQL server host", "username : the MySQL user name", "password : the MySQL password", "database : the initial database name", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "mysql_info", href: "/doc/api/mysql-info/"}, {label: "mysql_disconnect", href: "/doc/api/mysql-disconnect/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var database := mysql_connect(\"localhost\", \"root\", \"\", \"\")\nif bool(mysql_info(database, \"connection\"), false) { print(\"connected\\n\") } else { print(string(mysql_info(database, \"error\"), \"\"), \"\\n\") }\nif database != u64(0) { mysql_disconnect(database) }\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

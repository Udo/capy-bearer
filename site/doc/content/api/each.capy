function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>Call a function for each string</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function each(items : dval, callback : function(value : string) string)</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>each</code> calls <code>callback</code> once for each item in a list-shaped <code>dval</code>.</p><p>The callback receives a string value. <code>each</code> processes items in list order.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>This function returns no value.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var items := split(&quot;one,two&quot;, &quot;,&quot;)\neach(items, function(value : string) string { print(value); return &quot;&quot; })\nprint(&quot;\\n&quot;)\n</pre></div></div></main></div>")
}

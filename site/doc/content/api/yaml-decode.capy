function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>yaml_decode</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function yaml_decode(source : string) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>yaml_decode()</code> decodes YAML source into a <code>dval</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>source : YAML source</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>A <code>dval</code> that contains the decoded YAML.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var value := yaml_decode(&quot;name: Ada\\n&quot;)\nprint(value[&quot;name&quot;], &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/yaml-encode/\">yaml_encode</a><a class=\"related-link\" href=\"/doc/api/json-decode/\">json_decode</a><a class=\"related-link\" href=\"/doc/type/dvalue/\">dvalue</a><a class=\"related-link\" href=\"/doc/api/string/\">string</a></aside></div>")

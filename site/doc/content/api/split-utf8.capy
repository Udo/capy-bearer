function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>split_utf8</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function split_utf8(value : string, compound : bool = false) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>split_utf8</code> to split UTF-8 text into characters. Set <code>compound</code> when you need supported compound characters kept together.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>List-shaped <code>dval</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(join(split_utf8(&quot;Aé&quot;), &quot;,&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/split/\">split</a><a class=\"related-link\" href=\"/doc/api/split-space/\">split_space</a><a class=\"related-link\" href=\"/doc/api/split-kv/\">split_kv</a><a class=\"related-link\" href=\"/doc/api/split-http-headers/\">split_http_headers</a></aside></div>")

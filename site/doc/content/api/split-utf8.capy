function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "split_utf8"
    page["kind"] = "api"
    page["slug"] = "split-utf8"
    page["route"] = "/doc/api/split-utf8/"
    page["title"] = "split_utf8"
    page["content"] = "Use `split_utf8` to split UTF-8 text into characters. Set `compound` when you need supported compound characters kept together.\n"
    page["returns"] = "List-shaped `dval`."
    page["label"] = "split_utf8"
    page["capy_sig_lines"] = dval(["function split_utf8(value : string, compound : bool = false) dval"])
    page["param_lines"] = dval([])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([])
    page["examples"] = dval([{entry: "render", caption: "", body: "print(join(split_utf8(\"Aé\"), \",\"), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

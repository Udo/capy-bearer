function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>path_is_within</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function path_is_within(path : string, root : string) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>path_is_within()</code> resolves both paths and tests whether <code>root</code> contains <code>path</code>.</p><p>Both paths must exist. Resolution follows symbolic links and removes dot segments.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>path : the path to test</p></div><div><p>root : the containing directory</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> when <code>root</code> contains <code>path</code></p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var root := &quot;/tmp&quot;\nprint(path_is_within(&quot;/tmp&quot;, root), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/path-real/\">path_real</a><a class=\"related-link\" href=\"/doc/api/path-join/\">path_join</a></aside></div>")
}

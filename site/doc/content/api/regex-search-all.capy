function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>regex_search_all</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function regex_search_all(pattern : string, subject : string, flags : string = &quot;&quot;) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>The result contains <code>matched</code>, <code>count</code>, and <code>matches</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>pattern : regular expression</p></div><div><p>subject : text to search</p></div><div><p>flags : regular expression flags</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>Data for all non-overlapping matches.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var matches := regex_search_all(&quot;[a-z]+&quot;, &quot;capy docs&quot;)\nprint(s32(matches.count), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/regex-match/\">regex_match</a><a class=\"related-link\" href=\"/doc/api/regex-search/\">regex_search</a><a class=\"related-link\" href=\"/doc/api/regex-replace/\">regex_replace</a><a class=\"related-link\" href=\"/doc/api/regex-split/\">regex_split</a></aside></div>")
}

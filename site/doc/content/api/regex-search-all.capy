function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "regex_search_all"
    page["kind"] = "api"
    page["slug"] = "regex-search-all"
    page["route"] = "/doc/api/regex-search-all/"
    page["title"] = "regex_search_all"
    page["content"] = "The result contains `matched`, `count`, and `matches`.\n"
    page["returns"] = "Data for all non-overlapping matches."
    page["label"] = "regex_search_all"
    page["capy_sig_lines"] = dval(["function regex_search_all(pattern : string, subject : string, flags : string = \"\") dval"])
    page["param_lines"] = dval(["pattern : regular expression", "subject : text to search", "flags : regular expression flags", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([])
    page["examples"] = dval([{entry: "render", caption: "", body: "var matches := regex_search_all(\"[a-z]+\", \"capy docs\")\nprint(s32(matches.count), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

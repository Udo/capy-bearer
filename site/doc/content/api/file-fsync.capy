function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>file_fsync</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function file_fsync(handle : u64) bool</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>file_fsync</code> flushes pending writes for a handle. Call it before <code>file_close</code> when the file system must receive the writes first.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>handle : writable handle returned by <code>file_open</code></p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p><code>true</code> when Capy flushes the handle. Otherwise, it returns <code>false</code>.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var handle := file_open(&quot;/tmp/doc-fsync.txt&quot;, &quot;w&quot;)\nfile_write(handle, &quot;durable&quot;)\nprint(file_fsync(handle), &quot;\\n&quot;)\nfile_close(handle)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/file-write/\">file_write</a><a class=\"related-link\" href=\"/doc/api/file-close/\">file_close</a><a class=\"related-link\" href=\"/doc/api/file-open/\">file_open</a></aside></div>")
}

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>parse_query</h2><span class=\"call-boundary lib-call\">lib call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function parse_query(query : string) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>parse_query()</code> decodes URL query text into a map-shaped <code>dval</code>.</p><p>An ampersand separates pairs. The first equals sign separates a key and value. A key without an equals sign has an empty value. The last repeated key wins.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>query : the URL query text</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>the decoded parameters</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var values := parse_query(&quot;name=Ada&amp;role=admin&quot;)\nprint(values[&quot;name&quot;], &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/parse-uri/\">parse_uri</a><a class=\"related-link\" href=\"/doc/api/encode-query/\">encode_query</a></aside></div>")
}

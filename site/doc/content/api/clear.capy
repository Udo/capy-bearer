function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>Clear a dynamic value</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function clear(value : dval) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>clear(value)</code> removes all children and makes <code>value</code> an empty map.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : target value</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>The cleared target value.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var value := dval({&quot;name&quot;: &quot;Ada&quot;})\nvalue = clear(value)\nprint(has(value, &quot;name&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/type/dvalue/\">dvalue</a><a class=\"related-link\" href=\"/doc/api/set/\">set</a></aside></div>")
}

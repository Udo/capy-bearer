function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "file_close"
    page["kind"] = "api"
    page["slug"] = "file-close"
    page["route"] = "/doc/api/file-close/"
    page["title"] = "file_close"
    page["content"] = "`file_close` closes a handle from `file_open`. Close a handle after the final read or write.\n"
    page["label"] = "file_close"
    page["capy_sig_lines"] = dval(["function file_close(handle : u64)"])
    page["param_lines"] = dval(["handle : handle returned by `file_open`", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "file_open", href: "/doc/api/file-open/"}, {label: "file_read", href: "/doc/api/file-read/"}, {label: "file_write", href: "/doc/api/file-write/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "var handle := file_open(\"/tmp/doc-close.txt\", \"w\")\nfile_write(handle, \"done\")\nfile_close(handle)\nprint(file_get_contents(\"/tmp/doc-close.txt\"), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

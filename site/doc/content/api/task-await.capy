function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>task_await</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function task_await(id : string, timeout_ms : u64) dval</pre></div><div class=\"doc-section content\"><h3>Description</h3><p>Use <code>task_await</code> to wait for a task status. It returns when the task ends or the timeout expires.</p></div><div class=\"doc-section\"><h3>Return Values</h3><p>Task status map.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">var status := task_await(&quot;&quot;, u64(0))\nprint(string(status[&quot;state&quot;]), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/task/\">task</a><a class=\"related-link\" href=\"/doc/api/task-status/\">task_status</a><a class=\"related-link\" href=\"/doc/api/task-cancel/\">task_cancel</a></aside></div>")

function COMPONENT(request : dval) {
    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><div class=\"doc-title\"><h2>json_encode</h2><span class=\"call-boundary host-call\">host call</span></div><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function json_encode(value : dval) string\nfunction json_encode(value : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>json_encode()</code> converts a string or <code>dval</code> value to JSON text. A <code>none</code> value becomes JSON <code>null</code>.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : a string or <code>dval</code> value</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>JSON text.</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(json_encode(dval({&quot;name&quot;: &quot;Ada&quot;, &quot;middle&quot;: none})), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/base64-encode/\">base64_encode</a><a class=\"related-link\" href=\"/doc/api/base64-decode/\">base64_decode</a><a class=\"related-link\" href=\"/doc/api/string-from-bytes/\">string_from_bytes</a><a class=\"related-link\" href=\"/doc/api/bytes-of/\">bytes_of</a><a class=\"related-link\" href=\"/doc/api/json-decode/\">json_decode</a><a class=\"related-link\" href=\"/doc/api/html-escape/\">html_escape</a><a class=\"related-link\" href=\"/doc/api/uri-encode/\">uri_encode</a><a class=\"related-link\" href=\"/doc/api/uri-decode/\">uri_decode</a><a class=\"related-link\" href=\"/doc/api/hex/\">hex</a><a class=\"related-link\" href=\"/doc/api/brb-encode/\">brb_encode</a><a class=\"related-link\" href=\"/doc/api/brb-decode/\">brb_decode</a><a class=\"related-li")
    print("nk\" href=\"/doc/api/xml-encode/\">xml_encode</a><a class=\"related-link\" href=\"/doc/api/xml-decode/\">xml_decode</a><a class=\"related-link\" href=\"/doc/api/yaml-encode/\">yaml_encode</a><a class=\"related-link\" href=\"/doc/api/yaml-decode/\">yaml_decode</a><a class=\"related-link\" href=\"/doc/api/json-consume-space/\">json_consume_space</a></aside></div>")

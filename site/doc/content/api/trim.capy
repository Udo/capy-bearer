function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "trim"
    page["kind"] = "api"
    page["slug"] = "trim"
    page["route"] = "/doc/api/trim/"
    page["title"] = "trim"
    page["content"] = "`trim` removes leading and trailing whitespace.\n"
    page["returns"] = "text without leading or trailing whitespace"
    page["label"] = "trim"
    page["capy_sig_lines"] = dval(["function trim(raw : string) string"])
    page["param_lines"] = dval(["raw : text to trim", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "string", href: "/doc/api/string/"}, {label: "int_val", href: "/doc/api/int-val/"}, {label: "regex_split", href: "/doc/api/regex-split/"}, {label: "html_escape", href: "/doc/api/html-escape/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "print(trim(\"  docs  \"), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

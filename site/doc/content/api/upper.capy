function COMPONENT(request : dval) {
    var page := dval({source_page: ""})
    page["source_page"] = "upper"
    page["kind"] = "api"
    page["slug"] = "upper"
    page["route"] = "/doc/api/upper/"
    page["title"] = "upper"
    page["content"] = "`upper` changes lowercase ASCII characters to uppercase.\n"
    page["returns"] = "string with lowercase ASCII characters changed to uppercase"
    page["label"] = "upper"
    page["capy_sig_lines"] = dval(["function upper(value : string) string"])
    page["param_lines"] = dval(["value : string to convert", ""])
    page["notes"] = dval([])
    page["warnings"] = dval([])
    page["see"] = dval([{label: "string", href: "/doc/api/string/"}, {label: "string", href: "/doc/api/string/"}, {label: "length", href: "/doc/api/length/"}, {label: "clone", href: "/doc/api/clone/"}, {label: "ascii_safe_name", href: "/doc/api/ascii-safe-name/"}, {label: "base64_decode", href: "/doc/api/base64-decode/"}])
    page["examples"] = dval([{entry: "render", caption: "", body: "print(upper(\"bearer\"), \"\\n\")\n"}])
    page["guide_examples"] = dval([])
    component_render("/doc/components/doc_page.capy", page)
}

    print("<div class=\"doc-detail-layout\"><main class=\"content doc-page doc-detail\"><h2>upper</h2><div class=\"doc-section signatures\"><h3>Capy</h3><pre>function upper(value : string) string</pre></div><div class=\"doc-section content\"><h3>Description</h3><p><code>upper</code> changes lowercase ASCII characters to uppercase.</p></div><div class=\"doc-section params\"><h3>Parameters</h3><div><p>value : string to convert</p></div><div></div></div><div class=\"doc-section\"><h3>Return Values</h3><p>string with lowercase ASCII characters changed to uppercase</p></div><div class=\"doc-section example\"><h3>Example</h3><div class=\"example-language capy\"><h4>Capy</h4><pre class=\"example-source\">print(upper(&quot;bearer&quot;), &quot;\\n&quot;)\n</pre></div></div></main><aside class=\"doc-section see-also\"><h3>See also</h3><a class=\"related-link\" href=\"/doc/api/string/\">string</a><a class=\"related-link\" href=\"/doc/api/string/\">string</a><a class=\"related-link\" href=\"/doc/api/length/\">length</a><a class=\"related-link\" href=\"/doc/api/clone/\">clone</a><a class=\"related-link\" href=\"/doc/api/ascii-safe-name/\">ascii_safe_name</a><a class=\"related-link\" href=\"/doc/api/base64-decode/\">base64_decode</a></aside></div>")

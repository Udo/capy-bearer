#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "route-path-is-safe" {
        var page := dval({source_page: ""})
        page["source_page"] = "route_path_is_safe"
        page["kind"] = "api"
        page["slug"] = "route-path-is-safe"
        page["route"] = "/doc/api/route-path-is-safe/"
        page["title"] = "route_path_is_safe"
        page["content"] = "A safe route has non-empty segments. Segments can contain ASCII letters, digits, `_`, and `-`.\n"
        page["returns"] = "`true` if the path is safe."
        page["label"] = "route_path_is_safe"
        page["capy_sig_lines"] = dval(["function route_path_is_safe(path : string) bool"])
        page["param_lines"] = dval(["path : route text to test", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(route_path_is_safe(\"docs/api\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "route-path-normalize" {
        var page := dval({source_page: ""})
        page["source_page"] = "route_path_normalize"
        page["kind"] = "api"
        page["slug"] = "route-path-normalize"
        page["route"] = "/doc/api/route-path-normalize/"
        page["title"] = "route_path_normalize"
        page["content"] = "This function removes outer whitespace and leading and trailing slashes. It does not validate the result.\n"
        page["returns"] = "Normalized route text."
        page["label"] = "route_path_normalize"
        page["capy_sig_lines"] = dval(["function route_path_normalize(path : string) string"])
        page["param_lines"] = dval(["path : route text to normalize", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(route_path_normalize(\" /docs/api/ \"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "route-path-sanitize" {
        var page := dval({source_page: ""})
        page["source_page"] = "route_path_sanitize"
        page["kind"] = "api"
        page["slug"] = "route-path-sanitize"
        page["route"] = "/doc/api/route-path-sanitize/"
        page["title"] = "route_path_sanitize"
        page["content"] = "The function normalizes the path. It uses `fallback` for empty input. It returns an empty string for unsafe input.\n"
        page["returns"] = "A safe route, or an empty string."
        page["label"] = "route_path_sanitize"
        page["capy_sig_lines"] = dval(["function route_path_sanitize(path : string, fallback : string = \"index\") string"])
        page["param_lines"] = dval(["path : route text to validate", "fallback : route for empty input", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(route_path_sanitize(\"../private\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

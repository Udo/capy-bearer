#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "route-path-is-safe" {
        var page := dval({source_page: ""})
        page["source_page"] = "route_path_is_safe"
        page["kind"] = "api"
        page["slug"] = "route-path-is-safe"
        page["route"] = "/doc/api/route-path-is-safe/"
        page["title"] = "route_path_is_safe"
        page["content"] = "Use this function to test whether route text is safe after normalization.\n\nA safe route has non-empty segments. Each segment can contain ASCII letters, digits, `_`, and `-`. The function rejects `.` and `..` segments.\n\nFor handler routes, use `request.route` or `ROUTE_PATH`. These APIs parse and sanitize request input.\n"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "route_path_is_safe"
        page["sig_lines"] = dval(["bool route_path_is_safe(String path)", ""])
        page["capy_sig_lines"] = dval(["function route_path_is_safe(path : string) bool"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">uri", "route_path_sanitize", "route_path_normalize", "request_query_path", "request_query_route"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "route-path-normalize" {
        var page := dval({source_page: ""})
        page["source_page"] = "route_path_normalize"
        page["kind"] = "api"
        page["slug"] = "route-path-normalize"
        page["route"] = "/doc/api/route-path-normalize/"
        page["title"] = "route_path_normalize"
        page["content"] = "Use this function only to prepare route text for display or diagnostics.\n\nIt removes outer whitespace and leading and trailing `/`. It does not validate the result.\n\nBefore you compose a file path, use `route_path_sanitize()` or `ROUTE_PATH`.\n"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "route_path_normalize"
        page["sig_lines"] = dval(["String route_path_normalize(String path)", ""])
        page["capy_sig_lines"] = dval(["function route_path_normalize(path : string) string"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">uri", "route_path_sanitize", "route_path_is_safe", "0_Request"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "route-path-sanitize" {
        var page := dval({source_page: ""})
        page["source_page"] = "route_path_sanitize"
        page["kind"] = "api"
        page["slug"] = "route-path-sanitize"
        page["route"] = "/doc/api/route-path-sanitize/"
        page["title"] = "route_path_sanitize"
        page["content"] = "Use this function before you compose a file path from a route.\n\nIt removes outer whitespace and leading and trailing `/`. Empty input becomes `default_path`. Each segment must be non-empty and contain only ASCII letters, digits, `_`, and `-`. The function rejects `.` and `..` segments. It returns an empty string for unsafe input.\n\n`request.route` and `ROUTE_PATH` already use this sanitizer.\n"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "route_path_sanitize"
        page["sig_lines"] = dval(["String route_path_sanitize(String path, String default_path = \"index\")", ""])
        page["capy_sig_lines"] = dval(["function route_path_sanitize(path : string, fallback : string = \"index\") string"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">uri", "route_path_is_safe", "route_path_normalize", "request_query_path", "request_query_route", "request_context_params"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dir-remove" {
        var page := dval({source_page: ""})
        page["source_page"] = "dir_remove"
        page["kind"] = "api"
        page["slug"] = "dir-remove"
        page["route"] = "/doc/api/dir-remove/"
        page["title"] = "dir_remove"
        page["content"] = "`dir_remove()` removes a directory.\n\nWithout `recursive`, the directory must be empty. With `recursive = true`, it removes every contained file and directory.\n"
        page["returns"] = "`true` on success."
        page["label"] = "dir_remove"
        page["capy_sig_lines"] = dval(["function dir_remove(path : string, recursive : bool = false) bool"])
        page["param_lines"] = dval(["path : the directory path to remove", "recursive : `true` removes the directory and its contents", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["mkdir", "dir_list", "file_unlink"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var root := file_temp(\"/tmp/capy-doc-dir-remove-\")\nfile_unlink(root)\nmkdir(root)\nfile_put_contents(path_join(root, \"child.txt\"), \"x\")\nprint(dir_remove(root, true), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

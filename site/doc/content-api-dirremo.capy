#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dir-remove" {
        var page := dval({source_page: ""})
        page["source_page"] = "dir_remove"
        page["kind"] = "api"
        page["slug"] = "dir-remove"
        page["route"] = "/doc/api/dir-remove/"
        page["title"] = "dir_remove"
        page["content"] = "`dir_remove()` removes a directory from a Capy path.\n\nPass the directory path. Without `recursive`, the directory must be empty. With `recursive = true`, it removes all contents.\n\nUse the recursive form only when you intend to delete every contained file and directory.\n\nThe Capy call has the same arguments.\n"
        page["returns"] = "`true` on success"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "dir_remove"
        page["sig_lines"] = dval(["bool dir_remove(String path, bool recursive = false)", ""])
        page["capy_sig_lines"] = dval(["function dir_remove(path : string, recursive : bool = false) bool"])
        page["param_lines"] = dval(["path : directory path to remove", "recursive : `true` removes the directory and its contents", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "mkdir", "file_unlink", "file_truncate", "file_temp", "file_copy", "file_chmod"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

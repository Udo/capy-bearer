    if consider(tokens, "/doc/api/server-start-http/", "server_start_http", "API Functions", "server_start_http\n`server_start_http()` starts or updates a custom HTTP listener. The handler file must define `SERVE_HTTP`.\n\nkey : listener key\nbind : TCP port or Unix socket path\nfile : handler file\ncallback : optional handler name\nThe listener process ID, or `0`.") { found = true }
    if consider(tokens, "/doc/api/server-stop/", "server_stop", "API Functions", "server_stop\n`server_stop()` removes the custom HTTP listener for `key`.\n\nkey : listener key\n`true` if no listener remains.") { found = true }
    if consider(tokens, "/doc/api/session-destroy/", "session_destroy", "API Functions", "session_destroy\n`session_destroy()` expires the named session cookie and removes its server-side data.\n\nname : session cookie name\nThe resulting session state.") { found = true }
    if consider(tokens, "/doc/api/session-id-create/", "session_id_create", "API Functions", "session_id_create\nUse `session_id_create()` when you need an ID without starting a session.\n\nA new session ID.") { found = true }

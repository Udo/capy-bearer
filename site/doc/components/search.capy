function token_hit(text : string, tokens : dval) bool {
    var lower_text := lower(text)
    for token := tokens { if contains(lower_text, string(token)) { return true } }
    return false
}

function search_tokens(query : string) dval {
    var tokens := dval([])
    for raw := split_space(lower(query)) {
        var token := trim(string(raw))
        if length(token) >= 2 {
            tokens = push(tokens, token)
            if token == "strlen" || token == "count" { tokens = push(tokens, "length") }
            if token == "json" { tokens = push(tokens, "json_decode") }
        }
    }
    return tokens
}

function consider(tokens : dval, route : string, label : string, kind : string, body : string) bool {
    if !token_hit(label + "\n" + body, tokens) { return false }
    print("<div class=\"search-hit\"><span class=\"search-kind\">", html_escape(kind), "</span><a href=\"", html_escape(route), "\">", html_escape(label), "</a></div>")
    return true
}

function COMPONENT(request : dval) {
    var query := string(request.query.q)
    var tokens := search_tokens(query)
    print("<main class=\"content\"><h2>Search</h2>")
    print("<form class=\"search-bar\" action=\"/doc/search/\" method=\"get\"><input name=\"q\" type=\"search\" value=\"", html_escape(query), "\" aria-label=\"Search documentation\"></input><button type=\"submit\">Search</button></form>")
    if length(query) < 2 || length(tokens) == 0 { print("<p class=\"no-results\">Enter at least two characters.</p></main>"); return }
    var found := false
    print("<section class=\"search-section search-api\"><h3>API Functions</h3>")
    if consider(tokens, "/doc/api/array-merge/", "array_merge", "API Functions", "array_merge\n`array_merge` combines two `dval` values. It returns a new value.\n\nFor maps, values from `right` replace matching values from `left`. The function also merges lists.\n\nleft : first value\nright : second value\na merged `dval` value") { found = true }
    if consider(tokens, "/doc/api/backtrace-capture/", "backtrace_capture", "API Functions", "backtrace_capture\n`backtrace_capture` gets a backtrace for the current call stack.\n\nCall it with no arguments. You can also set the maximum frame count and skip count.\n\nmax_frames : maximum number of frames\nskip_frames : number of newest frames to omit\na backtrace string") { found = true }
    if consider(tokens, "/doc/api/backtrace-get-frames/", "backtrace_get_frames", "API Functions", "backtrace_get_frames\n`backtrace_get_frames` gets source-mapped frames for the current Capy call stack.\n\nSet `max_frames` to limit the result. Set `skip_frames` to omit the newest frames.\n\nmax_frames : maximum number of frames\nskip_frames : number of newest frames to omit\na backtrace string") { found = true }
    if consider(tokens, "/doc/api/base64-decode/", "base64_decode", "API Functions", "base64_decode\n`base64_decode` decodes Base64 text into a string.\n\nInvalid Base64 text returns an empty string.\n\nvalue : Base64 text\nthe decoded string") { found = true }
    if consider(tokens, "/doc/api/base64-encode/", "base64_encode", "API Functions", "base64_encode\n`base64_encode` encodes a string as Base64 text.\n\nUse `base64_decode` to decode the result.\n\nvalue : source string\nBase64 text") { found = true }
    if consider(tokens, "/doc/api/basename/", "basename", "API Functions", "basename\n`basename` returns the final component of a path.\n\nIt does not access the file system.\n\npath : a path string\nthe final path component") { found = true }
    if consider(tokens, "/doc/api/bool/", "bool", "API Functions", "bool\n`bool()` converts a `dval` to a Boolean value. `opt.fallback` is the result when conversion fails. It defaults to `false`. An empty or missing `dval` fails conversion and uses the fallback. Use `value?` before conversion when presence matters.\n\n`bool()` deliberately keeps a `dval` first parameter. Strings cannot be conditions. A string must pass through `dval()` before conversion, so `if \"true\"` remains a compile error.\n\nThe options map accepts only `fallback`. An unknown key, including `base`, is an error.\n\nvalue : dynamic value to convert\nopt : options map with `fallback`\nA Boolean value, or `opt.fallback`.") { found = true }
    if consider(tokens, "/doc/api/brb-decode/", "brb_decode", "API Functions", "brb_decode\n`brb_decode` decodes BRRB data into a `dval` value.\n\nUse it to read data from `brb_encode`.\n\nencoded : BRRB data\na decoded `dval` value") { found = true }
    if consider(tokens, "/doc/api/brb-encode/", "brb_encode", "API Functions", "brb_encode\n`brb_encode` encodes a `dval` value as BRRB data.\n\nUse `brb_decode` to restore the value.\n\nvalue : value to encode\nBRRB data as a string") { found = true }
    if consider(tokens, "/doc/api/call/", "call", "API Functions", "call\n`call()` calls an exported function in a loaded unit. It returns the result as `dval`.\n\nUse `unit_load()` once when several calls use the same unit. The two-argument form passes an empty `dval`.\n\nhandle : a value from `unit_load()`\nname : an exported function name\ninput : optional `dval` input\nThe exported function result.") { found = true }
    if consider(tokens, "/doc/api/clear/", "clear", "API Functions", "Clear a dynamic value\n`clear(value)` removes all children and makes `value` an empty map.\n\nvalue : target value\nThe cleared target value.") { found = true }
    if consider(tokens, "/doc/api/clone/", "clone", "API Functions", "clone\n`clone()` copies a string.\n\nMost Capy code does not need an explicit copy. Use `clone()` when a fresh string value is required.\n\nvalue : a source string\nA separate string copy.") { found = true }
    if consider(tokens, "/doc/api/component/", "component", "API Functions", "component\n`component()` renders a component and returns everything it printed as a string.\n\nIt collects the output into a buffer, which costs something. Reach for `component_render()` instead when you are writing the fragment straight into the current response and never look at the string — it skips the buffer entirely, so `component_render(\"card\")` does less work than `print(component(\"card\"))`.\n\nCapture the string when the string is the goal: wrapping the fragment in surrounding markup, checking whether it produced anything before emitting a container, storing it in a `dval` beside other values, or emitting the same fragment more than once from one call.\n\n## How a name resolves\n\nA name is a path with an optional `:HANDLER` suffix. Bearer appends `.capy` when the path has no suffix, so `\"card\"` and `\"card.capy\"` mean the same file.\n\nA path that starts with `/` is tried first as a real filesystem path and then as a site-root path, so `\"/tests/capy-request-context.capy\"` means that file under the site root.\n\nA relative path is tried against three directories, in order:\n\n1. the directory of the entry unit that is handling the request\n2. the directory of the unit calling `component()`, when that differs\n3. the site root\n\nThe first match wins. A resolved path that escapes the site root is rejected. Use `component_resolve()` to see which file a name reached. Test an optional name with `length(component_resolve(name)) > 0` before you render it.\n\n## Named handlers\n\n`\"lib/widgets.capy:CARD\"` calls the `COMPONENT:CARD` handler in that file. A name that is only `\":CARD\"` calls `COMPONENT:CARD` in the file that is currently rendering, which lets one file hold several related fragments.\n\nA file with no named handler must define a plain `COMPONENT` handler.\n\n## What the component sees\n\n`props` arrives as `request.props`. It is swapped in for the duration of the call and restored when the component returns, so a component cannot disturb its caller's props, and nested components each read their own.\n\nRelative paths inside the component resolve against the component's own file, not the caller's — a component in `lib/` can call `component(\"sibling\")` and reach `lib/sibling.capy`.\n\nThe target unit's `ONCE` handler runs before the component handler the first time that unit is used in the request.\n\nname : a component path, optionally followed by `:HANDLER`\nprops : optional input, readable inside the component as `request.props`\nThe component output as a string.\nAn unresolvable component does not raise an error. Bearer sets the response status to `500`, returns a banner element that describes the failure, and continues to render the page. Guard optional components with `length(component_resolve(name)) > 0` when a missing file should not be an error.") { found = true }
    if consider(tokens, "/doc/api/component-render/", "component_render", "API Functions", "component_render\n`component_render()` renders a component and writes its output straight into the current response. It returns true when it renders the component. It returns false when it cannot resolve the component.\n\nThis is the form to reach for in page layouts. `component()` opens a capture buffer, collects everything the component prints, and hands you a string; `component_render()` skips that buffer entirely. When you are only going to print the result anyway, `component_render(\"card\")` does less work than `print(component(\"card\"))`.\n\nUse a capturing call instead when you need the output as a value — to measure it, wrap it, store it, or decide whether to emit it at all.\n\nName resolution, `:HANDLER` suffixes, props scoping, and `ONCE` behaviour are identical to `component()`; that page documents the rules in full.\n\nname : a component path, optionally followed by `:HANDLER`\nprops : optional input, readable inside the component as `request.props`\nAn unresolvable component does not raise an error. Bearer sets the response status to `500`, writes a banner element describing the failure, and returns false. Rendering continues.") { found = true }
    if consider(tokens, "/doc/api/component-resolve/", "component_resolve", "API Functions", "component_resolve\n`component_resolve()` answers \"which file would `component()` actually load for this name?\". It renders nothing and runs no handler.\n\nThis is the tool for debugging resolution. Because a relative name is tried against several directories in turn, the same string can mean different files depending on which unit is calling it, and the failure that follows is usually reported against the wrong place. Printing the resolved path shows you which candidate won.\n\n## The order it searches\n\n`.capy` is appended when the name has no suffix. A `:HANDLER` suffix does not affect the returned path.\n\nA name starting with `/` is tried as a real filesystem path first, then as a path under the site root.\n\nA relative name is tried against, in order:\n\n1. the directory of the entry unit handling the request\n2. the directory of the unit calling `component_resolve()`, when that differs\n3. the site root\n\nThe first candidate that exists is returned. A candidate that resolves outside the site root is rejected, and the result is an empty string.\n\nAn empty return means that no component source file matches the name.\n\n## Check whether a component exists\n\n`if component_resolve(...)` is a compile error. A string has no `bool` constructor.\n\nUse this test:\n\n    if length(component_resolve(name)) > 0 { ... }\n\nname : a component path, optionally followed by `:HANDLER`\nThe absolute source path the name resolves to, or an empty string when nothing matches.") { found = true }
    if consider(tokens, "/doc/api/contains/", "contains", "API Functions", "contains\n`contains()` checks for a substring.\n\nhaystack : the string to search\nneedle : the substring to find\n`true` if `needle` occurs in `haystack`. An empty `needle` matches.") { found = true }
    if consider(tokens, "/doc/api/crypto-equal/", "crypto_equal", "API Functions", "crypto_equal\n`crypto_equal()` compares byte strings in constant time.\n\nUse it to compare secrets such as HMACs and tokens. Do not use `==` to compare secrets.\n\nleft : the expected byte string\nright : the submitted byte string\n`true` if both byte strings are equal.") { found = true }
    if consider(tokens, "/doc/api/csrf-field/", "csrf_field", "API Functions", "csrf_field\n`csrf_field()` returns a hidden form input with the active CSRF token.\n\nUse it in a form that changes state. Check the submitted value with `csrf_valid()` before you change state.\n\nsession_name : the session and cookie name\ntoken_name : the token namespace\nfield_name : the form field name. The default is `token_name`.\nAn HTML hidden input with the active CSRF token.") { found = true }
    if consider(tokens, "/doc/api/csrf-rotate/", "csrf_rotate", "API Functions", "csrf_rotate\n`csrf_rotate()` removes the active CSRF token from a token namespace.\n\nThe next `csrf_token()` call creates a replacement token. Use it after a sensitive successful change.\n\nsession_name : the session and cookie name\ntoken_name : the token namespace to clear") { found = true }
    if consider(tokens, "/doc/api/csrf-token/", "csrf_token", "API Functions", "csrf_token\n`csrf_token()` returns a stable token for one session and token namespace.\n\nUse the result in a hidden form field. Call `csrf_valid()` before you apply a browser-submitted change.\n\nsession_name : the session and cookie name\ntoken_name : the token namespace in the session\nThe active CSRF token.") { found = true }
    if consider(tokens, "/doc/api/csrf-valid/", "csrf_valid", "API Functions", "csrf_valid\n`csrf_valid()` checks a submitted CSRF token against the session token.\n\nIt does not create a missing token. Check the token before you apply a browser-submitted change.\n\nsubmitted : the value from the submitted form\nsession_name : the session and cookie name\ntoken_name : the token namespace\n`true` if `submitted` matches the active session token.") { found = true }
    if consider(tokens, "/doc/api/cwd-get/", "cwd_get", "API Functions", "cwd_get\n`cwd_get()` returns the current working directory path.\n\nSave this path before `cwd_set()` when you must restore the directory.\n\nThe current working directory path.") { found = true }
    if consider(tokens, "/doc/api/cwd-set/", "cwd_set", "API Functions", "cwd_set\n`cwd_set()` changes the worker process working directory.\n\nSave the current directory with `cwd_get()`. Restore it after temporary use.\n\npath : the new working directory path") { found = true }
    if consider(tokens, "/doc/api/delete/", "delete", "API Functions", "Delete a child\n`delete(value, key)` removes `key` from `value`. A missing key leaves the value unchanged.\n\nvalue : target value\nkey : child key\nThe changed target value.") { found = true }
    if consider(tokens, "/doc/api/dir-list/", "dir_list", "API Functions", "dir_list\n`dir_list()` returns one map for each directory entry.\n\nEach map has `name`, `type`, `size`, and `mtime`. The `type` value is `file`, `dir`, `symlink`, or `other`.\n\npath : the directory path to list\nA `dval` list of entry maps.") { found = true }
    if consider(tokens, "/doc/api/dir-remove/", "dir_remove", "API Functions", "dir_remove\n`dir_remove()` removes a directory.\n\nWithout `recursive`, the directory must be empty. With `recursive = true`, it removes every contained file and directory.\n\npath : the directory path to remove\nrecursive : `true` removes the directory and its contents\n`true` on success.") { found = true }
    if consider(tokens, "/doc/api/dirname/", "dirname", "API Functions", "dirname\n`dirname()` removes the final component from a path string.\n\nThe function does not access the file system.\n\npath : the path to inspect\nThe directory part of the path.") { found = true }
    if consider(tokens, "/doc/api/draw-float/", "draw_float", "API Functions", "draw_float\n`draw_float()` returns the next floating-point value from the request random sequence.\n\nBearer uses the request random seed and advances the random index after each call.\n\nfrom : the first range value\nto : the second range value\nprecision : the output precision\nAn `f64` value between the range values.") { found = true }
    if consider(tokens, "/doc/api/draw-int/", "draw_int", "API Functions", "draw_int\n`draw_int()` returns the next integer value from the request random sequence.\n\nBearer uses the request random seed and advances the random index after each call.\n\nfrom : the first range value\nto : the second range value\nA `u64` value between the range values.") { found = true }
    if consider(tokens, "/doc/api/dval/", "dval", "API Functions", "dval\n`dval()` converts a scalar or literal structure to a dynamic value.\n\nUse it for request payloads and nested map or list data. Existing `dval` input stays a `dval` value.\n\nvalue : a scalar, literal structure, or `dval`\nA `dval` value.") { found = true }
    if consider(tokens, "/doc/api/each/", "each", "API Functions", "Call a function for each string\n`each` calls `callback` once for each item in a list-shaped `dval`.\n\nThe callback receives a string value. `each` processes items in list order.\n\nThis function returns no value.") { found = true }
    if consider(tokens, "/doc/api/encode-query/", "encode_query", "API Functions", "encode_query\n`encode_query()` converts a map-shaped `dval` to a URL query string.\n\nPass the returned string after `?` in a URL.\n\nmap : map-shaped `dval` of URL parameters\nURL query string") { found = true }
    if consider(tokens, "/doc/api/every/", "every", "API Functions", "Test every string\n`every` tests each string in a list-shaped `dval` with `predicate`.\n\nThis function does not change `items`.\n\nThis function returns `true` when every item matches. It returns `true` for an empty list.") { found = true }
    if consider(tokens, "/doc/api/expand-path/", "expand_path", "API Functions", "expand_path\n`expand_path()` returns an expanded path string.\n\nPass a path and an optional base directory. It resolves a relative path against the base directory.\n\nWithout a base directory, it uses the current unit directory.\n\nUse the returned path with file APIs.\n\npath : path to expand\nrelative_to_path : base directory for a relative path\nexpanded path") { found = true }
    if consider(tokens, "/doc/api/f64/", "f64", "API Functions", "f64\n`f64()` converts the exact text from `value` to a floating-point value. The value must contain a complete decimal number. `opt.fallback` is the result for empty text or text that does not parse. It defaults to `0.0`.\n\n`value` accepts scalar values through `as string`. The conversion keeps scalar text exact. Empty and missing `dval` values both convert to empty text. Use `value?` before conversion when presence matters. An empty value is present, but a missing value is not.\n\nThe options map accepts only `fallback`. An unknown key, including `base`, is an error.\n\nvalue : scalar value or text to convert\nopt : options map with `fallback`\nAn `f64` value, or `opt.fallback`.") { found = true }
    if consider(tokens, "/doc/api/file-append/", "file_append", "API Functions", "file_append\n`file_append` adds text to the end of a file. Use `file_put_contents` to replace a file.\n\npath : path of the file to update\ncontent : text to append\nfirst : first text value to append\nsecond : second text value to append\nthird : third text value to append\n`true` when Capy appends the text. Otherwise, it returns `false`.") { found = true }
    if consider(tokens, "/doc/api/file-chmod/", "file_chmod", "API Functions", "file_chmod\n`file_chmod` changes the permission bits of a path.\n\npath : path of the file or directory\nmode : Unix permission bits as a decimal `s32`\n`true` when Capy changes the mode. Otherwise, it returns `false`.") { found = true }
    if consider(tokens, "/doc/api/file-close/", "file_close", "API Functions", "file_close\n`file_close` closes a handle from `file_open`. Close a handle after the final read or write.\n\nhandle : handle returned by `file_open`") { found = true }
    if consider(tokens, "/doc/api/file-copy/", "file_copy", "API Functions", "file_copy\n`file_copy` copies a file to another path. The source path remains available after a successful copy.\n\nfrom : source path\nto : destination path\n`true` when Capy copies the file. Otherwise, it returns `false`.") { found = true }
    if consider(tokens, "/doc/api/file-exists/", "file_exists", "API Functions", "file_exists\n`file_exists` tests for a regular file. It returns `false` for a directory. Use `file_stat` to inspect another path type.\n\npath : path to test\n`true` when a regular file exists. Otherwise, it returns `false`.") { found = true }
    if consider(tokens, "/doc/api/file-fsync/", "file_fsync", "API Functions", "file_fsync\n`file_fsync` flushes pending writes for a handle. Call it before `file_close` when the file system must receive the writes first.\n\nhandle : writable handle returned by `file_open`\n`true` when Capy flushes the handle. Otherwise, it returns `false`.") { found = true }
    if consider(tokens, "/doc/api/file-get-contents/", "file_get_contents", "API Functions", "file_get_contents\n`file_get_contents` reads a complete file into a string. Use it for a small file that fits in one value. Use `file_open` and `file_read` for incremental reads.\n\npath : path of the file to read\nThe file content, or `\"\"` when Capy cannot read the file.\nAn empty file and an unreadable file both return `\"\"`. Use `file_exists` when you must distinguish them.") { found = true }
    if consider(tokens, "/doc/api/file-mtime/", "file_mtime", "API Functions", "file_mtime\n`file_mtime` returns the modification time of a file.\n\npath : path of the file to inspect\nThe modification time as a Unix timestamp, or `0` when it is unavailable.") { found = true }
    if consider(tokens, "/doc/api/file-open/", "file_open", "API Functions", "file_open\n`file_open` opens a file for incremental access. Use the handle with `file_read`, `file_write`, `file_seek`, and `file_close`.\n\npath : path of the file to open\nmode : access mode, such as `\"r\"`, `\"w\"`, `\"a\"`, or `\"r+\"`\nA file handle, or `u64(0)` when Capy cannot open the file.") { found = true }
    if consider(tokens, "/doc/api/file-pread/", "file_pread", "API Functions", "file_pread\n`file_pread` reads at an absolute byte offset. It does not change the handle position.\n\nhandle : readable handle returned by `file_open`\noffset : absolute byte offset\nlength : maximum number of bytes to read\nA string with up to `length` bytes.") { found = true }
    if consider(tokens, "/doc/api/file-put-contents/", "file_put_contents", "API Functions", "file_put_contents\n`file_put_contents` writes a complete string to a file. It creates or replaces a small file.\n\npath : path of the file to write\ncontent : text that replaces the file content\n`true` when Capy writes the file. Otherwise, it returns `false`.") { found = true }
    if consider(tokens, "/doc/api/file-pwrite/", "file_pwrite", "API Functions", "file_pwrite\n`file_pwrite` writes text at an absolute byte offset. It does not change the handle position.\n\nhandle : writable handle returned by `file_open`\noffset : absolute byte offset\ndata : text to write\nThe number of bytes written.") { found = true }
    if consider(tokens, "/doc/api/file-read/", "file_read", "API Functions", "file_read\n`file_read` reads from the current handle position. It advances the position by the bytes read. It can return fewer bytes at the end of a file.\n\nhandle : readable handle returned by `file_open`\ncount : maximum number of bytes to read\nA string with up to `count` bytes from the current position.") { found = true }
    if consider(tokens, "/doc/api/file-rename/", "file_rename", "API Functions", "file_rename\n`file_rename` changes a file path. The source path no longer exists after a successful call.\n\nfrom : source path\nto : destination path\n`true` if Capy renames the file. Otherwise, `false`.") { found = true }
    if consider(tokens, "/doc/api/file-seek/", "file_seek", "API Functions", "file_seek\n`file_seek` sets the position for file reads and writes.\n\nhandle : handle from `file_open`\noffset : byte offset\nwhence : `0` for the start, `1` for the current position, or `2` for the end\nThe new byte offset. Returns `-1` on error.") { found = true }
    if consider(tokens, "/doc/api/file-stat/", "file_stat", "API Functions", "file_stat\n`file_stat` returns metadata for a path. The result includes `exists`, `is_file`, `is_dir`, `is_symlink`, and `size`.\n\npath : path to inspect\nA `dval` with file metadata.") { found = true }
    if consider(tokens, "/doc/api/file-symlink/", "file_symlink", "API Functions", "file_symlink\n`file_symlink` creates a symbolic link at `linkpath` that points to `target`.\n\ntarget : path for the symbolic link\nlinkpath : path of the new symbolic link\n`true` if Capy creates the link. Otherwise, `false`.") { found = true }
    if consider(tokens, "/doc/api/file-tell/", "file_tell", "API Functions", "file_tell\n`file_tell` returns the current position for a file handle.\n\nhandle : handle from `file_open`\nThe current byte offset.") { found = true }
    if consider(tokens, "/doc/api/file-temp/", "file_temp", "API Functions", "file_temp\n`file_temp` creates an empty file with a unique suffix.\n\nprefix : path prefix for the temporary file\nThe new empty file path. Returns `\"\"` on failure.") { found = true }
    if consider(tokens, "/doc/api/file-truncate/", "file_truncate", "API Functions", "file_truncate\n`file_truncate` sets a file length. A smaller length removes trailing bytes.\n\npath : file path\nsize : new file length in bytes\n`true` if Capy changes the file length. Otherwise, `false`.") { found = true }
    if consider(tokens, "/doc/api/file-unlink/", "file_unlink", "API Functions", "file_unlink\n`file_unlink` removes a file. A missing path does not cause an error.\n\npath : file path\nNo value.") { found = true }
    if consider(tokens, "/doc/api/file-write/", "file_write", "API Functions", "file_write\n`file_write` writes bytes at the current handle position. It advances the position.\n\nhandle : writable handle from `file_open`\nvalue : bytes to write\nThe number of bytes written.") { found = true }
    if consider(tokens, "/doc/api/filter/", "filter", "API Functions", "Filter strings\n`filter` keeps the strings for which `predicate` returns `true`.\n\nThe result keeps input order. This function does not change `items`.\n\nThis function returns a new list-shaped `dval`.") { found = true }
    if consider(tokens, "/doc/api/find/", "find", "API Functions", "Find text in a string\n`find` searches a string for another string.\n\nFor a list-shaped `dval`, use `some` to test for a matching item.\n\nThis function returns the byte position of `needle`. It returns `-1` when it does not find `needle`.") { found = true }
    if consider(tokens, "/doc/api/first/", "first", "API Functions", "first\n`first` checks values in order. It ignores values that contain only whitespace.\n\none : first value\ntwo : second value\nthree : third value\nfour : fourth value\nThe first nonblank value. Returns `\"\"` if no value is nonblank.") { found = true }
    if consider(tokens, "/doc/api/gen-float/", "gen_float", "API Functions", "gen_float\n`gen_float()` returns a deterministic value for the range values, index, seed, and precision.\n\nUse the same inputs to reproduce a value.\n\nfrom : first range value\nto : second range value\nindex : deterministic input position\nseed : deterministic input seed\nprecision : output precision\nA deterministic `f64` value.") { found = true }
    if consider(tokens, "/doc/api/gen-int/", "gen_int", "API Functions", "gen_int\n`gen_int()` returns a deterministic value for the range values, index, and seed.\n\nUse the same inputs to reproduce a value.\n\nfrom : first range value\nto : second range value\nindex : deterministic input position\nseed : deterministic input seed\nA deterministic `u64` value.") { found = true }
    if consider(tokens, "/doc/api/gen-noise01/", "gen_noise01", "API Functions", "gen_noise01\n`gen_noise01()` returns normalized noise for an index and seed.\n\nUse the same inputs to reproduce a value.\n\nindex : deterministic input position\nseed : deterministic input seed\nA deterministic `f64` value from `0` to `1`.") { found = true }
    if consider(tokens, "/doc/api/gen-noise32/", "gen_noise32", "API Functions", "gen_noise32\n`gen_noise32()` returns deterministic integer noise for an index and seed.\n\nUse the same inputs to reproduce a value.\n\nindex : deterministic input position\nseed : deterministic input seed\nA deterministic `u64` value.") { found = true }
    if consider(tokens, "/doc/api/gen-noise64/", "gen_noise64", "API Functions", "gen_noise64\n`gen_noise64()` returns deterministic integer noise for an index and seed.\n\nUse the same inputs to reproduce a value.\n\nindex : deterministic input position\nseed : deterministic input seed\nA deterministic `u64` value.") { found = true }
    if consider(tokens, "/doc/api/gen-sha1/", "gen_sha1", "API Functions", "gen_sha1\n`gen_sha1()` returns 20 raw SHA-1 bytes. Use `hex(gen_sha1(value))` when you need lowercase hexadecimal text.\n\nUse it only for SHA-1 compatibility.\n\nvalue : bytes to hash\nRaw 20-byte SHA-1 digest.") { found = true }
    if consider(tokens, "/doc/api/get/", "get", "API Functions", "Get a named child\n`get(value, key)` reads a named child without creating it. It returns `none` for a missing key or a scalar.\n\nvalue : source value\nkey : child key\nThe copied child, or `none`.") { found = true }
    if consider(tokens, "/doc/api/get-by-path/", "get_by_path", "API Functions", "Get a child by path\n`get_by_path(value, path)` reads a nested child without creating nodes. Use a slash between path segments.\n\nvalue : source value\npath : slash-separated child path\nThe copied child, or an empty string value when the path fails.") { found = true }
    if consider(tokens, "/doc/api/get-or-create/", "get_or_create", "API Functions", "Get or create a child\n`get_or_create(value, key, default)` stores `default` when `key` is missing. It changes and returns `value`.\n\nvalue : target value\nkey : child key\ndefault : value to store when the child is missing\nThe target value.") { found = true }
    if consider(tokens, "/doc/api/get-type-name/", "get_type_name", "API Functions", "Get a dynamic value type name\n`get_type_name(value)` returns the runtime type name for a dynamic value.\n\nvalue : value to inspect\nThe type name.") { found = true }
    if consider(tokens, "/doc/api/gz-compress/", "gz_compress", "API Functions", "gz_compress\n`gz_compress()` compresses a string with gzip.\n\nThe result contains binary data. Pass it to `gz_uncompress()` to restore the source.\n\nsource : uncompressed bytes\nGzip-compressed bytes as a string.") { found = true }
    if consider(tokens, "/doc/api/gz-uncompress/", "gz_uncompress", "API Functions", "gz_uncompress\n`gz_uncompress()` uncompresses gzip data from a string.\n\nUse it with data from `gz_compress()`.\n\nsource : gzip-compressed bytes\nUncompressed bytes as a string.") { found = true }
    if consider(tokens, "/doc/api/has/", "has", "API Functions", "Test for a child\n`has(value, key)` tests for a child without creating it. It returns `false` for a missing key or a scalar.\n\nvalue : value to test\nkey : child key\n`true` when the key exists.") { found = true }
    if consider(tokens, "/doc/api/hex/", "hex", "API Functions", "hex\n`hex()` converts each input byte to two lowercase hexadecimal characters.\n\nUse it to make digest bytes printable. For example, `hex(sha256(value))` returns a SHA-256 digest as lowercase hexadecimal text.\n\nvalue : bytes to encode\nLowercase hexadecimal text.") { found = true }
    if consider(tokens, "/doc/api/hmac-sha256/", "hmac_sha256", "API Functions", "hmac_sha256\n`hmac_sha256()` returns 32 raw HMAC-SHA256 bytes. Use `hex(hmac_sha256(key, value))` when you need lowercase hexadecimal text.\n\nkey : secret key bytes\nvalue : message bytes\nA raw 32-byte HMAC-SHA256 value.") { found = true }
    if consider(tokens, "/doc/api/html-escape/", "html_escape", "API Functions", "html_escape\n`html_escape()` escapes text for an HTML text position. It escapes ampersands, angle brackets, and double quotes.\n\nvalue : text to use in HTML\nText with HTML-sensitive characters replaced by entities.") { found = true }
    if consider(tokens, "/doc/api/http-request/", "http_request", "API Functions", "http_request\n`http_request()` sends an outbound HTTP or HTTPS request. Set `method`, `url`, `headers`, `body`, `timeout_ms`, and `follow_redirects` as needed.\n\nWhen you set a `security` field, set `https_only`, `public_dns_only`, `pin_dns`, `isolated_curl`, and `no_redirects` to `true`.\n\nrequest : a map that describes an outbound request\nA map with `status`, `headers`, `body`, and `error`.\nThe result can report `invalid_request`, `unsafe_dns`, `timeout`, `response_too_large`, `redirect_not_allowed`, `http_status`, or `network_failure`.") { found = true }
    if consider(tokens, "/doc/api/http-request-async/", "http_request_async", "API Functions", "http_request_async\n`http_request_async()` starts an outbound request and returns its job ID. Use `job_await()` or `job_result()` to get the response map.\n\nThe request map follows the `http_request()` rules.\n\nrequest : a map that describes an outbound request\nA job ID.") { found = true }
    if consider(tokens, "/doc/api/is-array/", "is_array", "API Functions", "Test for a container\n`is_array(value)` returns `true` when a value has map shape. It returns `true` for both maps and lists.\n\nvalue : value to test\n`true` for a map or list.") { found = true }
    if consider(tokens, "/doc/api/is-list/", "is_list", "API Functions", "Test for a list\n`is_list(value)` tests whether a value is a list.\n\nvalue : value to test\n`true` for a list-shaped value.") { found = true }
    if consider(tokens, "/doc/api/job-await/", "job_await", "API Functions", "job_await\n`job_await()` waits for a job until the timeout expires. It returns the current status when the timeout expires.\n\njob : a job ID as `dval`\ntimeout_ms : maximum wait time in milliseconds\nA job status map. A completed job includes `result`.") { found = true }
    if consider(tokens, "/doc/api/job-cancel/", "job_cancel", "API Functions", "job_cancel\n`job_cancel()` requests cancellation of a job. A canceled job reports the `cancelled` state.\n\njob : a job ID as `dval`\n`true` when the system cancels an active job. Otherwise, `false`.") { found = true }
    if consider(tokens, "/doc/api/job-result/", "job_result", "API Functions", "job_result\n`job_result()` checks a job with a short bounded wait. Use it to poll a job after `shell_exec(command, flags)` or `http_request_async()`.\n\njob : a job ID as `dval`\nA job status map. A completed job includes `result`.") { found = true }
    if consider(tokens, "/doc/api/job-status/", "job_status", "API Functions", "job_status\n`job_status()` checks a job without waiting. The map can include `state`, `done`, `kind`, `pid`, and `job_id`.\n\nThe `state` value can be `pending`, `running`, `done`, `failed`, `cancelled`, or `missing`.\n\njob : a job ID as `dval`\nA job status map.") { found = true }
    if consider(tokens, "/doc/api/join/", "join", "API Functions", "join\n`join()` reads each list value as text. It uses a newline when you omit the delimiter.\n\nitems : a `dval` list\ndelimiter : text between values\nOne string with the values separated by `delimiter`.") { found = true }
    if consider(tokens, "/doc/api/json-consume-space/", "json_consume_space", "API Functions", "json_consume_space\n`json_consume_space()` skips JSON whitespace from `index`. Use `json_decode()` for normal JSON parsing.\n\nsource : JSON source text\nindex : byte offset where the scan starts\nThe byte offset after JSON whitespace.") { found = true }
    if consider(tokens, "/doc/api/json-decode/", "json_decode", "API Functions", "json_decode\n`json_decode()` converts JSON text to a `dval` value. Objects become maps, arrays become lists, and `null` becomes `none`.\n\nvalue : JSON text\nThe decoded `dval` value.") { found = true }
    if consider(tokens, "/doc/api/json-encode/", "json_encode", "API Functions", "json_encode\n`json_encode()` converts a string or `dval` value to JSON text. A `none` value becomes JSON `null`.\n\nvalue : a string or `dval` value\nJSON text.") { found = true }
    if consider(tokens, "/doc/api/keys/", "keys", "API Functions", "Get child keys\n`keys(value)` returns a new list of child keys. A scalar returns an empty list.\n\nvalue : source value\nA list of child keys.") { found = true }
    if consider(tokens, "/doc/api/length/", "length", "API Functions", "length\n`length()` counts bytes in strings and markup. It counts entries in `dval` maps and lists, and elements in arrays.\n\nvalue : text, markup, a `dval` map or list, or an array\nA byte count for text and markup, or an entry count for maps, lists, and arrays.\n`length()` traps when a scalar `dval` reaches it.") { found = true }
    if consider(tokens, "/doc/api/lower/", "lower", "API Functions", "lower\n`lower()` converts uppercase ASCII characters to lowercase. It does not convert Unicode case.\n\nvalue : text to convert\nText with uppercase ASCII characters converted to lowercase.") { found = true }
    if consider(tokens, "/doc/api/ls/", "ls", "API Functions", "ls\n`ls()` returns the names in a directory. It returns an empty list when it cannot list the directory.\n\npath : directory path to list\nA `dval` list of entry names.") { found = true }
    if consider(tokens, "/doc/api/map/", "map", "API Functions", "map\n`map()` calls `mapper` for each item in `items`.\n\nIt converts each item to a string before it calls `mapper`. The function returns a new `dval` list.\n\nitems : the input list\nmapper : the function that transforms each item\na new list of transformed strings") { found = true }
    if consider(tokens, "/doc/api/markdown-to-ast/", "markdown_to_ast", "API Functions", "markdown_to_ast\n`markdown_to_ast()` parses Markdown into a `dval` document tree.\n\nThe root node contains a `children` list. Nodes contain a `type` field and fields for their content. The default options support GitHub-flavored Markdown.\n\nSet `gfm` to control GitHub-flavored extensions. Set `allow_html` to retain raw HTML nodes.\n\nsource : the Markdown source text\noptions : parser options\nthe Markdown document tree") { found = true }
    if consider(tokens, "/doc/api/markdown-to-html/", "markdown_to_html", "API Functions", "markdown_to_html\n`markdown_to_html()` renders Markdown source as HTML.\n\nRaw HTML stays escaped unless `options[\"allow_html\"]` is true. Only enable it for trusted source.\n\nsource : the Markdown source text\noptions : render options\nthe HTML text") { found = true }
    if consider(tokens, "/doc/api/memcache-command/", "memcache_command", "API Functions", "memcache_command\n`memcache_command()` sends `command` to the server and returns one bounded response read.\n\nUse a dedicated Memcache function when one is available. This function does not guarantee a complete multi-part response.\n\nFor `get` and `gets`, each protocol key token starts at token 1. For `gat` and `gats`, the protocol key token is token 2. For storage and single-key commands, the protocol key token is token 1.\n\nThe function normalizes whitespace in these protocol key tokens to underscores. It does not normalize command names, expiration tokens, metadata tokens, or payload text.\n\nconnection : the connection handle\ncommand : the Memcache command text\none server response read") { found = true }
    if consider(tokens, "/doc/api/memcache-connect/", "memcache_connect", "API Functions", "memcache_connect\n`memcache_connect()` opens a connection to a Memcache server.\n\nDo not pass a zero handle to another Memcache function.\n\nThe key operations normalize whitespace to underscores. This normalization is transparent. The keys `\"a b\"` and `\"a_b\"` address the same entry.\n\nhost : the server host name\nport : the server port\na connection handle, or zero on failure") { found = true }
    if consider(tokens, "/doc/api/memcache-delete/", "memcache_delete", "API Functions", "memcache_delete\n`memcache_delete()` deletes the entry for `key`.\n\nIt returns `true` only when the server returns `DELETED`. It normalizes whitespace in keys to underscores before it sends the request.\n\nThis normalization is transparent. The keys `\"a b\"` and `\"a_b\"` address the same entry.\n\nconnection : the connection handle\nkey : the entry key\n`true` when the server deletes the entry") { found = true }
    if consider(tokens, "/doc/api/memcache-get/", "memcache_get", "API Functions", "memcache_get\n`memcache_get()` reads the value for `key`.\n\nIt returns `default_value` for a missing key or an incomplete response. It normalizes whitespace in keys to underscores before it sends the request.\n\nThis normalization is transparent. The keys `\"a b\"` and `\"a_b\"` address the same entry.\n\nconnection : the connection handle\nkey : the entry key\ndefault_value : the value for a missing or invalid response\nthe stored value or `default_value`") { found = true }
    if consider(tokens, "/doc/api/memcache-get-multiple/", "memcache_get_multiple", "API Functions", "memcache_get_multiple\n`memcache_get_multiple()` reads several keys through one connection.\n\nMissing keys do not occur in the returned map. It normalizes whitespace in each key to underscores before it sends the request.\n\nThis normalization is transparent. The keys `\"a b\"` and `\"a_b\"` address the same entry.\n\nconnection : the connection handle\nkeys : the entry keys\na map of returned entries") { found = true }
    if consider(tokens, "/doc/api/memcache-set/", "memcache_set", "API Functions", "memcache_set\n`memcache_set()` stores `value` under `key`.\n\nIt returns `true` only when the server returns `STORED`. It normalizes whitespace in keys to underscores before it sends the request.\n\nThis normalization is transparent. The keys `\"a b\"` and `\"a_b\"` address the same entry.\n\nconnection : the connection handle\nkey : the entry key\nvalue : the value text\nexpires_in : the lifetime in seconds\n`true` when the server stores the entry") { found = true }
    if consider(tokens, "/doc/api/mkdir/", "mkdir", "API Functions", "mkdir\n`mkdir()` creates one directory at `path`.\n\nThe parent directory must exist. This function does not create parent directories.\n\npath : the directory path\n`true` when the API creates the directory") { found = true }
    if consider(tokens, "/doc/api/mysql-connect/", "mysql_connect", "API Functions", "mysql_connect\n`mysql_connect()` creates a MySQL connection lease and returns its handle.\n\nUse `mysql_info(database, \"connection\")` before database work. Call `mysql_disconnect()` after use. A failed connection can return a nonzero handle.\n\nhost : the MySQL server host\nusername : the MySQL user name\npassword : the MySQL password\ndatabase : the initial database name\na request-local MySQL connection handle") { found = true }
    if consider(tokens, "/doc/api/mysql-disconnect/", "mysql_disconnect", "API Functions", "mysql_disconnect\n`mysql_disconnect()` releases the MySQL connection lease.\n\nDo not use the handle after this call.\n\nhandle : the MySQL connection handle") { found = true }
    if consider(tokens, "/doc/api/mysql-escape/", "mysql_escape", "API Functions", "mysql_escape\n`mysql_escape(raw)` escapes `raw` and wraps it in single quotes.\n\nUse the second form to set the wrapper. Pass an empty string when no wrapper is needed. Prefer named parameters with `mysql_query()`.\n\nraw : the string to escape\nquote : the string that wraps the result\nthe escaped string") { found = true }
    if consider(tokens, "/doc/api/mysql-info/", "mysql_info", "API Functions", "mysql_info\n`mysql_info()` reads state that belongs to a connection rather than to a result set — whether the connection is live, what the last error was, and what the last statement did.\n\n## Keys\n\n| Key | Type | Meaning |\n| --- | --- | --- |\n| `connection` | bool | whether the handle is currently connected |\n| `error` | string | the last error text, empty when the last call succeeded |\n| `insert_id` | u64 | the `AUTO_INCREMENT` value the last `INSERT` generated |\n| `affected_rows` | u64 | rows changed by the last `INSERT`, `UPDATE` or `DELETE` |\n\nEach returns a `dval` carrying its natural type, so you can print it, store it, or pass it on without converting anything:\n\n\n## When you need a converter\n\nOnly when you need a Capy-typed value rather than a `dval` — for arithmetic, for a typed local, or for an `if`:\n\n\nThe fallback is what you get when the key holds no usable value. For `insert_id` after a statement that generated none, that is `0`.\n\n## Checking a write did something\n\n`affected_rows` is the difference between \"the statement ran\" and \"the statement changed a row\". An `UPDATE` matching nothing succeeds and affects zero rows:\n\n\n## Errors, and what to check after a query\n\n`mysql_query()` reports failure through the connection, so `error` is what you read after a query returns nothing useful:\n\nhandle : a connection handle from `mysql_connect()`\nkey : which piece of connection state to read\nThe value for `key`, as a `dval` carrying its natural type.\nAn unrecognised `key` is a hard error naming the key and listing the valid ones. It is not reported as an empty value, so a typo cannot be mistaken for \"no data\".\n\nReading state from a handle that never connected returns the fallback for each key rather than raising — check `connection` first when the connection itself is in doubt.") { found = true }
    if consider(tokens, "/doc/api/mysql-query/", "mysql_query", "API Functions", "mysql_query\n`mysql_query()` runs a query and returns its rows as a `dval`.\n\nUse named `:name` placeholders with a `dval` map. The API rejects positional `?` placeholders. Add `!` to a placeholder only for an unquoted non-negative integer.\n\nhandle : the MySQL connection handle\nquery : the SQL query text\nparams : the named parameter values\nthe query result rows") { found = true }
    if consider(tokens, "/doc/api/nibble/", "nibble", "API Functions", "nibble\n`nibble()` returns the text before the first `delim`.\n\nIt does not change `haystack`. If `delim` does not occur, it returns all of `haystack`.\n\nhaystack : the string to split\ndelim : the delimiter\nthe text before the first delimiter") { found = true }
    if consider(tokens, "/doc/api/ob-close/", "ob_close", "API Functions", "ob_close\n`ob_close()` discards the current output buffer and returns to the previous buffer.\n\nUse it when you do not need the buffered output.\n") { found = true }
    if consider(tokens, "/doc/api/ob-get/", "ob_get", "API Functions", "ob_get\n`ob_get()` returns the current output buffer contents.\n\nThe buffer stays active after this call.\n\nthe current output buffer contents") { found = true }
    if consider(tokens, "/doc/api/ob-get-close/", "ob_get_close", "API Functions", "ob_get_close\n`ob_get_close()` returns the current output buffer contents and closes the buffer.\n\nOutput then returns to the previous buffer.\n\nthe current output buffer contents") { found = true }
    if consider(tokens, "/doc/api/ob-start/", "ob_start", "API Functions", "Start an output buffer\n`ob_start()` starts an output buffer for the active request.\n\nOutput after this call goes to the buffer. Use `ob_get`, `ob_get_close`, or `ob_close` to read or close it.\n\nThis function returns no value.") { found = true }
    if consider(tokens, "/doc/api/parse-query/", "parse_query", "API Functions", "parse_query\n`parse_query()` decodes URL query text into a map-shaped `dval`.\n\nAn ampersand separates pairs. The first equals sign separates a key and value. A key without an equals sign has an empty value. The last repeated key wins.\n\nquery : the URL query text\nthe decoded parameters") { found = true }
    if consider(tokens, "/doc/api/parse-uri/", "parse_uri", "API Functions", "parse_uri\n`parse_uri()` returns URI parts as a `dval`.\n\nRead the `parts` and `query` maps from the result. Use `parse_query()` when you only have query text.\n\nuri : the URI or URL text\nthe URI data") { found = true }
    if consider(tokens, "/doc/api/password-hash/", "password_hash", "API Functions", "password_hash\n`password_hash()` creates a password encoding with a random salt and current scrypt parameters.\n\nStore the returned value exactly. Do not store an empty result.\n\nThe encoding includes its scrypt parameters. Its current parameter prefix is `$bearer$scrypt$65536$8$1$`. After a successful verification, compare the prefix with the parameters you require. Rehash the known password when the prefixes differ.\n\npassword : the password to hash\na self-contained password encoding, or an empty string on failure") { found = true }
    if consider(tokens, "/doc/api/password-verify/", "password_verify", "API Functions", "password_verify\n`password_verify()` tests a password against a stored encoding.\n\nIt rejects malformed encodings and parameters above the Bearer limits. Set password length and sign-in rate limits in public handlers.\n\npassword : the candidate password\nencoded : the stored password encoding\n`true` when the password matches a valid encoding") { found = true }
    if consider(tokens, "/doc/api/path-is-within/", "path_is_within", "API Functions", "path_is_within\n`path_is_within()` resolves both paths and tests whether `root` contains `path`.\n\nBoth paths must exist. Resolution follows symbolic links and removes dot segments.\n\npath : the path to test\nroot : the containing directory\n`true` when `root` contains `path`") { found = true }
    if consider(tokens, "/doc/api/path-join/", "path_join", "API Functions", "path_join\n`path_join()` joins `base` and `child` with one slash when needed.\n\nAn absolute `child` replaces `base`. This function does not resolve dot segments.\n\nbase : the base path\nchild : the path to append\nthe joined path") { found = true }
    if consider(tokens, "/doc/api/path-real/", "path_real", "API Functions", "path_real\n`path_real()` returns the canonical absolute path for an existing path.\n\nIt follows symbolic links and removes dot segments. It returns an empty string when it cannot resolve the path.\n\npath : the path to resolve\nthe canonical absolute path, or an empty string on failure") { found = true }
    if consider(tokens, "/doc/api/pop/", "pop", "API Functions", "Remove the final child\n`pop(value)` removes the final child and returns `value`. It does not return the removed child.\n\nvalue : target value\nThe changed target value.") { found = true }
    if consider(tokens, "/doc/api/posix-info/", "posix_info", "API Functions", "posix_info\n`posix_info(\"signal_name\", value)` returns the POSIX signal name for a signal number.\n\nkey : `signal_name`\nvalue : the value for `key`\nThe value for `key`.\nThe function stops with an error for an unknown key. The error lists the valid keys.") { found = true }
    if consider(tokens, "/doc/api/print/", "print", "API Functions", "print\n`print()` converts each value to a string and writes the values in order.\n\nIt writes to the active output buffer when one exists. Otherwise, it writes to the response.\n\nvalues : the values to output") { found = true }
    if consider(tokens, "/doc/api/process-start-directory/", "process_start_directory", "API Functions", "process_start_directory\n`process_start_directory()` returns the worker process start directory.\n\nThe value does not change when `cwd_set()` changes the current directory.\n\nthe worker process start directory") { found = true }
    if consider(tokens, "/doc/api/push/", "push", "API Functions", "Append a child\n`push(value, child)` appends `child` with the next numeric key. It changes and returns `value`.\n\nvalue : target value\nchild : value to append\nThe changed target value.") { found = true }
    if consider(tokens, "/doc/api/random-bytes/", "random_bytes", "API Functions", "random_bytes\n`random_bytes()` returns random bytes. The result can contain binary data.\n\nUse `base64_encode()` when you need printable text.\n\ncount : number of bytes to request\nRandom bytes as a string.") { found = true }
    if consider(tokens, "/doc/api/redirect/", "redirect", "API Functions", "redirect\n`redirect()` sets the response location and status. The default status is `302`.\n\nurl : redirect target URL\ncode : HTTP status code") { found = true }
    if consider(tokens, "/doc/api/regex-match/", "regex_match", "API Functions", "regex_match\nUse `regex_match()` to test a complete string. Use `regex_search()` to find text within a string.\n\npattern : regular expression\nsubject : text to test\nflags : regular expression flags\n`true` if the complete subject matches the pattern.") { found = true }
    if consider(tokens, "/doc/api/regex-replace/", "regex_replace", "API Functions", "regex_replace\nUse `$1` for a numbered capture in `replacement`.\n\npattern : regular expression\nreplacement : replacement text\nsubject : source text\nflags : regular expression flags\nText with all matches replaced.") { found = true }
    if consider(tokens, "/doc/api/regex-search/", "regex_search", "API Functions", "regex_search\nThe result contains `matched`. A matching result also contains `match`, `start`, `end`, `captures`, and `named`.\n\npattern : regular expression\nsubject : text to search\nflags : regular expression flags\nData for the first match.") { found = true }
    if consider(tokens, "/doc/api/regex-search-all/", "regex_search_all", "API Functions", "regex_search_all\nThe result contains `matched`, `count`, and `matches`.\n\npattern : regular expression\nsubject : text to search\nflags : regular expression flags\nData for all non-overlapping matches.") { found = true }
    if consider(tokens, "/doc/api/regex-split/", "regex_split", "API Functions", "regex_split\n`regex_split()` removes separators and keeps empty parts.\n\npattern : regular expression separator\nsubject : text to split\nflags : regular expression flags\nA list of text parts.") { found = true }
    if consider(tokens, "/doc/api/replace/", "replace", "API Functions", "replace\nUse `regex_replace()` when the search text is a regular expression.\n\nvalue : source text\nneedle : literal text to replace\nreplacement : replacement text\nText with every literal match replaced.") { found = true }
    if consider(tokens, "/doc/api/route-from-raw-path/", "route_from_raw_path", "API Functions", "route_from_raw_path\nUse `path` only below an application-controlled route root. It is empty when the route is unsafe.\n\nraw_path : route text to validate\ndefault_path : route for empty input\nRoute data with `path`, `page`, `raw_path`, and `valid`.") { found = true }
    if consider(tokens, "/doc/api/route-path-is-safe/", "route_path_is_safe", "API Functions", "route_path_is_safe\nA safe route has non-empty segments. Segments can contain ASCII letters, digits, `_`, and `-`.\n\npath : route text to test\n`true` if the path is safe.") { found = true }
    if consider(tokens, "/doc/api/route-path-normalize/", "route_path_normalize", "API Functions", "route_path_normalize\nThis function removes outer whitespace and leading and trailing slashes. It does not validate the result.\n\npath : route text to normalize\nNormalized route text.") { found = true }
    if consider(tokens, "/doc/api/route-path-sanitize/", "route_path_sanitize", "API Functions", "route_path_sanitize\nThe function normalizes the path. It uses `fallback` for empty input. It returns an empty string for unsafe input.\n\npath : route text to validate\nfallback : route for empty input\nA safe route, or an empty string.") { found = true }
    if consider(tokens, "/doc/api/runtime-perf/", "runtime_perf", "API Functions", "runtime_perf\n`runtime_perf()` returns data for the active request workspace.\n\nRuntime performance data.") { found = true }
    if consider(tokens, "/doc/api/runtime-safe-key/", "runtime_safe_key", "API Functions", "runtime_safe_key\nThe function trims `key`. It reports an error for an empty key.\n\nkey : runtime key\nlabel : name for an empty-key error\nA stable SHA-1 key.") { found = true }
    if consider(tokens, "/doc/api/s32/", "s32", "API Functions", "s32\n`s32()` converts the exact text from `value`. It uses base 10 unless `opt.base` selects another integer base. `opt.fallback` is the result for empty text or text that does not parse. It defaults to `0`.\n\n`value` accepts scalar values through `as string`. The conversion keeps scalar text exact. Empty and missing `dval` values both convert to empty text. Use `value?` before conversion when presence matters. An empty value is present, but a missing value is not.\n\nThe options map accepts only `fallback` and `base`. An unknown key is an error.\n\nvalue : scalar value or text to convert\nopt : options map with `fallback` and `base`\nA signed 32-bit integer, or `opt.fallback`.") { found = true }
    if consider(tokens, "/doc/api/s64/", "s64", "API Functions", "s64\n`s64()` converts the exact text from `value`. It uses base 10 unless `opt.base` selects another integer base. `opt.fallback` is the result for empty text or text that does not parse. It defaults to `0`.\n\n`value` accepts scalar values through `as string`. The conversion keeps scalar text exact. Empty and missing `dval` values both convert to empty text. Use `value?` before conversion when presence matters. An empty value is present, but a missing value is not.\n\nThe options map accepts only `fallback` and `base`. An unknown key is an error.\n\nvalue : scalar value or text to convert\nopt : options map with `fallback` and `base`\nA signed 64-bit integer, or `opt.fallback`.") { found = true }

function token_hit(text : string, tokens : dval) bool {
    var lower_text := lower(text)
    for token := tokens { if contains(lower_text, string(token, "")) { return true } }
    return false
}

function search_tokens(query : string) dval {
    var tokens := dval([])
    for raw := split_space(lower(query)) {
        var token := trim(string(raw, ""))
        if length(token) >= 2 {
            tokens = dval_push(tokens, token)
            if token == "strlen" || token == "count" { tokens = dval_push(tokens, "length") }
            if token == "setcookie" { tokens = dval_push(tokens, "response_cookie") }
            if token == "header" { tokens = dval_push(tokens, "response_header") }
            if token == "status" || token == "http_status" { tokens = dval_push(tokens, "response_status") }
            if token == "json" { tokens = dval_push(tokens, "json_decode") }
        }
    }
    return tokens
}

function consider(tokens : dval, route : string, label : string, body : string) bool {
    if !token_hit(label + "\n" + body, tokens) { return false }
    print("<div class=\"search-hit\"><a href=\"", html_escape(route), "\">", html_escape(label), "</a></div>")
    return true
}

function COMPONENT(request : dval) {
    var query := string(request.query.q, "")
    var tokens := search_tokens(query)
    print("<main class=\"content\"><h2>Search</h2>")
    print("<form class=\"search-bar\" action=\"/doc/search/\" method=\"get\"><input name=\"q\" type=\"search\" value=\"", html_escape(query), "\" aria-label=\"Search documentation\"></input><button type=\"submit\">Search</button></form>")
    if length(query) < 2 || length(tokens) == 0 { print("<p class=\"no-results\">Enter at least two characters.</p></main>"); return }
    var found := false
    if consider(tokens, "/doc/api/bool/", "bool", "bool\nbool\nUse `bool` to read scalar data as a Boolean value.\n\n`bool(dval, fallback)` reads `none`, scalar `string`, scalar `bool`, and scalar `f64` values. It returns `fallback` for maps, lists, and failed conversions.\n\n`bool(string, fallback)` trims spaces and then applies the same rules. Accepted text tokens are case-insensitive: `true`, `false`, `1`, `0`, `yes`, `no`, `on`, and `off`.\n\nconverted boolean, or `fallback`\n`bool` does not throw. It returns `fallback` when conversion fails.") { found = true }
    if consider(tokens, "/doc/api/brb-encode/", "brb_encode", "brb_encode\nbrb_encode\n`brb_encode()` converts a Capy `dval` into a BRRB2 byte string.\n\nPass a `dval` that you will later decode with `brb_decode()`. The returned string can contain any byte, including NUL. BRRB preserves scalars, nested maps, lists, empty lists, and the `N` tag for `none`.\n\nUse this function for Bearer DValue data. Use JSON or YAML for text formats that people read.\n\n\n") { found = true }
    if consider(tokens, "/doc/api/clone/", "clone", "clone\nclone\nUse `clone()` to copy a string before passing ownership across a boundary where you need a fresh value.\n\nMost Capy code does not need explicit clones. Use it only when normal ownership rules are not clear enough for the code you are writing.\n\nnew string copy\nCompilation fails when `clone()` receives anything other than one string.") { found = true }
    if consider(tokens, "/doc/api/component-exists/", "component_exists", "component_exists\ncomponent_exists\n`component_exists()` tests whether Capy can resolve a component file.\n\nA colon and handler name do not affect this check.\n\nUse this function before rendering an optional component. Its name resolution matches `component_resolve()`.\n\n`true` when Bearer resolves the component file. Otherwise, `false`.\n") { found = true }
    if consider(tokens, "/doc/api/component-resolve/", "component_resolve", "component_resolve\ncomponent_resolve\n`component_resolve()` resolves a Capy component name.\n\nA name without a suffix resolves to its `.capy` file. An explicit `.capy` target resolves to its Capy source path. A colon and handler name do not affect the returned path.\n\nUse this function to inspect a shorthand name before you render a component. Its name resolution matches `component()` and `component_exists()`.\n\nthe resolved component source path\n") { found = true }
    if consider(tokens, "/doc/api/contains/", "contains", "contains\ncontains\n`contains()` checks whether one Capy string contains another string.\n\nPass the string to search and the substring to find. It returns `true` for an empty substring.\n\nUse this function for a simple substring check.\n\n`true` when `needle` occurs in `haystack`, otherwise `false`\n") { found = true }
    if consider(tokens, "/doc/api/crypto-equal/", "crypto_equal", "crypto_equal\ncrypto_equal\n`crypto_equal()` compares two Capy byte strings in constant time.\n\nPass the expected secret and the submitted secret. It returns `true` when their bytes are equal. Use it for HMACs, tokens, and password hashes.\n\nDo not use `==` to compare secrets. Its time can reveal how many bytes matched.\n\n`true` when both byte strings are equal\n") { found = true }
    if consider(tokens, "/doc/api/dval/", "dval", "dval\ndval\nUse `dval()` to build a dynamic value from scalar values or a literal structure.\n\nIt converts `string`, integer, float, and `bool` scalars into typed `dval` entries. It keeps existing `dval` input as `dval`.\n\nUse it for request and task payloads, JSON-like in-memory data, and nested maps and lists.\n\nnew `dval` value\nCompilation fails when `dval()` receives an unsupported input type. The compiler rejects map literals with duplicate keys.") { found = true }
    if consider(tokens, "/doc/api/f64/", "f64", "f64\nf64\nUse `f64` to convert input to a floating-point value.\n\n`f64(dval, fallback)` accepts scalar `bool`, finite `f64`, and decimal text. `true` becomes `1.0`, and `false` becomes `0.0`.\n\n`f64(string, fallback)` trims spaces and then applies the same rules. The parser requires complete text, so `3.5ms` returns `fallback`.\n\nconverted `f64`, or `fallback`\n`f64` does not throw. It returns `fallback` for empty input, malformed text, maps, lists, and non-finite values.") { found = true }
    if consider(tokens, "/doc/api/file-exists/", "file_exists", "file_exists\nfile_exists\n`file_exists` tests whether a regular file exists at `path`. Use it before a file read or after a file write. It returns false for a directory. Use `file_stat()` and its `is_dir` field to test a directory.\n\ntrue when a regular file exists, otherwise false\n") { found = true }
    if consider(tokens, "/doc/api/file-pread/", "file_pread", "file_pread\nfile_pread\n`file_pread()` reads from an absolute byte offset and returns a `string`. It does not change the handle position.\n\nUse it for random reads between sequential reads. An invalid handle returns an empty string.\n\na Capy `string` with up to `len` bytes\n") { found = true }
    if consider(tokens, "/doc/api/file-pwrite/", "file_pwrite", "file_pwrite\nfile_pwrite\n`file_pwrite()` writes `string` bytes at an absolute offset without changing the handle position.\n\nUse a writable handle, such as one opened with `\"r+\"`, for an in-place edit. It returns zero for an invalid, closed, or non-writable handle.\n\nnumber of bytes written\n") { found = true }
    if consider(tokens, "/doc/api/file-read/", "file_read", "file_read\nfile_read\n`file_read()` returns a `string` from the current handle position. It advances the position by the bytes read.\n\nEnd of file can return fewer bytes or `\"\"`. Use `file_pread()` to read an absolute offset without moving the position.\n\na Capy `string` with up to `len` bytes from the current position\n") { found = true }
    if consider(tokens, "/doc/api/file-seek/", "file_seek", "file_seek\nfile_seek\n`file_seek` sets the read and write position for a handle. Use it before `file_read()` or `file_write()` for random access. It returns -1 when it cannot set the position. `file_tell()` returns the current position.\n\nnew absolute byte offset, or -1 on error\n") { found = true }
    if consider(tokens, "/doc/api/file-stat/", "file_stat", "file_stat\nfile_stat\n`file_stat()` returns file metadata in a map-shaped `dval`. Use it to test a path type or read its size and times.\n\nThe `exists` field is `false` when the path does not exist. Read fields with functions such as `bool()`.\n\na `dval` map with `exists`, `is_file`, `is_dir`, `is_symlink`, `size`, `mode`, `mtime`, and `ctime`\n") { found = true }
    if consider(tokens, "/doc/api/file-symlink/", "file_symlink", "file_symlink\nfile_symlink\n`file_symlink` creates a symbolic link at `linkpath`. The link points to `target`. Use it to give a file another path. It returns false when Capy cannot create the link. Use `path_real()` to resolve a link.\n\ntrue when Capy creates the link, otherwise false\n") { found = true }
    if consider(tokens, "/doc/api/file-temp/", "file_temp", "file_temp\nfile_temp\n`file_temp()` creates an empty temporary file and returns its path as a `string`. It adds a unique suffix to `prefix`.\n\nUse it for scratch files or before `file_rename()`. It returns `\"\"` when Capy cannot create a file.\n\npath of a new empty temporary file, or `\"\"` on failure\n") { found = true }
    if consider(tokens, "/doc/api/file-truncate/", "file_truncate", "file_truncate\nfile_truncate\n`file_truncate` sets a file length to `size` bytes. Use it to remove trailing content or extend a file. A smaller size discards trailing bytes. It returns false when Capy cannot resize the file.\n\ntrue when Capy resizes the file, otherwise false\n") { found = true }
    if consider(tokens, "/doc/api/file-unlink/", "file_unlink", "file_unlink\nfile_unlink\n`file_unlink` deletes a file at `file_name`. Use it to remove a temporary file or before you recreate a file. A missing path does not cause an error. The Capy API does not return an error value.\n\nnone\n") { found = true }
    if consider(tokens, "/doc/api/file-write/", "file_write", "file_write\nfile_write\n`file_write()` writes string bytes at a file handle's current offset. It returns the `u64` number of bytes written and advances the offset.\n\nPass a handle from `file_open()` in `\"w\"`, `\"a\"`, or `\"r+\"` mode. Strings can contain NUL bytes and other binary data.\n\nIt returns zero for an invalid, closed, or non-writable handle. Use it for sequential file output.\n\n`u64` number of bytes written\n") { found = true }
    if consider(tokens, "/doc/api/first/", "first", "first\nfirst\n`first()` returns the first nonblank string. It returns an empty string when no argument is nonblank.\n\nIt ignores leading and trailing whitespace when it tests each argument. Use it to select a fallback string.\n\n\nfirst nonblank string, or an empty string\n") { found = true }
    if consider(tokens, "/doc/api/gen-float/", "gen_float", "gen_float\ngen_float\n`gen_float()` returns a deterministic `f64` noise value for `index` and `seed`. `from` and `to` set the output range.\n\nUse the same inputs to reproduce procedural values. Capy calls the optional fifth input `precision`.\n\n\ndeterministic `f64` noise value\n") { found = true }
    if consider(tokens, "/doc/api/gen-sha1/", "gen_sha1", "gen_sha1\ngen_sha1\n`gen_sha1()` returns the SHA-1 digest of string bytes. It returns hexadecimal text by default, or raw digest bytes when `as_binary` is `true`.\n\nUse it only where SHA-1 compatibility is required. Use a current hash for new security-sensitive designs.\n\n\nSHA-1 digest string\n") { found = true }
    if consider(tokens, "/doc/api/gz-compress/", "gz_compress", "gz_compress\ngz_compress\n`gz_compress()` returns gzip-compressed bytes for a string. The returned string is binary data.\n\nPass the result to `gz_uncompress()`, write it to a file, or send it with the correct HTTP encoding. Use it to create gzip payloads.\n\nThe result uses the standard gzip format, including CRC32 and uncompressed-size fields.\n\ngzip-format compressed bytes\n") { found = true }
    if consider(tokens, "/doc/api/gz-uncompress/", "gz_uncompress", "gz_uncompress\ngz_uncompress\n`gz_uncompress()` returns the uncompressed bytes from a gzip string. Use it to read data made by `gz_compress()` or another gzip writer.\n\nIt validates the gzip header, CRC32 footer, and uncompressed-size footer. It reports an error for unsupported or invalid gzip data.\n\nuncompressed bytes\n") { found = true }
    if consider(tokens, "/doc/api/hmac-sha256/", "hmac_sha256", "hmac_sha256\nhmac_sha256\n`hmac_sha256()` returns the raw 32-byte HMAC-SHA256 for `key` and `data`. The returned string contains binary bytes.\n\nUse it for binary protocols. Use `hmac_sha256_hex()` when you need printable text.\n\nraw 32-byte HMAC-SHA256 string\n") { found = true }
    if consider(tokens, "/doc/api/hmac-sha256-hex/", "hmac_sha256_hex", "hmac_sha256_hex\nhmac_sha256_hex\n`hmac_sha256_hex()` returns the HMAC-SHA256 for `key` and `data` as lowercase hexadecimal text.\n\nUse it when you need a printable signature. Compare received signatures with `crypto_equal()`.\n\n64-character lowercase hexadecimal HMAC-SHA256 string\n") { found = true }
    if consider(tokens, "/doc/api/html-escape/", "html_escape", "html_escape\nhtml_escape\n`html_escape()` returns a string that is safe to insert as HTML text. Use it for text from users or other untrusted sources.\n\nIt escapes ampersands, angle brackets, and double quotes.\n\nstring with HTML-sensitive characters replaced by entities\n") { found = true }
    if consider(tokens, "/doc/api/map/", "map", "map\nmap\nThis function calls `f` for each list item and returns a new list.\n\nUse it to transform each string in a list. Capy converts each input item with `string()` before it calls `f`.\n\nUse `filter()` when you want to keep matching items instead.\n\nnew list of transformed strings\n") { found = true }
    if consider(tokens, "/doc/api/markdown-to-ast/", "markdown_to_ast", "markdown_to_ast\nmarkdown_to_ast\nThis function parses Markdown text into a `dval` document tree.\n\nThe root is a map-shaped document node. Its `children` field is a list-shaped value. The parser stores component data but does not call component hooks during parsing.\n\nBy default, the parser supports GitHub-flavored headings, paragraphs, blockquotes, lists, task items, code blocks, and tables.\n\nIt also supports rules, emphasis, links, images, autolinks, code spans, and `:::` directive blocks.\n\nEach node has a `type` field and node-specific fields. Common fields include `level`, `text`, `lang`, `href`, `src`, `name`, `argument`, `attrs`, and `children`.\n\nCommon block types are `heading`, `paragraph`, `blockquote`, `list`, `list_item`, `code_block`, `table`, `directive`, and `hr`. Common inline types are `text`, `code`, `strong`, `em`, `strike`, `link`, `image`, and `raw_html`.\n\nOptions:\n\n- `options[\"gfm\"]` enables tables, task lists, strikethrough, and bare URL autolinks. The default is `true`.\n- `options[\"allow_html\"]` captures raw HTML nodes for later output. The default is `false`.\n- `options[\"components\"]` stores hooks for `markdown_to_html()`.\n\n`dval` document tree\n") { found = true }
    if consider(tokens, "/doc/api/memcache-command/", "memcache_command", "memcache_command\nmemcache_command\nPass the `u64` handle from `memcache_connect()`.\n\nThis function appends CRLF to `command` and sends it to the server. It makes one bounded read for the response. It does not guarantee a complete multi-chunk response.\n\nUse a dedicated helper when it supports the operation.\n\none bounded server response read\n") { found = true }
    if consider(tokens, "/doc/api/memcache-delete/", "memcache_delete", "memcache_delete\nmemcache_delete\nPass the `u64` handle from `memcache_connect()`.\n\nThis function deletes the entry for `key`. It returns `true` only when the trimmed server response is exactly `DELETED`.\n\n`true` only for a `DELETED` server response\n") { found = true }
    if consider(tokens, "/doc/api/memcache-get/", "memcache_get", "memcache_get\nmemcache_get\nPass the `u64` handle from `memcache_connect()`.\n\nThis function returns the stored value for `key`. It returns `default_value` for a missing key, malformed response, truncated value body, or non-`VALUE` response.\n\nstored value or `default_value`\n") { found = true }
    if consider(tokens, "/doc/api/memcache-set/", "memcache_set", "memcache_set\nmemcache_set\nPass the `u64` handle from `memcache_connect()`.\n\nThis function stores `value` under `key`. It sends the value length in bytes. It returns `true` only when the trimmed server response is exactly `STORED`.\n\n`true` only for a `STORED` server response\n") { found = true }
    if consider(tokens, "/doc/api/mysql-insert-id/", "mysql_insert_id", "mysql_insert_id\nmysql_insert_id\n`mysql_insert_id()` returns the last automatic row ID as `u64`.\n\nCall this after an `INSERT` into a table with an `AUTO_INCREMENT` column.\n\nthe last automatic row ID for this connection\n") { found = true }
    if consider(tokens, "/doc/api/mysql-query/", "mysql_query", "mysql_query\nmysql_query\n`mysql_query()` runs a MySQL query and returns its rows as a `dval`.\n\nPass parameter values as a `dval` map. Use named `:name` placeholders. The API rejects positional `?` placeholders.\n\nOrdinary placeholders become quoted SQL strings. For an unquoted non-negative integer, such as `LIMIT` or `OFFSET`, add `!` to the placeholder: `:limit!`. Its value must contain one or more decimal digits. It cannot contain signs, whitespace, expressions, identifiers, or SQL fragments.\n\nAfter an insert, update, or delete, call `mysql_affected_rows()`.\n\nthe query result rows\n") { found = true }
    if consider(tokens, "/doc/api/ob-close/", "ob_close", "ob_close\nob_close\n`ob_close()` discards the current output buffer and returns to the previous buffer.\n\nUse this when you do not need captured output.\n\nno value\n") { found = true }
    if consider(tokens, "/doc/api/ob-get/", "ob_get", "ob_get\nob_get\n`ob_get()` returns the current output buffer as a `string`. The buffer stays active, so later `print()` calls add more output.\n\nUse `ob_get_close()` to get the contents and close the buffer.\n\nthe current output buffer contents\n") { found = true }
    if consider(tokens, "/doc/api/ob-get-close/", "ob_get_close", "ob_get_close\nob_get_close\n`ob_get_close()` returns the current output buffer as a `string` and closes it. Output returns to the previous buffer.\n\nUse this to capture output before you change or print it.\n\nthe current output buffer contents\n") { found = true }
    if consider(tokens, "/doc/api/ob-start/", "ob_start", "ob_start\nob_start\n`ob_start()` starts a new output buffer. Later `print()` calls write to this buffer instead of the response.\n\nCall `ob_get_close()` to get the contents. Call `ob_close()` to discard them. Buffers can nest.\n\nno value\n") { found = true }
    if consider(tokens, "/doc/api/password-hash/", "password_hash", "password_hash\npassword_hash\n`password_hash()` returns a password credential as a `string`. It uses a random salt and Bearer's current scrypt parameters.\n\nStore the returned encoding exactly as received. If the result is empty, do not store it. Report the failure.\n\na self-contained scrypt encoding, or an empty string on failure\nReturns an empty string when the runtime cannot create the hash.") { found = true }
    if consider(tokens, "/doc/api/password-needs-rehash/", "password_needs_rehash", "password_needs_rehash\npassword_needs_rehash\n`password_needs_rehash()` returns `true` when a stored Bearer password encoding needs replacement.\n\nCall this only after `password_verify()` succeeds. Hash the known password again. Then replace the stored credential as one operation.\n\nOther credential formats return `true`. Your application must verify them before it upgrades them.\n\n`true` if the encoding is malformed or uses older Bearer parameters\n") { found = true }
    if consider(tokens, "/doc/api/password-verify/", "password_verify", "password_verify\npassword_verify\n`password_verify()` returns `true` only when `password` matches `encoded`. It compares the derived value in constant time.\n\nThe API rejects malformed encodings. It also rejects parameters above the Bearer memory and work limits.\n\nSet password length limits and rate limits for public sign-in endpoints.\n\n`true` only if the password matches a valid bounded encoding\n") { found = true }
    if consider(tokens, "/doc/api/path-is-within/", "path_is_within", "path_is_within\npath_is_within\n`path_is_within()` returns `true` when `path` is inside `root`. It resolves both paths with `path_real()`. Both paths must exist. Resolution follows symbolic links and removes `.` and `..` segments.\n\nUse this check before you open a user-supplied path.\n\n`true` if `path` is inside `root`\n") { found = true }
    if consider(tokens, "/doc/api/path-join/", "path_join", "path_join\npath_join\n`path_join()` returns a `string` that joins `base` and `child` with one `/` when needed.\n\nIf `child` starts with `/`, it replaces `base`. If either value is empty, the API returns the other value.\n\nThis API does not resolve `.` or `..` segments. Use `path_real()` when you need a canonical existing path.\n\nthe joined path\n") { found = true }
    if consider(tokens, "/doc/api/path-real/", "path_real", "path_real\npath_real\n`path_real()` returns the canonical absolute path as a `string`. It follows symbolic links and removes `.` and `..` segments.\n\nIt returns `\"\"` if it cannot resolve the path.\n\nUse `path_is_within()` after this call to check a user-supplied path against an allowed root.\n\nthe canonical absolute path, or `\"\"` if resolution fails\n") { found = true }
    if consider(tokens, "/doc/api/print/", "print", "print\nprint\n`print(...values : as string)` constructs each non-string value as `string` and writes the values in order.\n\nUse `print(...array)` to spread a `[string]` array. When an output buffer is active, `print()` writes to that buffer. Otherwise, it writes to the response.\n\n\n\n") { found = true }
    if consider(tokens, "/doc/api/process-start-directory/", "process_start_directory", "process_start_directory\nprocess_start_directory\n`process_start_directory()` returns the worker's start directory as a `string`.\n\nThe value does not change when `cwd_set()` changes the current directory.\n\nthe worker process start directory\n") { found = true }
    if consider(tokens, "/doc/api/random-bytes/", "random_bytes", "random_bytes\nrandom_bytes\n`random_bytes()` returns cryptographically secure bytes as a `string`. The API returns no more than 1 MiB. It can return fewer bytes, including an empty string, if the random source fails.\n\nUse these bytes for session IDs, tokens, and salts. The result can contain binary bytes. Use `base64_encode()` or `sha256_hex()` when you need printable text.\n\ncryptographically random bytes\n") { found = true }
    if consider(tokens, "/doc/api/redirect/", "redirect", "redirect\nredirect\n`redirect()` sets the response `Location` header and status code.\n\nCall `redirect(url)` for status `302`. Use the two-argument form for another status.\n\nUse this API instead of setting the response header and status separately.\n\n\n") { found = true }
    if consider(tokens, "/doc/api/regex-match/", "regex_match", "regex_match\nregex_match\n`regex_match()` returns `true` when all of `subject` matches `pattern`.\n\nThis is not a substring search. Use `regex_search()` to find the first match in a string.\n\nSupported flags:\n\n- `i` ignores case.\n- `m` enables multiline `^` and `$`.\n- `s` lets `.` match a newline.\n- `x` enables extended pattern syntax.\n- `u` enables UTF-8 and Unicode properties.\n- `a` uses ASCII-oriented matching instead.\n\nBearer uses PCRE2 UTF-8 and Unicode properties by default. For example, `\\\\p{L}+` matches Unicode letters.\n\nInvalid patterns and flags raise a request-visible runtime error with the PCRE2 diagnostic.\n\n`true` if the entire subject matches the pattern\n") { found = true }
    if consider(tokens, "/doc/api/regex-replace/", "regex_replace", "regex_replace\nregex_replace\n`regex_replace()` replaces every `pattern` match in `subject` and returns a new `string`.\n\nThe replacement uses PCRE2 substitution syntax. Use `$1` for a numbered capture. Use `${name}` for a named capture.\n\nUse `replace()` for a literal search. Use `regex_replace()` when you need a pattern, capture, character class, anchor, or flag.\n\na new string with all matches replaced\nInvalid patterns, flags, and replacement syntax cause a request-visible runtime error.") { found = true }
    if consider(tokens, "/doc/api/regex-search/", "regex_search", "regex_search\nregex_search\nUse this function to find the first match in a string. It returns a DValue, not a Boolean.\n\nThe result has these fields:\n\n- `matched` is true when a match exists.\n- `pattern` and `flags` contain the supplied values. `flags` is `default` when none were supplied.\n- `match` is the complete matched text.\n- `start` and `end` are byte offsets in `subject`.\n- `captures` contains capture data. Capture `0` is the complete match.\n- `named` maps each named capture to its text.\n- `named_offsets` maps each named capture to `index`, `start`, and `end`.\n\nWhen no match exists, `matched` is false. The result omits match-specific fields.\n\nfirst-match data as a `dval`\n") { found = true }
    if consider(tokens, "/doc/api/regex-search-all/", "regex_search_all", "regex_search_all\nregex_search_all\nUse this function to find all non-overlapping matches in text.\n\nIt returns `dval` match data. Each result has `matched`, `count`, `matches`, `pattern`, and `flags` fields. `matches` contains entries with the same shape as `regex_search()`.\n\nThe function advances after a zero-length match. This prevents an infinite search.\n\n`dval` match data\n") { found = true }
    if consider(tokens, "/doc/api/regex-split/", "regex_split", "regex_split\nregex_split\nUse this function when a regular expression defines the separator. Use `split()` for a literal separator.\n\nThe result does not include separators. It keeps empty parts. If the pattern does not match, the result contains `subject` as one item. Zero-length matches advance safely.\n\n`dval` list of text parts\n") { found = true }
    if consider(tokens, "/doc/api/replace/", "replace", "replace\nreplace\nUse this function to replace every literal occurrence of `search` in `s`.\n\nThe function returns the changed text. It does not change `s`. Use `regex_replace()` when the search pattern is a regular expression.\n\nsource text with every literal match replaced\n") { found = true }
    if consider(tokens, "/doc/api/route-path-is-safe/", "route_path_is_safe", "route_path_is_safe\nroute_path_is_safe\nUse this function to test whether route text is safe after normalization.\n\nA safe route has non-empty segments. Each segment can contain ASCII letters, digits, `_`, and `-`. The function rejects `.` and `..` segments.\n\nFor handler routes, use `request.route` or `ROUTE_PATH`. These APIs parse and sanitize request input.\n\n\n") { found = true }
    if consider(tokens, "/doc/api/route-path-normalize/", "route_path_normalize", "route_path_normalize\nroute_path_normalize\nUse this function only to prepare route text for display or diagnostics.\n\nIt removes outer whitespace and leading and trailing `/`. It does not validate the result.\n\nBefore you compose a file path, use `route_path_sanitize()` or `ROUTE_PATH`.\n\n\n") { found = true }
    if consider(tokens, "/doc/api/route-path-sanitize/", "route_path_sanitize", "route_path_sanitize\nroute_path_sanitize\nUse this function before you compose a file path from a route.\n\nIt removes outer whitespace and leading and trailing `/`. Empty input becomes `default_path`. Each segment must be non-empty and contain only ASCII letters, digits, `_`, and `-`. The function rejects `.` and `..` segments. It returns an empty string for unsafe input.\n\n`request.route` and `ROUTE_PATH` already use this sanitizer.\n\n\n") { found = true }
    if consider(tokens, "/doc/api/runtime-safe-key/", "runtime_safe_key", "runtime_safe_key\nruntime_safe_key\nUse this function to make a stable runtime key from a non-empty name.\n\nThe function trims `key` and returns its SHA-1 value. Use the result for runtime task names or file names. An empty key is an error. `label` identifies that key in the error message.\n\nstable SHA-1 key\n") { found = true }
    if consider(tokens, "/doc/api/s32/", "s32", "s32\ns32\nUse `s32` to convert input to a 32-bit signed integer.\n\n`s32(dval, fallback)` accepts scalar `bool`, finite `f64`, and exact decimal text. `true` maps to `1`, and `false` maps to `0`.\n\n`s32(string, fallback)` trims spaces and then applies the same rules. Out-of-range values return `fallback`. A float input truncates toward zero.\n\nconverted `s32`, or `fallback`\n`s32` does not throw. It returns `fallback` for invalid text, `none`, maps, lists, or out-of-range values.") { found = true }
    if consider(tokens, "/doc/api/s64/", "s64", "s64\ns64\nUse `s64` to convert input to a 64-bit signed integer.\n\n`s64(dval, fallback)` accepts scalar `bool`, finite `f64`, and exact decimal text. Decimal text must contain a whole number.\n\n`s64(string, fallback)` trims spaces and then applies the same rules. A float input truncates toward zero.\n\nconverted `s64`, or `fallback`\n`s64` does not throw. It returns `fallback` for invalid text, `none`, maps, lists, or out-of-range values.") { found = true }
    if consider(tokens, "/doc/api/safe-name/", "safe_name", "safe_name\nsafe_name\nUse this function to remove unsafe characters from a name.\n\nThe result keeps only letters, digits, and `_`. It removes whitespace, separators, punctuation, and other characters. The result can be empty. Use `runtime_safe_key()` when you need a stable non-empty runtime key.\n\ntext that contains only letters, digits, and `_`\n") { found = true }
    if consider(tokens, "/doc/api/server-stop/", "server_stop", "server_stop\nserver_stop\nUse this function to stop a custom HTTP listener that `server_start_http()` created.\n\nIt removes the listener configuration for `key`. It returns true if no listener exists for that key. It returns false for an empty key or when the stop operation fails.\n\n`true` when no listener remains or Bearer stopped it\n") { found = true }
    if consider(tokens, "/doc/api/session-id-create/", "session_id_create", "session_id_create\nsession_id_create\nUse this function only when you need a new session ID without starting a session.\n\nIt returns a new 64-character lowercase hexadecimal ID. Use `session_start()` for the normal cookie and session-data flow.\n\nnew 64-character lowercase hexadecimal session ID\n") { found = true }
    if consider(tokens, "/doc/api/sha256/", "sha256", "sha256\nsha256\nUse this function when another binary operation needs a SHA-256 digest.\n\nIt returns the raw 32-byte digest of `data`. Use `sha256_hex()` when you need printable text.\n\nraw 32-byte SHA-256 digest\n") { found = true }
    if consider(tokens, "/doc/api/sha256-hex/", "sha256_hex", "sha256_hex\nsha256_hex\nUse this function when you need a printable SHA-256 digest.\n\nIt returns the SHA-256 digest of `data` as 64 lowercase hexadecimal characters. Use it for checksums, cache keys, and content fingerprints. Use `sha256()` when you need the raw 32-byte digest.\n\n64-character lowercase hexadecimal SHA-256 digest\n") { found = true }
    if consider(tokens, "/doc/api/shell-escape/", "shell_escape", "shell_escape\nshell_escape\nCapy `shell_escape(raw)` returns `raw` as one shell word. Give it one value that will become an argument in a command string.\n\nUse it before `shell_exec()` when a command contains input from outside the program. It does not make a complete command safe. Do not use it for shell syntax.\n\na single-quoted shell word that represents `raw`\n") { found = true }
    if consider(tokens, "/doc/api/shell-exec/", "shell_exec", "shell_exec\nshell_exec\nCapy `shell_exec(cmd)` runs a shell command and returns its output as a string. Give it a complete command string.\n\nThe returned string includes standard output and standard error. Capy does not return a separate exit status. Use it for a command when its text output is the result you need.\n\nEscape each input value with `shell_escape()` before you add it to `cmd`.\n\ncombined standard output and standard error\n") { found = true }
    if consider(tokens, "/doc/api/signal-name/", "signal_name", "signal_name\nsignal_name\nCapy `signal_name(sig)` returns the POSIX name for a signal number. Give it a numeric signal value.\n\nIt returns names such as `SIGSEGV`. It returns an empty string when the number is unknown. Use it to add a signal name to an error message or diagnostic output.\n\nsignal name, or an empty string for an unknown number\n") { found = true }
    if consider(tokens, "/doc/api/socket-close/", "socket_close", "socket_close\nsocket_close\nCapy `socket_close(sockfd)` closes a socket handle from `socket_connect()`. It does not return a value.\n\nCall it after you finish reading or writing the socket. Do not use the handle after you close it.\n\n\n") { found = true }
    if consider(tokens, "/doc/api/socket-read/", "socket_read", "socket_read\nsocket_read\nCapy `socket_read(sockfd, max_length, timeout)` reads a string from a socket. Give it a socket handle, a byte limit, and a timeout in seconds.\n\nIt returns the data that it reads. It can return an empty string when no data is available. Use it after `socket_connect()` or `socket_write()` when you expect a response.\n\ndata read from the socket\n") { found = true }
    if consider(tokens, "/doc/api/socket-write/", "socket_write", "socket_write\nsocket_write\nCapy `socket_write(sockfd, data)` sends a string to a socket. Give it a socket handle and the data to send.\n\nIt returns `true` when the write succeeds. It returns `false` when it fails. Use it after `socket_connect()` to send a request.\n\n`true` when the write succeeds, otherwise `false`\n") { found = true }
    if consider(tokens, "/doc/api/string-2/", "string", "string\nstring\nUse `string` to convert scalar data to text.\n\n`string(dval, fallback)` accepts scalar `string`, `bool`, and finite `f64` values. It returns `fallback` for an empty string, map, or list.\n\n`string(string, fallback)` trims spaces and then applies the same rules. Use it for user input that can contain accidental whitespace.\n\nconverted string, or `fallback`\n`string` does not throw. It returns `fallback` for unsupported shapes and empty text.") { found = true }
    if consider(tokens, "/doc/api/trap/", "trap", "trap\ntrap\nUse `trap()` to stop the current handler immediately after a failed guard.\n\n`trap()` has no arguments and no usable return value. Any reachable code after the call does not run.\n\nThe example keeps the condition false so the documentation page can render.\n\nno value because execution stops\n`trap()` always aborts execution when called. Calling it with arguments is a compile-time error.") { found = true }
    if consider(tokens, "/doc/api/trusted-markup/", "trusted_markup", "trusted_markup\ntrusted_markup\nUse `trusted_markup()` when content is already trusted and must stay HTML, not escaped text.\n\nSecurity warning: use `trusted_markup()` only on strings that your code builds. Do not pass request data, remote responses, or database text directly.\n\n`<?: expression ?>` inserts trusted markup in HTML text without extra escaping.\n\ntrusted markup value\nCompilation fails when `trusted_markup()` receives the wrong argument count or a non-string input.") { found = true }
    if consider(tokens, "/doc/api/u64/", "u64", "u64\nu64\nUse `u64` to convert input to a 64-bit unsigned integer.\n\n`u64(dval, fallback)` accepts scalar `bool`, finite `f64`, and exact decimal text. Decimal strings may use a leading `+`.\n\n`u64(string, fallback)` trims spaces and then applies the same rules. Negative strings, overflow, and fractions return `fallback`.\n\nconverted `u64`, or `fallback`\n`u64` does not throw. It returns `fallback` for invalid text, `none`, maps, lists, negative numbers, or out-of-range values.") { found = true }
    if consider(tokens, "/doc/guide/install-and-first-program/", "1. Getting started", "1. Getting started\n1. Getting started\nCapy programs run as Bearer units. A source file uses the `.capy` suffix. Bearer compiles the file when a request first uses it.\n\n## Your first page\n\nCreate `site/hello.capy`:\n\n```capy\nfunction RENDER(request : dval) {\n    print(\"Hello, Capy!\\n\")\n}\n\n```\n\n**Output**\n\n```text\nHello, Capy!\n\n```\n\n`RENDER` is the entry point for a web request. `print` adds text to the response. The `\\n` escape adds a newline.\n\nRequest the page through Bearer's default local HTTP socket:\n\n```text\ncurl --unix-socket /run/bearer/http.sock http://localhost/hello.capy\n```\n\nThe command prints the response body. Bearer logs compiler and runtime errors.\n\n## Add a value\n\nA local declaration uses `:=`. Capy infers the type from the value:\n\n```capy\nfunction RENDER(request : dval) {\n    var name := \"Ada\"\n    print(\"Hello, \", name, \"!\\n\")\n}\n\n```\n\n\n`print` accepts several arguments and writes them in order.\n\n## Write HTML\n\nA markup expression produces escaped HTML:\n\n```capy\nfunction RENDER(request : dval) {\n    var name := \"Ada\"\n    <><h1>Hello, <?= name ?>!</h1></>\n}\n\n```\n\n\nBearer writes top-level markup from `RENDER` to the response. The markup chapter explains escaping and trusted markup.\n\n## If it does not run\n\nConfirm that `bearer.service` is active. The source file must be below the configured site directory. The CLI helper must use the configured local socket.\n\n## Make the first change small\n\nChange one value and request the page again. For example, change `Ada` to your name. This proves that Bearer sees the file you edited.\n\nThen add one standard-library call, such as `response_header(\"Content-Type\", \"text/plain; charset=utf-8\")`. Small changes make compiler errors easier to isolate.\n\nContinue with basic source syntax before you add request data or application APIs.\n\n\n") { found = true }
    if consider(tokens, "/doc/guide/source-structure-and-syntax/", "2. Basic syntax", "2. Basic syntax\n2. Basic syntax\nA Capy file contains declarations. Functions, handlers, structs, and type aliases are declarations. Code that performs work belongs inside a function or handler.\n\n## A complete source file\n\n```capy\n// A comment continues to the end of the line.\nfunction RENDER(request : dval) {\n    var greeting := \"Hello\"\n    print(greeting, \", Capy!\\n\")\n}\n\n```\n\n**Output**\n\n```text\nHello, Capy!\n\n```\n\nThis file has one comment and one handler. Names are case-sensitive, so `greeting` and `Greeting` are different names.\n\n## Functions\n\nA function declaration has a name, parameters, a result type, and a body:\n\n```capy\nfunction add(left : s32, right : s32) s32 {\n    -> left + right\n}\n\nfunction RENDER(request : dval) {\n    print(add(20, 22), \"\\n\")\n}\n\n```\n\n\nThe `->` expression supplies the function result. A function that returns no value has the result type `void`. Handler declarations omit a result type because handlers write a response instead of returning one.\n\n## Statements and expressions\n\nWhitespace separates tokens but does not end an expression. Commas separate arguments and collection items. Most lines do not need a semicolon.\n\n```capy\nfunction add(left : s32, right : s32) s32 {\n    -> left + right\n}\n\nfunction RENDER(request : dval) {\n    var total := add(\n        20,\n        22\n    )\n    print(total, \"\\n\")\n}\n\n```\n\n\nA block starts with `{` and ends with `}`. Its expressions run from top to bottom.\n\n## Comments\n\nUse `//` for a line comment:\n\n```capy\nfunction RENDER(request : dval) {\n    // Explain why the next operation is necessary.\n    var retries := 3\n    print(retries, \"\\n\")\n}\n\n```\n\n\nComments do not change the program. Prefer names that make routine code clear without a comment.\n\n## Reserved names\n\nApplication code cannot declare host functions. Names that start with `__bearer_` are reserved for the standard library. Later chapters introduce the handler names that Bearer calls.\n\n## Keep the unit shape simple\n\nPut helper functions near the handler that uses them. Move a helper only when several units share it. This keeps the request flow easy to read.\n\nUse one top-level entry point for each route. Add named handlers only when the route needs separate component, WebSocket, task, or export entry points.\n\nA source file can declare types, structs, functions, and handlers in any order. Prefer the order that helps the next reader: data shapes first, helpers next, and handlers last.\n\n## Read syntax errors locally\n\nThe compiler reports the source path, line, and column. Look at that location first. If a block misses `-> expression`, the error points at the value-producing block.\n\nDo not use a newline to end an expression. Newlines are whitespace in normal code. Use braces and explicit block yields to show where a value comes from.\n\n\n") { found = true }
    if consider(tokens, "/doc/guide/values-and-types/", "3. Types", "3. Types\n3. Types\nEvery Capy value has a type. The compiler checks types before the program runs. It usually infers the type of a local value.\n\n## Integers\n\nAn integer literal has type `s32` when no other type is stated:\n\n```capy\nfunction RENDER(request : dval) {\n    var answer := 42\n    print(answer, \"\\n\")\n}\n\n```\n\n**Output**\n\n```text\n42\n\n```\n\nState a wider type on the local, or construct the value explicitly:\n\n```capy\nfunction RENDER(request : dval) {\n    var signed : s64 = 8\n    var inferred_signed := s64(9)\n    var unsigned : u64 = 10\n    var inferred_unsigned := u64(11)\n    print(signed, \" \", inferred_signed, \" \", unsigned, \" \", inferred_unsigned, \"\\n\")\n}\n\n```\n\n\nBoth forms produce the stated wide integer type. `var signed : s64 = s64(8)` also compiles, but the constructor repeats information already supplied by the annotation.\n\nParameters, function results, assignments, typed arrays, struct fields, and the other operand in an expression can also state the integer type. Thus, a function that accepts `u64` can receive the plain literal `8`. An unconstrained literal remains `s32`.\n\nArithmetic requires operands of the same type. Use a constructor when the surrounding code does not state the required type.\n\n## Booleans and floating-point numbers\n\nA `bool` is either `true` or `false`. Conditions require a boolean value.\n\n```capy\nfunction RENDER(request : dval) {\n    var enabled := true\n    var ratio := 2.5\n    print(enabled, \" \", ratio, \"\\n\")\n}\n\n```\n\n\nA decimal point or exponent makes an `f64` literal.\n\n## Strings\n\nA `string` stores bytes:\n\n```capy\nfunction RENDER(request : dval) {\n    var name := \"Ada\"\n    var empty := \"\"\n    print(name, empty, \"\\n\")\n}\n\n```\n\n\nAn empty string is still a string value. It is not missing data.\n\n## Arrays, tuples, and structs\n\nAn array contains values of one type:\n\n```capy\nfunction RENDER(request : dval) {\n    var names := [\"Ada\", \"Grace\"]\n    print(names[0], \"\\n\")\n}\n\n```\n\n\nA tuple has a fixed number of positions, which can have different types:\n\n```capy\nfunction RENDER(request : dval) {\n    var point := (3, 4)\n    print(point[0], \" \", point[1], \"\\n\")\n}\n\n```\n\n\nA struct gives names to fixed fields:\n\n```capy\nstruct Point {\n    x : s32\n    y : s32\n}\n\nfunction RENDER(request : dval) {\n    var point := Point(3, 4)\n    print(point.x, \" \", point.y, \"\\n\")\n}\n\n```\n\n\nArrays and struct instances are mutable reference values inside one workspace. Assignment shares their identity. Tuples remain immutable.\n\nThe collections chapter covers these types in detail.\n\n## Dynamic values and none\n\nA `dval` holds data whose shape is known only at run time. The `none` value represents missing dynamic data:\n\n```capy\nfunction RENDER(request : dval) {\n    var profile := {name: \"Ada\"}\n    var missing := none\n    print(profile.name, \" \", missing?, \"\\n\")\n}\n\n```\n\n\n`none` is different from `\"\"`, `false`, an empty map, and an empty list. A `dval` is also a mutable reference value inside one workspace. The dynamic-values chapter explains mutation, safe reads, and conversions.\n\n## Type aliases\n\nA type alias gives another name to a type:\n\n```capy\ntype Count = s64\n\nfunction RENDER(request : dval) {\n    var total : Count = 12\n    print(total, \"\\n\")\n}\n\n```\n\n\nAn alias does not create a new runtime type.\n\n\n") { found = true }
    if consider(tokens, "/doc/guide/expressions-and-control-flow/", "4. Expressions and control flow", "4. Expressions and control flow\n4. Expressions and control flow\nAn expression produces a value or performs an action. Capy evaluates listed expressions from left to right.\n\n## Calculate a value\n\n```capy\nfunction RENDER(request : dval) {\n    var price := 6\n    var quantity := 2\n    var total := price * quantity\n    print(total, \"\\n\")\n}\n\n```\n\n**Output**\n\n```text\n12\n\n```\n\n`*` runs before `+` and `-`. Parentheses make the intended order explicit.\n\n## Declare and assign locals\n\n`:=` declares a local and infers its type. `=` replaces its value:\n\n```capy\nfunction RENDER(request : dval) {\n    var count := 1\n    count = count + 1\n    print(count, \"\\n\")\n}\n\n```\n\n\nA local exists until the end of its block. An inner block can declare a new local with the same name without changing the outer local.\n\n## Conditions\n\nUse `if` to select code:\n\n```capy\nfunction RENDER(request : dval) {\n    var total := 12\n    if total > 10 {\n        print(\"large\\n\")\n    } else {\n        print(\"small\\n\")\n    }\n}\n\n```\n\n\nThe condition must have type `bool`. `&&` and `||` stop as soon as the result is known.\n\nAn `if` with `else` can also produce a value:\n\n```capy\nfunction RENDER(request : dval) {\n    var total := 12\n    var label := if total > 10 {\n        -> \"large\"\n    } else {\n        -> \"small\"\n    }\n    print(label, \"\\n\")\n}\n\n```\n\n\nEach reachable branch that produces a value must produce the same type. A branch that returns or traps does not produce a value.\n\n## Loops\n\nA `while` loop repeats while its condition is true:\n\n```capy\nfunction RENDER(request : dval) {\n    var index := 0\n    while index < 3 {\n        print(index, \"\\n\")\n        index = index + 1\n    }\n}\n\n```\n\n\nA `for` loop reads a half-open `s32` range, an array, or a `dval` map or list:\n\n```capy\nfunction RENDER(request : dval) {\n    for number := 1..4 {\n        print(number, \"\\n\")\n    }\n}\n\n```\n\n\nThe range is half-open. `1..4` contains `1`, `2`, and `3`. A range permits one loop value only.\n\nOptional metadata follows the value:\n\n```capy\nfunction show(names : [string], profile : dval) {\n    for name, index := names { print(index, \": \", name, \"\\n\") }\n    for item, key := profile { print(key, \": \", item, \"\\n\") }\n}\n\nfunction RENDER(request : dval) {\n    show([\"Ada\"], {role: \"admin\"})\n}\n\n```\n\n\nAn array index has type `s32`. A `dval` key has type `string`. `dval` list keys are decimal strings. Structs are not iterable. The old `=` and `in` forms are invalid.\n\nArray and `dval` loops recheck the current count before each iteration. A loop can visit items added while it runs. Shrinkage cannot cause an invalid access. `dval` loop items are copies. An array loop retains its current managed item while the body runs.\n\nUse `break` to leave the nearest loop. Use `continue` to start its next iteration.\n\n## Blocks\n\nA block yields a value when its final reachable item starts with `->`:\n\n```capy\nfunction RENDER(request : dval) {\n    var total := {\n        var subtotal := 10\n        -> subtotal + 2\n    }\n    print(total, \"\\n\")\n}\n\n```\n\n\nThis makes `total` equal to `12`. A block can keep temporary locals close to the calculation that uses them.\n\n\n") { found = true }
    if consider(tokens, "/doc/guide/functions-and-closures/", "5. Functions", "5. Functions\n5. Functions\nA function gives a name to a calculation. Parameters describe its input. The declared result type describes its output.\n\n## Define and call a function\n\n```capy\nfunction greet(name : string) string {\n    -> \"Hello, \" + name\n}\n\nfunction RENDER(request : dval) {\n    print(greet(\"Ada\"), \"\\n\")\n}\n\n```\n\n**Output**\n\n```text\nHello, Ada\n\n```\n\nThe `->` expression supplies the function result. Use `return` when a function must finish early.\n\n## Parameters and defaults\n\nParameters have names and types:\n\n```capy\nfunction label(name : string, suffix : string = \"!\") string {\n    -> name + suffix\n}\n\nfunction RENDER(request : dval) {\n    print(label(\"Capy\"), \"\\n\")\n}\n\n```\n\n\n`label(\"Capy\")` uses the default suffix. Defaults are trailing literals. A direct call can omit them, but a function value keeps the full parameter list.\n\nCapy evaluates arguments once from left to right.\n\n## Overloads\n\nSeveral functions can have the same name when their parameter types differ:\n\n```capy\nfunction describe(value : s32) string { -> \"integer\" }\nfunction describe(value : string) string { -> \"string\" }\n\nfunction RENDER(request : dval) {\n    print(describe(42), \" \", describe(\"Ada\"), \"\\n\")\n}\n\n```\n\n\nThe argument types select the overload. A result type never selects one.\n\n## Conversion parameters\n\nA parameter declared with `as` permits one constructor conversion:\n\n```capy\nfunction show(value : as string) {\n    print(value, \"\\n\")\n}\n\nfunction RENDER(request : dval) {\n    show(42)\n}\n\n```\n\n\nThe call behaves as if it passed `string(42)`. Capy does not chain several conversions.\n\n## Function values\n\nA function can be stored and called through a typed value:\n\n```capy\nfunction double(value : s32) s32 { -> value * 2 }\n\nfunction RENDER(request : dval) {\n    var operation : function(value : s32) s32 = double\n    var answer := operation(21)\n    print(answer, \"\\n\")\n}\n\n```\n\n\nA lambda defines a small function at its point of use:\n\n```capy\nfunction RENDER(request : dval) {\n    var add_one := function(value : s32) s32 {\n        -> value + 1\n    }\n    print(add_one(41), \"\\n\")\n}\n\n```\n\n\nA lambda can read captured outer values. Scalar captures copy. Array, `dval`, and struct captures share identity inside the workspace. A capture binding cannot be reassigned. The closure can mutate shared aggregate content.\n\n```capy\nfunction RENDER(request : dval) {\n    var offset := 2\n    var values := [10]\n    var update := function() s32 {\n        values.push(20)\n        -> offset + length(values)\n    }\n    print(update(), \" \", values[1], \"\\n\")\n}\n\n```\n\n\n## Generic and variadic functions\n\nAn `any` parameter creates a compile-time generic function. Use it when the same operation is valid for several concrete types.\n\nA variadic parameter collects values into a typed array:\n\n```capy\nfunction print_all(...values : as string) {\n    for value := values {\n        print(value)\n    }\n}\n\nfunction RENDER(request : dval) {\n    print_all(\"one\", \" \", \"two\", \"\\n\")\n}\n\n```\n\n\nUse `...items` to spread an array into a variadic call.\n\n\n") { found = true }
    if consider(tokens, "/doc/guide/strings-and-markup/", "6. Strings and HTML", "6. Strings and HTML\n6. Strings and HTML\nUse strings for text and markup expressions for HTML. Markup escapes ordinary strings before they enter the response.\n\n## Escape dynamic text\n\n```capy\nfunction RENDER(request : dval) {\n    var name := \"<Ada>\"\n    print(<><p>Hello, <?= name ?></p></>, \"\\n\")\n}\n\n```\n\n**Output**\n\n```text\n<p>Hello, &lt;Ada&gt;</p>\n\n```\n\n`<?= name ?>` selects an encoding from its location. HTML text and quoted attributes escape `&`, `<`, `>`, quotes, and apostrophes.\n\nInside a `script` element, a string becomes one self-contained JavaScript literal. The encoder protects the closing tag and JavaScript line separators. Inside a `style` element, a string becomes one self-contained CSS literal. Integer and Boolean values remain scalar values. `f64` interpolation is not supported in these elements.\n\n```capy\nfunction RENDER(request : dval) {\n    var name := string(request.query.name, \"guest\")\n    <>\n        <script>const name = <?= name ?>;</script>\n        <style>.name::before { content: <?= name ?>; }</style>\n    </>\n}\n\n```\n\n\nScript and style interpolation must start at a value boundary. Static source after it can apply an operator or a CSS unit. Do not put interpolation inside an existing string, template literal, or comment. Attribute values must use quotes. Tag and attribute names cannot contain interpolation.\n\nURL, event-handler, and inline-style attributes use HTML attribute escaping. Validate these values for their application context before interpolation.\n\n## String literals\n\nString literals use double quotes:\n\n```capy\nfunction RENDER(request : dval) {\n    var message := \"Hello\"\n    var line := \"first\\nsecond\"\n    print(message, \" \", line, \"\\n\")\n}\n\n```\n\n\nThe supported escapes include `\\n`, `\\r`, `\\t`, `\\\"`, and `\\\\`. String positions and lengths count bytes, not Unicode characters.\n\nUse `+` to join strings:\n\n```capy\nfunction RENDER(request : dval) {\n    var name := \"Ada\"\n    var greeting := \"Hello, \" + name\n    print(greeting, \"\\n\")\n}\n\n```\n\n\nUse a constructor to convert a scalar when a function does not already accept `as string`:\n\n```capy\nfunction RENDER(request : dval) {\n    var label := \"Count: \" + string(3)\n    print(label, \"\\n\")\n}\n\n```\n\n\n## Markup expressions\n\nA markup expression starts with `<>` and ends with `</>`:\n\n```capy\nfunction RENDER(request : dval) {\n    var title := \"Report\"\n    <>\n        <h1><?= title ?></h1>\n        <p>Ready</p>\n    </>\n}\n\n```\n\n\nThe expression has type `markup`. It can be printed, returned from an ordinary function, or placed inside other markup. A component writes markup to response output.\n\n## Trusted markup\n\nA `markup` value stays trusted when `<?= value ?>` inserts it into HTML text. In attributes, scripts, and styles, Capy escapes it as a string for that context. `<?: value ?>` also inserts a `markup` value without escaping it again. Raw interpolation works only in HTML text:\n\n```capy\nfunction RENDER(request : dval) {\n    var icon := trusted_markup(\"<strong>ready</strong>\")\n    <><p><?: icon ?></p></>\n}\n\n```\n\n\nUse `trusted_markup` only at a reviewed trust boundary. Do not apply it to request input, database text, or remote content.\n\n## Common string operations\n\nUse `length`, `substr`, `find`, `contains`, `replace`, `lower`, `upper`, `split`, and `join` for ordinary text work. Use `html_escape` when an API needs escaped text instead of a `markup` value.\n\nStrings use automatic reference counting. Assignment and function calls preserve their lifetime. Most programs do not need to call `clone`.\n\n\n") { found = true }
    if consider(tokens, "/doc/guide/collections-and-records/", "7. Arrays, tuples, and structs", "7. Arrays, tuples, and structs\n7. Arrays, tuples, and structs\nUse an array for an ordered collection of one type. Use a tuple for a short fixed group. Use a struct when fields need names.\n\n## Arrays\n\n```capy\nfunction RENDER(request : dval) {\n    var names := [\"Ada\", \"Grace\"]\n    print(names[0], \"\\n\")\n}\n\n```\n\n**Output**\n\n```text\nAda\n\n```\n\nArray indexes start at zero. An invalid index traps.\n\nDeclare the item type when an array starts empty:\n\n```capy\nfunction RENDER(request : dval) {\n    var names : [string] = []\n    names.push(\"Ada\")\n    print(names[0], \"\\n\")\n}\n\n```\n\n\n`push`, `pop`, `insert`, `remove`, `clear`, `reserve`, and `resize` change an array.\n\n## Array values\n\nAn array is a mutable reference value inside one workspace:\n\n```capy\nfunction append_three(values : [s32]) {\n    values.push(3)\n}\n\nfunction RENDER(request : dval) {\n    var first := [1, 2]\n    var second := first\n    append_three(second)\n    print(first[2], \" \", second[2], \"\\n\")\n}\n\n```\n\n\nAssignment and parameter passing share the array identity. Returns and captures also share it. Content mutation through a parameter affects the caller. A parameter binding remains immutable, so `values = [3]` is invalid. Array growth preserves identity.\n\nA `for` loop reads array items in order:\n\n```capy\nfunction RENDER(request : dval) {\n    var names := [\"Ada\", \"Grace\"]\n    for name, index := names {\n        print(index, \": \", name, \"\\n\")\n    }\n}\n\n```\n\n\nThe optional index follows the value and has type `s32`. The loop rechecks the current array length. It safely stops after shrinkage and can visit appended items. The loop retains each current managed item while the body runs.\n\nThe loop item is a value, not an assignable array position. Use an index to replace an item.\n\n## Tuples\n\nA tuple is immutable. It has fixed positions and can contain different types:\n\n```capy\nfunction RENDER(request : dval) {\n    var result := (200, \"ok\")\n    print(result[0], \" \", result[1], \"\\n\")\n}\n\n```\n\n\n`(value)` only groups an expression. It does not create a one-item tuple.\n\nA tuple can spread into matching function parameters:\n\n```capy\nfunction add(left : s32, right : s32) s32 { -> left + right }\n\nfunction RENDER(request : dval) {\n    var pair := (20, 22)\n    var answer := add(...pair)\n    print(answer, \"\\n\")\n}\n\n```\n\n\n## Structs\n\nA struct defines a named fixed layout:\n\n```capy\nstruct Point {\n    x : s32\n    y : s32\n}\n\nfunction RENDER(request : dval) {\n    var point := Point(3, 4)\n    print(point.x, \" \", point.y, \"\\n\")\n}\n\n```\n\n\nThe generated constructor takes fields in declaration order. A struct instance is a mutable reference value inside one workspace. Assignment, parameters, returns, and captures share its identity. Struct fields are assignable:\n\n```capy\nstruct Point {\n    x : s32\n    y : s32\n}\n\nfunction move_right(point : Point) {\n    point.x = point.x + 1\n}\n\nfunction RENDER(request : dval) {\n    var point := Point(3, 4)\n    move_right(point)\n    print(point.x, \"\\n\")\n}\n\n```\n\n\nThe field mutation affects the caller. The parameter binding itself remains immutable.\n\nA receiver-first function can use method syntax:\n\n```capy\nstruct Point {\n    x : s32\n    y : s32\n}\n\nfunction total(point : Point) s32 { -> point.x + point.y }\n\nfunction RENDER(request : dval) {\n    var point := Point(3, 4)\n    print(point.total(), \"\\n\")\n}\n\n```\n\n\nThis is the same call as `total(point)`.\n\n## Choose the right shape\n\nUse an array when every item has one static type. Use a tuple for a small fixed return value. Use a struct for application data with a stable shape. Use a `dval` map or list for decoded input and data that crosses a Bearer boundary.\n\n\n") { found = true }
    if consider(tokens, "/doc/guide/web-handlers-and-requests/", "9. Handling a web request", "9. Handling a web request\n9. Handling a web request\nA Capy Bearer handler receives one copied request snapshot. Declare every handler with `request : dval`.\n\n## Read the request snapshot\n\n```capy\nfunction RENDER(request : dval) {\n    var name := string(request.query.name, \"guest\")\n    response_header(\"Content-Type\", \"text/plain; charset=utf-8\")\n    print(\"Hello, \", name, \"!\\n\")\n}\n\n```\n\n**Output**\n\n```text\nHello, guest!\n\n```\n\nThe snapshot contains `method`, `query`, `form`, `headers`, `cookies`, `body`, `files`, `route`, `url`, `server`, `session`, `props`, `config`, `call`, `connection`, `unit`, and `websocket`.\n\n`route` contains `path`, `page`, `raw_path`, and `valid`. `url` contains `script` and `base`. `session` contains `id`, `name`, and `values`. `websocket` contains `connection_id`, `scope`, `opcode`, `binary`, and current-scope `connections`.\n\nMissing members are `none`. Use normal conversions for scalar values. For example, use `string(request.form.email, \"\")`, `s32(request.websocket.opcode, 0)`, and `bool(request.websocket.binary, false)`.\n\n## Form a response\n\nUse `print`, `response_status`, `response_header`, `response_cookie`, and `redirect` to change the response. Set headers before large output. Use a redirect after a successful state change so the user can refresh the page safely.\n\nUse `ws_send`, `ws_send_to`, and `ws_close` for WebSocket effects. Use `request.websocket.connections` to select current-scope clients.\n\n## Handle a form\n\nA handler normally uses one route for both the form and the POST result. Read `request.method` first. Read submitted fields from `request.form`.\n\nThis example shows the complete control flow. A GET request prints the form. A POST request validates the email, stores it in the session, queues a cookie, and redirects. The documentation renderer runs the GET path.\n\n```capy\nfunction RENDER(request : dval) {\n    response_header(\"Content-Type\", \"text/html; charset=utf-8\")\n    var method := string(request.method, \"GET\")\n\n    if method == \"POST\" {\n        var email := string(request.form.email, \"\")\n        if email == \"\" {\n            response_status(422, \"Unprocessable Content\")\n            <><p>Email is required.</p></>\n            return\n        }\n\n        var session := session_start(\"account\")\n        session = session_set(\"email\", email)\n        response_cookie(\"has_account\", \"1\")\n        redirect(\"/account\")\n        return\n    }\n\n    <>\n        <form method=\"post\">\n            <label>Email <input name=\"email\" type=\"email\" /></label>\n            <button>Save</button>\n        </form>\n    </>\n}\n\n```\n\n\n## Read uploaded files\n\nUploaded files appear in `request.files`. Each entry is a copied `dval` with the metadata that Bearer accepted for the request. Treat the original filename as user input.\n\nUse the generated request page for the exact file fields. Validate the file count, size, and type before you store anything.\n\n```capy\nfunction RENDER(request : dval) {\n    var files := request.files\n    print(\"files=\", length(files), \"\\n\")\n}\n\n```\n\n\n## Sessions\n\nSession effects return a state map with `id`, `name`, and `values`. Keep the returned value when later code needs changed session data. The handler request snapshot does not change.\n\n```capy\nfunction RENDER(request : dval) {\n    var session := session_start(\"account\")\n    session = session_set(\"theme\", \"dark\")\n    print(string(session.values.theme, \"\"), \"\\n\")\n}\n\n```\n\n\n## Other handlers\n\n`RENDER`, named `RENDER`, `COMPONENT`, named `COMPONENT`, `CLI`, `WS`, `TASK`, named `TASK`, `INIT`, `ONCE`, and custom HTTP handlers all use `request : dval`. Handlers do not return application values.\n\n\n") { found = true }
    if consider(tokens, "/doc/guide/tasks-and-jobs/", "11. Tasks and jobs", "11. Tasks and jobs\n11. Tasks and jobs\nA task runs a Capy handler outside the current request. A job runs an operating-system command. Both return immediately with a handle that the caller can inspect later.\n\n## Read status data\n\nTask status is a `dval` because fields can vary with the state:\n\n```capy\nfunction state_label(status : dval) string {\n    -> string(status.state, \"missing\")\n}\n\nfunction RENDER(request : dval) {\n    print(state_label({state: \"queued\"}), \"\\n\")\n}\n\n```\n\n**Output**\n\n```text\nqueued\n\n```\n\nReal task states are `queued`, `running`, `succeeded`, `failed`, `canceled`, or `missing`.\n\n## Define a task handler\n\nA named task handler receives one request value:\n\n```capy\nfunction TASK:STORE(request : dval) {\n    var props := request.props\n    var key := string(props.key, \"\")\n    if key == \"\" {\n        trap()\n    }\n    // Store the application result under key.\n}\n\nfunction RENDER(request : dval) {\n    print(\"task handler ready\\n\")\n}\n\n```\n\n\nThe task boundary copies props as BRRB. `dval` identity does not cross it. The worker does not receive the caller's request, session, connections, open handles, or memory state.\n\n## Submit a task\n\n`task` returns an opaque string ID after Bearer admits the task:\n\n```capy\nfunction RENDER(request : dval) {\n    var id := task(\"/tasks/store.capy:STORE\", {key: \"report-42\"})\n    print(id, \"\\n\")\n}\n\n```\n\n\nThe call traps if Bearer cannot admit the task. Use `task_status(id)` to poll. Use `task_await(id, timeout_ms)` to wait for a state:\n\n```capy\nfunction show_failure(id : string) {\n    var status := task_await(id, 5000)\n    if string(status.state, \"\") == \"failed\" {\n        print(string(status.failure_code, \"unknown\"))\n    }\n}\n\nfunction RENDER(request : dval) {\n    print(\"failure helper ready\\n\")\n}\n\n```\n\n\nA wait timeout does not cancel active work. `task_cancel(id)` requests cancellation, but a running task can finish first. Cancellation does not undo an external effect.\n\nA successful task means that its handler finished. Task status does not carry an application result. Store results in application-owned persistent storage.\n\n## Run a command\n\n`shell_spawn` starts a bounded operating-system job:\n\n```capy\nfunction RENDER(request : dval) {\n    var job := shell_spawn({cmd: \"printf ready\", timeout_ms: 1000})\n    var status := job_await(job, 3000)\n    print(string(status.state, \"missing\"), \"\\n\")\n}\n\n```\n\n\nUse `job_status`, `job_await`, `job_result`, and `job_cancel` with the returned handle. Always set a deliberate command timeout. Validate the final state before reading result data.\n\nThe shell interprets `cmd`. Do not build it from request data or other untrusted input.\n\n## Failure and retries\n\nBearer does not retry a failed task automatically. Submit a new task only when the application can repeat the operation safely. Use an application idempotency key for work that changes external state.\n\nDo not wait for long work in a page request unless the response requires it. Treat task IDs and job handles as opaque values.\n\n## Keep task input small\n\nPass a `dval` that contains only stable identifiers and simple options. Do not pass a full request snapshot to a task. Request data can contain cookies, headers, and uploaded-file metadata that the task does not need.\n\nUse a database row, file path, or application key when work needs large input. Validate that reference again inside the task. A task can run after the user request has ended.\n\nUse a visible status page for long work. It should show queued, running, done, failed, and canceled states in user terms.\n\n\n") { found = true }
    if consider(tokens, "/doc/api/http-request/", "http_request", "http_request\n`http_request()` sends one HTTP request and returns a `dval` response. Use it for a bounded outbound request. The response contains status, headers, and body.") { found = true }
    if !found { print("<p class=\"no-results\">No results for \"<strong>", html_escape(query), "</strong>\"</p>") }
    print("</main>")
}

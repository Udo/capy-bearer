#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "to-u64" {
        var page := dval({source_page: ""})
        page["source_page"] = "to_u64"
        page["kind"] = "api"
        page["slug"] = "to-u64"
        page["route"] = "/doc/api/to-u64/"
        page["title"] = "to_u64"
        page["content"] = "Capy has no native `to_u64` signature. Use `u64(value, fallback)`.\n"
        page["label"] = "to_u64"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">types", "2_DValue_to_u64", "to_s64", "brb_encode", "to_f64", "brb_decode", "to_bool"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

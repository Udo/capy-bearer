#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "string-list-each" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_StringList_each"
        page["kind"] = "api"
        page["slug"] = "string-list-each"
        page["route"] = "/doc/api/string-list-each/"
        page["title"] = "Call a function for each string"
        page["content"] = "`each` calls `callback` once for each item in a list-shaped `dval`.\n\nThe callback receives a string value. `each` processes items in list order.\n"
        page["returns"] = "This function returns no value."
        page["label"] = "each"
        page["capy_sig_lines"] = dval(["function each(items : dval, callback : function(value : string) string)"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_StringList"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var items := split(\"one,two\", \",\")\neach(items, function(value : string) string { print(value); return \"\" })\nprint(\"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "string-list-every" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_StringList_every"
        page["kind"] = "api"
        page["slug"] = "string-list-every"
        page["route"] = "/doc/api/string-list-every/"
        page["title"] = "Test every string"
        page["content"] = "`every` tests each string in a list-shaped `dval` with `predicate`.\n\nThis function does not change `items`.\n"
        page["returns"] = "This function returns `true` when every item matches. It returns `true` for an empty list."
        page["label"] = "every"
        page["capy_sig_lines"] = dval(["function every(items : dval, predicate : function(value : string) bool) bool"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_StringList"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var items := split(\"one,two\", \",\")\nprint(every(items, function(value : string) bool { return value != \"\" }), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "string-list-filter" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_StringList_filter"
        page["kind"] = "api"
        page["slug"] = "string-list-filter"
        page["route"] = "/doc/api/string-list-filter/"
        page["title"] = "Filter strings"
        page["content"] = "`filter` keeps the strings for which `predicate` returns `true`.\n\nThe result keeps input order. This function does not change `items`.\n"
        page["returns"] = "This function returns a new list-shaped `dval`."
        page["label"] = "filter"
        page["capy_sig_lines"] = dval(["function filter(items : dval, predicate : function(value : string) bool) dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_StringList"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var items := split(\"one,two\", \",\")\nvar kept := filter(items, function(value : string) bool { return value == \"two\" })\nprint(join(kept, \",\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "string-list-find" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_StringList_find"
        page["kind"] = "api"
        page["slug"] = "string-list-find"
        page["route"] = "/doc/api/string-list-find/"
        page["title"] = "Find text in a string"
        page["content"] = "`find` searches a string for another string.\n\nFor a list-shaped `dval`, use `some` to test for a matching item.\n"
        page["returns"] = "This function returns the byte position of `needle`. It returns `-1` when it does not find `needle`."
        page["label"] = "find"
        page["capy_sig_lines"] = dval(["function find(haystack : string, needle : string) s32"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_StringList"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(find(\"one,two\", \"two\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "string-list-map" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_StringList_map"
        page["kind"] = "api"
        page["slug"] = "string-list-map"
        page["route"] = "/doc/api/string-list-map/"
        page["title"] = "Map strings"
        page["content"] = "`map` calls `mapper` for each string in a list-shaped `dval`.\n\nThe result keeps input order. This function does not change `items`.\n"
        page["returns"] = "This function returns a new list-shaped `dval`."
        page["label"] = "map"
        page["capy_sig_lines"] = dval(["function map(items : dval, mapper : function(value : string) string) dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_StringList"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var items := split(\"one,two\", \",\")\nvar names := map(items, function(value : string) string { return upper(value) })\nprint(join(names, \",\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "string-list-some" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_StringList_some"
        page["kind"] = "api"
        page["slug"] = "string-list-some"
        page["route"] = "/doc/api/string-list-some/"
        page["title"] = "Test any string"
        page["content"] = "`some` tests each string in a list-shaped `dval` with `predicate`.\n\nThis function does not change `items`.\n"
        page["returns"] = "This function returns `true` when any item matches. It returns `false` for an empty list."
        page["label"] = "some"
        page["capy_sig_lines"] = dval(["function some(items : dval, predicate : function(value : string) bool) bool"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_StringList"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var items := split(\"one,two\", \",\")\nprint(some(items, function(value : string) bool { return value == \"two\" }), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "string-list-sort" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_StringList_sort"
        page["kind"] = "api"
        page["slug"] = "string-list-sort"
        page["route"] = "/doc/api/string-list-sort/"
        page["title"] = "Sort strings"
        page["content"] = "`sort` sorts the strings in a list-shaped `dval`.\n\nThis function does not change `items`.\n"
        page["returns"] = "This function returns a new list-shaped `dval` in ascending order."
        page["label"] = "sort"
        page["capy_sig_lines"] = dval(["function sort(items : dval) dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_StringList"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var items := split(\"two,one\", \",\")\nprint(join(sort(items), \",\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "string-list-unique" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_StringList_unique"
        page["kind"] = "api"
        page["slug"] = "string-list-unique"
        page["route"] = "/doc/api/string-list-unique/"
        page["title"] = "Get unique strings"
        page["content"] = "`unique` keeps the first copy of each string in a list-shaped `dval`.\n\nThe result keeps input order. This function does not change `items`.\n"
        page["returns"] = "This function returns a new list-shaped `dval`."
        page["label"] = "unique"
        page["capy_sig_lines"] = dval(["function unique(items : dval) dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_StringList"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var items := split(\"one,two,one\", \",\")\nprint(join(unique(items), \",\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "string-list" {
        var page := dval({source_page: ""})
        page["source_page"] = "0_StringList"
        page["kind"] = "api"
        page["slug"] = "string-list"
        page["route"] = "/doc/api/string-list/"
        page["title"] = "String list"
        page["content"] = "Use a list-shaped `dval` for an ordered string list. Create one with `dval([...])` or `split`.\n\nUse `join`, `map`, `filter`, `keys`, `unique`, `sort`, `some`, and `every` for list work. These functions return a new value unless stated otherwise.\n\nCapy has no separate `StringList` type. Use a list-shaped `dval` instead.\n"
        page["label"] = "StringList"
        page["capy_sig_lines"] = dval(["type dval (list of strings)"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_DValue", "split", "join"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var labels := map(unique(split(\"a,b,a\", \",\")), function(item : string) string { return upper(item) })\nprint(join(labels, \",\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

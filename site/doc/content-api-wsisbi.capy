#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "ws-is-binary" {
        var page := dval({source_page: ""})
        page["source_page"] = "ws_is_binary"
        page["kind"] = "api"
        page["slug"] = "ws-is-binary"
        page["route"] = "/doc/api/ws-is-binary/"
        page["title"] = "ws_is_binary"
        page["content"] = "## sig\n\nNo Capy signature.\n\nCapy has no native `ws_is_binary` signature. In a `WS` handler, use `request.websocket.binary`.\n"
        page["label"] = "ws_is_binary"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">websocket", ">0_Request", "ws_connections", "ws_message", "ws_connection_id", "ws_opcode", "ws_connection_count", "ws_scope"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

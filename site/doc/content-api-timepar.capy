#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "time-parse" {
        var page := dval({source_page: ""})
        page["source_page"] = "time_parse"
        page["kind"] = "api"
        page["slug"] = "time-parse"
        page["route"] = "/doc/api/time-parse/"
        page["title"] = "time_parse"
        page["content"] = "`time_parse` converts date or time text to a Unix timestamp.\n"
        page["returns"] = "parsed Unix timestamp, or zero when parsing fails"
        page["label"] = "time_parse"
        page["capy_sig_lines"] = dval(["function time_parse(value : string) u64"])
        page["param_lines"] = dval(["value : date or time text", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">time", "time_format_utc", "time_format_relative", "time_format_local", "time", "time_precise", "usleep"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(time_parse(\"1970-01-01 00:00:05 UTC\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

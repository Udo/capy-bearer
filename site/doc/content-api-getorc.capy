#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "get-or-create" {
        var page := dval({source_page: ""})
        page["source_page"] = "get_or_create"
        page["kind"] = "api"
        page["slug"] = "get-or-create"
        page["route"] = "/doc/api/get-or-create/"
        page["title"] = "Get or create a child"
        page["content"] = "`get_or_create(value, key, default)` stores `default` when `key` is missing. It changes and returns `value`.\n"
        page["returns"] = "The target value."
        page["label"] = "get_or_create"
        page["capy_sig_lines"] = dval(["function get_or_create(value : dval, key : string, default : as dval) dval"])
        page["param_lines"] = dval(["value : target value", "key : child key", "default : value to store when the child is missing", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_DValue", "set", "has"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var config := dval({:})\nconfig = get_or_create(config, \"host\", \"localhost\")\nprint(config.host, \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

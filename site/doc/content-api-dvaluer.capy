        page["kind"] = "api"
        page["slug"] = "dvalue-reference-target"
        page["route"] = "/doc/api/dvalue-reference-target/"
        page["title"] = "DValue::reference_target"
        page["content"] = "Capy does not support `reference_target`. DValues share identity inside one workspace, but Capy does not expose host pointers or C++ internal reference nodes.\n\n## C++ API\n\n`DValue::reference_target()` follows an internal reference chain and returns its final non-reference target pointer. It returns `0` for a non-reference, a null or self reference, or an unresolved chain.\n\n"
        page["returns"] = "resolved target pointer, or 0 when this node is not a usable reference"
        page["capy_status"] = "unsupported"
        page["label"] = "DValue::reference_target"
        page["sig_lines"] = dval(["DValue* DValue::reference_target()", "const DValue* DValue::reference_target() const", ""])
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_DValue", "2_DValue_is_reference", "2_DValue_deref"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-remove" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_remove"
        page["kind"] = "api"
        page["slug"] = "dvalue-remove"
        page["route"] = "/doc/api/dvalue-remove/"
        page["title"] = "DValue::remove"
        page["content"] = "`dval_remove(value, key)` removes the string key from `value`. It mutates `value` and returns that same identity. All workspace aliases observe the mutation. Assigning the result back remains valid.\n\nThe operation makes a scalar map-shaped. A missing key causes no other change. Removing the last child resets the next numeric index to zero.\n\n## C++ API\n\n`DValue::remove()` changes the object in place.\n"
        page["returns"] = "none"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "DValue::remove"
        page["sig_lines"] = dval(["void DValue::remove(String s)", ""])
        page["capy_sig_lines"] = dval(["function dval_remove(value : dval, key : string) dval"])
        page["param_lines"] = dval(["s : child key to erase", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_DValue", "2_DValue_clear", "2_DValue_has"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-require" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_require"
        page["kind"] = "api"
        page["slug"] = "dvalue-require"
        page["route"] = "/doc/api/dvalue-require/"
        page["title"] = "DValue::require"
        page["content"] = "Use `dval_require(value, key)` or `dval_require(value, index)` for a strict Capy read.\n\nCapy traps when the child is missing or the value cannot use the selector. C++ `key` returns a null pointer for a missing key. Check the pointer before use.\n\nThe documentation renderer cannot safely run a trap example. The example uses a present key.\n"
        page["returns"] = "copied child in Capy, or a child pointer in C++"
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "DValue::require"
        page["sig_lines"] = dval(["DValue* DValue::key(String s)", "const DValue* DValue::key(String s) const", ""])
        page["capy_sig_lines"] = dval(["function dval_require(value : dval, key : string) dval", "function dval_require(value : dval, index : s32) dval"])
        page["param_lines"] = dval(["key or index : required child selector", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_DValue", "2_DValue_key", "2_DValue_get_by_path"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])

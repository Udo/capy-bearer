#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-reference-target" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_reference_target"
        page["kind"] = "api"
        page["slug"] = "dvalue-reference-target"
        page["route"] = "/doc/api/dvalue-reference-target/"
        page["title"] = "Get a reference target"
        page["content"] = "Capy does not expose reference targets or host pointers.\n\nNo Capy alternative exists.\n"
        page["capy_status"] = "unsupported"
        page["label"] = "dval_reference_target"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["0_DValue"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-remove" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_remove"
        page["kind"] = "api"
        page["slug"] = "dvalue-remove"
        page["route"] = "/doc/api/dvalue-remove/"
        page["title"] = "Remove a child"
        page["content"] = "`dval_remove` removes `key` from `value`. A missing key leaves the value unchanged.\n"
        page["returns"] = "The changed target value."
        page["label"] = "dval_remove"
        page["capy_sig_lines"] = dval(["function dval_remove(value : dval, key : string) dval"])
        page["param_lines"] = dval(["value : target value", "key : child key", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var user := dval({\"name\": \"Ada\", \"role\": \"admin\"})\nuser = dval_remove(user, \"role\")\nprint(dval_has(user, \"role\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "dvalue-require" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_require"
        page["kind"] = "api"
        page["slug"] = "dvalue-require"
        page["route"] = "/doc/api/dvalue-require/"
        page["title"] = "Require a child"
        page["content"] = "`dval_require` reads a required child. Use it when a missing child is an error.\n"
        page["returns"] = "The copied child."
        page["errors"] = "The program traps when the child is missing or the selector is unusable."
        page["label"] = "dval_require"
        page["capy_sig_lines"] = dval(["function dval_require(value : dval, key : string) dval", "function dval_require(value : dval, index : s32) dval"])
        page["param_lines"] = dval(["value : source value", "key : required child key", "index : required list index", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var user := dval({\"name\": \"Ada\"})\nprint(dval_require(user, \"name\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

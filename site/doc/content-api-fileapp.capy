#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-append" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_append"
        page["kind"] = "api"
        page["slug"] = "file-append"
        page["route"] = "/doc/api/file-append/"
        page["title"] = "file_append"
        page["content"] = "`file_append` adds text to the end of a file. Use `file_put_contents` to replace a file.\n"
        page["returns"] = "`true` when Capy appends the text. Otherwise, it returns `false`."
        page["label"] = "file_append"
        page["capy_sig_lines"] = dval(["function file_append(path : string, content : string) bool", "function file_append(path : string, first : string, second : string) bool", "function file_append(path : string, first : string, second : string, third : string) bool"])
        page["param_lines"] = dval(["path : path of the file to update", "content : text to append", "first : first text value to append", "second : second text value to append", "third : third text value to append", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "file_put_contents", "file_get_contents", "file_exists"])
        page["examples"] = dval([{entry: "render", caption: "", body: "file_unlink(\"/tmp/doc-append.txt\")\nfile_append(\"/tmp/doc-append.txt\", \"a\", \"b\", \"c\")\nprint(file_get_contents(\"/tmp/doc-append.txt\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

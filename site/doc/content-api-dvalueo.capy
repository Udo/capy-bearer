#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-operator-index" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_operator_index"
        page["kind"] = "api"
        page["slug"] = "dvalue-operator-index"
        page["route"] = "/doc/api/dvalue-operator-index/"
        page["title"] = "Read a child by index"
        page["content"] = "## sig\n\nvalue[key]\n\nUse `value[key]` or `value[index]` to read a child. A missing child returns `none` and does not change the value.\n\nUse `dval_put` to set a named child.\n"
        page["returns"] = "The copied child, or `none`."
        page["label"] = "dval_operator_index"
        page["capy_sig_lines"] = dval(["value[key]"])
        page["param_lines"] = dval(["key : child key or list index", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var value := dval({\"site\": {\"title\": \"Bearer\"}})\nprint(value[\"site\"][\"title\"], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

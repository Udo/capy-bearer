#include "lib/doc_page.h"

// doc_page.h supplies generated API signatures and parsed guide examples.
void render_doc_page_link(String page, String label = "")
{
	page = doc_canonical_page(trim(page));
	if(page == "")
		return;
	if(label == "")
	{
		if(page.rfind("capy-", 0) == 0)
			label = first(load_doc_page(page).title, doc_default_title(page));
		else
			label = doc_index_label(page);
	}
	?><a href="./?p=<?= uri_encode(page) ?>"><?= label ?><?
	if(page.rfind("capy-", 0) != 0 && doc_page_kind(page) == DocPageKind::function)
	{
		?><span class="dim">()</span><?
	}
	?></a><?
}

void render_doc_params(DValue param_lines)
{
	if(param_lines.size() == 0)
		return;

	<><div class="doc-section params">
	<h3>Parameters</h3><?
	for(auto line : param_lines)
	{
		if(trim(line) == "")
			continue;
		String name = trim(nibble(line, ":"));
		String value = trim(line);
		?><div><b><?= name ?></b><?
		if(value != "")
		{
			?> : <?: doc_markdown_inline(value) ?><?
		}
		?></div><?
	}
	?></div></>
}

// The shared DocPage parser validates typed pairs before artifact creation.
bool doc_example_safe_member(String value)
{
	if(value == "")
		return(false);
	for(char c : value)
		if(!((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || c == '_' || c == '-'))
			return(false);
	return(true);
}

String doc_example_path(Request& context, String page, u64 idx, String language)
{
	String bin_dir = context.params["BEARER_BIN_DIRECTORY"];
	String member = ascii_safe_name(page);
	if(bin_dir == "" || !doc_example_safe_member(member) || (language != "capy" && language != "cpp"))
		return("");
	String root = path_join(bin_dir, "doc-examples");
	if(!file_exists(root) && !mkdir(root))
		return("");
	if(!path_is_within(root, bin_dir))
		return("");
	return(path_join(root, member + "_" + std::to_string(idx + 1) + "." + (language == "capy" ? "capy" : "uce")));
}

String doc_example_unit_source(String language, String entry, String body)
{
	String handler = doc_example_handler_name(entry);
	if(language == "capy")
		return("function " + handler + " {\n" + body + "\n}\n");
	return(handler + "(Request& context)\n{\n" + body + "\n}\n");
}

bool doc_write_if_changed(String path, String content)
{
	if(file_exists(path) && file_get_contents(path) == content)
		return(true);
	return(file_put_contents(path, content));
}

DValue doc_compile_example(Request& context, String page, u64 idx, String language, String entry, String body, bool complete_unit)
{
	DValue result;
	String path = doc_example_path(context, page, idx, language);
	if(path == "")
	{
		result["error"] = "DOC EXAMPLE ERROR: invalid example artifact path";
		return(result);
	}
	String source = complete_unit ? body + "\n" : doc_example_unit_source(language, entry, body);
	if(!doc_write_if_changed(path, source))
	{
		result["error"] = "DOC EXAMPLE ERROR: could not write " + path;
		return(result);
	}
	if(!unit_compile(path))
	{
		result["error"] = "DOC EXAMPLE ERROR: unit_compile failed for " + path;
		return(result);
	}
	result["path"] = path;
	return(result);
}

DValue doc_render_example(Request& context, String page, u64 idx, String language, String entry, String body, bool complete_unit)
{
	DValue result = doc_compile_example(context, page, idx, language, entry, body, complete_unit);
	if(result["error"].to_string() != "" || entry != "render")
		return(result);
	ob_start();
	unit_render(result["path"].to_string());
	result["output"] = ob_get_close();
	return(result);
}

void render_doc_example_result(String language, String entry, String body, DValue result)
{
	?><div class="example-language <?= language ?>">
		<h4><?= doc_example_language_label(language) ?></h4>
		<pre class="example-source"><?= body ?></pre><?
	if(result["error"].to_string() != "")
	{
		?><div class="example-output error"><div class="example-output-label">Error</div><pre><?= result["error"].to_string() ?></pre></div><?
	}
	else if(entry == "render")
	{
		?><div class="example-output"><div class="example-output-label">Output</div><pre><?= result["output"].to_string() ?></pre></div><?
	}
	else
	{
		?><div class="example-compile-only">Compile-only: <?= doc_example_handler_name(entry) ?> is not executed by documentation rendering.</div><?
	}
	?></div><?
}

void render_doc_signatures(DocPage doc_page)
{
	if(doc_page.capy_sig_lines.size() == 0 && doc_page.sig_lines.size() == 0 && doc_page.capy_status == "")
		return;
	?><div class="doc-section signatures">
	<h3>Capy</h3><?
	if(doc_page.capy_sig_lines.size() > 0)
	{
		?><pre><? print(join(doc_page.capy_sig_lines, "\n")); ?></pre><?
	}
	else
	{
		?><p class="signature-status"><?= doc_page.capy_status == "unsupported" ? "Unsupported by design for Capy." : doc_page.capy_status == "cpp-specific" ? "This page applies only to C++ (.uce)." : "No callable Capy declaration applies to this page." ?></p><?
	}
	if(doc_page.sig_lines.size() > 0)
	{
		?><h3>C++ (.uce)</h3><pre><? print(join(doc_page.sig_lines, "\n")); ?></pre><?
	}
	else
	{
		?><h3>C++ (.uce)</h3><p class="signature-status">No callable C++ declaration applies to this page.</p><?
	}
	?></div><?
}

void render_doc_examples(Request& context, String page, DocPage doc_page)
{
	if(doc_page.example_parse_error != "")
	{
		?><div class="doc-section example error"><h3>Example format error</h3><pre><?= doc_page.example_parse_error ?></pre></div><?
		return;
	}
	for(u64 idx = 0; idx < doc_page.guide_examples.size(); idx++)
	{
		DValue example = doc_page.guide_examples[idx];
		String entry = example["entry"].to_string();
		String body = example["body"].to_string();
		String expected = example["output"].to_string();
		DValue capy = doc_render_example(context, page, idx, "capy", entry, body, true);
		?><div class="doc-section example guide-example"><h3>Example: <?= doc_example_handler_name(entry) ?></h3><?
			render_doc_example_result("capy", entry, body, capy);
			if(entry == "render" && capy["error"].to_string() == "" && capy["output"].to_string() != expected)
			{
				?><div class="example-output error"><div class="example-output-label">Output error</div><pre>DOC EXAMPLE ERROR: output differs from :output</pre></div><?
			}
		?></div><?
	}
	for(u64 idx = 0; idx < doc_page.example_pairs.size(); idx++)
	{
		DValue pair = doc_page.example_pairs[idx];
		String entry = pair["entry"].to_string();
		String capy_body = pair["capy_body"].to_string();
		String cpp_body = pair["cpp_body"].to_string();
		DValue capy = doc_render_example(context, page, idx, "capy", entry, capy_body, false);
		DValue cpp = doc_render_example(context, page, idx, "cpp", entry, cpp_body, false);
		bool equal = entry != "render" || (capy["error"].to_string() == "" && cpp["error"].to_string() == "" && capy["output"].to_string() == cpp["output"].to_string());
		?><div class="doc-section example paired-example">
			<h3>Example: <?= doc_example_handler_name(entry) ?></h3><?
			render_doc_example_result("capy", entry, capy_body, capy);
			render_doc_example_result("cpp", entry, cpp_body, cpp);
			if(entry == "render" && !equal)
			{
				?><div class="example-output error"><div class="example-output-label">Parity error</div><pre>DOC EXAMPLE ERROR: Capy and C++ render output differs</pre></div><?
			}
		?></div><?
	}
	for(u64 idx = 0; idx < doc_page.cpp_only_examples.size(); idx++)
	{
		DValue example = doc_page.cpp_only_examples[idx];
		String entry = example["entry"].to_string();
		String body = example["body"].to_string();
		u64 artifact_idx = doc_page.guide_examples.size() + doc_page.example_pairs.size() + idx;
		DValue cpp = doc_render_example(context, page, artifact_idx, "cpp", entry, body, false);
		?><div class="doc-section example cpp-only-example"><h3>C++ example: <?= doc_example_handler_name(entry) ?></h3><?
			render_doc_example_result("cpp", entry, body, cpp);
		?></div><?
	}
	for(u64 idx = 0; idx < doc_page.example_blocks.size(); idx++)
	{
		u64 artifact_idx = doc_page.guide_examples.size() + doc_page.example_pairs.size() + doc_page.cpp_only_examples.size() + idx;
		DValue cpp = doc_render_example(context, page, artifact_idx, "cpp", "render", doc_page.example_blocks[idx], false);
		?><div class="doc-section example legacy-example"><h3>Legacy C++ example</h3><?
		render_doc_example_result("cpp", "render", doc_page.example_blocks[idx], cpp);
		?></div><?
	}
}

void render_see_section(String name, bool compact = false)
{
	DValue lines = split(file_get_contents("areas/" + name + ".txt"), "\n");
	s32 idx = 0;
	for(auto line : lines)
	{
		line = trim(line);
		if(line == "")
		{
			idx += 1;
			continue;
		}
		if(idx == 0)
		{
			if(compact)
			{
				?><h4><?= line ?></h4><?
			}
			else
			{
				<><div class="category"><h3><?= line ?></h3><ul></>
			}
		}
		else if(compact)
		{
			?><div class="related-link"><? render_doc_page_link(line); ?></div><?
		}
		else
		{
			?><li><? render_doc_page_link(line); ?></li><?
		}
		idx += 1;
	}
	if(!compact)
	{
		<></ul></div></>
	}
}

void render_doc_see_links(DValue see_lines)
{
	if(see_lines.size() == 0)
		return;

	<><h3 class="sidebar-subhead">Related</h3>
	<?
	for(auto sl : see_lines)
	{
		if(sl[0] == '>')
		{
			String target = trim(sl.substr(1));
			if(doc_has_area(target))
			{
				render_see_section(target, true);
			}
			else if(doc_has_page(target))
			{
				?><div class="related-link"><? render_doc_page_link(target); ?></div><?
			}
		}
		else
		{
			?><div class="related-link"><? render_doc_page_link(trim(sl)); ?></div><?
		}
	} 
	?>
	</>
}


RENDER(Request& context)
{
	String requested_page = first(context.get["p"], "index");
	String page = doc_canonical_page(requested_page);
	if(requested_page != page)
	{
		redirect("/doc/?p=" + uri_encode(page));
		return;
	}
	DocPage doc_page;
	String page_title = doc_default_title(page);
	if(page != "index")
	{
		doc_page = load_doc_page(page);
		if(doc_page.title != "")
			page_title = doc_page.title;
	}

	<><html>
	<head>
		<meta name="viewport" content="width=device-width, initial-scale=1"></meta>
		<title><?= page == "index" ? "Bearer Documentation" : page_title + " | Bearer Documentation" ?></title>
		<link rel="stylesheet" href='style.css?v=<?= time() ?>'></link>
	</head>
	<body>
		<h1>
			<a href="./">BEARER Docs</a><?
			if(page != "index")
			{
				?><span class="dim"> / </span><?= page_title ?><?
			}
		?>
		</h1>
		<?

		if(page == "index")
		{
			?><section class="capy-guide-index">
				<h2>Learn Capy</h2>
				<div class="capy-guide-grid"><?
				for(String target : doc_page_names())
				{
					if(target.rfind("capy-", 0) != 0)
						continue;
					DocPage guide = load_doc_page(target);
					?><div class="capy-guide-card"><? render_doc_page_link(target, first(guide.title, doc_default_title(target))); ?></div><?
				}
				?></div>
			</section>
			<div class="api-reference-heading"><h2>API Reference</h2><p>Bearer APIs available to Capy and C++ units.</p></div>
			<div class="search-bar">
				<input id="doc-search" type="search" aria-label="Search documentation" placeholder="Search documentation…" autocomplete="off" spellcheck="false"/>
				<span class="search-count" id="search-count"></span>
			</div>
			<div id="search-results" hidden></div>
			<div class="index-pane" id="index-pane">
			<div class="index-layout">
			<nav class="sidebar"><?
			for(auto file_name : ls("areas/"))
			{
				String ft = nibble(file_name, ".");
				render_see_section(ft);
			}
			?></nav>
			<main class="content">
			<h2>All APIs</h2>
			<div class="func-grid"><?
			for(auto file_name : ls("pages/"))
			{
				String ft = nibble(file_name, ".");
				String label = doc_index_label(ft);
				?><div class="func-item"><? render_doc_page_link(ft, label); ?></div><?
			}
			?></div>
			</main>
			</div>
			</div>
			<?
			<><script>
			(function () {
				var input = document.getElementById('doc-search');
				var results = document.getElementById('search-results');
				var pane = document.getElementById('index-pane');
				var counter = document.getElementById('search-count');
				var timer;
				var generation = 0;

				function showResults(html) {
					results.innerHTML = html;
					results.hidden = false;
					pane.hidden = true;
					var hits = results.querySelectorAll('.search-hit').length;
					counter.textContent = hits ? hits + ' result' + (hits > 1 ? 's' : '') : '';
				}

				function showIndex() {
					results.innerHTML = '';
					results.hidden = true;
					pane.hidden = false;
					counter.textContent = '';
				}

				input.addEventListener('input', function () {
					var q = this.value.trim();
					var requestGeneration = ++generation;
					clearTimeout(timer);
					if (q.length < 2) { showIndex(); return; }
					counter.textContent = '\u2026';
					timer = setTimeout(function () {
						fetch('search.uce?q=' + encodeURIComponent(q))
							.then(function (r) { if (!r.ok) throw new Error('search failed'); return r.text(); })
							.then(function (html) {
								if (requestGeneration === generation) showResults(html);
							})
							.catch(function () {
								if (requestGeneration === generation) counter.textContent = 'Search unavailable';
							});
					}, 220);
				});

				input.addEventListener('keydown', function (e) {
					if (e.key === 'Escape') {
						generation++;
						clearTimeout(timer);
						this.value = '';
						showIndex();
					}
				});
			})();
			</script></>
		}
		else
		{
			String detail_class = "detail-layout";
			if(page.rfind("capy-", 0) == 0)
				detail_class += " language-guide";
			if(doc_page.see_lines.size() == 0)
				detail_class += " no-sidebar";

			?><div class="<?= detail_class ?>">
			<article class="doc-detail"><?

			render_doc_signatures(doc_page);

			render_doc_params(doc_page.param_lines);

			if(trim(doc_page.content) != "")
			{
				?><div class="doc-section content"><?: markdown_to_html(doc_page.content) ?></div><?
			}

			render_doc_examples(context, page, doc_page);

			?></article><?

			if(doc_page.see_lines.size() > 0)
			{
				?><aside class="detail-sidebar">
				<div class="sidebar-card"><?
				render_doc_see_links(doc_page.see_lines);
				?></div>
				</aside><?
			}

			?></div><?
		}

		?>
	</body>
	</html></>
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "unit-render" {
        var page := dval({source_page: ""})
        page["source_page"] = "unit_render"
        page["kind"] = "api"
        page["slug"] = "unit-render"
        page["route"] = "/doc/api/unit-render/"
        page["title"] = "unit_render"
        page["content"] = "## sig\n\nfunction unit_render(name : string)\n\n`unit_render` runs a unit `RENDER` handler.\n"
        page["label"] = "unit_render"
        page["capy_sig_lines"] = dval(["function unit_render(name : string)"])
        page["param_lines"] = dval(["name : unit path", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">ob", "unit_call", "unit_load", "1_RENDER", "component"])
        page["examples"] = dval([{entry: "render", caption: "", body: "unit_render(\"/tests/capy-cross-target.capy\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

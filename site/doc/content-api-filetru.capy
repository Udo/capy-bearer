#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "file-truncate" {
        var page := dval({source_page: ""})
        page["source_page"] = "file_truncate"
        page["kind"] = "api"
        page["slug"] = "file-truncate"
        page["route"] = "/doc/api/file-truncate/"
        page["title"] = "file_truncate"
        page["content"] = "## sig\n\nfunction file_truncate(path : string, size : u64) bool\n\n`file_truncate` sets a file length. A smaller length removes trailing bytes.\n"
        page["returns"] = "`true` if Capy changes the file length. Otherwise, `false`."
        page["label"] = "file_truncate"
        page["capy_sig_lines"] = dval(["function file_truncate(path : string, size : u64) bool"])
        page["param_lines"] = dval(["path : file path", "size : new file length in bytes", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "file_put_contents(\"/tmp/doc-truncate.txt\", \"hello world\")\nif file_truncate(\"/tmp/doc-truncate.txt\", u64(5)) {\n    print(file_get_contents(\"/tmp/doc-truncate.txt\"), \"\\n\")\n}\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

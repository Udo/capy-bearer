#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "sqlite-query" {
        var page := dval({source_page: ""})
        page["source_page"] = "sqlite_query"
        page["kind"] = "api"
        page["slug"] = "sqlite-query"
        page["route"] = "/doc/api/sqlite-query/"
        page["title"] = "sqlite_query"
        page["content"] = "Use `sqlite_query` to run one SQL statement. Use `:name` placeholders with a parameter map.\n"
        page["returns"] = "Query result as `dval`."
        page["label"] = "sqlite_query"
        page["capy_sig_lines"] = dval(["function sqlite_query(handle : u64, query : string) dval", "function sqlite_query(handle : u64, query : string, params : dval) dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var db := sqlite_connect(\":memory:\")\nvar rows := sqlite_query(db, \"select :name as name\", dval({\"name\": \"Ada\"}))\nprint(rows[0][\"name\"], \"\\n\")\nsqlite_disconnect(db)\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

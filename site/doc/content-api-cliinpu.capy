#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "cli-input" {
        var page := dval({source_page: ""})
        page["source_page"] = "cli_input"
        page["kind"] = "api"
        page["slug"] = "cli-input"
        page["route"] = "/doc/api/cli-input/"
        page["title"] = "cli_input"
        page["content"] = "`cli_input()` is a C++ API. It returns a map that merges query parameters, form parameters, and JSON object fields. Later sources replace earlier fields with the same name.\n\nA JSON scalar or list is stored at `input[\"_\"]`. Use this API when C++ code needs several input values or DValue values.\n\nCapy does not expose `cli_input`. In a Capy `CLI` handler, read `request.query`, `request.form`, and `request.body` directly. A Capy handler receives exactly one copied `request : dval`.\n"
        page["returns"] = "merged CLI input values"
        page["capy_status"] = "cpp-specific"
        page["label"] = "cli_input"
        page["sig_lines"] = dval(["DValue cli_input(Request& context)", ""])
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval(["context : live C++ request context", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">ob", ">1_CLI", ">json_decode", "0_DValue", ">0_Request", "1_CLI", "cli_arg", "1_RENDER", "unit_call", "component", "component_exists"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

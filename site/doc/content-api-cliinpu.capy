#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "cli-input" {
        var page := dval({source_page: ""})
        page["source_page"] = "cli_input"
        page["kind"] = "api"
        page["slug"] = "cli-input"
        page["route"] = "/doc/api/cli-input/"
        page["title"] = "cli_input"
        page["content"] = "Capy does not provide the retired CLI input reader.\n\nIn a `CLI` handler, read `request.query`, `request.form`, and `request.body` directly. Each handler receives one copied `request : dval` value.\n"
        page["label"] = "cli_input"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">1_CLI", ">0_Request", "cli_arg", "json_decode"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "path-is-within" {
        var page := dval({source_page: ""})
        page["source_page"] = "path_is_within"
        page["kind"] = "api"
        page["slug"] = "path-is-within"
        page["route"] = "/doc/api/path-is-within/"
        page["title"] = "path_is_within"
        page["content"] = "## sig\n\nfunction path_is_within(path : string, root : string) bool\n\n`path_is_within()` resolves both paths and tests whether `root` contains `path`.\n\nBoth paths must exist. Resolution follows symbolic links and removes dot segments.\n"
        page["returns"] = "`true` when `root` contains `path`"
        page["label"] = "path_is_within"
        page["capy_sig_lines"] = dval(["function path_is_within(path : string, root : string) bool"])
        page["param_lines"] = dval(["path : the path to test", "root : the containing directory", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "path_real", "path_join"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var root := \"/tmp\"\nprint(path_is_within(\"/tmp\", root), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "f64" {
        var page := dval({source_page: ""})
        page["source_page"] = "f64"
        page["kind"] = "api"
        page["slug"] = "f64"
        page["route"] = "/doc/api/f64/"
        page["title"] = "f64"
        page["content"] = "`f64` converts a `dval` or a string to a floating-point value. The string form removes leading and trailing spaces. The value must contain a complete decimal number.\n"
        page["returns"] = "An `f64` value, or `fallback`."
        page["errors"] = "`f64` does not trap for an invalid conversion. It returns `fallback`."
        page["label"] = "f64"
        page["capy_sig_lines"] = dval(["function f64(value : dval, fallback : f64 = 0.0) f64", "function f64(value : string, fallback : f64 = 0.0) f64"])
        page["param_lines"] = dval(["value : value to convert", "fallback : value to return when conversion fails", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">types", "f64", "s64", "u64"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(f64(\" 3.5 \"), \"\\n\")\nprint(f64(\"not a number\", 9.0), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "json-decode" {
        var page := dval({source_page: ""})
        page["source_page"] = "json_decode"
        page["kind"] = "api"
        page["slug"] = "json-decode"
        page["route"] = "/doc/api/json-decode/"
        page["title"] = "json_decode"
        page["content"] = "`json_decode()` converts JSON text to a `dval` value. Objects become maps, arrays become lists, and `null` becomes `none`.\n"
        page["returns"] = "The decoded `dval` value."
        page["label"] = "json_decode"
        page["capy_sig_lines"] = dval(["function json_decode(value : string) dval"])
        page["param_lines"] = dval(["value : JSON text", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "json_encode", href: "/doc/api/json-encode/"}, {label: "dval", href: "/doc/api/dval/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "var value := json_decode(\"{\\\"name\\\":\\\"Ada\\\",\\\"tags\\\":[\\\"x\\\",\\\"y\\\"]}\")\nprint(value[\"name\"], \" has \", length(value[\"tags\"]), \" tags\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "trusted-markup" {
        var page := dval({source_page: ""})
        page["source_page"] = "trusted_markup"
        page["kind"] = "api"
        page["slug"] = "trusted-markup"
        page["route"] = "/doc/api/trusted-markup/"
        page["title"] = "trusted_markup"
        page["content"] = "## sig\n\nfunction trusted_markup(value : string) markup\n\n`trusted_markup` prevents HTML escaping for the value.\n"
        page["returns"] = "trusted markup"
        page["label"] = "trusted_markup"
        page["capy_sig_lines"] = dval(["function trusted_markup(value : string) markup"])
        page["param_lines"] = dval(["value : trusted HTML text", ""])
        page["notes"] = dval([])
        page["warnings"] = dval(["Use only HTML text that your code creates. Do not pass request, remote, or database text."])
        page["see"] = dval([">markup", "html_escape", "markdown_to_html", "component", "component_render"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(trusted_markup(\"<strong>safe</strong>\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

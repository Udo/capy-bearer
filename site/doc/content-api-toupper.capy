#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "to-upper" {
        var page := dval({source_page: ""})
        page["source_page"] = "to_upper"
        page["kind"] = "api"
        page["slug"] = "to-upper"
        page["route"] = "/doc/api/to-upper/"
        page["title"] = "to_upper"
        page["content"] = "Capy has no native `to_upper` signature. Use `upper(value)`.\n"
        page["label"] = "to_upper"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">string", "upper", "to_lower", "trim", "regex_split", "float_val", "regex_replace"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "load" {
        var page := dval({source_page: ""})
        page["source_page"] = "load"
        page["kind"] = "api"
        page["slug"] = "load"
        page["route"] = "/doc/api/load/"
        page["title"] = "load"
        page["content"] = "## sig\n\nload is not available in Capy\n\nCapy does not support `#load`. The checked Capy surface has no replacement for this directive.\n"
        page["label"] = "load"
        page["capy_sig_lines"] = dval([])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["component"])
        page["examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "split" {
        var page := dval({source_page: ""})
        page["source_page"] = "split"
        page["kind"] = "api"
        page["slug"] = "split"
        page["route"] = "/doc/api/split/"
        page["title"] = "split"
        page["content"] = "Use `split` to separate text at each delimiter.\n"
        page["returns"] = "List-shaped `dval`."
        page["label"] = "split"
        page["capy_sig_lines"] = dval(["function split(value : string, delimiter : string) dval"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(join(split(\"one,two\", \",\"), \"|\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

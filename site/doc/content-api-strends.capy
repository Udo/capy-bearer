#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "str-ends-with" {
        var page := dval({source_page: ""})
        page["source_page"] = "str_ends_with"
        page["kind"] = "api"
        page["slug"] = "str-ends-with"
        page["route"] = "/doc/api/str-ends-with/"
        page["title"] = "str_ends_with"
        page["content"] = "Use `str_ends_with` to test a string suffix.\n"
        page["returns"] = "`true` when the text ends with the suffix."
        page["label"] = "str_ends_with"
        page["capy_sig_lines"] = dval(["function str_ends_with(haystack : string, needle : string) bool"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(str_ends_with(\"index.capy\", \".capy\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

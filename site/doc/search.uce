#include "lib/doc_page.h"

void render_hit(String ft, String name, String snippet)
{
	ft = doc_canonical_page(ft);
	<><div class="search-hit">
		<a href="./?p=<?= uri_encode(ft) ?>"><?= name ?></a><?
		if(snippet != "") { ?><span class="search-snippet"><?: doc_markdown_inline(snippet) ?></span><? } ?>
	</div></>
}

void add_search_token(DValue& tokens, String value)
{
	value = to_lower(trim(value));
	if(value.length() < 2)
		return;
	if(value == "the" || value == "and" || value == "for" || value == "how" || value == "with" || value == "to" || value == "of" || value == "in")
		return;
	for(String existing : tokens)
		if(existing == value)
			return;
	tokens.push_back(value);
}

DValue search_tokens(String query)
{
	DValue tokens;
	for(String token : split_space(query))
	{
		String clean;
		for(char c : token)
		{
			if((c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '_')
				clean += c;
		}
		add_search_token(tokens, clean);
		if(clean == "strlen")
			add_search_token(tokens, "length");
		else if(clean == "count")
			add_search_token(tokens, "length");
		else if(clean == "setcookie")
			add_search_token(tokens, "response_cookie");
		else if(clean == "header")
			add_search_token(tokens, "response_header");
		else if(clean == "http_status" || clean == "status")
			add_search_token(tokens, "response_status");
		else if(clean == "json")
			add_search_token(tokens, "json_decode");
	}
	return(tokens);
}

u32 search_score(String name, String source, DValue tokens)
{
	String lower_name = to_lower(name);
	String lower_source = to_lower(source);
	u32 score = 0;
	for(String token : tokens)
	{
		bool title_hit = contains(lower_name, token);
		bool body_hit = contains(lower_source, token);
		if(title_hit)
			score += 10;
		else if(body_hit)
			score += 1;
	}
	return(score);
}

String search_snippet(String source, DValue tokens)
{
	for(auto line : split(source, "\n"))
	{
		String t = trim(line);
		if(t.length() <= 4 || t.substr(0, 1) == ":")
			continue;
		String lower = to_lower(t);
		for(String token : tokens)
		{
			if(contains(lower, token))
			{
				if(t.length() > 160)
					t = t.substr(0, 160) + "…";
				return(t);
			}
		}
	}
	return("");
}

RENDER(Request& context)
{
	String q = to_lower(trim(context.get["q"]));

	if(q.length() < 2)
	{
		return;
	}

	DValue tokens = search_tokens(q);
	if(tokens.size() == 0)
	{
		<><p class="no-results">No results for "<strong><?= q ?></strong>"</p></>
		return;
	}

	DValue hits;
	u32 max_score = 0;
	DValue documents = doc_page_names();
	documents.each([&](DValue document, String) {
		String ft = document.to_string();
		String source = doc_page_source(ft);
		String name = first(doc_page_title_from_source(source), doc_index_label(ft));
		u32 score = search_score(name, source, tokens);
		if(score == 0)
			return;
		DValue hit;
		hit["ft"] = ft;
		hit["name"] = name;
		hit["snippet"] = search_snippet(source, tokens);
		hit["score"] = std::to_string(score);
		hits.push(hit);
		if(score > max_score)
			max_score = score;
	});

	if(hits.size() == 0)
	{
		<><p class="no-results">No results for "<strong><?= q ?></strong>"</p></>
		return;
	}

	for(u32 score = max_score; score > 0; score--)
	{
		hits.each([&](DValue hit, String) {
			if(hit["score"].to_u64() == score)
				render_hit(hit["ft"].to_string(), hit["name"].to_string(), hit["snippet"].to_string());
		});
	}
}

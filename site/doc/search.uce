#include "lib/doc_page.h"

void render_hit(String ft, String name, String snippet)
{
	<><div class="search-hit">
		<a href="./?p=<?= uri_encode(ft) ?>"><?= name ?></a><?
		if(snippet != "") { ?><span class="search-snippet"><?= snippet ?></span><? } ?>
	</div></>
}

RENDER(Request& context)
{
	String q = to_lower(trim(context.get["q"]));

	if(q.length() < 2)
	{
		return;
	}

	// Collect results into two buckets: title matches first, then content-only matches
	DValue title_ft;
	DValue title_name;
	DValue title_snippet;

	DValue body_ft;
	DValue body_name;
	DValue body_snippet;

	DValue documents = doc_page_names();
	documents.each([&](DValue document, String) {
		String ft = document.to_string();
		String content = doc_page_source(ft);
		String name = first(doc_page_title_from_source(content), doc_index_label(ft));
		bool name_match = contains(to_lower(name), q);
		bool content_match = contains(to_lower(content), q);

		if(!name_match && !content_match)
			return;

		// Find first content line that contains the query for a snippet
		String snippet = "";
		if(!name_match || content_match)
		{
			for(auto line : split(content, "\n"))
			{
				String t = trim(line);
				if(t.length() > 4 && t.substr(0, 1) != ":" && contains(to_lower(t), q))
				{
					snippet = t;
					if(snippet.length() > 120)
						snippet = snippet.substr(0, 120) + "…";
					break;
				}
			}
		}

		if(name_match)
		{
			title_ft.push_back(ft);
			title_name.push_back(name);
			title_snippet.push_back(snippet);
		}
		else
		{
			body_ft.push_back(ft);
			body_name.push_back(name);
			body_snippet.push_back(snippet);
		}
	});

	u32 count = title_ft.size() + body_ft.size();

	if(count == 0)
	{
		<><p class="no-results">No results for "<strong><?= q ?></strong>"</p></>
		return;
	}

	for(u32 i = 0; i < title_ft.size(); i++)
		render_hit(title_ft[i], title_name[i], title_snippet[i]);

	for(u32 i = 0; i < body_ft.size(); i++)
		render_hit(body_ft[i], body_name[i], body_snippet[i]);
}

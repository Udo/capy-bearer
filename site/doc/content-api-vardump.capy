#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "var-dump" {
        var page := dval({source_page: ""})
        page["source_page"] = "var_dump"
        page["kind"] = "api"
        page["slug"] = "var-dump"
        page["route"] = "/doc/api/var-dump/"
        page["title"] = "var_dump"
        page["content"] = "## sig\n\nfunction var_dump(value : dval, prefix : string = \"\", postfix : string = \"\") string\n\n`var_dump` formats a `dval` as a string.\n"
        page["returns"] = "formatted string"
        page["label"] = "var_dump"
        page["capy_sig_lines"] = dval(["function var_dump(value : dval, prefix : string = \"\", postfix : string = \"\") string"])
        page["param_lines"] = dval(["value : value to format", "prefix : text before the formatted value", "postfix : text after the formatted value", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">types", "0_DValue", "json_encode", "print"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(var_dump(dval({\"name\": \"Ada\"})), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

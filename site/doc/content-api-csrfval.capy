#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "csrf-valid" {
        var page := dval({source_page: ""})
        page["source_page"] = "csrf_valid"
        page["kind"] = "api"
        page["slug"] = "csrf-valid"
        page["route"] = "/doc/api/csrf-valid/"
        page["title"] = "csrf_valid"
        page["content"] = "`csrf_valid()` checks a submitted CSRF token against the session token.\n\nIt does not create a missing token. Check the token before you apply a browser-submitted change.\n"
        page["returns"] = "`true` if `submitted` matches the active session token."
        page["label"] = "csrf_valid"
        page["capy_sig_lines"] = dval(["function csrf_valid(submitted : string, session_name : string = \"bearer-session\", token_name : string = \"csrf_token\") bool"])
        page["param_lines"] = dval(["submitted : the value from the submitted form", "session_name : the session and cookie name", "token_name : the token namespace", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "csrf_token", href: "/doc/api/csrf-token/"}, {label: "csrf_field", href: "/doc/api/csrf-field/"}, {label: "csrf_rotate", href: "/doc/api/csrf-rotate/"}, {label: "crypto_equal", href: "/doc/api/crypto-equal/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "var token := csrf_token(\"capy-doc-session\")\nprint(csrf_valid(token, \"capy-doc-session\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

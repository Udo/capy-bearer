#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "expand-path" {
        var page := dval({source_page: ""})
        page["source_page"] = "expand_path"
        page["kind"] = "api"
        page["slug"] = "expand-path"
        page["route"] = "/doc/api/expand-path/"
        page["title"] = "expand_path"
        page["content"] = "## sig\n\nfunction expand_path(path : string, relative_to_path : string = \"\") string\n\n`expand_path()` returns an expanded path string.\n\nPass a path and an optional base directory. It resolves a relative path against the base directory.\n\nWithout a base directory, it uses the current unit directory.\n\nUse the returned path with file APIs.\n"
        page["returns"] = "expanded path"
        page["label"] = "expand_path"
        page["capy_sig_lines"] = dval(["function expand_path(path : string, relative_to_path : string = \"\") string"])
        page["param_lines"] = dval(["path : path to expand", "relative_to_path : base directory for a relative path", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">sys", "path_join", "path_real", "dirname", "file_append", "basename", "file_exists"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(expand_path(\"sub/page.capy\", \"/var/www/site\"), \"\\n\")"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

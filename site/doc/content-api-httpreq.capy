#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "http-request-async" {
        var page := dval({source_page: ""})
        page["source_page"] = "http_request_async"
        page["kind"] = "api"
        page["slug"] = "http-request-async"
        page["route"] = "/doc/api/http-request-async/"
        page["title"] = "http_request_async"
        page["content"] = "`http_request_async()` starts an outbound request and returns its job ID. Use `job_await()` or `job_result()` to get the response map.\n\nThe request map follows the `http_request()` rules.\n"
        page["returns"] = "A job ID."
        page["label"] = "http_request_async"
        page["capy_sig_lines"] = dval(["function http_request_async(request : dval) u64"])
        page["param_lines"] = dval(["request : a map that describes an outbound request", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["http_request", "job_await", "job_result"])
        page["examples"] = dval([{entry: "render", caption: "", body: "var outbound := dval({\"method\": \"GET\", \"url\": \"http://127.0.0.1/tests/capy-render.capy\", \"headers\": {\"Host\": \"bearer.openfu.com\"}, \"timeout_ms\": 2000})\nvar job := http_request_async(outbound)\nvar done := job_await(dval(job), 3000)\nprint(s32(dval_get_by_path(done, \"result/status\")), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    if slug == "http-request" {
        var page := dval({source_page: ""})
        page["source_page"] = "http_request"
        page["kind"] = "api"
        page["slug"] = "http-request"
        page["route"] = "/doc/api/http-request/"
        page["title"] = "http_request"
        page["content"] = "`http_request()` sends an outbound HTTP or HTTPS request. Set `method`, `url`, `headers`, `body`, `timeout_ms`, and `follow_redirects` as needed.\n\nWhen you set a `security` field, set `https_only`, `public_dns_only`, `pin_dns`, `isolated_curl`, and `no_redirects` to `true`.\n"
        page["returns"] = "A map with `status`, `headers`, `body`, and `error`."
        page["errors"] = "The result can report `invalid_request`, `unsafe_dns`, `timeout`, `response_too_large`, `redirect_not_allowed`, `http_status`, or `network_failure`."
        page["label"] = "http_request"
        page["capy_sig_lines"] = dval(["function http_request(request : dval) dval"])
        page["param_lines"] = dval(["request : a map that describes an outbound request", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["http_request_async"])
        page["examples"] = dval([{entry: "cli", caption: "", body: "var outbound := dval({\"method\": \"GET\", \"url\": \"http://127.0.0.1/tests/capy-render.capy\", \"headers\": {\"Host\": \"bearer.openfu.com\"}, \"timeout_ms\": 2000})\nvar response := http_request(outbound)\nprint(\"status=\", s32(response[\"status\"]), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

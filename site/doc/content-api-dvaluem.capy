#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-map" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_map"
        page["kind"] = "api"
        page["slug"] = "dvalue-map"
        page["route"] = "/doc/api/dvalue-map/"
        page["title"] = "Map a dynamic value"
        page["content"] = "## sig\n\nfunction dval_map(value : dval, mapper : function(value : dval, key : string) dval) dval\n\n`dval_map` calls `mapper` for each child. It keeps map keys and list shape.\n"
        page["returns"] = "A new mapped value."
        page["label"] = "dval_map"
        page["capy_sig_lines"] = dval(["function dval_map(value : dval, mapper : function(value : dval, key : string) dval) dval"])
        page["param_lines"] = dval(["value : source value", "mapper : function that replaces each child", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var names := dval([\"ada\", \"grace\"])\nvar result := dval_map(names, function(item : dval, key : string) dval { return dval(upper(string(item))) })\nprint(result[0], \",\", result[1], \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

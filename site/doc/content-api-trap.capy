#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "trap" {
        var page := dval({source_page: ""})
        page["source_page"] = "trap"
        page["kind"] = "api"
        page["slug"] = "trap"
        page["route"] = "/doc/api/trap/"
        page["title"] = "trap"
        page["content"] = "## sig\n\nfunction trap()\n\n`trap` stops the current handler.\n"
        page["returns"] = "no value because execution stops"
        page["errors"] = "`trap` always aborts execution."
        page["label"] = "trap"
        page["capy_sig_lines"] = dval(["function trap()"])
        page["param_lines"] = dval([])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">runtime", "error_pages", "unit_render", "unit_compile"])
        page["examples"] = dval([{entry: "render", caption: "", body: "if false { trap() }\nprint(\"handler continues\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

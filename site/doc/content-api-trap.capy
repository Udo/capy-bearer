#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "trap" {
        var page := dval({source_page: ""})
        page["source_page"] = "trap"
        page["kind"] = "api"
        page["slug"] = "trap"
        page["route"] = "/doc/api/trap/"
        page["title"] = "trap"
        page["content"] = "Use `trap()` to stop the current handler immediately after a failed guard.\n\n`trap()` has no arguments and no usable return value. Any reachable code after the call does not run.\n\nThe example keeps the condition false so the documentation page can render.\n"
        page["returns"] = "no value because execution stops"
        page["errors"] = "`trap()` always aborts execution when called. Calling it with arguments is a compile-time error."
        page["example_error"] = "expected contiguous :example cpp render"
        page["label"] = "trap"
        page["sig_lines"] = dval(["void trap()", ""])
        page["capy_sig_lines"] = dval(["function trap()"])
        page["param_lines"] = dval(["none", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([">runtime", "error_pages", "unit_render", "unit_compile"])
        page["example_pairs"] = dval([])
        page["cpp_only_examples"] = dval([])
        page["legacy_examples"] = dval([])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

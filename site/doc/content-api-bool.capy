#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "bool" {
        var page := dval({source_page: ""})
        page["source_page"] = "bool"
        page["kind"] = "api"
        page["slug"] = "bool"
        page["route"] = "/doc/api/bool/"
        page["title"] = "bool"
        page["content"] = "## sig\n\nfunction bool(value : dval, fallback : bool = false) bool\nfunction bool(value : string, fallback : bool = false) bool\n\n`bool` converts a `dval` or string to a Boolean value.\n\nFor strings, it ignores outer whitespace and accepts case-insensitive Boolean text. It returns `fallback` when conversion fails.\n"
        page["returns"] = "a Boolean value"
        page["label"] = "bool"
        page["capy_sig_lines"] = dval(["function bool(value : dval, fallback : bool = false) bool", "function bool(value : string, fallback : bool = false) bool"])
        page["param_lines"] = dval(["value : value to convert", "fallback : value to return when conversion fails", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval(["string"])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(bool(\"YES\"), \"\\n\")\nprint(bool(\"unknown\", true), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "dvalue-each" {
        var page := dval({source_page: ""})
        page["source_page"] = "2_DValue_each"
        page["kind"] = "api"
        page["slug"] = "dvalue-each"
        page["route"] = "/doc/api/dvalue-each/"
        page["title"] = "Iterate dynamic values"
        page["content"] = "Use `for value, key := input` to iterate a dynamic value. `value` is a copied child and `key` is a string.\n\nLists use numeric keys in order. Maps use key order. A scalar runs the loop once with an empty key.\n"
        page["label"] = "dval_each"
        page["capy_sig_lines"] = dval(["for value, key := input { ... }"])
        page["param_lines"] = dval(["input : value to iterate", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([])
        page["examples"] = dval([{entry: "render", caption: "", body: "var value := dval({\"name\": \"Ada\", \"role\": \"admin\"})\nfor item, key := value {\n    print(key, \"=\", item, \"\\n\")\n}\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

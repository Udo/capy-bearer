#exports data

function data(input : dval) dval {
    var slug := string(input.slug, "")
    if slug == "join" {
        var page := dval({source_page: ""})
        page["source_page"] = "join"
        page["kind"] = "api"
        page["slug"] = "join"
        page["route"] = "/doc/api/join/"
        page["title"] = "join"
        page["content"] = "`join()` reads each list value as text. It uses a newline when you omit the delimiter.\n"
        page["returns"] = "One string with the values separated by `delimiter`."
        page["label"] = "join"
        page["capy_sig_lines"] = dval(["function join(items : dval, delimiter : string = \"\\n\") string"])
        page["param_lines"] = dval(["items : a `dval` list", "delimiter : text between values", ""])
        page["notes"] = dval([])
        page["warnings"] = dval([])
        page["see"] = dval([{label: "split", href: "/doc/api/split/"}, {label: "json_encode", href: "/doc/api/json-encode/"}, {label: "map", href: "/doc/api/map/"}])
        page["examples"] = dval([{entry: "render", caption: "", body: "print(join(split(\"a,b,c\", \",\"), \"-\"), \"\\n\")\n"}])
        page["guide_examples"] = dval([])
        return page
    }
    return dval({source_page: "", kind: "", slug: "", title: "Page not found", label: "Page not found", content: ""})
}

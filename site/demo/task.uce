#include "demo_guard.h"

RENDER(Request& context)
{
	if(!test_demo_request_allowed(context))
	{
		test_demo_render_restricted_html(context, "Tasks", "enqueue named background tasks");
		return;
	}
	String id = context.get["id"];
	if(context.get["cmd"] == "Execute")
	{
		DValue props; props["nested"]["value"] = "demo";
		id = task("/tests/task-handlers.uce", props);
	}
	<><h1>Tasks</h1><form action="?"><input type="submit" name="cmd" value="Execute"/></form><pre><? print("Task ID: ", id, "\n"); if(id.size() == 64) print(var_dump(task_status(id))); ?></pre></>;
}

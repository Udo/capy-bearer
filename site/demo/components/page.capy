function COMPONENT(request : dval) {
    var title := string(request.props.title, {fallback: "Demo"})
    var heading := string(request.props.heading, {fallback: title})
    var body := string(request.props.body, {fallback: "This included demo route runs from native Capy."})
    request.out.headers["Content-Type"] = "text/html; charset=utf-8"
    print("<!doctype html>")
    print(<>
        <html>
            <head>
                <title><?= title ?></title>
                <link rel="stylesheet" href="/demo/style.css"></link>
            </head>
            <body>
                <main>
                    <h1><?= heading ?></h1>
                    <p><?= body ?></p>
    </>)
    if request.props.links? {
        print(<><ul></>)
        for link := request.props.links {
            var href := string(link.href)
            var label := string(link.label, {fallback: href})
            print(<><li><a href="<?= href ?>"><?= label ?></a></li></>)
        }
        print(<></ul></>)
    }
    print(<>
                </main>
            </body>
        </html>
    </>)
}

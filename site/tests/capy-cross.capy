function COMPONENT(request : dval) {
    print("capy-component-ok")
}

function COMPONENT:CARD(request : dval) {
    print("capy-named-ok")
}

function CLI(request : dval) {
    unit_render("/tests/capy-cross-target.capy")
    print("|")
    {
        var result := unit_call("/tests/capy-cross-target.capy", "echo", "roundtrip")
        var copy := result
        result = dval("other")
        var counted_result := unit_call("/tests/capy-cross-target.capy", "counted", "")
        print(copy, result, "|", counted_result, "|", arc_live(), "|")
    }
    print(arc_live())
}

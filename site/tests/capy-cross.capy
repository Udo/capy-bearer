function COMPONENT {
    print("capy-component-ok")
}

function COMPONENT:CARD {
    print("capy-named-ok")
}

function CLI {
    unit_render("/tests/capy-cross-target.uce")
    print("|")
    {
        var result := unit_call("/tests/capy-cross-target.uce", "echo", "roundtrip")
        var copy := result
        result = dval("other")
        var counted_result := unit_call("/tests/capy-cross-target.uce", "counted", "")
        print(copy, result, "|", counted_result, "|", arc_live(), "|")
    }
    print(arc_live())
}

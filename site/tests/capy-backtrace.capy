function outer() string {
    inner()
}
function inner() string {
    var capture := function() string {
        backtrace_get_frames(4, 0) + "\n==\n" + backtrace_get_frames(2, 1)
    }
    capture()
}
function trace_live() s32 {
    outer()
    arc_live()
}
function explicit_return_trace() string {
    return backtrace_get_frames(4, 0)
}
function bounds() string {
    var none := backtrace_get_frames(-1, 0)
    var clamped := backtrace_get_frames(2147483647, 0)
    var skipped := backtrace_get_frames(2147483647, 2147483647)
    var negative_skip := backtrace_get_frames(2, -1)
    none + "|" + clamped + "|" + skipped + "|" + negative_skip
}
function CLI {
    if true {
        var nested := outer()
        print(nested)
    }
    print("\n--\n", backtrace_get_frames(0, 0), "|", trace_live())
    print("\n++\n", explicit_return_trace(), "\n~~\n", backtrace_get_frames(), "\n@@\n", bounds())
}

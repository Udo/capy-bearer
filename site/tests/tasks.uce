#include "testlib.h"

TASK(Request& context)
{
	DValue nested = context.props["nested"];
	file_put_contents("/tmp/bearer-site-task-worker.txt", nested["value"].to_string());
}

RENDER(Request& context)
{
	if(!test_demo_request_allowed(context))
	{
		site_tests_restricted(context, "Tasks", "enqueue and inspect named task workers");
		return;
	}
	u64 passed = 0, failed = 0, skipped = 0;
	auto check = [&](String name, bool ok, String detail) { site_tests_case(name, ok ? "pass" : "fail", detail); if(ok) passed++; else failed++; };
	for(String path : {"/tmp/bearer-site-task-worker.txt", "/tmp/bearer-task-cpp.txt", "/tmp/bearer-task-cpp-named.txt", "/tmp/bearer-task-capy.txt", "/tmp/bearer-task-capy-named.txt"})
		file_unlink(path);
	DValue props;
	props["nested"]["value"] = "copied-props";
	String self_id = task("/tests/tasks.uce", props);
	String cpp_id = task("/tests/task-handlers.uce", props);
	String cpp_named_id = task("/tests/task-handlers.uce:CPP", props);
	String capy_id = task("/tests/task-handlers.capy", props);
	String capy_named_id = task("/tests/task-handlers.capy:CAPY", props);
	DValue self_done = task_await(self_id, 10000);
	DValue cpp_done = task_await(cpp_id, 10000);
	DValue cpp_named_done = task_await(cpp_named_id, 10000);
	DValue capy_done = task_await(capy_id, 10000);
	DValue capy_named_done = task_await(capy_named_id, 10000);
	String cancel_id = task("/tests/task-handlers.capy", props);
	DValue cancelled = task_cancel(cancel_id);
	DValue cancel_done = task_await(cancel_id, 10000);
	site_tests_page_start("Tasks", "Named task admission carries only copied props and exposes opaque IDs.");
	check("exact opaque task ID", self_id.size() == 64, "id=" + self_id);
	check("C++ caller to current C++ TASK", self_done["state"].to_string() == "succeeded" && file_get_contents("/tmp/bearer-site-task-worker.txt") == "copied-props", "state=" + self_done["state"].to_string());
	check("C++ caller to C++ default/named TASK", cpp_done["state"].to_string() == "succeeded" && cpp_named_done["state"].to_string() == "succeeded" && file_get_contents("/tmp/bearer-task-cpp.txt") == "copied-props" && file_get_contents("/tmp/bearer-task-cpp-named.txt") == "copied-props", "default=" + cpp_done["state"].to_string() + " named=" + cpp_named_done["state"].to_string());
	check("C++ caller to Capy default/named TASK", capy_done["state"].to_string() == "succeeded" && capy_named_done["state"].to_string() == "succeeded" && file_get_contents("/tmp/bearer-task-capy.txt") == "copied-props" && file_get_contents("/tmp/bearer-task-capy-named.txt") == "copied-props", "default=" + capy_done["state"].to_string() + " named=" + capy_named_done["state"].to_string());
	check("queued/running cancellation", cancelled["id"].to_string() == cancel_id && (cancel_done["state"].to_string() == "canceled" || cancel_done["state"].to_string() == "succeeded"), "state=" + cancel_done["state"].to_string());
	site_tests_summary(passed, failed, skipped, "The dedicated pool executes TASK handlers with context.props only.");
	site_tests_page_end();
}

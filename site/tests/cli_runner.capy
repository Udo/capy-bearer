function CLI(request : dval) {
    request.out.headers["Content-Type"] = "text/plain; charset=utf-8"
    var action := string(request.query.action, {fallback: "run"})
    if action == "list" {
        print("native\n")
        return
    }
    var group := string(request.query.group)
    if group != "" && group != "native" {
        print("[FAIL] bearer_cli_runner: groups run in scripts/run_cli_tests.sh\n")
        trap()
    }
    print("[PASS] bearer_cli_runner:native - native Capy CLI runner is reachable\n")
    print("[GROUP] native 0 ms\n\nSummary: 1 passed, 0 failed, 0 skipped\n")
}

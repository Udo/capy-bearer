struct Named {
    name : string
}

struct TextPair {
    number : s32
    text : string
}

struct NestedPair {
    inner : TextPair
    outer : string
}

struct PairBox {
    value : TextPair
}

function add(left : s32, right : s32) s32 {
    -> left + right
}

function subtract(left : s32, right : s32) s32 {
    -> left - right
}

function identity(value : any) value::type {
    -> value
}

function choose(value : any) value::type {
    -> value
}

function choose(value : s32) value::type {
    -> value + 1
}

function same(first : any, second : first::type) first::type {
    -> second
}

function make_pair TextPair {
    -> TextPair(9, clone("pair"))
}

function nested_pair NestedPair {
    -> NestedPair(TextPair(1, clone("inner")), clone("outer"))
}

function pair_label(value : TextPair) string {
    -> value.text
}

function countdown(value : any) value::type {
    if value == 0 {
        return value
    }
    return countdown(value - 1)
}

function CLI(request : dval) {
    {
        var dependent := same(clone("first"), clone("second"))
        print(dependent, "|", arc_live(), "|")
    }
    print(arc_live(), "|")
    print(identity(7), "|", identity(clone("generic")), "|")
    print(choose(4), "|", choose(clone("fallback")), "|")
    print(identity([1, 2])[1], "|", identity(Named(clone("name"))).name, "|")
    {
        var result := make_pair()
        print(result.number, result.text, "|", arc_live(), "|")
    }
    print(identity(make_pair()).text, "|", arc_live(), "|")
    print(pair_label(make_pair()), "|", arc_live(), "|")
    {
        var boxed := PairBox(make_pair())
        print(boxed.value.text, "|", arc_live(), "|")
    }
    {
        var nested_result := nested_pair()
        print(nested_result.inner.text, nested_result.outer, "|", arc_live(), "|")
    }
    print(Named(clone("temporary")).name, "|", arc_live(), "|")
    print(TextPair(1, clone("nested")).text, "|", arc_live(), "|")
    var operation := add
    var labeler := pair_label
    print(operation(2, 3))
    operation = subtract
    print(operation(2, 3), labeler(make_pair()), "|", arc_live(), "|")
    print(countdown(3), "|", bool(0), bool(2), s32(true), "|", arc_live())
}

function CLI {
    {
        var path := file_temp("/tmp/capy-final-parity-")
        var handle := file_open(path, "r+")
        file_write(handle, "hello")
        var pwrite := file_pwrite(handle, u64(2), "XYZ")
        var pread := file_pread(handle, u64(0), u64(5))
        var kv := split_kv(" name = Ada\nrole=admin", "=", true, true)
        var packed := gz_compress("archive data")
        var unpacked := gz_uncompress(packed)
        var archive := path + ".zip"
        var destination := path + ".out"
        var created := zip_create(archive, dval({"hello.txt": "Hello ZIP", "nested/value.txt": "42"}))
        var listed := zip_list(archive)
        var extracted := zip_extract(archive, destination)
        var content := zip_read(archive, "hello.txt")
        print(pwrite, "|", pread, "|", kv["NAME"], ":", kv["ROLE"], "|", unpacked, "|", created, s32(listed["count"]), extracted, content == "Hello ZIP", file_get_contents(destination + "/nested/value.txt") == "42", "|", arc_live())
        file_close(handle)
        file_unlink(path)
        file_unlink(archive)
        dir_remove(destination, true)
    }
    print("|", arc_live(), "|", length(file_pread(u64(0), u64(0), u64(1))) == 0)
}

function exercise {
    {
        var digest := sha256("abc")
        var encoded := password_hash("correct horse")
        var random := random_bytes(u64(16))
        var noise32 := gen_noise32(u64(1), u64(2))
        var noise64 := gen_noise64(u64(1), u64(2))
        var noise01 := gen_noise01(u64(1), u64(2))
        var integer := gen_int(u64(7), u64(7), u64(10))
        var floating := gen_float(1.0, 0.0, u64(1))
        var drawn_int := draw_int(u64(1), u64(10))
        var drawn_float := draw_float(0.0, 1.0)
        print(hex(gen_sha1("abc")), "|", length(gen_sha1("abc")), "|", length(digest), "|", hex(digest), "|", length(hmac_sha256("key", "message")), "|", hex(hmac_sha256("key", "message")), "|", hex("ABC"), "|", crypto_equal(digest, sha256("abc")), crypto_equal(digest, "bad"), "|", length(random), "|", password_verify("correct horse", encoded), password_verify("wrong", encoded), "|", noise32, "|", noise64, "|", noise01 >= 0.0, "|", integer, "|", floating >= 0.0, "|", drawn_int >= u64(1), "|", drawn_float >= 0.0, "|", arc_live())
    }
    print("|", arc_live())
}
function CLI(request : dval) { exercise() }
function RENDER(request : dval) { exercise() }

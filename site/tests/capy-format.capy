function require(value : bool) {
    if !value { trap() }
}
function require_roundtrip(value : f64) {
    require(bits_of(f64(string(value))) == bits_of(value))
}

function CLI(request : dval) {
    var signed8 : s8 = -128
    var signed16 : s16 = -32768
    var signed32 : s32 = -2147483648
    var signed64 : s64 = -9223372036854775808
    var unsigned8 : u8 = 255
    var unsigned16 : u16 = 65535
    var unsigned32 : u32 = 4294967295
    var unsigned64 : u64 = 18446744073709551615
    require(string(signed8) == "-128")
    require(string(signed16) == "-32768")
    require(string(signed32) == "-2147483648")
    require(string(signed64) == "-9223372036854775808")
    require(string(unsigned8) == "255")
    require(string(unsigned16) == "65535")
    require(string(unsigned32) == "4294967295")
    require(string(unsigned64) == "18446744073709551615")
    require(string(s64(0)) == "0")
    require(string(s64(-7)) == "-7")
    var live_before := arc_live()
    for i := 0..100 { var rendered := string(s64(i)) }
    require(arc_live() == live_before)
    require(string(0.1 + 0.2) == "0.30000000000000004")
    require(string(1.9) == "1.8999999999999999")
    require(u64(string(unsigned64)) == unsigned64)
    require(s64(string(signed64)) == signed64)
    require_roundtrip(0.1 + 0.2)
    require_roundtrip(f64(unsigned64))
    require_roundtrip(f64(signed64))
    require_roundtrip(1.9)
    require(string(1e20) == "1e+20")
    require(string(1e-6) == "9.9999999999999995e-07")
    require(string(-0.0) == "-0")
    require(string(f64_from_bits(1)) == "4.9406564584124654e-324")
    require(string(f64_from_bits(9218868437227405311)) == "1.7976931348623157e+308")
    require(string(f64_from_bits(9218868437227405312)) == "inf")
    require(string(f64_from_bits(18442240474082181120)) == "-inf")
    require(string(f64_from_bits(9221120237041090561)) == "nan")
    require(string(f64_from_bits(18444492273895866369)) == "-nan")
    require(string(f64_from_bits(4503599627370495)) == "2.2250738585072009e-308")
    require(string(f64_from_bits(4503599627370496)) == "2.2250738585072014e-308")
    var sample : u64 = 88172645463325252
    for i := 0..20 {
        sample = sample * u64(2862933555777941757) + u64(3037000493)
        var candidate := f64_from_bits(sample)
        if is_finite(candidate) { require_roundtrip(candidate) }
    }
    print("capy-format-ok\n")
}

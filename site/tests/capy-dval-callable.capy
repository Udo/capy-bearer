function plus_one(value : s32) s32 { -> value + 1 }

function CLI(request : dval) {
    var baseline := arc_live()
    {
        var captured := s32(10)
        var values := {map: {named: plus_one, closure: function(value : s32) s32 { -> value + captured }}, list: [plus_one, {closure: function(value : s32) s32 { -> value + captured }}]}
        var named : function(value : s32) s32 = values.map.named
        var closure : function(value : s32) s32 = values.map.closure
        var item : function(value : s32) s32 = values.list[0]
        var nested : function(value : s32) s32 = values.list[1].closure
        var public := brb_decode(brb_encode(values))
        print(named(2), ":", closure(2), ":", item(2), ":", nested(2), "|", json_encode(values), "|", yaml_encode(values), "|", xml_encode(values), "|", has(public.map, "named"), has(public.map, "closure"), public.map.named?, public.map.closure?, public.list[0]?, public.list[1].closure?, "|", length(public.map), ":", length(public.list), ":", length(public.list[1]))
    }
    print("|", arc_live() == baseline)
    {
        var captured := s32(20)
        var value := {slot: function(item : s32) s32 { -> item + captured }}
        value.slot = plus_one
    }
    print("|", arc_live() == baseline)
    {
        var captured := s32(30)
        var value := {slot: function(item : s32) s32 { -> item + captured }}
        delete(value, "slot")
    }
    print("|", arc_live() == baseline)
    {
        var captured := s32(40)
        var value := {slot: function(item : s32) s32 { -> item + captured }}
        clear(value)
    }
    print("|", arc_live() == baseline)
    {
        var captured := s32(50)
        var value := {slot: function(item : s32) s32 { -> item + captured }}
        var copy := value
        copy.slot = plus_one
    }
    print("|", arc_live() == baseline)
}

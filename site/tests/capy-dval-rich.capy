function EXPORT_enrich (input : dval) dval {
    print("custom-once;")
    input.export_mutation = "child"
    return dval({"input": input, "language": "capy", "items": [1, 2, 3]})
}

function CLI(request : dval) {
    {
        var child := unit_call("/tests/capy-cross-target.capy", "structured", {"user": {"name": "Ada"}, "items": [4, 9]})
        print(child["source"], "|", child["name"], "|", s32(child["second"]), "|")
        var capy_input := {"origin": "capy"}
        var capy := unit_call("/tests/capy-dval-rich.capy", "enrich", capy_input)
        print(capy["language"], "|", capy["input"]["origin"], "|", has(capy_input, "export_mutation"), "|")
        var profile := dval({
            "name": "Ada",
            "age": 42,
            "active": true,
            "tags": ["math", "logic"]
        })
        print(
            profile["name"], "|",
            s32(profile["age"]), "|",
            bool(profile["active"]), "|",
            profile["tags"][1], "|",
            has(profile, "name"), has(profile, "missing"), "|",
            arc_live(), "|"
        )
        for value, key := profile {
            print(key, ";")
        }
        print("|")
        for value, key := profile["tags"] {
            print(key, "=", value, ";")
        }
        print("|")
        for value, key := dval([1, 2, 3]) {
            if s32(value) == 1 {
                continue
            }
            print(s32(value), ";")
            if s32(value) == 2 {
                break
            }
        }
        print("|", arc_live(), "|")
    }
    print(arc_live(), "|")
    {
        var empty_map := dval({:})
        var empty_list := dval([])
        print(has(empty_map, "missing"), has(empty_list, 0), "|")
        for value, key := empty_map {
            print("unexpected-map")
        }
        for value, key := empty_list {
            print("unexpected-list")
        }
        print(arc_live(), "|")
    }
    print(arc_live())
}

function EXPORT_enrich (input : dval) dval {
    print("custom-once;")
    return dval({"input": input, "language": "capy", "items": [1, 2, 3]})
}

function CLI {
    {
        var cpp := unit_call("/tests/capy-cross-target.uce", "structured", {"user": {"name": "Ada"}, "items": [4, 9]})
        print(cpp["source"], "|", cpp["name"], "|", s32(cpp["second"]), "|")
        var capy := unit_call("/tests/capy-dval-rich.capy", "enrich", {"origin": "capy"})
        print(capy["language"], "|", capy["input"]["origin"], "|")
        var profile := dval({
            "name": "Ada",
            "age": 42,
            "active": true,
            "tags": ["math", "logic"]
        })
        print(
            profile["name"], "|",
            s32(profile["age"]), "|",
            bool(profile["active"]), "|",
            profile["tags"][1], "|",
            dval_has(profile, "name"), dval_has(profile, "missing"), "|",
            arc_live(), "|"
        )
        for key, value = profile {
            print(key, ";")
        }
        print("|")
        for key, value = profile["tags"] {
            print(key, "=", value, ";")
        }
        print("|")
        for key, value = dval([1, 2, 3]) {
            if s32(value) == 1 {
                continue
            }
            print(s32(value), ";")
            if s32(value) == 2 {
                break
            }
        }
        print("|", arc_live(), "|")
    }
    print(arc_live(), "|")
    {
        var empty_map := dval({:})
        var empty_list := dval([])
        print(dval_has(empty_map, "missing"), dval_has(empty_list, 0), "|")
        for key, value = empty_map {
            print("unexpected-map")
        }
        for key, value = empty_list {
            print("unexpected-list")
        }
        print(arc_live(), "|")
    }
    print(arc_live())
}

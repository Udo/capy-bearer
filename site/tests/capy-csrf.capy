function RENDER(request : dval) {
    var action := string(request.query.action)
    var token := csrf_token("capy-csrf", "token")
    if action == "token" {
        print(token)
    } else {
        if action == "field" {
            print(csrf_field("capy-csrf", "token", "submitted"))
        } else {
            if action == "rotate" {
                csrf_rotate("capy-csrf", "token")
                print(csrf_token("capy-csrf", "token"))
            } else {
                print(csrf_valid(string(request.query.submitted), "capy-csrf", "token"))
            }
        }
    }
}

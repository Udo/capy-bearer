function CLI(request : dval) {
    {
        var path := file_temp("/tmp/capy-files-phase-")
        var handle := file_open(path, "r+")
        var written := file_write(handle, "capy!")
        var seeked := file_seek(handle, s64(0), s64(0))
        var content := file_read(handle, u64(5))
        var position := file_tell(handle)
        var synced := file_fsync(handle)
        file_close(handle)
        file_unlink(path)
        print(handle != u64(0), "|", written, "|", seeked, "|", content, "|", position, "|", synced, "|", arc_live())
    }
    print("|", arc_live(), "|", file_open("/definitely-not-a-capy-file", "r") == u64(0), "|", length(file_read(u64(0), u64(1))) == 0)
}

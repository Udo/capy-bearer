function contextual_value() string {
    print("once;")
    return clone("<once>")
}

function context_page() markup {
    var value := clone("</script><style>&\"'\\\n  ")
    return <><?= contextual_value() ?><p title="<?= value ?>" href="<?= value ?>" onclick="<?= value ?>" style="<?= value ?>"><?= value ?></p><script>const value = <?= value ?>; const count = <?= 7 ?>;</script><style>.x::before { content: <?= value ?>; width: <?= 7 ?>px; }</style></>
}

function CLI(request : dval) {
    print(context_page(), "|", arc_live())
}

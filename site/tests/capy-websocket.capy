function WS(request : dval) {
    var connection := string(request.websocket.connection_id, "")
    var scope := string(request.websocket.scope, "")
    var ids := request.websocket.connections
    if length(connection) > 0 && length(ids) > 0 && string(ids[0]) == connection {
        if s32(request.websocket.opcode, 0) == 1 && !bool(request.websocket.binary, false) {
            ws_send("echo:" + string(request.body, ""), false, scope)
            ws_send_to(connection, "direct:" + string(request.body, ""), false)
            ws_close()
        } else {
            if s32(request.websocket.opcode, 0) == 2 && bool(request.websocket.binary, false) {
                ws_send(string(request.body, ""), true, scope)
                ws_close()
            }
        }
    }
}

function RENDER {
    response_status(201)
    response_header("X-Capy-Context", "yes")
    response_header("X-Capy-Clean", "first\r\nX-Injected: bad")
    print(request_param("REQUEST_METHOD"), "|", request_get("name"), "|", request_post("answer"), "|", request_body(), "|", arc_live())
}

function COMPONENT {
    var request := request_context()
    print(request["props"]["name"], "|", request["props"]["missing"]?, "|", arc_live())
}

function COMPONENT:SCALAR {
    print(request_context().props)
}

function COMPONENT:TRAP {
    print("must-not-leak")
    trap()
}

function COMPONENT:HANDLE (request : request) {
    var snapshot := request_context(request)
    if length(string(snapshot["current_unit"])) > 0 {
        print("handle|", arc_live())
    }
}

function RENDER {
    var props := dval({"name": "Capy"})
    var known := units_list()
    print(component("/tests/capy-request-context.capy", props), "|")
    component_render("/tests/capy-request-context.capy", props)
    print("|", dval_string(unit_call("/tests/capy-cross-target.uce", "echo", dval("unit"))), "|", dval_string(known[0]) != "")
}

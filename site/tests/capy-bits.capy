function require(value : bool) {
    if !value { trap() }
}

function CLI(request : dval) {
    var s8_value : s8 = -86
    var s16_value : s16 = -21846
    var s32_value : s32 = -1431655766
    var s64_value : s64 = -6148914691236517206
    var u8_value : u8 = 129
    var u16_value : u16 = 32769
    var u32_value : u32 = 2147483649
    var u64_value : u64 = 9223372036854775809

    require(bit_and(s8_value, s8(15)) == 10)
    require(bit_and(s16_value, s16(15)) == 10)
    require(bit_and(s32_value, s32(15)) == 10)
    require(bit_and(s64_value, s64(15)) == 10)
    require(bit_and(u8_value, u8(15)) == 1)
    require(bit_and(u16_value, u16(15)) == 1)
    require(bit_and(u32_value, u32(15)) == 1)
    require(bit_and(u64_value, u64(15)) == 1)
    require(bit_or(s8_value, s8(1)) == -85)
    require(bit_or(s16_value, s16(1)) == -21845)
    require(bit_or(s32_value, s32(1)) == -1431655765)
    require(bit_or(s64_value, s64(1)) == -6148914691236517205)
    require(bit_or(u8_value, u8(1)) == 129)
    require(bit_or(u16_value, u16(1)) == 32769)
    require(bit_or(u32_value, u32(1)) == 2147483649)
    require(bit_or(u64_value, u64(1)) == 9223372036854775809)
    require(bit_xor(s8_value, s8(-1)) == 85)
    require(bit_xor(s16_value, s16(-1)) == 21845)
    require(bit_xor(s32_value, s32(-1)) == 1431655765)
    require(bit_xor(s64_value, s64(-1)) == 6148914691236517205)
    require(bit_xor(u8_value, u8(255)) == 126)
    require(bit_xor(u16_value, u16(65535)) == 32766)
    require(bit_xor(u32_value, u32(4294967295)) == 2147483646)
    require(bit_xor(u64_value, u64(18446744073709551615)) == 9223372036854775806)
    require(bit_not(s8_value) == 85)
    require(bit_not(s16_value) == 21845)
    require(bit_not(s32_value) == 1431655765)
    require(bit_not(s64_value) == 6148914691236517205)
    require(bit_not(u8_value) == 126)
    require(bit_not(u16_value) == 32766)
    require(bit_not(u32_value) == 2147483646)
    require(bit_not(u64_value) == 9223372036854775806)

    require(bit_shl(s8(1), s8(3)) == 8)
    require(bit_shl(s16(1), s16(3)) == 8)
    require(bit_shl(s32(1), s32(3)) == 8)
    require(bit_shl(s64(1), s64(3)) == 8)
    require(bit_shl(u8(1), u8(7)) == 128)
    require(bit_shl(u16(1), u16(15)) == 32768)
    require(bit_shl(u32(1), u32(31)) == 2147483648)
    require(bit_shl(u64(1), u64(63)) == 9223372036854775808)
    require(bit_shr(s8(-128), s8(1)) == -64)
    require(bit_shr(s16(-32768), s16(1)) == -16384)
    require(bit_shr(s32(-2147483648), s32(1)) == -1073741824)
    require(bit_shr(s64(-9223372036854775808), s64(1)) == -4611686018427387904)
    require(bit_shr(u8(128), u8(1)) == 64)
    require(bit_shr(u16(32768), u16(1)) == 16384)
    require(bit_shr(u32(2147483648), u32(1)) == 1073741824)
    require(bit_shr(u64(9223372036854775808), u64(1)) == 4611686018427387904)

    require(bit_rotate_left(s8(-126), s8(1)) == 5)
    require(bit_rotate_left(s16(-32766), s16(1)) == 5)
    require(bit_rotate_left(s32(-2147483646), s32(1)) == 5)
    require(bit_rotate_left(s64(-9223372036854775806), s64(1)) == 5)
    require(bit_rotate_left(u8(129), u8(1)) == 3)
    require(bit_rotate_left(u16(32769), u16(1)) == 3)
    require(bit_rotate_left(u32(2147483649), u32(1)) == 3)
    require(bit_rotate_left(u64(9223372036854775809), u64(1)) == 3)
    require(bit_rotate_right(s8(5), s8(1)) == -126)
    require(bit_rotate_right(s16(5), s16(1)) == -32766)
    require(bit_rotate_right(s32(5), s32(1)) == -2147483646)
    require(bit_rotate_right(s64(5), s64(1)) == -9223372036854775806)
    require(bit_rotate_right(u8(3), u8(1)) == 129)
    require(bit_rotate_right(u16(3), u16(1)) == 32769)
    require(bit_rotate_right(u32(3), u32(1)) == 2147483649)
    require(bit_rotate_right(u64(3), u64(1)) == 9223372036854775809)

    require(bit_count_lz(s8(1)) == 7)
    require(bit_count_lz(s16(1)) == 15)
    require(bit_count_lz(s32(1)) == 31)
    require(bit_count_lz(s64(1)) == 63)
    require(bit_count_lz(u8(1)) == 7)
    require(bit_count_lz(u16(1)) == 15)
    require(bit_count_lz(u32(1)) == 31)
    require(bit_count_lz(u64(1)) == 63)
    require(bit_count_tz(s8(0)) == 8)
    require(bit_count_tz(s16(0)) == 16)
    require(bit_count_tz(s32(0)) == 32)
    require(bit_count_tz(s64(0)) == 64)
    require(bit_count_tz(u8(0)) == 8)
    require(bit_count_tz(u16(0)) == 16)
    require(bit_count_tz(u32(0)) == 32)
    require(bit_count_tz(u64(0)) == 64)
    require(bit_count_1(s8_value) == 4)
    require(bit_count_1(s16_value) == 8)
    require(bit_count_1(s32_value) == 16)
    require(bit_count_1(s64_value) == 32)
    require(bit_count_1(u8_value) == 2)
    require(bit_count_1(u16_value) == 2)
    require(bit_count_1(u32_value) == 2)
    require(bit_count_1(u64_value) == 2)

    require(bits_of(f32_from_bits(u32(1069547520))) == 1069547520)
    require(bits_of(f32_from_bits(u32(0))) == 0)
    require(bits_of(f32_from_bits(u32(2147483648))) == 2147483648)
    require(is_nan(f32_from_bits(u32(2143289344))))
    require(bits_of(f32_from_bits(u32(2143289344))) == 2143289344)
    require(bits_of(f64_from_bits(u64(4609434218613702656))) == 4609434218613702656)
    require(bits_of(f64_from_bits(u64(0))) == 0)
    require(bits_of(f64_from_bits(u64(9223372036854775808))) == 9223372036854775808)
    require(is_nan(f64_from_bits(u64(9221120237041090560))))
    require(bits_of(f64_from_bits(u64(9221120237041090560))) == 9221120237041090560)
    print("capy-bits-ok")
}

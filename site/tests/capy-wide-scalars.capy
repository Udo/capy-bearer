function previous(value : s64) s64 {
    return value - s64(1)
}

function next(value : u64) u64 {
    return value + u64(1)
}

function half(value : f64) f64 {
    return value / 2.0
}

function CLI(request : dval) {
    var annotated_signed : s64 = 8
    var inferred_signed := s64(8)
    var annotated_unsigned : u64 = 9
    var inferred_unsigned := u64(9)
    var maximum : u64 = 18446744073709551615
    var minimum : s64 = -9223372036854775808
    var ratio : f64 = 1.25e2
    var wide_function : function(value : u64) u64 = next
    var float_function : function(value : f64) f64 = half
    var not_a_number := 0.0 / 0.0
    print(
        annotated_signed, "|", inferred_signed, "|", annotated_unsigned, "|", inferred_unsigned, "|",
        maximum, "|", minimum, "|", previous(s64(0)), "|", s64(-7) / s64(2), "|", s64(-7) % s64(2), "|", s64(-2) < s64(1), "|",
        maximum + u64(1) == u64(0), "|",
        u64(10) / u64(3), "|", u64(10) % u64(4), "|", u64(9) > u64(4), "|",
        ratio, "|", -3.0 / 2.0, "|",
        wide_function(u64(4)), "|", float_function(7.0), "|",
        u64(-1), "|", u64(9.75), "|", s32(u64(4294967295)), "|",
        f64(u64(9007199254740992)) == 9007199254740992.0, "|", time() > u64(0), time_precise() > 0.0, "|",
        1.0 / 0.0, "|", not_a_number == not_a_number, not_a_number != not_a_number, "|", -0.0, "|", arc_live()
    )
}

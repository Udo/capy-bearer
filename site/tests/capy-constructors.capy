function CLI(request : dval) {
    var missing := dval({}).missing
    var empty := dval("")
    var invalid := dval("no")
    var maximum := u64(18446744073709551615)
    var minimum := s64(-9223372036854775808)
    var decimal := 0.1 + 0.2
    print(
        s32(s32(7)), ":", s32(s64(7)), ":", s32(u64(7)), ":", s32(7.0), ":", s32(true), ":", s32(dval(7)), ":", s32("7"), "|",
        s64(s32(7)), ":", s64(s64(7)), ":", s64(u64(7)), ":", s64(7.0), ":", s64(true), ":", s64(dval(7)), ":", s64("7"), "|",
        u64(s32(7)), ":", u64(s64(7)), ":", u64(u64(7)), ":", u64(7.0), ":", u64(true), ":", u64(dval(7)), ":", u64("7"), "|",
        f64(s32(7)), ":", f64(s64(7)), ":", f64(u64(7)), ":", f64(7.0), ":", f64(true), ":", f64(dval(7)), ":", f64("7"), "|",
        string(s32(7)), ":", string(s64(7)), ":", string(u64(7)), ":", string(7.0), ":", string(true), ":", string(dval(7)), ":", string("7"), "|",
        bool(dval(true)), ":", bool(dval(false)), ":", bool(dval("true")), "|",
        u64(string(maximum)) == maximum, ":", s64(string(minimum)) == minimum, ":", f64(string(decimal)) == decimal, "|",
        s32(missing, {fallback: 11}), ":", s32(empty, {fallback: 12}), ":", s32(invalid, {fallback: 13}), ":",
        s64(missing, {fallback: s64(-14)}), ":", s64(empty, {fallback: s64(-15)}), ":", s64(invalid, {fallback: s64(-16)}), ":",
        u64(missing, {fallback: u64(21)}), ":", u64(empty, {fallback: u64(22)}), ":", u64(invalid, {fallback: u64(23)}), ":",
        f64(missing, {fallback: 1.1}), ":", f64(empty, {fallback: 1.2}), ":", f64(invalid, {fallback: 1.3}), ":",
        string(missing, {fallback: "absent"}), ":", string(empty, {fallback: "empty"}), ":",
        bool(missing, {fallback: true}), ":", bool(empty, {fallback: true}), ":", bool(invalid, {fallback: true}), "|",
        u64("101", {base: 2}), ":", s32("101", {base: 2}), ":", s64("ff", {base: 16}), ":", u64("ff", {base: 16}), ":", u64("42")
    )
}

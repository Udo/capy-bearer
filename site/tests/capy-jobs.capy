function CLI {
    {
    var escaped := shell_escape("a'b; echo injected")
    var shell := shell_exec("printf %s " + escaped)
    var spec := dval({"cmd": "printf spawned", "timeout_ms": 1000})
    var job := shell_spawn(spec)
    var done := job_await(job, 3000)
    var status := job_status(job)
    var stored := job_result(job)
    var failed_job := shell_spawn(dval({"cmd": "exit 7", "timeout_ms": 1000}))
    var failed := job_await(failed_job, 3000)
    file_unlink("/tmp/bearer-job-descendant.pid")
    var cancelling := shell_spawn(dval({"cmd": "sleep 30 & echo $! > /tmp/bearer-job-descendant.pid; wait", "timeout_ms": 60000}))
    var descendant_ready := shell_exec("for i in $(seq 1 100); do test -s /tmp/bearer-job-descendant.pid && exit 0; sleep .01; done; exit 1")
    var descendant := trim(file_get_contents("/tmp/bearer-job-descendant.pid"))
    var cancelled := job_cancel(cancelling)
    var descendant_gone := shell_exec("kill -0 " + shell_escape(descendant) + " 2>/dev/null; printf %s $?") == "1"
    var cancelled_status := job_await(cancelling, 5000)
    file_unlink("/tmp/bearer-task-cpp.txt")
    file_unlink("/tmp/bearer-task-cpp-named.txt")
    file_unlink("/tmp/bearer-task-capy.txt")
    file_unlink("/tmp/bearer-task-capy-named.txt")
    var task_props := dval({"nested": {"value": "capy-caller"}})
    var cpp_task := task("/tests/task-handlers.uce", task_props)
    var cpp_named_task := task("/tests/task-handlers.uce:CPP", task_props)
    var capy_task := task("/tests/task-handlers.capy", task_props)
    var capy_named_task := task("/tests/task-handlers.capy:CAPY", task_props)
    var cpp_status := task_status(cpp_task)
    var cpp_done := task_await(cpp_task, u64(10000))
    var cpp_named_done := task_await(cpp_named_task, u64(10000))
    var capy_done := task_await(capy_task, u64(10000))
    var capy_named_done := task_await(capy_named_task, u64(10000))
    var cancel_task := task("/tests/task-handlers.capy", task_props)
    var task_cancelled := task_cancel(cancel_task)
    var cancel_done := task_await(cancel_task, u64(10000))
    var server := server_start_http("capy-jobs-server", "29994", "servers/http.uce", "named")
    var stopped := server_stop("capy-jobs-server")
    var shell_status := "bad-shell"
    if shell == "a'b; echo injected" { shell_status = "shell" }
    var cancel_status := "no-cancel"
    if cancelled && descendant_gone { cancel_status = "cancel" }
    var task_status_value := "bad-task"
    if string(cpp_status["id"]) == cpp_task && string(cpp_done["state"]) == "succeeded" && string(cpp_named_done["state"]) == "succeeded" && string(capy_done["state"]) == "succeeded" && string(capy_named_done["state"]) == "succeeded" && file_get_contents("/tmp/bearer-task-cpp.txt") == "capy-caller" && file_get_contents("/tmp/bearer-task-cpp-named.txt") == "capy-caller" && file_get_contents("/tmp/bearer-task-capy.txt") == "capy-caller" && file_get_contents("/tmp/bearer-task-capy-named.txt") == "capy-caller" { task_status_value = "tasks" }
    if string(task_cancelled["id"]) != cancel_task || (string(cancel_done["state"]) != "canceled" && string(cancel_done["state"]) != "succeeded") { task_status_value = "bad-cancel" }
    var cwd_status := "no-cwd"
    if process_start_directory() != "" { cwd_status = "cwd" }
    var server_status := "no-server"
    if server > 0 && stopped { server_status = "server" }
    print(shell_status, "|", string(dval_get_by_path(done, "result/stdout"), "missing"), "|", string(dval_get_by_path(status, "state"), "missing"), "|", string(dval_get_by_path(stored, "state"), "missing"), "|", string(dval_get_by_path(failed, "state"), "missing"), "|", cancel_status, "|", string(dval_get_by_path(cancelled_status, "state"), "missing"), "|", task_status_value, "|", cwd_status, "|", server_status, "|")
    }
    print(arc_live())
}

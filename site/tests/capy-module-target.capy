#exports echo, counted, default_input

function ONCE(request : dval) { print("handler-once;") }
function RENDER(request : dval) { print("handler-render;") }

function echo(input : dval) dval {
    -> input
}

function default_input(input : dval) dval {
    -> dval("default")
}

function counted(input : dval) dval {
    print("counted;")
    -> input
}

function hidden(input : dval) dval {
    -> input
}

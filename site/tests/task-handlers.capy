function TASK(request : dval) {
    file_put_contents("/tmp/bearer-task-capy.txt", string(get_by_path(request.props, "nested/value"), ""))
}

function TASK:CAPY(request : dval) {
    file_put_contents("/tmp/bearer-task-capy-named.txt", string(get_by_path(request.props, "nested/value"), ""))
}

function TASK:SCALAR(request : dval) {
    file_put_contents("/tmp/bearer-task-capy.txt", string(request.props, ""))
}

function TASK:NONE(request : dval) {
    if request.props? {
        file_put_contents("/tmp/bearer-task-capy.txt", "unexpected")
    } else {
        file_put_contents("/tmp/bearer-task-capy.txt", "none")
    }
}

function TASK:SLOW(request : dval) {
    usleep(1000000)
    file_put_contents("/tmp/bearer-task-capy.txt", "slow")
}

function TASK:TRAP(request : dval) {
    trap()
}

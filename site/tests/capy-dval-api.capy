function CLI { var ignored := dval_api_run() }
function RENDER { var ignored := dval_api_run() }

function dval_api_run() s32 {
    {
    var value := {name: "Ada", drop: "x"}
    value = dval_put(value, "age", 42)
    value = dval_remove(value, "drop")
    value = dval_push(value, "tail")
    var explicit_name := string(dval_require(value, "name"))
    print(dval_is_array(value), dval_is_list(value), explicit_name, s32(value.age), value["0"], "|")
    var list := dval_set_array(dval("ignored"))
    list = dval_push(list, "one")
    list = dval_push(list, "two")
    list = dval_pop(list)
    print(dval_is_list(list), list[0], "|")
    var nested := {site: {title: "Bearer"}}
    print(nested.site.title, dval_has(dval_get_by_path(nested, "none"), "x"), "|")
    var typed := dval_set_type(dval("scalar"), "M")
    var empty := dval_get_or_create({:}, "created")
    print(dval_has(empty, "created"), dval_get_type_name(empty), dval_to_json(dval("A")), "|")
    if f64(dval("1.5")) == 1.5 { print("f") }
    print(bool(dval("yes")), dval_to_stringmap({x: "y"}).x, "|")
    var assigned := dval_assign(dval("old"), "new")
    assigned = dval_set_bool(assigned, true)
    var cleared := dval_clear({gone: "yes"})
    var fields := {name: "Ada", role: "engineer"}
    print(bool(assigned), dval_has(cleared, "gone"), dval_key(fields, "name"), dval_keys(fields)[0], dval_values(fields)[1], "|")
    var mapped := dval_map(dval([1, 2]), function(item : dval, key : string) dval { return dval(s32(item) + 1) })
    var filtered := dval_filter({keep: 2, drop: 1}, function(item : dval, key : string) bool { return s32(item) == 2 })
    print(s32(mapped[0]), s32(mapped[1]), dval_has(filtered, "keep"), dval_has(filtered, "drop"), "|")
    print(s64(dval("-42")), u64(dval("42")), s64(dval("bad"), s64(-9)), u64(dval("bad"), u64(18446744073709551615)), "|")
    }
    print(arc_live())
    return 0
}

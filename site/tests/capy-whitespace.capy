function add
(
    left : s32,
    right : s32
)
s32
{
    left
    +
    right
}

function multiline_return() s32 {
    return
    9
}

function no_value_return {
    return
}

function CLI(request : dval) {
    var first := 1 var second := 2
    var sum := first
    +
    second
    var called := add
    (
        sum,
        4
    )
    var values := [
        1,
        2
    ]
    if
    called == 7
    {
        print(called, "|", values
        [0] + values
        [1], "|", multiline_return())
    }
    no_value_return()
}

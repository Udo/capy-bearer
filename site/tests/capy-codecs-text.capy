function exercise {
    {
        var value := dval({name: "Ada"})
        var packed := brb_encode(value)
        var restored := brb_decode(packed)
        var xml := xml_decode("<root><name>Ada</name></root>")
        var xml_encoded := xml_encode(value)
        var yaml := yaml_decode("name: Ada\n")
        var yaml_encoded := yaml_encode(value)
        var ast := markdown_to_ast("# Title")
        var offset := json_consume_space(" \t\nvalue", 0)
        print(restored["name"], "|", xml["children"][0]["text"], "|", length(xml_encoded), "|", yaml["name"], "|", length(yaml_encoded), "|", ast["type"], "|", markdown_to_html("**bold**"), "|", offset, "|", json_encode("x"), "|", json_encode(value), "|", html_escape("<&>\""), "|", arc_live())
    }
    print("|", arc_live())
}
function CLI(request : dval) { exercise() }
function RENDER(request : dval) { exercise() }

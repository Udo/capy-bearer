function exercise(request : dval) {
    {
    ob_start()
    print("outer")
    ob_start()
    print("inner")
    var inner := ob_get()
    var captured := ob_get_close()
    print("+", captured)
    ob_start()
    print("discard")
    ob_close()
    var outer := ob_get_close()
    var route := route_from_raw_path("workspace/projects", "index")
    var rejected := route_from_raw_path("../unsafe", "index")
    var perf := runtime_perf()
    var input_name := string(request.form.name, string(request.query.name, ""))
    if input_name == "" && string(request.server.BEARER_CLI, "") == "1" {
        input_name = string(json_decode(string(request.body, "{}")).name, "")
    }
    var displayed_name := input_name
    if displayed_name == "" { displayed_name = "fallback" }
    print(displayed_name, "|", input_name, "|", inner, "|", outer, "|", string(request.route.path, "fallback"), "|", route.page, bool(route.valid, false), string(rejected.path, "") == "", !bool(rejected.valid, false), "|", length(string(request.url.script, "")) > 0, length(string(request.url.base, "")) > 0, get_type_name(perf) != "invalid", "|", length(session_id_create()) == 64)
    }
    print("|", arc_live())
}

function CLI(request : dval) { exercise(request) }
function RENDER(request : dval) {
    if string(request.query.status, "") == "yes" { response_status(202, "Capy Accepted") }
    exercise(request)
}

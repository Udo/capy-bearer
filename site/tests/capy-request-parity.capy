function exercise(request : dval) {
    {
    ob_start()
    print("outer")
    ob_start()
    print("inner")
    var inner := ob_get()
    var captured := ob_get_close()
    print("+", captured)
    ob_start()
    print("discard")
    ob_close()
    var outer := ob_get_close()
    var route := path_normalize("workspace/projects", {fallback: "index"})
    var rejected := path_normalize("../unsafe", {fallback: "index"})
    var perf := runtime_perf()
    var input_name := string(request.form.name, {fallback: string(request.query.name)})
    if input_name == "" && string(request.server.BEARER_CLI) == "1" {
        input_name = string(json_decode(string(request.body, {fallback: "{}"})).name)
    }
    var displayed_name := input_name
    if displayed_name == "" { displayed_name = "fallback" }
    print(displayed_name, "|", input_name, "|", inner, "|", outer, "|", string(request.route.path, {fallback: "fallback"}), "|", route, route != "", rejected == "", "|", length(string(request.url.script)) > 0, length(string(request.url.base)) > 0, get_type_name(perf) != "invalid", "|", length(session_id_create()) == 64)
    }
    print("|", arc_live())
}

function CLI(request : dval) { exercise(request) }
function RENDER(request : dval) {
    if string(request.query.status) == "yes" { request.out.status = 202 }
    exercise(request)
}

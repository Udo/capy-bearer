function RENDER(request : dval) {
    var action := string(request.query.action, "")
    if action == "set" {
        var session := session_start("capy-session")
        session = session_set("value", string(request.query.value, ""))
        request.out.cookies["capy-extra"] = "yes"
        print("set")
    } else {
        if action == "remove" {
            var session := session_start("capy-session")
            session = session_remove("value")
            print("removed")
        } else {
            if action == "destroy" {
                var session := session_destroy("capy-session")
                print("destroyed")
            } else {
                {
                    var session := session_start("capy-session")
                    if length(string(session.values.value, "")) > 0 {
                        print(string(session.values.value, ""))
                    } else {
                        print("missing")
                    }
                }
                print("|", string(request.cookies["capy-extra"], ""), "|", arc_live())
            }
        }
    }
}

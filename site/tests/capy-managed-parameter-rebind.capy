struct Box { value : s32 }

function rebind_text(value : string) string {
    value = value + "!"
    return value
}

function rebind_array(values : [s32]) [s32] {
    values = [s32(7), s32(8)]
    return values
}

function two_scopes(value : string, flag : bool) string {
    if flag { value = "A" }
    value = value + "?"
    return value
}

function mutate_array(values : [s32]) void {
    values[0] = s32(4)
    values.push(s32(5))
}

function mutate_box(box : Box) void {
    box.value = s32(9)
}

function CLI(request : dval) {
    var text := "go"
    var path := "api/length"
    var head := nibble(path, "/")
    var caller := "cc" + "/" + "dd"
    var rebound_text := two_scopes(caller, false)
    var pad := "z" + "z"
    var nibble_path := "aaa" + "/" + "bbb"
    var arc_before := arc_live()
    for index := 0..50 { var unused := nibble(nibble_path, "/") }
    var arc_after := arc_live()
    var values := [s32(1), s32(2)]
    var box := Box(s32(3))
    var rebound := rebind_array(values)
    mutate_array(values)
    mutate_box(box)
    print(rebind_text(text), "|", text, "|", head, ":", path, "|", rebound_text, ":", caller, ":", pad, "|", arc_after - arc_before, "|", rebound[0], rebound[1], "|", values[0], values[1], values[2], "|", box.value, "|", arc_live())
}

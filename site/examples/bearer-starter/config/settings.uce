void config_theme(DValue& options, String key, String label, String path, String mode, String description, String footer_text, String meta_description, String theme_color)
{
	DValue& theme = options[key];
	theme["label"] = label;
	theme["path"] = path;
	theme["mode"] = mode;
	theme["mode-class"] = mode == "dark" ? "dark-theme" : "";
	theme["description"] = description;
	theme["footer_text"] = footer_text;
	theme["meta_description"] = meta_description;
	theme["theme_color"] = theme_color;
}

DValue get_config()
{
	DValue config;

	config["site"]["name"] = "BEARER Starter";
	config["site"]["default_page_title"] = "Home";
	config["site"]["timezone"] = "UTC";

	config["users"]["enable_signup"].set_bool(true);
	config["filebase"]["path"] = "/tmp/bearer-starter-data";

	config["theme"]["key"] = "portal-dark";
	DValue& themes = config["theme"]["options"];
	config_theme(themes, "light", "Starter Light", "themes/light/", "light", "Original starter light theme kept for backward compatibility.", "BEARER Starter running with the Starter Light theme.", "Starter Light theme for the BEARER starter", "#3b82f6");
	config_theme(themes, "dark", "Starter Dark", "themes/dark/", "dark", "Original starter dark theme kept for backward compatibility.", "BEARER Starter running with the Starter Dark theme.", "Starter Dark theme for the BEARER starter", "#0f172a");
	config_theme(themes, "portal-light", "AI Portal Light", "themes/portal-light/", "light", "Dense, corporate portal layout in a light palette.", "BEARER Starter running with the AI Portal Light starter theme.", "AI Portal Light theme for the BEARER starter", "#0f68ad");
	config_theme(themes, "portal-dark", "AI Portal Dark", "themes/portal-dark/", "dark", "Glassy dark portal shell and the current default starter theme.", "BEARER Starter running with the AI Portal Dark starter theme.", "AI Portal Dark theme for the BEARER starter", "#0f172a");
	config_theme(themes, "localfirst", "Local First", "themes/localfirst/", "dark", "llm2-derived admin shell with sidebar chrome.", "BEARER Starter running with the Local First starter theme.", "Local First admin-shell theme for the BEARER starter", "#020913");
	config_theme(themes, "retro-gaming", "Retro Gaming", "themes/retro-gaming/", "dark", "CRT scanlines, pixel font, neon glow.", "INSERT COIN // BEARER Starter running the Retro Gaming theme.", "Retro Gaming pixel theme for the BEARER starter", "#0a0a1a");

	config["menu"][""]["title"] = "Home";
	config["menu"][""]["hidden"].set_bool(true);
	config["menu"]["page1"]["title"] = "Components";
	config["menu"]["features"]["title"] = "Features";
	config["menu"]["page2"]["title"] = "Ajaxy";
	config["menu"]["gauges"]["title"] = "Gauges";
	config["menu"]["dashboard"]["title"] = "Dashboard";
	config["menu"]["workspace"]["title"] = "Workspace";
	config["menu"]["themes"]["title"] = "Themes";
	config["menu"]["auth/demo"]["title"] = "Auth";

	return(config);
}
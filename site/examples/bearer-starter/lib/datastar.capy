function datastar_sse_headers(request : dval) {
    request.out.headers["Content-Type"] = "text/event-stream; charset=utf-8"
    request.out.headers["Cache-Control"] = "no-cache, no-store, must-revalidate"
    request.out.headers["X-Accel-Buffering"] = "no"
}

function datastar_patch_elements(elements : string) string {
    return clone("event: datastar-patch-elements\ndata: elements ") + elements + "\n\n"
}

function datastar_patch_signals(signals_json : string) string {
    return clone("event: datastar-patch-signals\ndata: signals ") + signals_json + "\n\n"
}

function CLI(request : dval) {
    print(datastar_patch_signals("{\"datastar\":true}"))
}

function dval_to_f64(value : dval, fallback : f64) f64 { dval_f64(__bearer_dv_apply_brrb(20, value, "", dval(fallback))) }
function dval_to_bool(value : dval) bool { dval_bool(__bearer_dv_apply_brrb(21, value, "", dval(false))) }
function dval_to_bool(value : dval, fallback : bool) bool { dval_bool(__bearer_dv_apply_brrb(21, value, "", dval(fallback))) }
function dval_to_s64(value : dval) s64 { __bearer_dv_s64_brrb(value, 0s64) }
function dval_to_s64(value : dval, fallback : s64) s64 { __bearer_dv_s64_brrb(value, fallback) }
function dval_to_u64(value : dval) u64 { __bearer_dv_u64_brrb(value, 0u64) }
function dval_to_u64(value : dval, fallback : u64) u64 { __bearer_dv_u64_brrb(value, fallback) }

// StringList is represented by a list-shaped copied DValue.  These callbacks
// deliberately stay in Capy, just like dval_map/dval_filter.
function every(items : dval, predicate : function(value : string) bool) bool {
    for key, item = items { if !predicate(dval_string(item)) { return false } }
    return true
}
function some(items : dval, predicate : function(value : string) bool) bool {
    for key, item = items { if predicate(dval_string(item)) { return true } }
    return false
}
function string_list_find(items : dval, predicate : function(value : string) bool, fallback : string) string {
    for key, item = items { var value := dval_string(item); if predicate(value) { return value } }
    return fallback
}
function keys(items : dval) dval {
    var result := dval([])
    for key, item = items { result = dval_push(result, dval(key)) }
    return result
}
function map(items : dval, mapper : function(value : string) string) dval {
    var result := dval([])
    for key, item = items { result = dval_push(result, dval(mapper(dval_string(item)))) }
    return result
}
function filter(items : dval, predicate : function(value : string) bool) dval {
    var result := dval([])
    for key, item = items { var value := dval_string(item); if predicate(value) { result = dval_push(result, dval(value)) } }
    return result
}
function unique(items : dval) dval {
    var result := dval([])
    for key, item = items {
        var value := dval_string(item)
        if !some(result, function(candidate : string) bool { candidate == value }) { result = dval_push(result, dval(value)) }
    }
    return result
}

function dval_map(value : dval, mapper : function(value : dval, key : string) dval) dval {
    var result := dval({:})
    var list := dval_is_list(value)
    if list { result = dval_set_array(result) }
    if dval_is_array(value) {
        for key, item = value {
            var mapped := mapper(item, key)
            if list { result = dval_push(result, mapped) }
            else { result = dval_put(result, key, mapped) }
        }
    } else {
        result = dval_push(result, mapper(value, ""))
    }
    return result
}

function dval_filter(value : dval, predicate : function(value : dval, key : string) bool) dval {
    var result := dval({:})
    var list := dval_is_list(value)
    if list { result = dval_set_array(result) }
    if dval_is_array(value) {
        for key, item = value {
            if predicate(item, key) {
                if list { result = dval_push(result, item) }
                else { result = dval_put(result, key, item) }
            }
        }
    } else {
        if predicate(value, "") { result = dval_push(result, value) }
    }
    return result
}


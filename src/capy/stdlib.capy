// DValues cross the Bearer boundary as copied ARC values.  Mutators return the
// replacement value: `value = dval_push(value, child)`; no host alias escapes.
function to_lower(value : string) string { lower(value) }
function to_upper(value : string) string { upper(value) }
function find(haystack : string, needle : string) s32 { __bearer_string_find(haystack, needle) }
function contains(haystack : string, needle : string) bool { __bearer_string_find(haystack, needle) != -1 }
function replace(value : string, needle : string, replacement : string) string { __bearer_string_replace(value, needle, replacement) }
function lower(value : string) string { __bearer_string_lower(value) }
function upper(value : string) string { __bearer_string_upper(value) }
function first() string { return "" }
function first(one : string) string { return one }
function first(one : string, two : string) string { var result := two; if __bearer_string_nonblank(one) { result = one }; return result }
function first(one : string, two : string, three : string) string { return first(first(one, two), three) }
function first(one : string, two : string, three : string, four : string) string { return first(first(one, two), first(three, four)) }
function substr(value : string, start : s32) string { __bearer_string_substr(value, start as s64, length(value) as s64) }
function substr(value : string, start : s64) string { __bearer_string_substr(value, start, length(value) as s64) }
function substr(value : string, start : s32, length : s32) string { __bearer_string_substr(value, start as s64, length as s64) }
function substr(value : string, start : s64, length : s64) string { __bearer_string_substr(value, start, length) }
function strpos(haystack : string, needle : string) s64 { __bearer_string_strpos(haystack, needle, 0s64) }
function strpos(haystack : string, needle : string, offset : s64) s64 { __bearer_string_strpos(haystack, needle, offset) }
function dval_set(value : dval, source : dval) dval { __bearer_dv_apply_brrb(0, value, "", source) }
function dval_assign(value : dval, source : dval) dval { dval_set(value, source) }
function dval_push(value : dval, child : dval) dval { __bearer_dv_apply_brrb(1, value, "", child) }
function dval_pop(value : dval) dval { __bearer_dv_apply_brrb(2, value, "", dval("")) }
function dval_remove(value : dval, key : string) dval { __bearer_dv_apply_brrb(3, value, key, dval("")) }
function dval_clear(value : dval) dval { __bearer_dv_apply_brrb(4, value, "", dval("")) }
function dval_get_by_path(value : dval, path : string) dval { __bearer_dv_apply_brrb(5, value, path, dval("")) }
function dval_get_or_create(value : dval, key : string) dval { __bearer_dv_apply_brrb(6, value, key, dval("")) }
function dval_set_array(value : dval) dval { __bearer_dv_apply_brrb(7, value, "", dval("")) }
function dval_set_bool(value : dval, flag : bool) dval { __bearer_dv_apply_brrb(8, value, "", dval(flag)) }
function dval_set_type(value : dval, type : string) dval { __bearer_dv_apply_brrb(9, value, type, dval("")) }
function dval_get_type_name(value : dval) string { dval_string(__bearer_dv_apply_brrb(10, value, "", dval(""))) }
function dval_is_array(value : dval) bool { dval_bool(__bearer_dv_apply_brrb(11, value, "", dval(""))) }
function dval_is_list(value : dval) bool { dval_bool(__bearer_dv_apply_brrb(12, value, "", dval(""))) }
function dval_key(value : dval, key : string) dval { __bearer_dv_apply_brrb(13, value, key, dval("")) }
function dval_keys(value : dval) dval { __bearer_dv_apply_brrb(14, value, "", dval("")) }
function dval_values(value : dval) dval { __bearer_dv_apply_brrb(15, value, "", dval("")) }
function dval_to_json(value : dval) string { dval_string(__bearer_dv_apply_brrb(16, value, "", dval(""))) }
function dval_to_json(value : dval, quote : string) string { dval_string(__bearer_dv_apply_brrb(16, value, quote, dval(""))) }
function dval_to_stringmap(value : dval) dval { __bearer_dv_apply_brrb(17, value, "", dval("")) }
function dval_put(value : dval, key : string, child : dval) dval { __bearer_dv_apply_brrb(18, value, key, child) }
function dval_to_string(value : dval) string { dval_string(__bearer_dv_apply_brrb(19, value, "", dval(""))) }
function dval_to_string(value : dval, fallback : string) string { dval_string(__bearer_dv_apply_brrb(19, value, "", dval(fallback))) }

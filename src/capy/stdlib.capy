function dval_to_f64(value : dval) f64 { dval_f64(__bearer_dv_apply_brrb(__bearer_dval_dval_to_f64, value, "", dval(0.0))) }
function dval_to_f64(value : dval, fallback : f64) f64 { dval_f64(__bearer_dv_apply_brrb(__bearer_dval_dval_to_f64, value, "", dval(fallback))) }

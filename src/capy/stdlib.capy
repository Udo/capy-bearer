function route_path_sanitize(path : string, fallback : string) string { dval_string(__bearer_route_path_brrb(3, dval(path), fallback, dval(""))) }
function runtime_safe_key(key : string) string { dval_string(__bearer_route_path_brrb(4, dval(key), "runtime key", dval(""))) }

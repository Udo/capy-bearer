function split(value : string, delimiter : string) dval { __bearer_text_parsing_brrb(10, dval(value), delimiter, dval("")) }
function join(items : dval) string { join(items, "\n") }
function join(items : dval, delimiter : string) string {
    var result := ""
    var first := true
    for key, item = items { if !first { result = result + delimiter }; result = result + dval_string(item); first = false }
    result
}
function regex_split(pattern : string, subject : string) dval { __bearer_regex_dval(3, pattern, subject, "", "") }

function int_val(raw : string) u64 { __bearer_dv_u64_brrb(__bearer_text_parsing_brrb(4, dval(raw), "", dval(10.0)), 0u64) }
function int_val(raw : string, base : s32) u64 { __bearer_dv_u64_brrb(__bearer_text_parsing_brrb(4, dval(raw), "", dval(base)), 0u64) }
function to_bool(raw : string) bool { dval_bool(__bearer_text_parsing_brrb(5, dval(raw), "", dval(false))) }
function to_bool(raw : string, fallback : bool) bool { dval_bool(__bearer_text_parsing_brrb(5, dval(raw), "", dval(fallback))) }
function to_f64(raw : string) f64 { dval_to_f64(dval(raw), 0.0) }
function to_f64(raw : string, fallback : f64) f64 { dval_to_f64(dval(raw), fallback) }
function to_s64(raw : string) s64 { __bearer_dv_s64_brrb(dval(raw), 0s64) }
function to_s64(raw : string, fallback : s64) s64 { __bearer_dv_s64_brrb(dval(raw), fallback) }
function to_u64(raw : string) u64 { __bearer_dv_u64_brrb(dval(raw), 0u64) }
function to_u64(raw : string, fallback : u64) u64 { __bearer_dv_u64_brrb(dval(raw), fallback) }
function str_starts_with(haystack : string, needle : string) bool { dval_bool(__bearer_text_parsing_brrb(6, dval(haystack), needle, dval(false))) }
function str_ends_with(haystack : string, needle : string) bool { dval_bool(__bearer_text_parsing_brrb(7, dval(haystack), needle, dval(false))) }
function encode_query(map : dval) string { dval_string(__bearer_text_parsing_brrb(8, map, "", dval(""))) }
function parse_query(query : string) dval { __bearer_text_parsing_brrb(9, dval(query), "", dval("")) }

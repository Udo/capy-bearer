function file_open(path : string, mode : string) u64 { __bearer_file_open(path, mode) }
function file_read(handle : u64, count : u64) string { __bearer_file_read(handle, count) }
function file_write(handle : u64, value : string) u64 { __bearer_file_write(handle, value) }
function file_seek(handle : u64, offset : s64, whence : s64) s64 { __bearer_file_seek(handle, offset, whence) }
function file_tell(handle : u64) s64 { __bearer_file_tell(handle) }
function file_fsync(handle : u64) bool { __bearer_file_fsync(handle) }
function file_close(handle : u64) { __bearer_file_close(handle) }
function file_temp(prefix : string) string { __bearer_file_temp(prefix) }
function file_unlink(path : string) { __bearer_file_unlink(path) }

function time() u64 { __bearer_time() }
function time_precise() f64 { __bearer_time_precise() }
